 or any(k not in (\"effective_at\", \"ack_window\") for k in rev):\n            return False\n        if rev.get(\"effective_at\") not in (\"anchor\", \"delivery_ack\"):\n            return False\n        if \"ack_window\" in rev and not is_int(rev[\"ack_window\"], 1):\n            return False\n    return True\n\n\ndef contract_door(contract):\n    if not isinstance(contract, dict):\n        return False\n    if contract.get(\"schema\") != \"a2a-contract-v0\":\n        return False\n    if not is_lower_hex(contract.get(\"contract_id\"), 32) or not is_lower_hex(contract.get(\"nonce\"), 32):\n        return False\n    parties = contract.get(\"parties\")\n    if not isinstance(parties, list) or len(parties) != 2 or not all(isinstance(p, dict) for p in parties):\n        return False\n    roles = [p.get(\"role\") for p in parties]\n    if roles.count(\"principal\") != 1 or roles.count(\"contractor\") != 1:\n        return False\n    domains = []\n    by_dom = {}\n    for p in parties:\n        dom = normalize_domain(p.get(\"domain\"))\n        if dom is None:\n            return False\n        domains.append(dom)\n        if not is_https_url(p.get(\"key_url\")):\n            return False\n        if b64_canonical(p.get(\"public_key_ed25519_b64\"), 32) is None:\n            return False\n        by_dom[dom] = p\n    if domains[0] == domains[1]:\n        return False\n    task = contract.get(\"task\")\n    if not isinstance(task, dict) or not isinstance(task.get(\"purpose\"), str) or not task[\"purpose\"]:\n        return False\n    if \"payload_digest\" in task and task[\"payload_digest\"] is not None:\n        if not is_lower_hex(task[\"payload_digest\"], 64):\n            return False\n    grant = contract.get(\"grant\")\n    if not isinstance(grant, dict) or any(k not in GRANT_KEYS for k in grant):\n        return False\n    auth = grant.get(\"authorized_actions\")\n    proh = grant.get(\"prohibited_actions\")\n    if not nonempty_str_list(auth) or not nonempty_str_list(proh):\n        return False\n    if set(auth) & set(proh):\n        return False\n    if not grant_types_ok(grant):\n        return False\n    if not numbers_and_keys_ok(contract):\n        return False\n    est = contract.get(\"establishes\")\n    if not isinstance(est, list) or not est or not all(isinstance(s, str) for s in est):\n        return False\n    for s in est:\n        if any(rx.search(s) for rx in EST_RES):\n            return False\n    dne = contract.get(\"does_not_establish\")\n    if not isinstance(dne, list) or not dne or not all(isinstance(s, str) for s in dne):\n        return False\n    lows = [s.lower() for s in dne]\n    if not any(\"runtime\" in s or \"enforce\" in s for s in lows):\n        return False\n    if not any(\"judge\" in s or \"liability\" in s or \"fault\" in s for s in lows):\n        return False\n    if not any(\"deviat\" in s for s in lows):\n        return False\n    if not any(\"legal\" in s for s in lows):\n        return False\n    sigs = contract.get(\"signatures\")\n    if not isinstance(sigs, list):\n        return False\n    try:\n        msg = b\"a2a-contract-v0\\n\" + canonical(without(contract, \"signatures\"))\n    except Exception:\n        return False\n    seen_roles = set()\n    for s in sigs:\n        if not isinstance(s, dict):\n            return False\n        dom = normalize_domain(s.get(\"domain\"))\n        if dom is None or dom not in by_dom:\n            return False\n        party = by_dom[dom]\n        if verify(party.get(\"public_key_ed25519_b64\"), s.get(\"signature\"), msg) is not True:\n            return False\n        seen_roles.add(party.get(\"role\"))\n    if seen_roles != {\"principal\", \"contractor\"}:\n        return False\n    return True\n\n\ndef settleable_terms(contract):\n    reasons = set()\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else None\n    if not isinstance(grant, dict):\n        return reasons\n    auth = grant.get(\"authorized_actions\")\n    if not isinstance(auth, list):\n        reasons.add(\"authorized_actions_missing\")\n    names = []\n    if isinstance(auth, list):\n        names.extend(auth)\n    proh = grant.get(\"prohibited_actions\")\n    if isinstance(proh, list):\n        names.extend(proh)\n    cond = grant.get(\"conditional\")\n    if isinstance(cond, list):\n        for e in cond:\n            if isinstance(e, dict):\n                names.append(e.get(\"action\"))\n    if any(not isinstance(n, str) or not ACTION_RE.match(n) for n in names):\n        reasons.add(\"grant_action_name_invalid\")\n    ws = grant.get(\"witnesses\")\n    if isinstance(ws, list):\n        if len(ws) > 32:\n            reasons.add(\"too_many_witnesses\")\n        wnames = []\n        for w in ws:\n            if isinstance(w, dict):\n                if b64_decode_any(w.get(\"public_key_ed25519_b64\"), 32) is None:\n                    reasons.add(\"witness_key_invalid\")\n                wnames.append(w.get(\"name\"))\n        if len(wnames) != len(set(wnames)):\n            reasons.add(\"key_conflict\")\n    keys = []\n    parties = contract.get(\"parties\")\n    if isinstance(parties, list):\n        for p in parties:\n            if isinstance(p, dict):\n                raw = b64_decode_any(p.get(\"public_key_ed25519_b64\"), 32)\n                if raw is not None:\n                    keys.append(raw)\n    if isinstance(ws, list):\n        for w in ws:\n            if isinstance(w, dict):\n                raw = b64_decode_any(w.get(\"public_key_ed25519_b64\"), 32)\n                if raw is not None:\n                    keys.append(raw)\n    if len(keys) != len(set(keys)):\n        reasons.add(\"key_conflict\")\n    ordering = grant.get(\"ordering\")\n    if isinstance(ordering, dict) and \"same_height\" in ordering:\n        sh = ordering[\"same_height\"]\n        if sh is not None and sh != \"conservative\":\n            reasons.add(\"tie_policy_refused\")\n    rev = grant.get(\"revocation\")\n    if isinstance(rev, dict) and rev.get(\"effective_at\") not in (\"anchor\", \"delivery_ack\"):\n        reasons.add(\"revocation_policy_not_recomputable\")\n    if isinstance(rev, dict) and rev.get(\"effective_at\") == \"delivery_ack\" and not is_int(rev.get(\"ack_window\"), 1):\n        reasons.add(\"ack_window_missing\")\n    fin = grant.get(\"finality\")\n    depth = fin.get(\"depth\") if isinstance(fin, dict) else None\n    if not is_int(depth, 1):\n        reasons.add(\"finality_policy_missing\")\n    if \"expiry_height\" in grant and grant[\"expiry_height\"] is not None and not is_int(grant[\"expiry_height\"], 0):\n        reasons.add(\"bad_expiry_height\")\n    ap = grant.get(\"approval_policy\")\n    if isinstance(ap, dict) and ap.get(\"allow_unscoped\"):\n        reasons.add(\"unscoped_approvals_refused\")\n    return reasons\n\n\ndef as_str_list(grant, key):\n    if not isinstance(grant, dict):\n        return []\n    v = grant.get(key)\n    if not isinstance(v, list):\n        return []\n    return v\n\n\ndef deleg_allowed(grant):\n    if not isinstance(grant, dict):\n        return []\n    d = grant.get(\"delegation\")\n    if not isinstance(d, dict):\n        return []\n    a = d.get(\"allowed\")\n    return a if isinstance(a, list) else []\n\n\ndef cond_list(grant):\n    if not isinstance(grant, dict):\n        return []\n    c = grant.get(\"conditional\")\n    if not isinstance(c, list):\n        return []\n    return [e for e in c if isinstance(e, dict)]\n\n\ndef requires_of(entry):\n    if \"requires\" not in entry:\n        return None\n    return entry[\"requires\"]\n\n\ndef grant_within(c, p):\n    if not isinstance(c, dict) or not isinstance(p, dict):\n        return False\n    ca = as_str_list(c, \"authorized_actions\")\n    pa = as_str_list(p, \"authorized_actions\")\n    if any(a not in pa for a in ca):\n        return False\n    cp = as_str_list(c, \"prohibited_actions\")\n    pp = as_str_list(p, \"prohibited_actions\")\n    if any(a not in cp for a in pp):\n        return False\n    if any(a not in as_str_list(p, \"data_access\") for a in as_str_list(c, \"data_access\")):\n        return False\n    ph = json_int(p.get(\"max_hops\")) if \"max_hops\" in p else None\n    if ph is not None:\n        ch = json_int(c.get(\"max_hops\")) if \"max_hops\" in c else None\n        if ch is None or ch > ph - 1:\n            return False\n    pa_allowed = deleg_allowed(p)\n    if any(a not in pa_allowed for a in deleg_allowed(c)):\n        return False\n    ccond = cond_list(c)\n    pcond = cond_list(p)\n    ccond_by = {}\n    for e in ccond:\n        ccond_by[e.get(\"action\")] = e\n    c_auth = set(ca)\n    for e in pcond:\n        a = e.get(\"action\")\n        r = requires_of(e)\n        if a in cp:\n            continue\n        if a not in c_auth and a not in ccond_by:\n            continue\n        if a not in ccond_by or requires_of(ccond_by[a]) != r:\n            return False\n    p_auth = set(pa)\n    p_cond_actions = {e.get(\"action\") for e in pcond}\n    for e in ccond:\n        a = e.get(\"action\")\n        if a not in p_auth and a not in p_cond_actions:\n            return False\n    pe = json_int(p.get(\"expiry_height\")) if \"expiry_height\" in p else None\n    if pe is not None:\n        ce = json_int(c.get(\"expiry_height\")) if \"expiry_height\" in c else None\n        if ce is None or ce > pe:\n            return False\n    prev = p.get(\"revocation\")\n    if isinstance(prev, dict):\n        crev = c.get(\"revocation\")\n        if not isinstance(crev, dict) or \"effective_at\" not in crev:\n            return False\n        m = prev.get(\"effective_at\")\n        cm = crev.get(\"effective_at\")\n        if m == \"anchor\":\n            if cm != \"anchor\":\n                return False\n        elif m == \"delivery_ack\":\n            if cm == \"anchor\":\n                pass\n            elif cm == \"delivery_ack\":\n                if \"ack_window\" in prev and json_int(prev.get(\"ack_window\")) is not None:\n                    w = json_int(prev.get(\"ack_window\"))\n                    cw = json_int(crev.get(\"ack_window\")) if \"ack_window\" in crev else None\n                    if cw is None or cw > w:\n                        return False\n            else:\n                return False\n        else:\n            return False\n    pf = p.get(\"finality\")\n    if isinstance(pf, dict):\n        cf = c.get(\"finality\")\n        if not isinstance(cf, dict):\n            return False\n        if \"depth\" in pf and json_int(pf.get(\"depth\")) is not None:\n            d = json_int(pf.get(\"depth\"))\n            cd = json_int(cf.get(\"depth\")) if \"depth\" in cf else None\n            if cd is None or cd < d:\n                return False\n        if \"max_target_bits\" in pf and decode_target_hex(pf.get(\"max_target_bits\")) is not None:\n            pt = decode_target_hex(pf.get(\"max_target_bits\"))\n            if \"max_target_bits\" not in cf:\n                return False\n            ct = decode_target_hex(cf.get(\"max_target_bits\"))\n            if ct is None or ct > pt:\n                return False\n    pws = p.get(\"witnesses\")\n    pkeys = []\n    if isinstance(pws, list):\n        for w in pws:\n            if isinstance(w, dict) and isinstance(w.get(\"public_key_ed25519_b64\"), str):\n                pkeys.append(w[\"public_key_ed25519_b64\"])\n    if pkeys:\n        ckeys = []\n        cws = c.get(\"witnesses\")\n        if isinstance(cws, list):\n            for w in cws:\n                if isinstance(w, dict) and isinstance(w.get(\"public_key_ed25519_b64\"), str):\n                    ckeys.append(w[\"public_key_ed25519_b64\"])\n        if not ckeys or any(k not in ckeys for k in pkeys):\n            return False\n    for key in (\"privacy\", \"ordering\"):\n        if key in p and p[key] is not None:\n            if key not in c or c[key] is None:\n                return False\n            if canonical(p[key]) != canonical(c[key]):\n                return False\n    def unscoped(g):\n        ap = g.get(\"approval_policy\")\n        return isinstance(ap, dict) and ap.get(\"allow_unscoped\") is True\n    if unscoped(c) and not unscoped(p):\n        return False\n    def approver_set(g):\n        ap = g.get(\"approval_policy\")\n        if not isinstance(ap, dict) or \"approvers\" not in ap or not isinstance(ap.get(\"approvers\"), list):\n            return set()\n        return {canonical(e) for e in ap[\"approvers\"]}\n    if approver_set(c) != approver_set(p):\n        return False\n    return True\n\n\ndef strict_terms(contract, parent, parent_supplied):\n    reasons = set()\n    sigs = contract.get(\"signatures\") if isinstance(contract, dict) else None\n    if isinstance(sigs, list):\n        for s in sigs:\n            if not isinstance(s, dict):\n                continue\n            raw = b64_decode_any(s.get(\"signature\"), 64)\n            if raw is not None and not sig_bytes_strict(raw):\n                reasons.add(\"contract_signature_not_strict\")\n                break\n    if isinstance(contract, dict) and \"bond\" in contract and contract[\"bond\"] is not None:\n        bond = contract[\"bond\"]\n        amt = bond.get(\"amount\") if isinstance(bond, dict) else None\n        if not (isinstance(bond, dict) and is_int(amt, 1, MAX_SAFE)):\n            reasons.add(\"bond_malformed\")\n    if isinstance(contract, dict) and \"parent_contract\" in contract and contract[\"parent_contract\"] is not None:\n        if not parent_supplied:\n            reasons.add(\"parent_not_supplied\")\n        else:\n            pc = contract.get(\"parent_contract\")\n            ok = (\n                isinstance(parent, dict)\n                and isinstance(pc, dict)\n                and contract_door(parent)\n                and contract_door(contract)\n                and \"contract_id\" in pc\n                and \"contract_id\" in parent\n                and pc.get(\"contract_id\") == parent.get(\"contract_id\")\n                and grant_within(contract.get(\"grant\"), parent.get(\"grant\"))\n            )\n            if not ok:\n                reasons.add(\"parent_narrowing_failed\")\n    return reasons\n\n\ndef out_of_scope(contract):\n    if not isinstance(contract, dict):\n        return False\n    req = contract.get(\"requirements\")\n    if isinstance(req, dict):\n        if \"spine\" in req or \"convergence\" in req:\n            return True\n        if \"admission\" in req and req[\"admission\"] is not None:\n            return True\n    grant = contract.get(\"grant\")\n    if isinstance(grant, dict):\n        if \"limits\" in grant and grant[\"limits\"] is not None:\n            return True\n        ap = grant.get(\"approval_policy\")\n        if isinstance(ap, dict) and \"approvers\" in ap and approvers_well_formed(ap.get(\"approvers\"), grant):\n            return True\n    return False\n\n\ndef header_hash(raw):\n    return hashlib.sha256(hashlib.sha256(raw).digest()).digest()[::-1].hex()\n\n\ndef parse_header_hex(h):\n    if not isinstance(h, str):\n        return None\n    body = h[:-1] if h.endswith(\"\\n\") and len(h) == 161 else h\n    if not is_lower_hex(body, 160):\n        return None\n    if h != body and not (len(h) == 161 and h.endswith(\"\\n\")):\n        return None\n    return bytes.fromhex(body)\n\n\nclass ViewInfo:\n    def __init__(self):\n        self.headers = {}\n        self.tip = None\n        self.lower_height = None\n        self.lower_hash = None\n        self.floor = None\n\n\ndef check_view(contract, view):\n    reasons = set()\n    info = ViewInfo()\n    ok = True\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else None\n    fin = grant.get(\"finality\") if isinstance(grant, dict) else None\n    floor_s = fin.get(\"max_target_bits\") if isinstance(fin, dict) else None\n    floor = decode_target_hex(floor_s) if isinstance(floor_s, str) else None\n    if floor is None:\n        ok = False\n    else:\n        info.floor = floor\n    lb = contract.get(\"lower_bound\") if isinstance(contract, dict) else None\n    if not isinstance(lb, dict) or json_int(lb.get(\"height\")) is None or not is_lower_hex(lb.get(\"hash\"), 64):\n        ok = False\n    else:\n        info.lower_height = json_int(lb.get(\"height\"))\n        info.lower_hash = lb.get(\"hash\")\n    headers = view.get(\"headers\") if isinstance(view, dict) else None\n    if not isinstance(headers, list) or not headers:\n        ok = False\n    parsed = []\n    if isinstance(headers, list):\n        prev_h = None\n        prev_hash = None\n        for h in headers:\n            if not isinstance(h, dict) or json_int(h.get(\"height\")) is None or json_int(h.get(\"height\")) < 0:\n                ok = False\n                parsed = None\n                break\n            raw = parse_header_hex(h.get(\"hex\"))\n            if raw is None:\n                ok = False\n                parsed = None\n                break\n            height = json_int(h.get(\"height\"))\n            if prev_h is not None and height != prev_h + 1:\n                ok = False\n            hh = header_hash(raw)\n            if prev_hash is not None:\n                prev_field = raw[4:36][::-1].hex()\n                if prev_field != prev_hash:\n                    ok = False\n            nbits = int.from_bytes(raw[72:76], \"little\")\n            target = decode_compact(nbits)\n            if target is None or floor is None or target > floor:\n                ok = False\n            elif int(hh, 16) > target:\n                ok = False\n            parsed.append((height, hh, raw[36:68]))\n            prev_h = height\n            prev_hash = hh\n        if parsed is not None and ok:\n            found = False\n            for height, hh, merkle in parsed:\n                info.headers[height] = {\"hash\": hh, \"merkle\": merkle}\n            if parsed:\n                info.tip = parsed[-1][0]\n            if info.lower_height is not None:\n                hdr = info.headers.get(info.lower_height)\n                if hdr is None or hdr[\"hash\"] != info.lower_hash:\n                    ok = False\n                else:\n                    found = True\n            if not found:\n                ok = False\n    if not ok:\n        reasons.add(\"chain_view_rejected\")\n        info = None\n    elif parsed is not None and len(parsed) > 200000:\n        reasons.add(\"input_too_large\")\n        info = None\n        ok = False\n    if isinstance(view, dict) and isinstance(view.get(\"headers\"), list):\n        strict_ok = is_strict(view)\n        for h in view[\"headers\"]:\n            if not isinstance(h, dict) or json_int(h.get(\"height\")) is None or not is_lower_hex(h.get(\"hex\"), 160):\n                strict_ok = False\n                break\n        if not strict_ok:\n            reasons.add(\"view_not_strict\")\n    return ok, reasons, info\n\n\nclass Rec:\n    def __init__(self, raw, sha, sign_bytes):\n        self.raw = raw\n        self.sha = sha\n        self.sign_bytes = sign_bytes\n        self.schema = raw.get(\"schema\")\n\n\ndef party_key(contract, role):\n    parties = contract.get(\"parties\") if isinstance(contract, dict) else None\n    if not isinstance(parties, list):\n        return None\n    for p in parties:\n        if isinstance(p, dict) and p.get(\"role\") == role:\n            return p.get(\"public_key_ed25519_b64\")\n    return None\n\n\ndef witness_key(contract, name):\n    if not isinstance(name, str):\n        return None\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else None\n    if not isinstance(grant, dict):\n        return None\n    ws = grant.get(\"witnesses\")\n    if not isinstance(ws, list):\n        return None\n    for w in ws:\n        if isinstance(w, dict) and w.get(\"name\") == name:\n            return w.get(\"public_key_ed25519_b64\")\n    return None\n\n\ndef all_keys(contract):\n    keys = []\n    for role in (\"principal\", \"contractor\"):\n        k = party_key(contract, role)\n        if isinstance(k, str):\n            keys.append(k)\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else None\n    ws = grant.get(\"witnesses\") if isinstance(grant, dict) else None\n    if isinstance(ws, list):\n        for w in ws:\n            if isinstance(w, dict) and isinstance(w.get(\"public_key_ed25519_b64\"), str):\n                keys.append(w[\"public_key_ed25519_b64\"])\n    return keys\n\n\ndef matching_key(schema, entry, contract):\n    if not isinstance(entry, dict):\n        return None\n    role = entry.get(\"role\")\n    if schema == \"a2a-execution-v0\" and role == \"contractor\":\n        return party_key(contract, \"contractor\")\n    if schema == \"a2a-execution-v0\" and role == \"witness\":\n        return witness_key(contract, entry.get(\"witness_name\"))\n    if schema == \"a2a-revocation-v0\" and role == \"principal\":\n        return party_key(contract, \"principal\")\n    if schema == \"a2a-revocation-ack-v0\" and role == \"contractor\":\n        return party_key(contract, \"contractor\")\n    return None\n\n\ndef classify_signing(rec, contract):\n    sigs = rec.raw.get(\"signatures\")\n    if not isinstance(sigs, list) or not sigs:\n        return \"none\"\n    msg = rec.sign_bytes\n    lax = False\n    for entry in sigs:\n        key = matching_key(rec.schema, entry, contract)\n        if key is None:\n            continue\n        result = verify(key, entry.get(\"sig_b64\"), msg)\n        if result is True:\n            raw = b64_canonical(entry.get(\"sig_b64\"), 64)\n            if raw is not None and sig_bytes_strict(raw) and is_strict(entry):\n                return \"strict\"\n            if raw is None or not sig_bytes_strict(raw):\n                lax = True\n    if not lax:\n        for entry in sigs:\n            if not isinstance(entry, dict):\n                continue\n            sig = entry.get(\"sig_b64\")\n            raw = b64_canonical(sig, 64)\n            if raw is not None and sig_bytes_strict(raw):\n                continue\n            for key in all_keys(contract):\n                if verify(key, sig, msg) is True:\n                    lax = True\n                    break\n            if lax:\n                break\n    return \"lax\" if lax else \"none\"\n\n\ndef body_not_strict(raw):\n    body = without(raw, \"signatures\", \"anchor\")\n    if not is_strict(body):\n        return True\n    if \"nenrin_ref\" in body and body[\"nenrin_ref\"] is not None and not is_lower_hex(body[\"nenrin_ref\"], 64):\n        return True\n    cref = body.get(\"contract_ref\")\n    if isinstance(cref, dict):\n        for fld in (\"contract_sha256\", \"payload_digest\"):\n            if fld in cref and not is_lower_hex(cref[fld], 64):\n                return True\n    if raw.get(\"schema\") == \"a2a-execution-v0\":\n        if \"performed_actions\" in body and not str_list(body[\"performed_actions\"]):\n            return True\n        if \"delegated_to\" in body and not str_list(body[\"delegated_to\"]):\n            return True\n        if \"approvals\" in body and not obj_list(body[\"approvals\"]):\n            return True\n        approvals = body.get(\"approvals\")\n        if isinstance(approvals, list):\n            for ap in approvals:\n                if not isinstance(ap, dict):\n                    continue\n                for fld in (\"sig_b64\", \"signature\"):\n                    if fld in ap:\n                        raw_sig = b64_decode_any(ap[fld], 64)\n                        if raw_sig is not None and not sig_bytes_strict(raw_sig):\n                            return True\n    return False\n\n\ndef anchor_not_strict(raw):\n    if \"anchor\" not in raw:\n        return False\n    anc = raw.get(\"anchor\")\n    if not is_strict(anc):\n        return True\n    if not isinstance(anc, dict):\n        return True\n    if \"block_hash\" in anc and not is_lower_hex(anc[\"block_hash\"], 64):\n        return True\n    proof = anc.get(\"proof\")\n    if isinstance(proof, list):\n        for op in proof:\n            if isinstance(op, dict) and \"hex\" in op and not hex_pairs(op[\"hex\"]):\n                return True\n    return False\n\n\ndef payload_of(contract):\n    task = contract.get(\"task\") if isinstance(contract, dict) else None\n    if isinstance(task, dict) and \"payload_digest\" in task:\n        return task[\"payload_digest\"]\n    return None\n\n\ndef classify_binding(ref, cid, pdg, csha):\n    if \"contract_sha256\" not in ref or ref.get(\"contract_sha256\") is None:\n        if ref.get(\"contract_id\") == cid:\n            return \"unbound\"\n        return \"drop\"\n    sha = ref.get(\"contract_sha256\")\n    if not is_lower_hex(sha, 64):\n        return \"inconsistent\"\n    if sha != csha:\n        return \"foreign\"\n    if ref.get(\"contract_id\") != cid:\n        return \"inconsistent\"\n    if pdg is not None and ref.get(\"payload_digest\") != pdg:\n        return \"inconsistent\"\n    return \"bound\"\n\n\ndef bind_records(contract, events, csha):\n    cid = contract.get(\"contract_id\") if isinstance(contract, dict) else None\n    pdg = payload_of(contract)\n    seen = set()\n    bound = []\n    disps = {}\n    if not isinstance(events, list):\n        return bound, disps\n    for ev in events:\n        if not isinstance(ev, dict) or ev.get(\"schema\") not in CTX:\n            continue\n        try:\n            sha = sha256_hex(canonical(ev))\n            body = without(ev, \"signatures\", \"anchor\")\n            sign_bytes = CTX[ev[\"schema\"]] + canonical(body)\n        except Exception:\n            continue\n        if sha in seen:\n            continue\n        seen.add(sha)\n        ref = ev.get(\"contract_ref\")\n        if not isinstance(ref, dict):\n            ref = {}\n        cls = classify_binding(ref, cid, pdg, csha)\n        if cls == \"drop\":\n            continue\n        if cls == \"bound\":\n            bound.append(Rec(ev, sha, sign_bytes))\n        else:\n            disps[sha] = cls\n    return bound, disps\n\n\ndef body_digest(raw):\n    return hashlib.sha256(canonical(without(raw, \"anchor\"))).digest()\n\n\ndef proof_reaches(raw, merkle):\n    anc = raw.get(\"anchor\")\n    if not isinstance(anc, dict):\n        return False\n    proof = anc.get(\"proof\")\n    if not isinstance(proof, list) or not proof or len(proof) > 512:\n        return False\n    current = body_digest(raw)\n    for op in proof:\n        if not isinstance(op, dict):\n            return False\n        name = op.get(\"op\")\n        if name == \"sha256\":\n            current = hashlib.sha256(current).digest()\n        elif name == \"hexlify\":\n            current = current.hex().encode(\"ascii\")\n        elif name in (\"append\", \"prepend\"):\n            hx = op.get(\"hex\")\n            if not hex_pairs(hx):\n                return False\n            extra = bytes.fromhex(hx)\n            if len(extra) > 4096:\n                return False\n            current = current + extra if name == \"append\" else extra + current\n        else:\n            return False\n        if len(current) > 65536:\n            return False\n    return current == merkle\n\n\nclass BatchParser:\n    def __init__(self, s):\n        self.s = s\n        self.n = len(s)\n        self.i = 0\n        self.depth = 0\n\n    def skip(self):\n        while self.i < self.n and self.s[self.i] in \" \\t\\r\\n\":\n            self.i += 1\n\n    def parse(self):\n        self.skip()\n        v = self.val()\n        self.skip()\n        if self.i != self.n:\n            raise ValueError(\"trailing\")\n        return v\n\n    def val(self):\n        self.skip()\n        if self.i >= self.n:\n            raise ValueError(\"eof\")\n        c = self.s[self.i]\n        if c == \"{\":\n            return self.obj()\n        if c == \"[\":\n            return self.arr()\n        if c == '\"':\n            return self.string()\n        if c == \"t\":\n            self.lit(\"true\")\n            return True\n        if c == \"f\":\n            self.lit(\"false\")\n            return False\n        if c == \"n\":\n            self.lit(\"null\")\n            return None\n        if c == \"N\":\n            self.lit(\"NaN\")\n            return float(\"nan\")\n        if c == \"I\":\n            self.lit(\"Infinity\")\n            return float(\"inf\")\n        if c == \"-\" and self.s.startswith(\"-Infinity\", self.i):\n            self.i += 9\n            return float(\"-inf\")\n        if c == \"-\" or c.isdigit():\n            return self.number()\n        raise ValueError(\"value\")\n\n    def lit(self, word):\n        if not self.s.startswith(word, self.i):\n            raise ValueError(\"lit\")\n        self.i += len(word)\n\n    def obj(self):\n        self.depth += 1\n        if self.depth > 512:\n            raise ValueError(\"depth\")\n        self.i += 1\n        d = {}\n        self.skip()\n        if self.i < self.n and self.s[self.i] == \"}\":\n            self.i += 1\n            self.depth -= 1\n            return d\n        while True:\n            self.skip()\n            key = str(self.string())\n            self.skip()\n            if self.i >= self.n or self.s[self.i] != \":\":\n                raise ValueError(\"colon\")\n            self.i += 1\n            val = self.val()\n            if key in d:\n                raise ValueError(\"dup\")\n            d[key] = val\n            self.skip()\n            if self.i < self.n and self.s[self.i] == \",\":\n                self.i += 1\n                continue\n            if self.i < self.n and self.s[self.i] == \"}\":\n                self.i += 1\n                self.depth -= 1\n                return d\n            raise ValueError(\"obj\")\n\n    def arr(self):\n        self.depth += 1\n        if self.depth > 512:\n            raise ValueError(\"depth\")\n        self.i += 1\n        arr = []\n        self.skip()\n        if self.i < self.n and self.s[self.i] == \"]\":\n            self.i += 1\n            self.depth -= 1\n            return arr\n        while True:\n            arr.append(self.val())\n            self.skip()\n            if self.i < self.n and self.s[self.i] == \",\":\n                self.i += 1\n                continue\n            if self.i < self.n and self.s[self.i] == \"]\":\n                self.i += 1\n                self.depth -= 1\n                return arr\n            raise ValueError(\"arr\")\n\n    def string(self):\n        if self.i >= self.n or self.s[self.i] != '\"':\n            raise ValueError(\"str\")\n        self.i += 1\n        start_char = self.i\n        escaped = False\n        out = []\n        while self.i < self.n:\n            c = self.s[self.i]\n            if c == '\"':\n                self.i += 1\n                start_byte = len(self.s[:start_char].encode(\"utf-8\"))\n                return SpanStr(\"\".join(out), start_byte, escaped)\n            if c == \"\\\\\":\n                escaped = True\n                self.i += 1\n                if self.i >= self.n:\n                    raise ValueError(\"esc\")\n                e = self.s[self.i]\n                mapping = {'\"': '\"', \"\\\\\": \"\\\\\", \"/\": \"/\", \"b\": \"\\b\", \"f\": \"\\f\", \"n\": \"\\n\", \"r\": \"\\r\", \"t\": \"\\t\"}\n                if e in mapping:\n                    out.append(mapping[e])\n                    self.i += 1\n                elif e == \"u\":\n                    hexpart = self.s[self.i + 1 : self.i + 5]\n                    if len(hexpart) != 4 or any(ch not in \"0123456789abcdefABCDEF\" for ch in hexpart):\n                        raise ValueError(\"u\")\n                    out.append(chr(int(hexpart, 16)))\n                    self.i += 5\n                else:\n                    raise ValueError(\"esc\")\n            elif ord(c) < 0x20:\n                raise ValueError(\"ctrl\")\n            else:\n                out.append(c)\n                self.i += 1\n        raise ValueError(\"unterminated\")\n\n    def number(self):\n        start = self.i\n        if self.s[self.i] == \"-\":\n            self.i += 1\n        if self.i >= self.n or not self.s[self.i].isdigit():\n            raise ValueError(\"num\")\n        if self.s[self.i] == \"0\":\n            self.i += 1\n        else:\n            while self.i < self.n and self.s[self.i].isdigit():\n                self.i += 1\n        is_float = False\n        if self.i < self.n and self.s[self.i] == \".\":\n            is_float = True\n            self.i += 1\n            if self.i >= self.n or not self.s[self.i].isdigit():\n                raise ValueError(\"frac\")\n            while self.i < self.n and self.s[self.i].isdigit():\n                self.i += 1\n        if self.i < self.n and self.s[self.i] in \"eE\":\n            is_float = True\n            self.i += 1\n            if self.i < self.n and self.s[self.i] in \"+-\":\n                self.i += 1\n            if self.i >= self.n or not self.s[self.i].isdigit():\n                raise ValueError(\"exp\")\n            while self.i < self.n and self.s[self.i].isdigit():\n                self.i += 1\n        token = self.s[start : self.i]\n        if is_float:\n            return float(token)\n        digits = token[1:] if token.startswith(\"-\") else token\n        if len(digits) > 4300:\n            raise ValueError(\"long\")\n        return int(token)\n\n\ndef batch_leg_ok(raw):\n    anc = raw.get(\"anchor\")\n    if not isinstance(anc, dict):\n        return False\n    ops = anc.get(\"proof\")\n    if not isinstance(ops, list):\n        return False\n    hexlifies = [i for i, op in enumerate(ops) if isinstance(op, dict) and op.get(\"op\") == \"hexlify\"]\n    if not hexlifies:\n        return True\n    if hexlifies != [0]:\n        return False\n    digest = body_digest(raw)\n    digest_hex = digest.hex()\n    batch = bytearray(digest_hex.encode(\"ascii\"))\n    pre_len = 0\n    found = False\n    for op in ops[1:]:\n        if not isinstance(op, dict):\n            return False\n        name = op.get(\"op\")\n        if name == \"sha256\":\n            found = True\n            break\n        if name not in (\"append\", \"prepend\"):\n            return False\n        hx = op.get(\"hex\")\n        if not hex_pairs(hx):\n            return False\n        extra = bytes.fromhex(hx)\n        if len(extra) > 4096:\n            return False\n        if name == \"prepend\":\n            batch = bytearray(extra) + batch\n            pre_len += len(extra)\n        else:\n            batch.extend(extra)\n    if not found:\n        return False\n    try:\n        text = bytes(batch).decode(\"utf-8\")\n        obj = BatchParser(text).parse()\n    except Exception:\n        return False\n    if not isinstance(obj, dict) or obj.get(\"schema\") not in BATCH_SCHEMAS:\n        return False\n    records = obj.get(\"records\")\n    if not isinstance(records, list) or not all(isinstance(r, dict) for r in records):\n        return False\n    if \"count\" in obj and obj.get(\"count\") != len(records):\n        return False\n    matches = [i for i, r in enumerate(records) if r.get(\"sha\") == digest_hex]\n    if len(matches) != 1:\n        return False\n    idx = matches[0]\n    entry = records[idx]\n    if obj.get(\"schema\") == \"nenrin-agreement-batch-v1\":\n        kind = {\"a2a-execution-v0\": \"execution\"}.get(raw.get(\"schema\"))\n        if kind is None:\n            return False\n        if entry.get(\"kind\") != kind:\n            return False\n        if \"schema\" in entry and entry.get(\"schema\") != raw.get(\"schema\"):\n            return False\n    sha = entry.get(\"sha\")\n    if not isinstance(sha, SpanStr) or sha.escaped or sha.start_byte != pre_len:\n        return False\n    return True\n\n\ndef anchors_validly(rec, viewinfo):\n    if viewinfo is None:\n        return False\n    anc = rec.raw.get(\"anchor\")\n    if not isinstance(anc, dict):\n        return False\n    h = json_int(anc.get(\"height\"))\n    if h is None or h < 0:\n        return False\n    bh = anc.get(\"block_hash\")\n    if not is_lower_hex(bh, 64):\n        return False\n    hdr = viewinfo.headers.get(h)\n    if hdr is None or hdr[\"hash\"] != bh:\n        return False\n    if not proof_reaches(rec.raw, hdr[\"merkle\"]):\n        return False\n    if not batch_leg_ok(rec.raw):\n        return False\n    return True\n\n\ndef triage(bound, contract, viewinfo):\n    reasons = set()\n    disps = {}\n    meta = []\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else None\n    rev_obj = isinstance(grant, dict) and isinstance(grant.get(\"revocation\"), dict)\n    groups = {}\n    for rec in bound:\n        sign = classify_signing(rec, contract)\n        bbad = body_not_strict(rec.raw)\n        abad = anchor_not_strict(rec.raw)\n        meta.append((rec, sign, bbad, abad))\n        groups.setdefault(rec.sign_bytes, []).append(rec)\n    info = {rec.sha: (sign, bbad, abad) for rec, sign, bbad, abad in meta}\n\n    def table_kept(rec):\n        sign, bbad, abad = info[rec.sha]\n        if sign != \"strict\" or bbad or abad:\n            return False\n        if rec.schema == \"a2a-revocation-v0\" and not rev_obj:\n            return False\n        return True\n\n    kept = []\n    for rec, sign, bbad, abad in meta:\n        if sign != \"strict\" and bbad:\n            disps[rec.sha] = \"record_not_strict\"\n            continue\n        if sign != \"strict\" and sign == \"lax\":\n            disps[rec.sha] = \"signature_not_strict\"\n            continue\n        if sign != \"strict\":\n            disps[rec.sha] = \"rejected\"\n            continue\n        if bbad:\n            disps[rec.sha] = \"record_not_strict\"\n            reasons.add(\"record_not_strict\")\n            continue\n        if abad:\n            others = [\n                other\n                for other in groups[rec.sign_bytes]\n                if other.sha != rec.sha and table_kept(other) and anchors_validly(other, viewinfo)\n            ]\n            disps[rec.sha] = \"anchor_not_strict\"\n            if not others:\n                reasons.add(\"anchor_not_strict\")\n            continue\n        if rec.schema == \"a2a-revocation-v0\" and not rev_obj:\n            disps[rec.sha] = \"revocation_not_provided_for\"\n            continue\n        kept.append(rec)\n    return kept, disps, reasons\n\n\ndef collapse(kept, viewinfo):\n    groups = {}\n    order = []\n    for rec in kept:\n        if rec.sign_bytes not in groups:\n            order.append(rec.sign_bytes)\n            groups[rec.sign_bytes] = []\n        groups[rec.sign_bytes].append(rec)\n    out = []\n    disps = {}\n    for key in order:\n        group = groups[key]\n        shas = {r.sha for r in group}\n        if len(shas) <= 1:\n            out.extend(group)\n            continue\n        valid = [r for r in group if anchors_validly(r, viewinfo)]\n        if valid:\n            def sort_key(r):\n                return (json_int(r.raw[\"anchor\"][\"height\"]), r.sha)\n            valid.sort(key=sort_key)\n            keep = valid[0]\n            for r in group:\n                if r.sha != keep.sha:\n                    disps[r.sha] = \"duplicate_dropped\"\n            out.append(keep)\n        else:\n            out.extend(group)\n    return out, disps\n\n\ndef conformance_problem(rec):\n    raw = rec.raw\n    if rec.schema == \"a2a-execution-v0\":\n        allowed = EXEC_FIELDS\n    elif rec.schema == \"a2a-revocation-v0\":\n        allowed = REV_FIELDS\n    else:\n        allowed = ACK_FIELDS\n    if any(k not in allowed for k in raw):\n        return True\n    if rec.schema != \"a2a-execution-v0\":\n        return False\n    pa = raw.get(\"performed_actions\")\n    if not str_list(pa):\n        return True\n    if len(pa) > 256:\n        return True\n    if any(not ACTION_RE.match(a) for a in pa):\n        return True\n    if \"outcomes\" in raw and raw[\"outcomes\"] is not None:\n        outcomes = raw[\"outcomes\"]\n        if not isinstance(outcomes, dict):\n            return True\n        for k, val in outcomes.items():\n            if k not in pa or val not in OUTCOMES:\n                return True\n    approvals = raw.get(\"approvals\")\n    if isinstance(approvals, list):\n        for ap in approvals:\n            if isinstance(ap, dict):\n                act = ap.get(\"action\")\n                if not isinstance(act, str) or not ACTION_RE.match(act):\n                    return True\n    return False\n\n\ndef has_contractor_sig(rec, contract):\n    sigs = rec.raw.get(\"signatures\")\n    key = party_key(contract, \"contractor\")\n    if not isinstance(sigs, list) or not isinstance(key, str):\n        return False\n    for entry in sigs:\n        if isinstance(entry, dict) and entry.get(\"role\") == \"contractor\":\n            if verify(key, entry.get(\"sig_b64\"), rec.sign_bytes) is True:\n                return True\n    return False\n\n\ndef apply_conformance(kept, contract):\n    disps = {}\n    deviations = set()\n    out = []\n    for rec in kept:\n        if conformance_problem(rec):\n            if rec.schema == \"a2a-execution-v0\" and has_contractor_sig(rec, contract):\n                deviations.add(\"nonconforming_record\")\n                out.append(rec)\n            else:\n                disps[rec.sha] = \"rejected\"\n        else:\n            out.append(rec)\n    return out, disps, deviations\n\n\ndef ignore_revocations(kept):\n    out = []\n    disps = {}\n    for rec in kept:\n        if rec.schema == \"a2a-revocation-v0\" and rec.raw.get(\"revoked_by\") != \"principal\":\n            disps[rec.sha] = \"ignored\"\n        else:\n            out.append(rec)\n    return out, disps\n\n\ndef anchor_disposition(rec, viewinfo):\n    anc = rec.raw.get(\"anchor\")\n    height = None\n    bh = None\n    if isinstance(anc, dict):\n        height = json_int(anc.get(\"height\"))\n        bh = anc.get(\"block_hash\")\n    if height is None or height < 0 or not is_lower_hex(bh, 64):\n        return \"anchor_incomplete\", None\n    if viewinfo.lower_height is not None and height < viewinfo.lower_height:\n        return \"anchor_below_lower_bound\", height\n    hdr = viewinfo.headers.get(height)\n    if height > viewinfo.tip or hdr is None:\n        return \"anchor_beyond_observed_chain\", height\n    if bh != hdr[\"hash\"]:\n        return \"orphaned\", height\n    if not proof_reaches(rec.raw, hdr[\"merkle\"]):\n        return \"anchor_proof_invalid\", height\n    if not batch_leg_ok(rec.raw):\n        return \"anchor_batch_leg_refused\", height\n    return \"accepted\", height\n\n\ndef approval_fields_ok(ap, need_csha):\n    if not is_int(ap.get(\"valid_until_height\"), 0):\n        return False\n    if not is_lower_hex(ap.get(\"nonce\"), 32):\n        return False\n    if not isinstance(ap.get(\"single_use\"), bool):\n        return False\n    if need_csha and not is_lower_hex(ap.get(\"contract_sha256\"), 64):\n        return False\n    return True\n\n\ndef field_or_null(ap, key):\n    return ap[key] if key in ap else None\n\n\ndef classify_approval(ap, pk, contract, csha):\n    if not isinstance(ap, dict) or not isinstance(pk, str):\n        return \"forged\"\n    sig = ap.get(\"sig_b64\")\n    if approval_fields_ok(ap, True):\n        msg = b\"a2a-approval-v2\\n\" + canonical(\n            {\n                \"contract_sha256\": ap[\"contract_sha256\"],\n                \"action\": field_or_null(ap, \"action\"),\n                \"valid_until_height\": ap[\"valid_until_height\"],\n                \"nonce\": ap[\"nonce\"],\n                \"single_use\": ap[\"single_use\"],\n            }\n        )\n        if verify(pk, sig, msg) is True:\n            return \"counted\" if ap[\"contract_sha256\"] == csha else \"other_terms\"\n    if approval_fields_ok(ap, False):\n        msg = b\"a2a-approval-v1\\n\" + canonical(\n            {\n                \"contract_id\": contract.get(\"contract_id\"),\n                \"payload_digest\": payload_of(contract),\n                \"action\": field_or_null(ap, \"action\"),\n                \"valid_until_height\": ap[\"valid_until_height\"],\n                \"nonce\": ap[\"nonce\"],\n                \"single_use\": ap[\"single_use\"],\n            }\n        )\n        if verify(pk, sig, msg) is True:\n            return \"label_bound\"\n    msg = b\"a2a-approval-v0\\n\" + canonical(\n        {\n            \"contract_id\": contract.get(\"contract_id\") if isinstance(contract, dict) and \"contract_id\" in contract else None,\n            \"payload_digest\": payload_of(contract),\n            \"action\": field_or_null(ap, \"action\"),\n        }\n    )\n    if verify(pk, sig, msg) is True:\n        return \"label_bound\"\n    return \"forged\"\n\n\ndef walk_grant(accepted, contract, csha, surviving_sha):\n    deviations = set()\n    grant = contract.get(\"grant\") if isinstance(contract, dict) else {}\n    if not isinstance(grant, dict):\n        grant = {}\n    pk = party_key(contract, \"principal\")\n    prohibited = set(as_str_list(grant, \"prohibited_actions\"))\n    authorized = set(as_str_list(grant, \"authorized_actions\"))\n    conditional = {}\n    for e in cond_list(grant):\n        if isinstance(e.get(\"action\"), str):\n            conditional[e[\"action\"]] = e\n    allowed_deleg = set(deleg_allowed(grant))\n    expiry = json_int(grant.get(\"expiry_height\")) if \"expiry_height\" in grant and grant.get(\"expiry_height\") is not None else None\n    rev_policy = grant.get(\"revocation\") if isinstance(grant.get(\"revocation\"), dict) else None\n    counted = []\n    forged = False\n    for rec in accepted:\n        if rec.schema != \"a2a-execution-v0\":\n            continue\n        approvals = rec.raw.get(\"approvals\")\n        if not isinstance(approvals, list):\n            continue\n        for ap in approvals:\n            cls = classify_approval(ap, pk, contract, csha)\n            if cls == \"forged\":\n                forged = True\n            elif cls == \"counted\":\n                counted.append(\n                    {\n                        \"action\": ap.get(\"action\"),\n                        \"height\": rec.height,\n                        \"rec_sha\": rec.sha,\n                        \"valid_until\": json_int(ap.get(\"valid_until_height\")),\n                        \"nonce\": ap.get(\"nonce\"),\n                        \"single_use\": ap.get(\"single_use\") is True,\n                    }\n                )\n    if forged:\n        deviations.add(\"forged_approval\")\n    revocations = [r for r in accepted if r.schema == \"a2a-revocation-v0\"]\n    acks = [r for r in accepted if r.schema == \"a2a-revocation-ack-v0\"]\n    eff = []\n    if isinstance(rev_policy, dict):\n        mode = rev_policy.get(\"effective_at\")\n        window = json_int(rev_policy.get(\"ack_window\"))\n        for rev in revocations:\n            h = rev.height\n            if mode == \"anchor\":\n                e = h\n            else:\n                names = {sha256_hex(canonical(without(rev.raw, \"anchor\")))}\n                names |= set(surviving_sha.get(rev.sign_bytes, []))\n                cands = []\n                if window is not None:\n                    cands.append(h + window)\n                for ack in acks:\n                    if ack.raw.get(\"revocation_sha256\") in names:\n                        cands.append(ack.height)\n                e = min(cands) if cands else h\n            eff.append(e)\n    consumed = set()\n    for rec in accepted:\n        if rec.schema != \"a2a-execution-v0\":\n            continue\n        h = rec.height\n        revoked = any(e <= h for e in eff)\n        actions = rec.raw.get(\"performed_actions\")\n        if not isinstance(actions, list):\n            actions = []\n        if revoked:\n            if any(isinstance(a, str) for a in actions):\n                deviations.add(\"revoked\")\n            continue\n        for a in actions:\n            if not isinstance(a, str):\n                continue\n            if expiry is not None and h > expiry:\n                deviations.add(\"after_expiry\")\n            if a in prohibited:\n                deviations.add(\"prohibited\")\n                continue\n            if a in conditional:\n                used = None\n                for ap in counted:\n                    if ap[\"action\"] != a:\n                        continue\n                    if ap[\"rec_sha\"] != rec.sha and not (ap[\"height\"] < h):\n                        continue\n                    if ap[\"valid_until\"] is None or h > ap[\"valid_until\"]:\n                        continue\n                    if ap[\"single_use\"] and ap[\"nonce\"] in consumed:\n                        continue\n                    used = ap\n                    break\n                if used is None:\n                    deviations.add(\"conditional\")\n                elif used[\"single_use\"]:\n                    consumed.add(used[\"nonce\"])\n                continue\n            if a not in authorized:\n                deviations.add(\"unauthorized\")\n        delegated = rec.raw.get(\"delegated_to\")\n        if isinstance(delegated, list):\n            for d in delegated:\n                if isinstance(d, str) and d not in allowed_deleg:\n                    deviations.add(\"delegation\")\n    return deviations\n\n\ndef nenrin_checks(execs, nenrin, csha):\n    reasons = set()\n    deviations = set()\n    if not isinstance(nenrin, list) or not nenrin:\n        return reasons, deviations\n    index = {}\n    bad = set()\n    for w in nenrin:\n        if not isinstance(w, dict):\n            continue\n        try:\n            sha = sha256_hex(canonical(w))\n        except Exception:\n            continue\n        if not is_strict(w):\n            bad.add(sha)\n        else:\n            index[sha] = w\n    seen = set()\n    for rec in execs:\n        if rec.sha in seen:\n            continue\n        seen.add(rec.sha)\n        ref = rec.raw.get(\"nenrin_ref\")\n        if ref in bad:\n            reasons.add(\"walk_not_strict\")\n        walk = index.get(ref)\n        if walk is None:\n            continue\n        ctx = walk.get(\"context\")\n        if isinstance(ctx, dict) and \"contract_sha256\" in ctx and ctx[\"contract_sha256\"] is not None and ctx[\"contract_sha256\"] != csha:\n            deviations.add(\"evidence_names_other_contract\")\n    return reasons, deviations\n\n\ndef evidence_missing(accepted, contract):\n    req = contract.get(\"requirements\") if isinstance(contract, dict) else None\n    if not isinstance(req, dict) or req.get(\"evidence\") != \"nenrin_required\":\n        return False\n    for rec in accepted:\n        if rec.schema == \"a2a-execution-v0\" and not is_lower_hex(rec.raw.get(\"nenrin_ref\"), 64):\n            return True\n    return False\n\n\ndef bond_outcome(contract, verdict, status):\n    if not isinstance(contract, dict) or \"bond\" not in contract or contract.get(\"bond\") is None:\n        return \"n/a\"\n    bond = contract.get(\"bond\")\n    amt = bond.get(\"amount\") if isinstance(bond, dict) else None\n    n = json_int(amt)\n    well = isinstance(bond, dict) and n is not None and 1 <= n <= MAX_SAFE\n    if well:\n        if verdict == \"underspecified\":\n            return \"undetermined\"\n        if status == \"provisional\":\n            return \"pending_finality\"\n        if verdict == \"deviation\":\n            return \"forfeited\"\n        return \"held\"\n    if isinstance(bond, dict) and \"amount\" in bond and bool(bond.get(\"amount\")):\n        return \"undetermined\"\n    return \"n/a\"\n\n\ndef core_result(csha, verdict, status, bond, deviations, reasons, event_set, dispositions):\n    return {\n        \"contract_sha256\": csha,\n        \"verdict\": verdict,\n        \"status\": status,\n        \"bond_outcome\": bond,\n        \"deviation_codes\": sorted(deviations) if verdict == \"deviation\" else [],\n        \"underspecified_reasons\": sorted(reasons) if verdict == \"underspecified\" else [],\n        \"event_set\": event_set,\n        \"dispositions\": {k: dispositions[k] for k in sorted(dispositions)},\n    }\n\n\ndef settle(contract, events, view, nenrin, parent, parent_supplied):\n    if not isinstance(contract, dict):\n        return core_result(None, \"underspecified\", \"undetermined\", \"n/a\", set(), {\"contract_not_verified\"}, [], {})\n    if out_of_scope(contract):\n        raise InputError(\"out of scope\")\n    csha = sha256_hex(b\"a2a-contract-v0\\n\" + canonical(without(contract, \"signatures\")))\n    reasons = set()\n    door_ok = contract_door(contract)\n    if not door_ok:\n        reasons.add(\"contract_not_verified\")\n    else:\n        reasons |= settleable_terms(contract)\n    reasons |= strict_terms(contract, parent, parent_supplied)\n    view_ok, view_reasons, viewinfo = check_view(contract, view)\n    reasons |= view_reasons\n    if not isinstance(events, list):\n        return core_result(csha, \"underspecified\", \"undetermined\", bond_outcome(contract, \"underspecified\", \"undetermined\"), set(), reasons | {\"input_not_settleable\"}, [], {})\n    bound, disps = bind_records(contract, events, csha)\n    kept, triage_disps, triage_reasons = triage(bound, contract, viewinfo if view_ok else None)\n    disps.update(triage_disps)\n    reasons |= triage_reasons\n    too_many = len(kept) > 10000\n    if too_many:\n        reasons.add(\"input_too_large\")\n    if view_ok and not too_many:\n        kept, drop_disps = collapse(kept, viewinfo)\n        disps.update(drop_disps)\n    four_two = bool(reasons & FOUR_TWO)\n    full = view_ok and door_ok and not four_two and not too_many\n    event_set = []\n    deviations = set()\n    orphaned_heights = []\n    accepted = []\n    if full:\n        kept, conf_disps, conf_devs = apply_conformance(kept, contract)\n        disps.update(conf_disps)\n        deviations |= conf_devs\n        kept, ign_disps = ignore_revocations(kept)\n        disps.update(ign_disps)\n        execs_for_nenrin = [r for r in kept if r.schema == \"a2a-execution-v0\"]\n        surviving = {}\n        for rec in kept:\n            surviving.setdefault(rec.sign_bytes, []).append(rec.sha)\n        for rec in kept:\n            disp, height = anchor_disposition(rec, viewinfo)\n            disps[rec.sha] = disp\n            rec.height = height\n            if disp == \"accepted\":\n                accepted.append(rec)\n            elif disp == \"orphaned\":\n                orphaned_heights.append(height)\n            else:\n                reasons.add(disp)\n        accepted.sort(key=lambda r: (r.height, r.sha))\n        event_set = [{\"kind\": KIND[r.schema], \"sha256\": r.sha, \"height\": r.height} for r in accepted]\n        deviations |= walk_grant(accepted, contract, csha, surviving)\n        n_reasons, n_devs = nenrin_checks(execs_for_nenrin, nenrin, csha)\n        reasons |= n_reasons\n        deviations |= n_devs\n        if not reasons and (deviations or event_set) and evidence_missing(accepted, contract):\n            deviations.add(\"evidence_missing\")\n    if reasons:\n        verdict = \"underspecified\"\n        status = \"undetermined\"\n    else:\n        if deviations:\n            verdict = \"deviation\"\n        elif not event_set:\n            verdict = \"nothing_to_settle\"\n        else:\n            verdict = \"within_grant\"\n        k = json_int(contract[\"grant\"][\"finality\"][\"depth\"])\n        horizon = viewinfo.tip - k + 1\n        heights = [r.height for r in accepted] + orphaned_heights\n        if not heights or all(h <= horizon for h in heights):\n            status = \"final\"\n        else:\n            status = \"provisional\"\n    return core_result(csha, verdict, status, bond_outcome(contract, verdict, status), deviations, reasons, event_set, disps)\n\n\ndef load_dir(path):\n    p = Path(path)\n    try:\n        contract = parse_json((p / \"contract.json\").read_text(encoding=\"utf-8\"))\n        view = parse_json((p / \"view.json\").read_text(encoding=\"utf-8\"))\n    except FileNotFoundError:\n        raise InputError(\"missing input\")\n    except UnicodeError:\n        raise InputError(\"invalid utf-8\")\n    events = []\n    evdir = p / \"events\"\n    if evdir.is_dir():\n        for f in sorted(evdir.iterdir(), key=lambda x: x.name):\n            if f.is_file():\n                try:\n                    events.append(parse_json(f.read_text(encoding=\"utf-8\")))\n                except UnicodeError:\n                    raise InputError(\"invalid utf-8\")\n    nenrin = None\n    ndir = p / \"nenrin\"\n    if ndir.is_dir():\n        nenrin = []\n        for f in sorted(ndir.iterdir(), key=lambda x: x.name):\n            if f.is_file():\n                try:\n                    nenrin.append(parse_json(f.read_text(encoding=\"utf-8\")))\n                except UnicodeError:\n                    raise InputError(\"invalid utf-8\")\n    parent = None\n    parent_supplied = False\n    pp = p / \"parent.json\"\n    if pp.is_file():\n        try:\n            parent = parse_json(pp.read_text(encoding=\"utf-8\"))\n        except UnicodeError:\n            raise InputError(\"invalid utf-8\")\n        parent_supplied = True\n    return contract, events, view, nenrin, parent, parent_supplied\n\n\ndef main():\n    if len(sys.argv) != 2:\n        fail(\"usage\")\n    try:\n        args = load_dir(sys.argv[1])\n        result = settle(*args)\n    except InputError as e:\n        fail(str(e))\n    emit(result, 0)\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\nNotes on readings I was not sure of:\n\n- Collapse (6.4) runs whenever the view passes rules 1–8, even if 4.1/4.2 failed. Conformance, anchors, and the walk do not. Triage (6.0) always runs, so a strictly signed non-strict body can add `record_not_strict` beside a door failure. If the view fails, nothing “anchors validly.”\n- `parent_not_supplied` does not also add `parent_narrowing_failed`. A supplied non-object parent does.\n- Child 4.1 failure still adds `contract_not_verified` on its own; the with-parent check only adds `parent_narrowing_failed`.\n- A carried out-of-scope key (`spine`, `convergence`, non-null `limits`/`admission`, or a well-formed `approvers` list) exits 2 with `{\"error\":\"out of scope\"}` instead of claiming a core v0 result. Null `limits`/`admission` stay in scope.\n- Batch bytes are parsed with the 2.2 reader (`NaN` is a number, not a settlement-wide parse error). A non-strict batch is not refused for that alone.\n- `forged_approval` is still charged on revoked executions. Nonce consumption is not.\n- Revocations with `revoked_by != \"principal\"` are ignored after conformance, so an extra field is `rejected` rather than `ignored`.\n- Disposition object keys are sorted by record sha256. Core comparison should be by parsed JSON, not byte-for-byte text.","refusal":null,"reasoning":"I will implement `settle.py` based solely on the MUSUBI settle core v0 specification.\n\nThe implementation will read inputs from a vector directory and output JSON with eight core fields or an error. It requires strict JSON parsing with duplicate key detection and depth limits, canonical JSON formatting, and Ed25519 validation ensuring points lie on the curve, are not the identity, and have prime order.\n\nThe implementation will cover contract verification, view verification, record triage, binding, conformance, anchors, grant evaluation, NENRIN checks, and verdict generation. JSON parsing must reject duplicate keys, nesting deeper than 512 levels, NaN, Infinity, negative Infinity, and integers longer than 4300 digits.\n\nI will use Python's `json` module with `object_pairs_hook` to detect duplicate keys and `parse_constant` to accept exactly `NaN`, `Infinity`, and `-Infinity`. Large number tokens exceeding the double range will be read as infinity. I also need to enforce that integer tokens contain no fraction or exponent.\n\nI need a custom JSON decoder to distinguish integer tokens from float tokens. Python's standard parser converts both 1.0 and 1e2 into floats, which would violate the strictness rules requiring every number to be an integer within ±(2^53-1). The decoder must preserve the original token form so I can enforce that no number is non-integer and apply canonical formatting only to non-integer values.\n\nI will use `json.JSONDecoder` with `parse_int` and `parse_float` hooks to tag each number as an integer or float during parsing. This preserves the original token form so I can enforce the 4300-digit limit and strict integer rules. The tagged structure will be unwrapped afterward for normal processing.\n\nI am weighing a custom number class approach to preserve original token spelling for canonical JSON output. The specification requires non-integer values to be formatted as Python's json module writes them, including NaN, Infinity, -Infinity, and finite floats like 1.5 or 1e+16.\n\nI clarified the canonical JSON formatting rules. Non-finite numbers must be written as `NaN`, `Infinity`, or `-Infinity`. Finite floats should use Python's `repr` format, such as `1e+16` or `1.0`.\n\nI realized that `isinstance(True, int)` returns True in Python, so a simple `int` subclass cannot distinguish booleans from integers. I will use a custom `JInt` class instead to track integer tokens cleanly.\n\nI will use `JInt` and `JFloat` subclasses to distinguish integer tokens from booleans and floats. For canonical JSON, finite floats will be formatted with `repr`, while non-finite values use the exact strings `NaN`, `Infinity`, or `-Infinity`. I also need a pre-parse scan of the raw text to count nesting depth, since the 512-level limit applies to brackets and braces outside of strings.\n\nI am writing a raw-text scanner that counts nesting depth while tracking string boundaries and escape sequences. This will enforce the 512-level limit before parsing begins. I also need to scan for integer tokens longer than 4300 digits.\n\nI realized Python's standard `json.loads` accepts `NaN`, `Infinity`, and `-Infinity` by default as valid JSON extensions. To enforce the strict parse error requirement, I must explicitly configure `parse_constant` to reject any non-standard number tokens.\n\nI will implement `parse_constant` to explicitly return `JFloat` instances for `NaN`, `Infinity`, and `-Infinity`, ensuring they are tagged as floats rather than defaulting to plain Python floats. I also drafted the `object_pairs_hook` logic that raises a `ValueError` upon detecting duplicate keys.\n\nI am now working out the canonical JSON encoding rules. Objects must have keys sorted by Unicode code point with no whitespace, and arrays must also be whitespace-free. Strings require escaping of quotes, backslashes, and control characters U+0000 through U+001F, plus special escapes for b, f, n, r, and t. I am checking how Python's `json.dumps` handles these edge cases to ensure the output matches the specification exactly.\n\nI will write a custom canonical encoder instead of relying on Python's `json.dumps`. Integers must be plain decimal with no leading zeros. I also need to handle lone surrogate code points by encoding them as `\\udxxx` sequences, since Python's JSON parser preserves them in strings.\n\nI confirmed that Python's JSON decoder preserves surrogate pairs as separate code units rather than combining them into a single character. I am now determining whether valid surrogate pairs should be written back as `\\udxxx` sequences during canonical encoding, or if only lone surrogates require that escape.\n\nValid surrogate pairs will be encoded as their combined Unicode character rather than as separate `\\udxxx` escapes. Only lone surrogate code units must be written as `\\udxxx`.\n\nI will implement base64 with padding and canonical decoding, where re-encoding yields the same text. Public keys are 32 bytes and signatures are 64 bytes. A public key is unusable if it does not decode to a valid Edwards25519 point, is the identity point, or lies outside the prime-order subgroup.\n\nEdwards25519 points are encoded as 32 little-endian bytes with the y-coordinate in the first 255 bits and the x-sign bit in the top byte. A 255-bit y-coordinate must be strictly less than p (2^255 - 19) to be canonical. The identity point is encoded as 0x01 followed by 31 zero bytes. A valid point must have prime order L, meaning its order divides L.\n\nI will verify that a decoded point is in the prime-order subgroup by multiplying it by the group order L and checking that the result is the identity. The identity point itself must be rejected separately.\n\nI am now implementing the Edwards25519 arithmetic. I have defined the curve constants p, d, L, and I. I am writing a point decompression routine that reads the 32-byte little-endian encoding, extracts the y-coordinate and x-sign bit, and rejects any y-coordinate greater than or equal to p.\n\nI completed the Edwards25519 point decompression routine. It computes x² from y² using the curve equation, resolves the x-coordinate with modular square roots and the imaginary unit I, and enforces that the recovered x matches the sign bit in the top byte.\n\nI defined the Edwards25519 point addition formulas for affine coordinates. Scalar multiplication by L will use double-and-add, requiring roughly 252 doublings.\n\nSignature strictness requires the first 32 bytes to be a canonical Edwards25519 point in the prime-order subgroup, and the last 32 bytes to be a little-endian scalar strictly less than L. The R component is validated exactly like a public key. I will use the cryptography library's Ed25519PublicKey class for signature verification.\n\nI will perform the custom Edwards25519 point checks before calling the cryptography library's verify method. This ensures that non-canonical keys are rejected as unusable according to section 3.2, rather than letting the library raise an exception.\n\nStrict verification requires both a strict signature and a successful verification. The contract door treats false and unusable as equivalent refusals, so only the contract_not_verified code is needed. Rule 6 accepts a public key that decodes to 32 bytes, but rule 15 rejects it during signature verification if the point fails validation. The SHA-256 hash of the contract is now being considered.\n\nThe signing bytes are the prefix `b\"a2a-contract-v0\\n\"` concatenated with the canonical JSON of the contract excluding its `signatures` key. The SHA-256 hash is lowercased hex. If the contract is not an object, the hash is null and the only refusal code is `contract_not_verified`. If `events` is not a list, the code is `input_not_settleable`, but the file interface guarantees that `events` will always be a list.\n\nThe file interface reads contract.json, view.json, and optional parent.json. The events/ directory holds one element per file; a missing directory yields an empty list. The optional nenrin/ directory behaves the same way. Every file is UTF-8 text. Event order is ignored for settlement but binding walks them in given order and skips duplicate record_sha256 values.\n\nThe output JSON object must list its fields in the exact order specified by the specification: contract_sha256, verdict, status, bond_outcome, deviation_codes, underspecified_reasons, event_set, and dispositions. The dispositions mapping is an object, so its key order affects canonical JSON encoding.\n\nI will sort disposition keys by sha256 for stable JSON output. Lists that represent sets will be sorted. I cannot match the reference's exact key order without it, so I will rely on standard JSON separators and the specified field order.\n\nI am reconsidering whether to sort disposition keys. The reference implementation likely preserves insertion order, so matching it exactly is risky.\n\nI will use compact JSON with keys in the specification order. Disposition keys will be sorted by record SHA-256 for determinism. I cannot match the reference's exact key order without it, so I will rely on standard JSON formatting.\n\nI will use compact JSON with sorted disposition keys and the eight specified fields, ending with a newline. I am now reviewing the contract door rules: schema must be \"a2a-contract-v0\", contract_id and nonce must each be 32 lowercase hex characters, and parties must contain exactly two objects with distinct roles of principal and contractor.\n\nI am continuing to review the contract door rules. The remaining checks cover domain normalization, key_url as an HTTPS URL, canonical base64 public keys, task objects with a non-empty purpose and optional payload_digest, grant objects restricted to allowed keys, authorized and prohibited actions as non-empty strings with no overlap, typed grant keys when present, integer bounds, printable ASCII keys, and establishes and does_not_establish regex validation.\n\nThe contract door requires each party to have at least one verifying signature. If the contract is an object but its canonical form cannot be computed, the SHA-256 hash must still be produced even if the door ultimately rejects the contract. Keys outside the core specification, such as spine, convergence, approvers, limits, or admission, are out of scope and would disqualify any implementation from claiming core v0 conformance.\n\nThe interface distinguishes between success output and 2.2 errors, which print an error and exit with code 2. Out-of-scope keys are not treated as 2.2 errors; they disqualify the implementation from core v0 conformance instead.\n\nTest vectors may carry keys such as synth_limits_null or synth_admission_null that trigger a 4.1 refusal rather than being treated as carried keys. The requirements.spine and requirements.convergence fields are considered carried whenever their key is present, even if the value is null.\n\ngrant.approval_policy.approvers is carried only when it is a well-formed list; other values trigger a 4.1 refusal. grant.limits is carried whenever its value is present and non-null, but a null value is not carried and does not force requirements.admission. The synth_limits_null vector should still be settled because the door may reject it for reasons unrelated to carrying that key.\n\nA null admission value is in scope, so it does not trigger an out-of-scope refusal. A well-formed approver list is out of scope. The interface only defines exit codes 0 and 2, so encountering out-of-scope keys will produce a 2.2-style error rather than claiming conformance.\n\nThe parent may carry approvers while the child remains in scope. A child carrying a well-formed approver list is out of scope, so the entire settlement is rejected.\n\nThe 4.2 settlement rules apply only after 4.1 accepts the contract. Action names must match the pattern `^[a-z][a-z0-9_.:-]{0,63}$`. The `too_many_witnesses` refusal applies when there are more than 32 witnesses. The `key_conflict` refusal occurs when two keys decode to the same 32 bytes, including principal, contractor, and witness keys. The `tie_policy_refused` refusal applies when `same_height` is present but not null and not `\"conservative\"`.\n\n`revocation_policy_not_recomputable` cannot fire because 4.1 already validates `effective_at`. `ack_window_missing` applies when `delivery_ack` and `ack_window` are not integers greater than or equal to one. `finality_policy_missing` applies when `depth` is absent or not an integer greater than or equal to one. `bad_expiry_height` cannot fire. `unscoped_approvals_refused` triggers only if `allow_unscoped` is present and strictly `True`; since 4.1 requires it to be boolean, this means exactly `True`. The review is now moving to 4.3 Strict terms.\n\nThe 4.1 contract door applies `contract_signature_not_strict` when a signature decodes to exactly 64 bytes but is not strict, even if it fails verification. This reason appears once per signature. The `bond_malformed` refusal applies when a bond is present and non-null but its amount is not an integer between 1 and 2^53-1.\n\nThe `parent_not_supplied` refusal applies when a parent contract is present but no parent was supplied. The `parent_narrowing_failed` refusal applies when a parent contract is present, a parent is supplied, but the parent is not an object or fails its own 4.1 check, or the child contract fails 4.1 when combined with the parent. This narrowing check is judged by 4.3.1 and adds only `parent_narrowing_failed`; it does not also add `contract_not_verified`, which is decided by 4.1 on the child contract alone.\n\nThe parent narrowing rule checks whether the parent is absent, not an object, or fails its own 4.1 check. If no parent was supplied, the parent is absent, so this condition is met and `parent_narrowing_failed` applies.\n\nThe specification revision clarifies that when a parent contract is present but no parent is supplied, the parent is absent and therefore not an object. Both `parent_not_supplied` and `parent_narrowing_failed` can apply simultaneously.\n\nThe fourth narrowing rule is being reinterpreted. It applies only when a parent contract is supplied, not when none is provided. If no parent is supplied, the third row already covers that case. The fourth row instead checks whether the supplied parent input is an object and passes its own 4.1 check. This yields two distinct refusal paths rather than overlapping ones.\n\nThe `grant_subset` narrowing rule is being implemented. Absent or null lists count as empty, and a key is considered set only when its value is present and non-null.\n\nThe narrowing rules for `grant_subset` are being enumerated. The child must not introduce any authorized actions absent from the parent. The parent must not introduce any prohibited actions absent from the child. The child may omit data access entries. The child may not set max_hops above the parent's value, and a parent with zero max_hops excludes all children. The child may not add delegation allowed entries absent from the parent. Conditional entries are next.\n\nThe remaining narrowing rules are being enumerated. Conditional actions must be present in the parent's authorized or conditional actions. The child must not set an expiry height above the parent's. Witness keys, privacy, and ordering must match when the parent sets them. The child may not enable allow_unscoped if the parent does not. Approvers are compared as canonical entries. Rule 10 requires the child's max_target_bits to decode to a target no larger than the parent's.\n\nIf the parent's max_target_bits is absent, the target comparison is skipped, but the child must still carry a finality object when the parent does. The view verification rules are now being enumerated: max_target_bits must be eight lowercase hex digits decoding to a positive target; lower_bound must be an object with an integer height and a sixty-four-character lowercase hex hash; and headers must be a non-empty list.\n\nEach header is an object with a non-negative integer height and a 160-character lowercase hex string. Heights must be consecutive. From the second header onward, bytes 4-36 reversed as hex must equal the previous header's hash. The view must contain a header at lower_bound.height whose hash matches lower_bound.hash. Header hashes are sha256(sha256(80 raw bytes)), byte-reversed, and formatted in lowercase hex. A trailing newline on the hex string triggers only a view_not_strict refusal.\n\nA header ending in a line feed passes rules 1 through 8 and is refused only by rule 9 as view_not_strict. An upper-case hex header fails rule 4 and is refused by both chain_view_rejected and view_not_strict. A view that is not an object or whose headers field is not a list is refused only as chain_view_rejected.\n\nRule 9 applies when the view is an object whose headers field is a list. Every header must be an object with an integer height and a 160-character lowercase hex string. The view itself must be strict: no strings or keys may contain control characters, every key must be ASCII, and every number must be an integer within ±(2^53-1). A value nested deeper than 512 levels is also non-strict, though parsing would have already failed at that depth.\n\nA view that passes rules 1 through 8 but contains more than 200,000 headers is refused as input_too_large instead of chain_view_rejected. No further record examination follows. It is unclear whether triage and anchor checks are skipped in this case.\n\nSection 2.3 states that a problem in rules 4.1, 4.2, or 5.1 stops record examination. The input_too_large refusal is a separate exception: it triggers after verification and still halts further examination. Section 6.1 says binding runs even when sections 4 or 5 fail, but input_too_large is a post-verification consequence of 5.1, so it may still block classification.\n\nBinding will still run even when a view is refused as input_too_large, because that refusal is not a problem in rules 1 through 8. Triage, anchor checks, and header walking will be skipped instead.\n\nRe-reading section 2.3 shows that triage runs before the 4.1 and 5.1 checks, and problems found there do not stop the other checks in that paragraph. Only a problem in rules 4.1, 4.2, or 5.1 rules 1 through 8 halts further record examination.\n\nThe full computation order is now clear. After binding and triage, the contract and view are checked. Collapsing copies, conformance, and anchor checks follow. The event set is then walked. Checks 4.3, 5.1 rule 9, 6.0, 7.4, and 11 are collected but never stop the computation.\n\nSection 6.2 imposes an input_too_large limit of 10,000 records after triage, halting further examination. Section 6.4 collapse is conditional on 5.1 rules 1 through 8 passing, even if 4.1 fails. This creates a contradiction with section 2.3, which stops examination whenever 4.1, 4.2, or 5.1 rules 1 through 8 find problems.\n\nSection 6.4 explicitly overrides section 2.3 by running collapse even when section 4 fails, provided the view passed rules 1 through 8. The same conditional is being checked for conformance and anchor checks.\n\nThe event set is empty when the walk does not run. A reason from 4.3, 5.1 rule 9, 6.0, 7.4, or 11 never empties it.\n\nSection 9.2 states that bound records never examined because sections 4, 5, or 6.2 failed have no disposition. Triage assigns dispositions before the section 4 check, so triage dispositions remain valid even if a later section fails.\n\nSection 9.2 contradicts the earlier assumption that triage assigns dispositions before section 4. If records are never examined when sections 4, 5, or 6.2 fail, then triage must occur after those checks. The actual computation order may be: compute contract_sha256, run sections 4 and 5 first, bind records, then triage.\n\nBinding dispositions are always reported, even when sections 4 or 5 fail. Triage dispositions are only assigned when triage runs; if sections 4, 5, or 6.2 fail, records are not examined and no triage dispositions exist.\n\nThe implementation order is now fixed. Contract and view checks run before binding and triage. Bound records receive no disposition when sections 4 or 5 fail, so triage is skipped entirely. Failing-closed reasons from 6.0 are therefore absent, which aligns with the specification that they never stop the event set computation.\n\nThe implementation order is being refined. If the contract is not an object, the computation halts immediately with no binding or dispositions. If events are not a list, the computation also stops, though computing contract_sha256 in that case is ambiguous and will be skipped. The planned sequence now begins with parsing inputs, then computes contract_sha256, checks out-of-scope status, and proceeds to sections 4 and 5.\n\nBinding runs unconditionally unless the contract is not an object. If sections 4, 5, or view input_too_large fail, triage is skipped and only foreign, inconsistent, and unbound dispositions are assigned; the event set remains empty. Otherwise triage proceeds, followed by the size limit check, collapse, conformance, and anchors. The event set is then built from accepted records.\n\nThe event set is always computed before the walk begins. Even when underspecified reasons from 4.3, 5.1 rule 9, 6.0, or anchors are found, the walk still runs and produces deviations internally. The verdict becomes underspecified and deviations remain empty.\n\nEvidence_missing is only appended when the verdict would otherwise be within_grant or deviation; it is suppressed if the verdict is already underspecified. The final verdict order is: underspecified if any underspecified reasons exist, otherwise deviation if deviations were found, otherwise nothing_to_settle if the event set is empty, and finally within_grant.\n\nSection 11.1 checks are collected even when the settlement is already underspecified. They may add walk_not_strict or evidence_names_other_contract, but they never stop the event set computation.\n\nSection 11.1 is skipped when triage is bypassed, because it requires examined records. The cross-check deviation from 11.1 would be collected internally but omitted from the output if the verdict is already underspecified. Section 7 still evaluates kept and unrejected executions, including orphaned anchors.\n\nExecutions that fail anchor checks with underspecified reasons are still read by section 11.1, because section 7 evaluates all kept executions regardless of acceptance. Executions set aside in 6.0 or rejected by 6.6 are excluded from this check.\n\nA helper function `is_strict(value)` is needed for the strictness definition in 6.0, and additional checks must be added for `body_not_strict`.\n\nRecord signing bytes are the context plus the canonical form of the record without signatures and anchor. A strictly signed record requires one signature entry with an allowed role, strict verification, and a strict signature object. Execution roles are contractor or witness; the latter requires a matching grant witness name. Even when the contract is invalid or witness keys are missing, triage still attempts to match execution roles.\n\nTriage is gated by 4.1 passing, so parties and witnesses are well-formed when it runs. Keys that decode to 32 bytes but fail the Ed25519 point check are treated as unusable and not strictly signed. Revocation records require the principal role, while ack records require the contractor role. A record is set aside with reason `record_not_strict` if its `record_sha256` cannot be computed at all.\n\nCanonicalization failures that would prevent computing `record_sha256` are effectively impossible. The parser rejects integers longer than 4300 digits and limits nesting depth to 512, so any successfully parsed record can always be canonicalized.\n\nCanonicalization handles lone surrogates safely because they encode as ASCII escape sequences. During binding, records whose `record_sha256` cannot be computed are set aside with reason `record_not_strict`; the remaining records proceed to binding. Identical byte sequences are skipped during the binding walk.\n\nFilenames will be sorted to ensure deterministic event ordering. The binding table is being drafted: it checks the contract reference, validates the SHA256 hex format, and compares it against the contract SHA256 and ID to assign unbound, inconsistent, or foreign dispositions.\n\nThe binding table now includes a payload digest check: if the reference carries a payload digest that does not match the record, the disposition is inconsistent. A missing contract_id causes unbound only when the contract SHA256 is absent or null and the ID matches; otherwise the record is dropped silently.\n\nTriage in 6.0 applies exclusively to bound records. Records that are not strictly signed and have a non-strict body are set aside with reason `record_not_strict`. Records that are not strictly signed but whose signature verifies under lax rules alone are set aside with reason `signature_not_strict`. All other non-strict records are rejected.\n\nStrictly signed records with a non-strict body are set aside with reason `record_not_strict` and also add an underspecified reason. If a strictly signed record has an invalid anchor and another bound record shares its signing bytes, it is set aside with `anchor_not_strict`; otherwise it becomes an underspecified reason. A revocation record is set aside with `revocation_not_provided_for` when the grant's revocation field is not an object. All other strictly signed records are kept. Anchor validity depends on the view.\n\nThe `anchor_not_strict` triage rule is circular with 6.4. It requires knowing whether another bound record with the same signing bytes is kept and anchors validly, but that outcome depends on the same strictness checks. The algorithm must therefore evaluate strictness for all bound records together.\n\nThe disposition `anchor_not_strict` applies to both the set-aside case and the underspecified case. The exact wording of 9.2 is being re-read to determine whether the reason is added to the settlement in the set-aside scenario.\n\nThe first triage row sets aside the record with disposition `anchor_not_strict` but does not add the underspecified reason, because a valid copy exists. The second row fails closed with disposition `anchor_not_strict` and adds the underspecified reason.\n\nThe underspecified `anchor_not_strict` case is not set aside; it is failing closed and therefore never examined again. Only the strictly signed body-not-strict row both sets aside a record and adds an underspecified reason.\n\nBoth the set-aside and failing-closed `anchor_not_strict` outcomes are treated as not kept, so they never enter the event set. Only the \"otherwise\" case adds the underspecified reason. A record is considered kept by this table if it is strictly signed, body strict, and its anchor is valid under 6.4.\n\n\"Anchors validly\" requires a non-negative height, a matching block hash in the view, a proof reaching the Merkle root, and an accepted batch leg. It does not compare against the checkpoint.\n\nIf the good copy anchors validly but the bad-anchor copy fails closed, the bad copy is set aside or rejected and never examined again. 6.4 therefore sees only the good copy. If none of the bound records anchor validly, 6.4 keeps all of them.\n\nThe implementation will group bound records by signing bytes. A strictly signed, body strict, anchor strict record is the candidate good copy for its group. A strictly signed record with a non-strict anchor is set aside without reason if the group contains a good copy; otherwise it fails closed with reason. Anchor checks precede revocation checks in the triage table.\n\nA revocation record with a bad anchor is handled by the anchor rows, not the revocation_not_provided_for rule. If the anchor is strict but the grant lacks a revocation object, the record is set aside and does not count as kept by this table; its non-strict anchor copy then fails closed. A lax signature is one that passes 3.4 verification yet does not satisfy strict Ed25519 requirements.\n\nA record is strictly signed only if every signature entry verifies under strict Ed25519 rules and the entry itself is a strict value. A signature that passes lax verification but fails strict requirements—such as an S-value at or above the order L, a non-prime-order R point, or a control character in a field—counts as non-strict. The triage row therefore applies to any signature entry that verifies under 3.4 yet does not satisfy strictness.\n\nThe `signature_not_strict` triage row applies to any signature entry that verifies under lax rules but fails strict Ed25519 verification. A record is not strictly signed if its only valid signature has the wrong role, yet a different signature entry still verifies under 3.4. That lax signature triggers the set-aside.\n\nThe signature triage rule is now fully defined. A record is strictly signed only if at least one signature entry with an allowed role and matching key both verifies under strict Ed25519 rules and carries a strict value. If any verifying signature fails strictness, the record is set aside with reason `signature_not_strict`. Otherwise it is rejected.\n\nAny signature entry whose base64 value verifies under 3.4 will trigger the `signature_not_strict` triage row, even if its role is wrong. A strict signature beside a malleated one should keep the record; problems in the signatures list are ignored for strictly signed records.\n\nBody strictness is violated when the body value itself is not strict, nenrin_ref is present but neither null nor 64 lowercase hex, or contract_ref fields are present and not 64 lowercase hex. For executions, performed_actions and delegated_to must be lists of strings, approvals must be a list of objects, and any approval containing a signature that decodes to 64 bytes must satisfy strict Ed25519 rules. A missing nenrin_ref key is acceptable.\n\nA null value in contract_ref fields is treated as present and therefore invalid for strictness, since null is not 64 lowercase hex. This may conflict with binding rules that allow absent or null contract_sha256 for unbound records.\n\nA signature entry that decodes to fewer than 64 bytes is not checked for strict Ed25519 rules; it is classified as forged under 10.4. An absent anchor is treated as strict by default.\n\nA kept record with no anchor is not strictly signed, so it reaches 7.4 and is classified as `anchor_incomplete`. In 6.4, kept records are grouped by signing bytes; if multiple distinct records exist, the one with the smallest `(height, record_sha256)` pair is kept and the rest are dropped as `duplicate_dropped`. The specification does not clarify how to compare records when an anchor height is missing.\n\nOnly copies that anchor validly are kept in the duplicate-dropping path, so every candidate has a valid integer height. Dropped copies are never examined for conformance or anchors.\n\nA kept revocation is ignored if its `revoked_by` field is not `\"principal\"`. This check runs after conformance, which rejects revocations with extra fields.\n\nThe ignore rule for revocations must run before section 7. Otherwise a bad anchor would underspecify the settlement first. The full pipeline is kept, then duplicate collapse, then conformance, then ignore, then anchors.\n\n6.6 conformance rejects records with extra fields, non-string performed_actions, outcomes checks, more than 256 actions, or invalid action name patterns. An execution record that fails conformance but carries a contractor signature verifying under 3.4 is charged as `nonconforming_record` and still proceeds to section 7. The specification does not clarify whether a witness-signed record with conformance problems is rejected instead of charged.\n\nA witness-only execution with conformance problems is rejected. The specification does not explain which later check would read a rejected record, since conformance and collapse do not depend on other records.\n\nThe repeated conformance pass is unnecessary because conformance and duplicate collapse are independent of other records. Rejected records are never examined again, so they do not affect later checks.\n\n6.6 rejection is distinct from 6.0 rejection. An approval object that lacks an action field fails the action name pattern and counts as a conformance problem.\n\nRecords that pass section 6 are evaluated in order by sections 7.4, 7.5, and 7.6; the first failure determines the disposition.\n\nSection 7.4 rejects an anchor if it lacks a height or its block_hash is not exactly 64 lowercase hex. A height below the lower bound yields `anchor_below_lower_bound`. A height beyond the observed chain tip or a missing header at that height yields `anchor_beyond_observed_chain`. A block_hash that does not match the view hash yields `orphaned`, with no reason but the height still counting toward finality.\n\nSection 7.5 requires the proof to be a non-empty list of at most 512 operations.\n\nSection 7.5 proof validation begins with the body digest, which is the SHA-256 of the canonical record excluding only the anchor key. The operations are applied to that digest, and the final result must equal the Merkle root from bytes 36–68 of the raw header. A failure yields `anchor_proof_invalid`.\n\nSection 7.6 batch-leg validation rejects a record if it refuses the batch leg, producing `anchor_batch_leg_refused`. If all checks pass, the record is accepted.\n\nThe body digest excludes signatures but includes them in the canonical record used for signing.\n\nSection 7.6 rejects a record if hexlify is not the first operation or appears more than once, producing `hexlify_not_leading`. The batch leg is rebuilt by walking operations after the first up to the first sha256; any operation that is not append or prepend yields `batch_leg_malformed`. The reconstructed batch concatenates prepend operands in front-to-back order, then the ASCII hex of the body digest, then append operands in their original order.\n\nSection 7.6 requires the batch bytes to parse as strict JSON into an object matching one of the three batch schemas; otherwise the record is rejected as `batch_not_json` or `batch_schema_unknown`. A batch containing `NaN` fails strictness and is refused.\n\nThe parenthetical citation to strict JSON (2.2) refers to the reader rules, not the strictness definition in section 6.0. This means NaN is parsed as a number and then fails strictness, producing batch_not_json.\n\nThe batch schema requires a `records` list of objects. A `count` field must equal the list length; otherwise `batch_count_mismatch`. Exactly one record's SHA-256 hash must match the ASCII hex digest; otherwise `record_not_listed_in_batch` or `record_listed_twice`. For typed batches, each record's `kind` must match the schema kind, and its `schema` field must equal the record's own schema.\n\nThe raw batch text must contain the record SHA-256 as 64 unescaped hex characters. Its first character must sit at a byte offset equal to the total length of all prepend operands.\n\nThe SHA-256 hex string must begin immediately after the prepend operands, at the splice point where the body digest was inserted. This confirms the hexlify output matches the record's own SHA field exactly.\n\nThe SHA-256 hex string must appear as raw 64 characters with no escapes; any escape sequence triggers an internal refusal. Its first character must sit at a byte offset equal to the total length of all prepend operands. The exact position of that string in the raw batch text is still unclear.\n\nThe batch JSON must be parsed with position tracking to locate the exact raw span of the record's SHA-256 string. That span must contain exactly 64 unescaped hex characters, and its start offset must equal the total length of all prepend operands.\n\nPrepend operands are hex-decoded bytes, so their total length is measured in raw bytes. The header is 80 bytes: version, previous hash, Merkle root, timestamp, nBits, and nonce. The Merkle root sits at bytes 36–68. The header hash is the double SHA-256 of those 80 bytes, reversed, then hex-encoded.\n\nThe previous hash field is the computed header hash of the prior block, not a stored value. The nBits field is bytes 72–76 as a little-endian uint32 target. The header hash must be no greater than that target when read as a big-endian 256-bit integer.\n\nThe compact target is decoded from the nBits field by extracting the 8-bit exponent and the 23-bit mantissa. The value is invalid if the sign bit is set or the mantissa is zero.\n\nThe compact target is computed as mantissa shifted left by eight times the exponent minus three, or right if the exponent is smaller. A target of zero is invalid because the specification requires a positive value.\n\nStatus is undetermined when the verdict is underspecified. Otherwise it is final if every accepted height and every orphaned height is at most the horizon, where the horizon equals the chain tip minus the finality depth plus one. It is provisional otherwise. If there are no accepted or orphaned heights, the status is final. A missing finality depth produces an underspecified verdict and an undetermined status.\n\nIf rules 4.1, 4.2, or 5.1 fail, the event set is empty and no further examination occurs. Orphaned records only arise after a successful view and depth check. A missing finality depth therefore leaves the status undetermined without generating orphaned records.\n\nIf only rule 4.3 fails, the event set is still computed and the status remains undetermined.\n\nSection 9.3 defines bond outcomes: absent or null bonds yield n/a. A bond that is not an object with a positive integer amount produces an underspecified verdict; the outcome is undetermined when lower layers read it as a bond, and n/a otherwise. Python truthiness determines whether the amount counts as a valid bond.\n\nA well-formed bond yields undetermined if the verdict is underspecified, pending_finality if the status is provisional, held for within_grant and nothing_to_settle otherwise, and forfeited for deviation. Section 10.1 defines revocation effective_at as the anchor height h, and delivery_ack as the minimum of h plus ack_window and the heights of acknowledgments naming that revocation.\n\nIf no acknowledgments name the revocation, the effective_at height is simply h plus ack_window. An acknowledgment names a revocation when its revocation_sha256 matches either the lowercase hex body digest of the revocation or the record_sha256 of a copy still present after step 6.4. A copy dropped by step 6.4 no longer names the revocation.\n\nRevocations are sorted by effective_at height and record SHA-256. An execution at height h is revoked if a revocation has effective_at at or before h. A revoked execution yields deviation revoked for every performed action, consumes no approval nonce, and skips further checks.\n\nIf expiry_height is present and not null, actions at heights above it receive after_expiry verdict, though this does not halt other checks.\n\nEach string action is judged in sequence: prohibited actions are rejected, conditional actions are handled by section 10.4, and all remaining actions that are not in the authorized set are unauthorized.\n\nDelegated_to entries missing from delegation.allowed yield a delegation deviation.\n\nEvery approval on accepted executions is classified. A non-object or missing principal key is forged. If the signature base64 verifies over a v2 message and the contract SHA-256 matches, the approval is counted; otherwise it is other_terms. If the signature verifies over v1 or v0, it is label_bound. Otherwise it is forged.\n\nThe v2 message prefix is the byte string \"a2a-approval-v2\\n\" followed by the canonical JSON of the approval fields: contract_sha256, action, valid_until_height, nonce, and single_use.\n\nStep 2 approval fields require valid_until_height to be a non-negative integer, nonce to be 32 lowercase hex characters, single_use to be a boolean, and contract_sha256 to be 64 lowercase hex. A v1 signature is attempted only when these checks pass and the contract SHA-256 matches; otherwise the approval is other_terms. The v1 message prefix is \"a2a-approval-v1\\n\" followed by canonical JSON containing contract_id, payload_digest from the contract task, action, valid_until_height, nonce, and single_use.\n\nThe v1 message includes payload_digest even when absent, canonicalized as null. The v0 message prefix is \"a2a-approval-v0\\n\" followed by canonical JSON of contract_id, payload_digest, and action, with no field checks beyond signature verification.\n\nA missing sig_b64 field causes the approval to be judged forged. For conditional actions, the first counted approval in event set order is used: it must match the action, name the same record or a height strictly below h, satisfy valid_until_height, and leave the nonce unconsumed if single_use is true.\n\nNonces are consumed only when single_use is true. Consumed nonces are shared across all actions and executions. A missing approval yields deviation conditional. Every forged approval adds the deviation forged_approval, even on revoked executions.\n\nA revoked execution's approval can still approve a later action if it names the same record or a lower height. The nonce is not consumed for that revoked record's own judgment, but the approval may be counted by a subsequent execution.\n\nThe event set order scans all counted approvals in record list order. An approval from a later record is excluded because its height is not strictly below the current execution height.\n\nSection 11 NENRIN applies only when nenrin_records is a non-empty list. A missing or empty value is treated as absent, and a non-list value is also treated as absent.\n\nThe walk is not strict. Left-out objects are skipped. Other objects are indexed by record_sha256, and non-objects are ignored.\n\nExecutions kept by rule 6.0 that are not rejected by rule 6.6 and remain after step 6.4 are processed once per record_sha256.\n\nFor each kept execution, the walk whose record_sha256 matches its nenrin_ref is looked up. If that walk exists and its contract_sha256 differs from the current contract, the deviation evidence_names_other_contract is added. If the walk was left out because it was not strict, the reason walk_not_strict is set. A mismatched nenrin_ref produces no deviation or reason.\n\nSection 11.2 adds evidence_missing when requirements.evidence is nenrin_required and a kept execution's nenrin_ref is missing or not exactly 64 lowercase hex characters. This check applies only after the verdict would be within_grant or deviation.\n\nRule 13 of section 4.1 establishes a regex that rejects strings in the establishes field if they match case-insensitively against performed, delivered, money moved, funds transferred, paid, or payment completed.\n\nThe establishes regex also rejects strings containing contract, binding, guarantee, escrow, custody, solvent, lawful, fair, or certified. Rule 14 does_not_establish applies when the list is non-empty: a kept execution is judged against groups of runtime or enforce, judge or liability or fault, deviat, and legal.\n\nEach of the four groups in rule 14 must appear inside at least one string. The keyword does not need to be split across separate strings.\n\nDomain normalization strips whitespace and lowercases the string. It removes one or more trailing dots. The result must contain at least two labels separated by dots. Each label starts and ends with a letter or digit. It may contain hyphens in between. Consecutive dots produce empty labels and fail validation.\n\n`str.strip()` removes all Unicode whitespace characters. A `key_url` must parse as a valid HTTPS URL with a non-empty host. Each signature in the list is verified against the party whose domain normalizes to the object's domain.\n\nA signature is refused if its domain does not match any party. A non-object in the signatures list is also refused. Every party must have at least one valid signature. Numbers in the contract must be integers within ±(2^53-1). Boolean values are not numbers. Object keys anywhere must be printable ASCII characters.\n\nRule 8 restricts grant keys to a fixed set. The limits key is permitted, but only when it is null; if present as an object, the grant is out of scope and must be skipped. Rule 10 governs approval_policy.\n\nRule 10 restricts the approval_policy object to the keys allow_unscoped and approvers. If approvers is present, it must be a well-formed list of one to sixteen elements; otherwise the contract is refused as not verified. A present but empty or malformed approvers list is refused. A present and well-formed approvers list is carried out of scope.\n\nA conflict exists between the preamble and rule 10. The preamble says approvers is checked only when present and not null, but rule 10 explicitly requires a list whenever that key is present. Because null is not a list, it would refuse the contract under rule 10 even though the preamble would skip it.\n\nThe approvers conflict is resolved by special-casing the key: any present value, including null, must be a well-formed list or refuse. A present but null requires field is not a string, so it does not satisfy the conditional rule's requirement.\n\nThe delegation rule is next.\n\nDelegation must be an object with exactly one key, allowed, containing a list of non-empty strings; an empty object is refused.\n\nOrdering may contain only the optional same_height key, which must be a string or null.\n\nRevocation requires effective_at to be either anchor or delivery_ack. It may also contain ack_window as an integer greater than or equal to one. If ack_window is absent and effective_at is delivery_ack, 4.1 passes but 4.2 adds ack_window_missing.\n\nFinality may contain depth as an integer greater than or equal to one and max_target_bits.\n\nWitnesses must be a list of objects with non-empty name strings and public keys that decode to 32 bytes. Privacy must be a non-empty string when present. Max_hops and expiry_height must be integers greater than or equal to zero when present; booleans are refused.\n\ndata_access must be a list of non-empty strings. Any carried out-of-scope field causes the program to exit with code 2 and an error.\n\nA parent contract may carry out-of-scope keys such as approvers or spine without failing 4.1. The door only checks for in-scope fields, so a parent that passes all required checks remains valid even if it contains keys the settlement logic ignores.\n\n4.3 signature strictness is checked independently of 4.1. Malformed contracts are still decoded to extract signatures. A non-list signatures value is skipped. The view is evaluated even when section 4 fails. chain_view_rejected applies when rules 1–8 fail or the view is invalid, using a single reason.\n\nRule 9 separately adds view_not_strict. If the view passes rules 1–8 but contains more than 200,000 headers, the reason is input_too_large instead of proceeding normally. Rule 9 can still fail if non-strict strings appear in extra keys.\n\ninput_too_large and view_not_strict may both apply. A section 5 failure such as input_too_large still triggers binding, but bound records are not triaged. This avoids missing record_not_strict reasons.\n\nSection 6.2 limits kept records to ten thousand after triage. Exceeding this cap triggers input_too_large and halts further examination. Kept records that are triaged but not fully examined receive no final disposition from anchors, matching the rule that never-examined records have none.\n\nSet-aside and rejected records retain their 6.0 dispositions even when triage halts before they are examined. Kept records that were triaged but not further examined receive no additional disposition from anchors.\n\nEvents are ordered by anchor height and record SHA-256. The dispositions object maps each record SHA-256 to exactly one disposition code.\n\nDeviation codes and underspecified reasons are empty unless the verdict is deviation or underspecified. The JSON output will use ensure_ascii=False and deterministic key order: contract_sha256, verdict, status, bond_outcome, deviation_codes, underspecified_reasons, event_set, dispositions. Disposition keys will be sorted for determinism.\n\nEvent set items will use the key order kind, sha256, height. Error output is a JSON object with a short reason and exit code 2 for duplicate keys, depth above 512, invalid JSON, integers exceeding 4300 digits, NaN or infinity, and bad UTF-8. Missing contract.json or view.json triggers an error; extra files are ignored. Floats will be encoded using Python repr for canonical output.\n\nThe specification requires canonical float encoding to match Python's json module output, not repr. This is a subtle distinction because the two can differ for some values.\n\nCanonical float encoding will use Python repr for finite values, producing forms like '1.5' rather than '1.50'. Negative zero is handled correctly by both repr and json.dumps. JInt values are encoded as plain integers with no leading zeros. Booleans and null map directly to true, false, and null. A custom string-escaping routine is being drafted to handle quotes, backslashes, and control characters.\n\nThe string-escaping routine now handles control characters, valid surrogate pairs, and non-BMP characters. It writes standard escape sequences for \\b, \\f, \\n, \\r, and \\t, and encodes other ASCII control characters as four-digit Unicode escapes. Valid UTF-16 surrogate pairs are decoded into their corresponding scalar characters.\n\nThe string-escaping routine now encodes stray surrogate characters as four-digit Unicode escapes. The canonical() function returns UTF-8 bytes. Ed25519 constants P and L are being defined for the point implementation.\n\nThe Ed25519 point recovery function is being implemented. It derives the curve constants D and I, then reconstructs an x-coordinate from a 32-byte public key by solving the curve equation and applying the correct sign bit.\n\nThe Ed25519 point implementation now includes identity detection, point addition, and scalar multiplication via binary exponentiation. A function to verify canonical prime-order points is being drafted.\n\nThe canonical prime-order point check verifies that the recovered point is not identity and that its order is exactly L. The square-root formula is confirmed correct for p ≡ 5 (mod 8), and the recovered point lies on the curve by construction.\n\nSmall-order points are rejected because their order divides 8 but is not 1. Scalar multiplication by L requires roughly 252 point additions, which may be slow for many records, so extended coordinates could be used to speed up the check. The cryptography package already handles signature verification.\n\nAffine coordinates are sufficient for the small number of keys. Projective coordinates will be used to avoid modular inversions in the scalar multiplication loop.\n\nThe cryptography package will not be relied upon to reject non-canonical or small-order points, so those checks must be implemented manually. For strict signature validation, the R point must pass the prime-order test and the S scalar must be less than L.\n\nOpenSSL may reject signatures with S >= L before the program ever checks them. If so, \"lax verifies\" would not trigger for those adversarial signatures. The specification notes that OpenSSL differs from the reference in this regard.\n\nSignatures with S >= L are rejected as not strictly signed, not as signature_not_strict. The lax-verification row only applies when verify returns true.\n\nThe program will call cryptography's verify directly to match the reference behavior exactly. The disposition for synth_signature_s_plus_l depends on whether that call returns true.\n\nA strict signature beside a malleated one in the same record makes the record strictly signed; the bad entry is ignored. A canonical base64 decoder is being drafted that validates padding, length, and re-encoding to ASCII.\n\nThe base64 decoder will use validate=True to reject non-alphabet characters, whitespace, and invalid padding. A helper function checks that a string is exactly n lowercase hex characters. An integer validation routine is being drafted.\n\nThe integer validation helpers are now defined: `is_json_int` checks for the custom JInt type, and `is_safe_int` enforces the 53-bit safe range. The custom JSON parser correctly handles negative numbers. A recursive `is_strict` function is being drafted to validate JSON values.\n\nThe `is_strict` validator now rejects strings containing control characters U+0000–U+001F or U+007F, permits non-ASCII bytes, and requires JInt values to stay within the 53-bit safe range. It also returns False for floats and JFloats, and recursively checks lists and dictionaries.\n\nThe `is_strict` validator now enforces that dictionary keys are ASCII printable strings, rejecting control characters and DEL. It recursively checks all values.\n\nThe specification requires every object key to be ASCII and free of control characters and DEL. This matches contract rule 12, so keys must be printable ASCII (U+0020–U+007E). Spaces are permitted in keys. Strings may contain non-ASCII bytes and spaces, but must still avoid control characters and DEL.\n\nBody strictness rules are being clarified. The `nenrin_ref` field is strict only when it is null or exactly 64 lowercase hex characters; any other value makes the body non-strict. If `contract_ref` is not an object, those fields are treated as absent.\n\nBody strictness also rejects performed_actions, delegated_to, and approvals when they are not lists of strings or objects. Empty lists are valid. A non-strict body is set aside before reaching later record checks.\n\nApproval signatures are checked for strictness only when they canonical-base64-decode to exactly 64 bytes. The check requires the first 32 bytes to pass the public-key test and the last 32 bytes to have an S scalar below L. A non-canonical 64-byte signature does not trigger this rule.\n\nWitness names are unique during triage because a duplicate name triggers key_conflict. A grant revocation that is missing, null, or not an object is set aside as revocation_not_provided_for. If the revocation object exists, rule 4.1 ensures its effective_at is either anchor or delivery_ack.\n\nThe `same_height` field in rule 4.2 is valid only when it is null, absent, or exactly `\"conservative\"`. Any other string value makes the record non-strict. Section 10 clarifies that same-block records are resolved by explicit settlement logic rather than by ordering rules.\n\nConservative and null same_height values are accepted without altering the walk. Finality depth is guaranteed to be an integer of at least one when status computation proceeds, because rule 4.2 ensures this once rule 4.1 passes and no finality policy is missing. The lower_bound height comparison in section 7.4 is safe because the anchor check only runs after lower_bound validation succeeds.\n\nThe view header map uses heights as keys, which are unique and consecutive. The tip is the height of the last header. Rule 8 requires the view to contain a header at lower_bound.height whose hash matches lower_bound.hash; any missing or mismatched entry fails. Rule 4 requires each header hex string to be exactly 160 lowercase hex characters followed by an optional single line feed, rejecting carriage returns.\n\nHash computation uses the 80 bytes of hex data, ignoring any trailing line feed. Rule 9 strictness requires every string, key, number, and header object in the view to be strict. A trailing line feed makes the hex string non-strict because it contains a control character, and it also prevents the string from being exactly 160 characters, so the view is not strict. Upper-case hex letters are permitted in strict strings.\n\nA height value that is a float, such as 1.0, causes both rule 4 and rule 9 to fail. Rule 4 rejects the view because the height is not an integer. Rule 9 rejects it because the number is not an integer.\n\nIn section 6.1, the contract_id comparison still executes even when the contract identifier is malformed or not a string. If rule 4.1 fails, the contract identifier may be invalid, but the binding logic continues using the computed contract_sha256. Records matching that hash are bound only if their contract_id equals the computed identifier.\n\nA missing contract_id is treated as None, so the comparison against a reference value still works. The canonical contract SHA-256 is computed from the JSON representation of the contract object, including non-integer numbers and null values for non-object inputs. Duplicate keys in nested JSON objects are handled correctly by the custom parser. If an events file element is itself a JSON array, it is ignored as not a record.\n\nFiles are sorted by name for deterministic processing. Identical content hashes to the same SHA-256, so duplicate files bind identically and the first occurrence is kept. A missing parent file is treated as absent; invalid JSON in a parent file causes a parse error that halts settlement.\n\nA missing nenrin directory is treated as absent, not an empty list. Section 11.1 is skipped when the evidence list is absent or empty.\n\nThe requirements.evidence field is read in section 11 but not checked by the door. Only the value \"nenrin_required\" triggers rule 11.2; other values are ignored.\n\nThe walk record_sha256 is the SHA-256 of the canonical walk value. A deviation occurs in section 11.1 when the walk context is an object, contract_sha256 is present and non-null, and it differs from the computed contract SHA-256.\n\nEvidence checks apply only when required. A missing, null, or non-64 lowercase hex nenrin_ref triggers a deviation. If the event set contains accepted execution without that evidence and no other deviations exist, the verdict becomes deviation rather than within_grant. An empty event set is handled by rule 11.\n\nAn empty event set is classified as nothing_to_settle, so section 11.2 does not apply and no evidence_missing deviation is added.\n\nWhen a record is underspecified, the deviation codes list remains empty; forged approvals are not reported even if they were computed.\n\nIf a record is underspecified, the status is undetermined regardless of orphaned heights or whether the bond is well-formed.\n\nMalformed bonds are classified as n/a when the amount is missing, null, or not a positive integer. They are undetermined only when the amount is present and truthy, such as with integers, floats, or booleans.\n\nExtra keys in a bond object are permitted; the amount field alone determines well-formedness. A signature is judged for strictness and encoding validity even when contract rule 4.1 fails, independent of verification. If a 64-byte signature decodes correctly but its R is not prime-order or its S is not below L, it is flagged as non-strict regardless of whether it verifies.\n\nRule 6 requires that every action the child can perform must appear in the parent contract's conditional list with an identical `requires` value. A missing or null `requires` is treated as matching on both sides. If the child lacks a matching entry, or if the existing entry has a different `requires`, the rule is violated.\n\nRule 7 forbids the child from introducing conditional actions that the parent does not already authorize. Rule 4 requires the child's max_hops to be strictly less than the parent's; a missing or equal value is a violation. Rule 9 requires a matching revocation object when the parent has one, and if the parent's effective_at is an anchor, the child's must also be an anchor.\n\nRule 9 also allows the child's effective_at to be delivery_ack when the parent's is delivery_ack, and it compares ack_window only if both contracts specify an integer value. Rule 10 requires the child finality object whenever the parent has one, enforces that the child depth is at least the parent's depth, and checks max_target_bits only when the parent's key decodes successfully.\n\nRule 11 requires the child contract to contain at least one witness whose public key string matches each witness key of the parent. If the parent has no witnesses, this rule is skipped and the child may have none. String equality is used for the comparison.\n\nRule 12 requires the child contract to set privacy and ordering to the exact same JSON value as the parent. An ordering object containing `{\"same_height\": null}` counts as a present, non-null value, so the child must match it exactly. The specification does not clarify whether key order in objects affects equality.\n\nJSON equality is semantic dictionary comparison, so key order does not matter. Rule 13 requires the child approval_policy.allow_unscoped to be true only when the parent's is also true; a missing parent value counts as false. Rule 14 compares approvers as sets of canonical bytes, treating absent lists as empty.\n\nCanonical bytes for an approver entry sort its keys and preserve the actions array order. A parent with approvers but a child without them is a violation. If the child has an approvers key that is not well-formed, contract rule 4.1 fails before narrowing begins.\n\nA child contract that fails rule 4.1 on its own is also rejected when supplied with a parent contract, producing both `parent_narrowing_failed` and `contract_not_verified`. The specification revision clarifies that supplying a parent contract does not change the reason codes; a standalone 4.1 failure still yields only `contract_not_verified`.\n\nThe `contract_not_verified` reason is determined solely by the child contract's own 4.1 check. If the child passes 4.1 on its own but fails when supplied with a parent contract, only `parent_narrowing_failed` applies.\n\nThe fourth row of the settlement table is implemented literally: if a parent contract is present and the parent is not an object, fails 4.1, or the child fails 4.1 when supplied with that parent, `parent_narrowing_failed` is added alongside `contract_not_verified`. If no parent is supplied, only `parent_not_supplied` is reported.\n\nThe parent_contract must be an object. Its contract_id must match the parent's contract_id, and a missing or absent value fails narrowing.\n\nIf the child fails 4.1 on its own, the grant subset check is skipped because the settlement table already treats that as a failure with the parent supplied.\n\nThe view floor is derived from the contract.\n\nRule 1 requires grant.finality.max_target_bits to be 8 lowercase hex that decodes to a target. A missing grant or finality field causes chain_view_rejected even if rule 4.1 failed. Rule 2 accepts any integer height, but negative values are rejected by rule 8 because headers have non-negative heights.\n\nHeaders must form a consecutive sequence starting from any non-negative height. The proof current bytes must not exceed 65536 at any step, checked after each operation. Hex operands are limited to 4096 bytes; an empty string is permitted. A proof that exceeds this length is rejected as anchor_proof_invalid, not as a strictness failure.\n\nNon-object proof entries and missing operations are rejected. The baseline proof begins with an append operation rather than hexlify, so the batch leg must accept immediately. The body digest is computed by canonicalizing the record after removing its anchor key, then applying sha256. Canonical key sorting follows Unicode code point order.\n\nWhen the contract is not an object, the output is an underspecified verdict with undetermined status. The bond outcome is n/a because no bond exists. The event set and dispositions are empty.\n\nMultiple underspecified reasons are collected and deduplicated. Deviation codes are sorted and deduplicated. A nonconforming_record deviation is added during 6.6; if the anchor also fails with underspecified, the verdict remains underspecified and this deviation is omitted. Witness signatures require a role of \"witness\" and an exact matching witness_name.\n\nSignature entries are objects with role, sig_b64, and witness_name for witnesses. Missing witness_name or non-object entries are skipped. Verification messages use fixed context prefixes: a2a-execution-v0, a2a-revocation-v0, and a2a-revocation-ack-v0. Contract signing bytes are the prefix plus canonical contract bytes with the signatures key removed entirely. Party key lookup for contract signatures is noted but not detailed.\n\nDomain normalization uses the party's own normalized domain and public key. Multiple parties sharing the same normalized domain violate rule 4.1. The establishes regex uses case-insensitive word boundaries, matching \"paid\" only when not followed by \"for this record\".\n\nThe `does_not_establish` list must contain only strings; non-string elements cause refusal. The `task.purpose` field must be a non-empty string. The `payload_digest` is optional: it may be absent or null, or it may be 64 lowercase hex when present. Schema matching requires an exact match.\n\nInvalid UTF-8 in input files will raise an error. A JSON BOM may cause parsing to fail, which is acceptable. The JSON parser's `parse_int` hook will be used to reject integer tokens longer than 4300 digits; if it raises `ValueError`, the exception is caught and treated as a parse error.\n\n`+Infinity` is rejected by the JSON parser. `1e400` parses as a float and fails rule 11 in contracts; it is not a parse error. Depth is checked before parsing and again via the JSON parser. A depth of exactly 512 is allowed and strict.\n\nDuplicate keys in a JSON object cause the program to exit with code 2 and emit an error JSON containing a short reason string. The text-based depth scan is reserved for hard errors; because the JSON parser already enforces the 512-level limit, the strictness check does not need its own depth guard.\n\nError messages will be short, such as \"duplicate key\", \"invalid json\", and \"integer too long\". The implementation will be a single settle.py file. For step 8 of section 7.6, the batch leg must decode its UTF-8 bytes into a string to locate the sha string's byte offset; offsets are byte-based, not character-based.\n\nThe body digest hex is inserted at the exact byte offset equal to the total prepend bytes length. The 64-character hex string therefore occupies batch[pre_len:pre_len+64], so no character-to-byte mapping is needed.\n\nThe SHA string must begin with a quote and end with a quote immediately after the 64 hex characters. Escaped sequences cannot produce a false positive because the raw bytes at that offset are checked directly.\n\nThe batch-leg splice check requires both the digest hex to sit at the exact prepend offset and the preceding byte to be a JSON quote. A match of the digest elsewhere in the batch would still fail if the splice is not at the sha field.\n\nThe batch-leg splice check requires the 64 hex characters to be wrapped in JSON quotes at the exact prepend offset. If the digest sits there but is not a JSON string, the program refuses with code `internal`.\n\nA custom JSON parser will record each string's byte span. The sha field's raw content will be checked for backslashes to catch escaped values, and its start offset will be compared against the prepend length to detect misplacement.\n\nA recursive descent parser will track byte indices to locate the exact JSON string span for records[i].sha. The batch will be decoded from UTF-8 bytes into a string while preserving a byte offset map, or parsed directly from bytes.\n\nA separate recursive descent parser will locate the SHA string span in the batch without modifying the main JSON parser. It will return each string's byte start and end positions so the splice check can verify exact placement and raw unescaped content.\n\nThe main JSON parser will use the standard library with hooks for depth, duplicate keys, and integer limits. A custom span-aware parser is reserved only for the batch-leg splice check.\n\nThe scanner will walk raw bytes to locate JSON strings matching the digest and confirm they contain no escape sequences. Object key order is irrelevant for logic but required for canonical sorting. The custom float type JFloat preserves standard float string representation.\n\nJFloat string representations are 'inf' and 'nan', so non-finite values need special-case handling. The parser must check for JInt specifically rather than int, because bool is an int but not a JInt. json.loads already rejects leading zeros as parse errors.\n\nA signature that does not decode to 64 bytes is skipped and never triggers the strictness check. The strictness deviation only applies when decoding succeeds but the result is non-canonical; otherwise the signature is unusable under rule 15.\n\nCanonical base64 decoding to exactly 64 bytes is required before checking strictness. Non-canonical signatures are skipped and do not trigger the strictness deviation; rule 4.1 may still refuse them as unusable. A canonical signature with S >= L adds the contract_signature_not_strict reason even if it verifies or does not. Only one reason is recorded per bad signature.\n\nThe `allow_unscoped` flag is truthy only when rule 4.1 passes, so it cannot trigger an unscoped-approvals refusal if the door check fails. Key conflicts are detected by comparing decoded 32-byte public keys across the principal, contractor, and witnesses, plus checking for duplicate witness names; a witness key invalid error is still checked even though it should not occur after rule 4.1. The action-name pattern in rule 4.2 applies to authorized actions, prohibited actions, and conditional actions.\n\nRule 4.1 only requires non-empty strings, so action names like \"Read\" or \"payment!\" pass it but fail rule 4.2. The pattern is a lowercase letter followed by up to 63 of those characters, giving a total length of 1 to 64.\n\nWitness counts are not limited in rule 4.1, so 33 witnesses with valid keys would pass 4.1 yet still trigger the too_many_witnesses refusal in 4.2.\n\nEmpty authorized_actions is not an error; it simply means no actions are explicitly authorized.\n\nProhibited actions are checked before conditional and authorized actions.\n\nA conditional action takes precedence over an authorized action. If an action appears in both lists, it is judged as conditional and requires approval.\n\nIf the delegation field is missing, the allowed set is empty and no deviation is recorded for delegated_to entries.\n\nThe performed_actions field must be present and not a list.\n\nAn absent `performed_actions` field is a conformance problem under rule 6.6, not a strictness error. A strictly signed execution without this field is kept and later flagged as nonconforming. If the contractor signed it, the program charges `nonconforming_record` and continues. In that case, rule 10.3 finds no actions to process.\n\nA null `performed_actions` field is not a list, so it never reaches rule 6.6. The outcomes object must be present and non-null, its keys must match entries in `performed_actions`, and its values must be ok, error, timeout, or partial. Null or absent outcomes are allowed. More than 256 performed actions is a conformance problem.\n\nAny approval whose action name is missing or does not match the pattern causes a conformance problem, even if that approval is unused. If a conformance problem exists and no verifying contractor signature is present, the execution is rejected. A verifying contractor signature is one where the signature over the record signing bytes validates against the contractor's public key. Conformance checks run before the ignore step.\n\nIf both a conformance problem and an ignore condition apply, the execution is rejected. Ignored records are excluded from section 7 and do not trigger anchor_incomplete; their disposition is ignored.\n\nFor orphaned heights, the claimed height is valid because orphaned is the fourth row of table 7.4, so the height check already passed. The block hash is valid hex but does not match the view header at that height. The height is within the observed chain range.\n\nA height is provisional if it exceeds the horizon, which is computed as T minus k plus one. A height at or below the horizon is final.\n\nBaseline executions at heights above the horizon are provisional. Missing evidence such as nenrin_required causes a deviation. The view may start below the checkpoint because the first header's previous hash is not checked. A limit of 200,000 headers will be enforced. input_too_large and event set handling are next.\n\nEmpty event sets are underspecified and status undetermined. Binding is always computed for object contracts. Foreign records map to record_sha256. Inconsistent or unbound records are listed. Not-ours records have no disposition. Duplicate record_sha256 values in events cause the first copy to be kept and subsequent copies to be dropped with duplicate_dropped. The kept copy continues processing, and any later anchor failure applies to it rather than the dropped copies.\n\nA group containing only one record is not collapsed. Groups with multiple records are guaranteed to have distinct record_sha256 values because identical records were already merged in step 6.3.\n\nThe anchors_validly check reuses section 7 proof and batch functions but returns only a boolean without emitting reasons. It requires a verified view, so it runs only after the view passes. It checks that the height exists in the view, the block hash matches, the proof is valid, and the batch leg is valid. It does not enforce the lower bound check from note 7.4.\n\nA record below the checkpoint can still anchor validly for collapse purposes, but section 7 later marks it as anchor_below_lower_bound. During the 6.0 anchor cross-check, a non-strict anchor copy is set aside when a strict copy exists; the kept copy then proceeds to 6.4 for possible collapse. If both copies are strictly anchored, both are kept and 6.4 collapses them. The table ordering places the body-not-strict row before the anchor-not-strict row.\n\nA record that is not strictly signed and whose body is not strict is set aside as record_not_strict without also adding an underspecified reason. The fourth row of the table only applies to strictly signed records. A signature_status helper function will classify signatures as strict, lax, or none.\n\nThe `signature_status` helper extracts the signatures list and schema context. It builds a signing message from the canonical body with signatures and anchor removed. It iterates over signature entries to classify them as strict, lax, or none.\n\nThe helper maps signature roles to public keys: contractor for execution records, witness by name for execution records, principal for revocation records, and contractor for revocation-ack records. Entries with unrecognized roles or missing keys are skipped.\n\nThe helper verifies each signature against its mapped public key. A signature that is both strict and the entry is strict is classified as strict. Otherwise it is classified as lax if any signature verifies, or none otherwise. The specification requires that a signature verify under rule 3.4 alone.\n\nWrong-role entries that verify against any known key will be counted as lax signatures. This matches the specification's requirement that a signature verify under rule 3.4 alone.\n\nA signature is strictly verified only if the entry itself is a strict value. If a signature entry contains non-strict fields, the record is not strictly signed even when the signature verifies, so it falls under the lax row as signature_not_strict.\n\nThe \"lax\" label in the signature status table describes verification that is not strict. A signature that strictly verifies but whose entry contains non-strict fields is itself a strict signature, so it should be classified as strict rather than lax.\n\nStrictly signed requires an allowed role, a signature that strictly verifies, and a strict entry. A signature that strictly verifies but whose entry is not strict is rejected rather than treated as lax.\n\nThe `synth_approval_lax` test vector concerns approval signatures, not record signatures. A strict signature that verifies but carries an incorrect role is rejected rather than treated as lax.\n\nWitness keys must pass the point check in rule 3.2; otherwise verification returns unusable and the record is not strictly signed. The principal key is valid because rule 4.1 already requires a verifying signature from the principal, so the key must be a valid point.\n\nApproval canonical messages include all specified keys, defaulting missing fields to null.\n\nApproval signatures are verified against v2, then v1, then v0. A signature that verifies under any older form is labeled label_bound. If none verify, the approval is forged.\n\nA v2 signature that verifies is classified as counted or other_terms, not label_bound. Older forms are not checked after a successful v2 verification.\n\nApproval fields have strict types: single_use must be a JSON boolean, nonce must be a 32-character lowercase hex string, valid_until_height must be a non-negative integer, and contract_sha256 must be a 64-character lowercase hex string. The height h must be less than or equal to valid_until_height.\n\nEvent set kinds are execution, revocation, or revocation_ack.\n\nEvent set SHA-256 values are record_sha256, computed over the entire record including anchor and signatures. Heights in event sets are anchor heights for accepted records. Accepted records map to disposition \"accepted\". The JSON output uses integers for heights and strings for contract_sha256, with ensure_ascii=False and UTF-8 stdout. The program exits with code 0 or 2 and prints exactly one JSON object.\n\nThe JSON output will use compact separators and include a trailing newline. Field order follows the specification exactly. Deviation codes, reasons, and disposition keys are sorted alphabetically for stability.\n\nEvent sets must list height before sha256. The requirements key is only partially checked: spine and convergence are out of scope, evidence is read later, recovery is ignored, and other keys are skipped. Out-of-scope fields will not cause errors so in-scope tests pass.\n\nNull values for limits and admission are in scope and must not be rejected. An empty limits object is out of scope and should error, though no test expects this. The limits key is allowed by rule 4.1, but rule 10 does not type-check its value.\n\nCarried keys will be checked for out-of-scope values before any output is produced, even if the door check would reject the record. This prevents undefined results when a carried key is out of scope. The risk is that a test vector expecting contract_not_verified might fail if it also carries an out-of-scope key.\n\nThe implementation will error on out-of-scope keys rather than silently ignore them. This is safer because no reference specification exists for those cases, and the test vectors do not appear to expect settlements for records carrying such keys.\n\nA parent carrying an out-of-scope key does not invalidate the child settlement, because narrowing only evaluates the child record. A child carrying a null `requirements.spine` is out of scope and must error, since the specification does not define that result. The 6.2 counting rule for records kept by 6.0 is also being reviewed.\n\nKept records are those that pass triage and survive merging of identical bytes. The 10,000-record cap counts unique kept records; one record duplicated many times counts as a single entry. A single pass is expected for conformance, though a loop will be included to catch any missed interactions. In section 10.1, the revocation SHA-256 must match either the lowercase hex body digest or the record SHA-256 of a copy still present after step 6.4.\n\nCopies set aside during 6.0 are not in the input after 6.4, because they were removed before that step. Only kept copies that survive 6.4 can match the revocation SHA-256. A revocation ignored because revoked_by does not equal the principal survives 6.4 but is excluded from the input before anchors.\n\nIgnored revocations do not revoke anything, so their acknowledgments are irrelevant. The effective height for a delivery acknowledgment is the record height plus the acknowledgment window; this only applies when step 4.2 succeeds. Multiple revocations are sorted by effective height, and execution is revoked if any effective height is less than or equal to the record height. A same-block revocation anchor correctly sets the effective height equal to the record height.\n\nExecution revocation checks include accepted, orphaned, and anchor-failure dispositions. Ignored records are excluded because they apply to revocations. Duplicate drops, set aside records, and rejections from step 6.6 are also excluded. Executions that failed anchors are still checked.\n\nExecutions that are nonconforming but continue are kept by 6.0 and checked in step 11.1.\n\nFor the `walk_not_strict` check, the implementation computes the SHA-256 of a walk even when the walk is not strict. If the SHA-256 cannot be computed, the walk is skipped. A `nenrin_ref` that is not a 64-character hex string or null would fail to match any walk's SHA-256, so the execution would be set aside during 6.0 and excluded from step 11.1.\n\nWalks that fail the strictness check are excluded from the index but their SHA-256 values are still tracked in a set. A walk is considered not strict only under the general definition in section 6.0, first paragraph, and body-specific extra checks do not apply to walks. Non-object records are not treated as walks left out for strictness.\n\nIf an execution cites a non-object, no walk_not_strict deviation is generated. The evidence_names_other_contract deviation only applies when the walk is strict and an object, and its context check fails. A single execution can trigger both walk_not_strict and other deviations; in that case the verdict remains underspecified and step 11.2 is skipped.\n\nA single deviation reason does not empty the event set; the verdict may still be deviation while step 11.2 applies. All reasons are collected in a set. A view_not_strict reason alone does not stop the walk or empty the event set, so the status remains undetermined and the event set is non-empty.\n\nA rejected chain view stops examination and empties the event set. A trailing newline passes rules 1–8 but fails rule 9, so the event set is computed and the verdict remains underspecified. An anchor below the lower bound does not empty the event set; other records may still be present while the reason is added. The specification explicitly states that reasons from steps 4.3, 5.1 rule 9, 6.0, 7.4, or 11 do not empty the event set.\n\nAnchor_incomplete does not empty the event set. The settlement becomes underspecified, but the walk continues over accepted records. The event set is only empty when examination stops early.\n\nThe event set will not be emptied for anchor failures. The walk continues over accepted records, but if any reason leaves the verdict underspecified, deviation codes are left empty.\n\nStep 4.3 does not halt event set computation either. Malformed bonds, parent issues, and non-strict contract signatures still trigger walk execution, but the verdict is underspecified and deviations are hidden. A well-formed bond that is underspecified yields undetermined status.\n\nA record_not_strict reason does not halt event set computation; the bad record is set aside and the verdict becomes underspecified. Anchor_not_strict failures will be treated similarly. Disposition codes match their corresponding reason codes, such as anchor_incomplete or orphaned. The lower_bound for step 7.4 is drawn from the contract when the view passes, and the record height is compared against it. The tip height is the last header height.\n\nA header hash is computed by applying SHA-256 twice and reversing the bytes. The Merkle root occupies bytes 36 through 67 of the raw block. The nBits target decodes from the last four bytes using compact encoding, returning None for invalid or zero values.\n\nRule 7 requires the decoded nBits target to be valid and not exceed the floor, and the header hash number must not exceed that target. Rule 6 requires the reversed bytes 4 through 35 of the raw block to match the previous header hash.\n\nThe provided view is only a partial excerpt, so full baseline testing is not possible without the complete files. I will implement carefully and may add unit tests for individual components. The program must be returned as a single code block. I am also drafting an `is_https_url` helper using `urllib.parse.urlparse` to validate that `key_url` values are valid HTTPS URLs.\n\nThe HTTPS URL helper accepts URLs with credentials in the netloc. Domain labels must contain at least two segments after normalization, each matching the pattern `^[a-z0-9]([a-z0-9-]*[a-z0-9])?$`. This forbids hyphenated first or last characters and empty labels. Underscores are also rejected. The parties array must contain exactly two objects.\n\nEach party must be an object. Roles must contain exactly one principal and one contractor. Public keys are canonical base64-to-32-byte values; point checks are deferred to signature verification. Signatures that fail point checks are refused, even when other signatures for the same party are valid. Contract rule 15 requires every signature object to be an object, and a missing signature field makes the key unusable. A party with at least one verifying signature is accepted, but any bad signature still triggers refusal.\n\nA missing domain on a signature normalizes to a party and triggers refusal. Rule 11 numbers are checked across all values: JFloats, integers outside range, plain integers, and booleans are refused. Rule 12 requires all object keys to be printable ASCII. The code will be structured cleanly.\n\nA `canon_text` helper is being drafted to serialize values into canonical text for hashing. It maps None to 'null', booleans to 'true' or 'false', integers to strings, and floats to 'NaN' or infinity. A `canonical` wrapper will encode that text as UTF-8 bytes. JSON keys are always strings, so mixed-type sorting is not a concern.\n\nThe `canon_text` helper now handles strings, lists, and dictionaries. Lists become comma-separated bracketed text. Dictionaries are sorted by key and rendered as quoted JSON objects. A `canon_string` helper quotes keys for canonical output.\n\nChecking whether Python 3's `repr()` on a `JFloat` subclass returns the bare number or an object-style string, since canonical float output must be exact.\n\nPython 3 subclasses of `int` and `float` inherit the base type's `repr`, so a bare `repr(JFloat(1.5))` returns `'1.5'`. To guarantee exact canonical output, I will call `repr(float(v))` explicitly.\n\nBatch JSON parsing must follow strict JSON rules. Duplicate keys and nesting depth exceeding 512 are parse errors that yield batch_not_json. NaN values are permitted by the parser.\n\nNaN is treated as a parse success, but it fails strictness checks and yields batch_not_json. The parenthetical note that NaN is read as a number indicates the interesting behavior occurs after parsing.\n\nNaN is read as a number during parsing, so it does not trigger a parse error. It will only cause a refusal if it fails later strictness checks or schema validation.\n\nThe batch parser will return batch_not_json for parse failures, non-object values, and non-strict JSON. Schema mismatches yield batch_schema_unknown. A missing records array triggers batch_schema_unknown. A count field that does not equal the record list length triggers batch_count_mismatch.\n\nThe count field must be an integer; a float value causes a mismatch. Only the execution batch schema is typed, so the other schemas are skipped in step 7. The record schema maps to the execution kind.\n\nRevocation and ack records yield record_kind_unknown for typed batches. A present but null schema field causes a mismatch. The SHA must be an exact hex digest string match; non-string values trigger record_not_listed. Escaped characters in the SHA string refuse internal and map to anchor_batch_leg_refused.\n\nThe body digest is 32 bytes. The proof must be non-empty and contain no more than 512 operations. The first sha256 after the leading hexlify ends the batch construction; any operations following it belong to the Merkle path and are excluded from the batch.\n\nProof validation requires both Merkle root reachability and the additional header checks in 7.6 to pass. The height check in 7.4 runs first; if the height is below the lower bound, proof checks are skipped entirely. An anchor is refused as incomplete when the height is missing, negative, or non-integer, or when the block hash is absent, not exactly 64 lowercase hex characters, or contains uppercase letters.\n\nUppercase letters in the anchor block hash trigger a strictness refusal under rule 6.0, so the proof validation in 7.5 is never reached. An absent block hash is treated as strict and only fails later under 7.4.\n\nA helper `is_hex_pairs` will enforce that proof operation hex values are non-empty strings with even length and only lowercase hex characters. Empty strings are permitted. If a hex key is present but its value fails this check, the anchor is refused as not strict.\n\nNon-object entries in the proof list are not proof operations, so they do not trigger the hex-pair check. The anchor is still strict and 7.5 rejects the invalid proof. A missing contract.json file causes an error exit with code 2.\n\nA missing view.json file causes an error exit with code 2. The events directory must contain only files, sorted by name; any unparsable file causes the entire input to fail. If parent.json is present, it must parse successfully. A contract that is a list yields contract_not_verified and a null SHA. For object contracts, the SHA is always computed even if canonical serialization fails. Records containing non-strict floats are set aside.\n\nCanonical output must exactly match the reference signer's spelling of NaN and other floats, or signature verification will fail. A record that is strictly signed but contains a non-strict body is set aside and flagged as record_not_strict.\n\nApproval message objects are canonicalized with keys sorted alphabetically. The v1 schema includes contract_id, payload_digest, and nonce; the v0 schema includes action, contract_id, and payload_digest. Missing or null contract_id and payload_digest fields will be serialized as null in the canonical output.\n\nThe principal key is treated as missing and refused as forged if the parties object is malformed, even though the principal key should normally exist. Forged approvals will also be judged for revoked executions, despite the rule that nothing else in a record is judged.\n\nThe parenthetical in 10.4 is exhaustive, so forged approvals are explicitly judged for revoked executions. Each forged approval adds exactly one deviation code, preventing double-counting. A nonconforming record continues to section 7 and may be accepted before walk judges it.\n\nNonconforming records add both the nonconforming_record and revoked deviation codes when applicable. Delegation checks require string entries, and action comparisons are exact with no case folding. The prohibited list uses exact string matching. During the walk, grant keys are handled defensively since 4.1 already ensures authorized_actions and prohibited_actions exist as lists. Expiry_height is validated as a non-negative integer when present.\n\nThe \"computation repeated\" rule in 6.6 means rejecting nonconforming records, removing them, and re-running checks that could be affected by their absence. It does not require repeating the entire anchor or walk computation.\n\nThe exact order of operations is 6.4, then 6.6, then 7. Collapsed records that are later rejected do not return to the batch, so they cannot trigger further rejections. The \"repeat\" in 6.6 is a reference implementation detail rather than a literal loop over all records. Rule 6.5 ignores position.\n\nThe ignore rule in 6.5 applies during 6.0, before 6.4. A kept revocation is ignored if revoked_by is not the principal. Ignored revocations are excluded from collapse and anchors. They are skipped by 6.6, so conformance problems on them never trigger rejection.\n\nThe ignore rule in 6.5 will be applied after 6.6, not before it. Extra fields on a revocation are checked during 6.6 and cause rejection if they exist. A kept revocation is one that survives both 6.0 and 6.6.\n\nReconsidering the placement of the ignore rule: applying it during 6.0 would prevent a duplicate revocation with a non-principal revoked_by from entering 6.4 groups, so only the valid copy survives collapse. Applying it after 6.4 would let both copies collapse first.\n\nReconsidering the ignore rule placement: since revoked_by is signed, two copies of the same revocation body are identical and collapse into one group regardless of whether the ignore rule applies before or after 6.4. Extra fields in the body change the signing bytes, so they form separate groups; extra fields in signatures do not.\n\nConformance checks only cover top-level fields, so extra signature entries are ignored and do not affect collapse. The ignore rule will be applied after conformance and before anchors. Records that fail closed in 6.0 will receive a disposition. A `record_sha256` helper is being drafted to compute the SHA-256 of the canonical record.\n\nA `body_digest` helper computes the SHA-256 of the canonical body, excluding the anchor key. A `signing_body` helper excludes both anchor and signatures before signing. Canonical output omits whitespace and preserves UTF-8 string encoding. The next step is to verify the establishes regex against the reference Python implementation.\n\nThe `establishes` regex will use case-insensitive matching. The `\\b` word boundary handles Unicode letters correctly, so Japanese strings are not a concern. A `check_dne` helper is being drafted to validate the `does_not_establish` list.\n\nThe `check_dne` helper validates the `does_not_establish` list by requiring at least one string containing \"runtime\" or \"enforce\", one containing \"judge\", \"liability\", or \"fault\", one containing \"deviat\", and one containing \"legal\". Empty strings are permitted in the list but do not match any group.\n\nThe `establishes` list must be a non-empty list of strings, and no string may match the forbidden patterns. The `similar` list must also be a non-empty list of strings with no matches. A list containing only empty strings fails the content check. Duplicate deviation reasons across records are handled by Set semantics. `json.dumps(None)` produces the JSON literal `null`. Standard output uses locale encoding.\n\nOutput will be written directly to `sys.stdout.buffer` as UTF-8 bytes to avoid locale encoding issues. Errors are formatted as `{\"error\": \"...\"}`. The events directory is read as a flat list of files; hidden files or subdirectories are skipped, and any JSON parse failure triggers an error.\n\nThe parent narrowing rule 6 compares requires fields. A missing requires field is treated as null, so a child without requires matches a parent without requires and passes. If the child lacks the key, it fails because null does not equal the parent's requires value. Rule 6 also checks that conditional entries contain the action; if none do, it is a violation.\n\nRule 1 checks exact string equality for list membership. Duplicates in a child's authorized actions are allowed even when the parent contains them.\n\nAn absent data_access field counts as an empty list. A child with no entries is a subset of a parent that has entries, so it passes. A parent with no entries and a child with entries violates rule 3.\n\nIf a child delegation object is absent or null, its allowed list is treated as empty.\n\nA child with a delegation object and allowed entries violates the parent when the parent has no delegation. The max_hops field must be an integer or absent; booleans are rejected. A child may not exceed its parent's max_hops by one or more, so a child with max_hops equal to p is invalid if the parent's is p - 1.\n\nExpiry height may equal the parent's value; only a higher child expiry is invalid. Finality depth must be at least the parent's, so a child with equal depth passes. The child's target bits may not exceed the parent's, and equal targets are allowed. The child's acknowledgment window may not be larger than the parent's, with equal windows permitted.\n\nA child may use an anchor when the parent uses delivery_ack, but not the reverse. If a parent's privacy is null, the rule treats it as unset and imposes no constraint on the child. A null ordering field also leaves the child unconstrained.\n\nThe `allow_unscoped` flag is compared as a boolean string. A child may set it true only when the parent also allows it; otherwise narrowing fails. If both are true, narrowing passes and 4.2 alone rejects the child for unscoped approvals. Witness keys are compared as strings, not raw bytes.\n\nRule 11 requires the child to have at least one witness whose key matches a parent witness key. Because 4.1 already validates that every parent witness key is a string, this condition is automatically satisfied.\n\nIf a parent has no witnesses, the witness rule is skipped. The approver comparison logic extracts the `approvers` list from the parent's `approval_policy`, canonicalizes each entry, and compares them as sets of bytes. The order of approvers does not matter, but the order of actions within each entry does.\n\nA child without an approval_policy has empty approvers, so it violates narrowing when the parent requires specific approvers. Parent contract_id must match exactly as a string. The parent is validated against 4.1 alone; any failure there is recorded as parent_narrowing_failed rather than contract_not_verified. Parent bond and signature checks belong to 4.3, not 4.1.\n\nA parent with a non-strict signature that still verifies passes 4.1, but 4.3 would flag the child's signatures as not strict. The parent's own signature is only rejected if it fails verification entirely.\n\nThe `contract_signature_not_strict` reason applies only to the child's signatures, not the parent's. A missing `finality.max_target_bits` causes `chain_view_rejected`. A zero mantissa in the target bits is rejected by both door and view; door rule 10 fails and view rule 1 fails, producing `contract_not_verified` and `chain_view_rejected`.\n\n`contract_not_verified` is a single reason drawn from any 4.1 failure, so 4.2 reasons are not added. The door function will return a boolean via `door_ok`. A separate `is_out_of_scope` helper checks whether the requirements dictionary contains \"spine\" or \"convergence\".\n\nThe `is_out_of_scope` helper now also returns True when the requirements dictionary contains a non-null admission field, or when the grant dictionary contains limits, or when the approval policy approvers are well formed. The `approvers_well_formed` check requires conditional actions from the grant.\n\nA present but malformed approver list causes the door to refuse and the contract to be in scope. Each approver must contain only the keys name, public_key_ed25519_b64, and actions. The name must be a non-empty string. The public key must be a canonical 32-byte Ed25519 base64 string. Names and keys must be unique across the list. Actions must be a non-empty list of distinct non-empty strings. Every action must match an entry in the conditional policy. If the conditional policy is absent then no action matches.\n\nI will verify that conditional actions are unique as part of 4.1. The approver key uniqueness check uses string inequality, since canonical base64 strings decode to identical bytes. I am now beginning the implementation.\n\nStrict signature checks require point multiplication and inversion on the Ed25519 curve. Affine inversion is expensive, but the workload is small enough for tests. I will use extended coordinates from RFC 8032 for faster projective arithmetic.\n\nI will implement the Ed25519 point multiplication and addition manually using projective coordinates, following RFC 8032's extended twisted Edwards addition formula. No external libraries such as nacl will be used.\n\nI decided against manual projective coordinate arithmetic to avoid bugs. Affine point multiplication is sufficient for correctness and clarity, with optimization deferred if tests prove it necessary. I am also exploring a small-order cofactor check to verify that L·P is the identity element.\n\nI am now implementing projective Edwards addition to avoid inversions during scalar multiplication. The point must be checked for membership in the prime-order subgroup by verifying that L·P is the identity element.\n\nI abandoned the projective Edwards addition formula to avoid errors. I will use a well-tested RFC 8032 scalar multiplication routine instead. The standard library's modular exponentiation is fast enough for correctness.\n\nAffine point multiplication is sufficient for correctness and speed. The strict signature check requires the R point to be a canonical prime-order encoding that is not the identity element. The S value must be less than L, parsed as a 32-byte little-endian integer. The example signatures are standard 64-character base64 strings.\n\nI will add a note about ambiguities after the code block. I confirmed that raising ValueError inside json.loads object_pairs_hook propagates correctly. I am designing a depth scanner that counts brackets outside strings and handles escaped quotes.\n\nUnicode escapes are not structural and do not affect bracket counting. The parser will reject integers longer than 4300 digits, excluding the sign from that count. Scientific notation is treated as a float token rather than an integer.\n\nI confirmed that the custom JSON parser correctly distinguishes tokens: negative integers parse as JInt, scientific notation parses as JFloat, and boolean values are not treated as integers.\n\nFiles are read as UTF-8 and any decoding error is caught as invalid input. A top-level JSON number longer than 4300 digits raises an integer-too-long error. The walk logic treats an empty performed_actions list as a valid deviation-free state, and delegation checks are applied before the within_grant check.\n\nThe `evidence_missing` reason only applies when a required reference is not a 64-character hexadecimal string. A missing walk for an accepted execution does not trigger this error; the cross-check deviation only fires if the walk is present and names another contract. The `nenrin_required` check validates the reference format but does not require the walk to be supplied.\n\nWalks will be indexed by SHA-256. If a walk is found and its contract SHA-256 matches the context, no deviation occurs under 11.1. The absence of the context SHA-256 means this rule does not apply. The three conditions for the deviation are present, non-null, and not equal. I am also considering whether a non-strict walk could share the same SHA-256 as a strict one.\n\nA non-strict walk cannot share the same SHA-256 as a strict walk, since identical bytes imply identical strictness.\n\nWhen dispositions exist but the event set is empty and no reasons are underspecified, the verdict is nothing_to_settle. The status is final if no orphaned records remain above the horizon; otherwise it is provisional. A bond is held if the status is final, or pending_finality if provisional. If all records are foreign, the verdict remains nothing_to_settle provided both 4.1 and view checks pass.\n\nI will reject view headers that are empty or contain gaps. Rule 4 requires non-negative integer heights, so booleans and floats fail. I am adding an `is_int` helper to validate JInt values against optional bounds.\n\nThe view check will accept any JInt for the lower_bound height, even unsafe integers. Contract rule 11 would have already rejected an unsafe height during contract verification. This keeps the two checks independent.\n\nA float height such as 1.5 fails rule 2 and triggers both chain_view_rejected and contract_not_verified. An unsafe integer height passes rule 4 but fails rule 9, so only view_not_strict is added and chain_view_rejected is omitted.\n\nThe view strictness check now covers every string, key, and number in the value. Each header must contain an integer height and a hex string of exactly 160 lowercase characters. A view with uppercase hex or a float value fails this rule.\n\nIf a view is not an object or its headers field is not a list, only chain_view_rejected applies. view_not_strict is not added in those cases. The check_view_strict implementation begins with an isinstance check against dict.\n\nRule 9 requires an integer height but does not mandate non-negative. A negative integer therefore fails rule 4 while still satisfying rule 9, so only chain_view_rejected is added. The additional shape check for header heights is independent of the strictness requirement.\n\nThe view strictness check will be split into two phases: first verify the view is an object with a list of headers, then validate each header's shape and strictness separately. A header containing a control character in any field will fail `is_strict` and trigger `view_not_strict`, even if its height and hex are otherwise valid. The batch position parser still needs to be implemented.\n\nA custom string subclass will carry byte offsets and escape flags. The parser will use json.loads for the value, then re-parse with a custom hook to tag every string with its raw span.\n\nThe custom parser will be limited to batch inputs. It must still enforce rules 2.2: rejecting duplicates, depth limits, NaN, and oversized integers. Main inputs will continue using json.loads to avoid bugs.\n\nThe custom JSON parser will be used for both batch validation and span tracking. It will be trusted after testing, with no redundant cross-check against json.loads.\n\nA simpler way to locate the SHA string in a batch is to check that the 64-character digest hex appears raw between two quotes at the splice point. This avoids building a custom JSON parser for span tracking.\n\nThe raw digest hex must appear at the exact splice point inside records[i].sha. A different string placed at that position would fail the check even if it contains the same digest.\n\nA position-tracking JSON parser is being implemented to locate the exact byte span of `records[i].sha`. This avoids relying on the raw 64-character hex check, which would fail if the string contains escapes. The parser class will track depth and advance through the raw bytes.\n\nThe parser will return SpanStr objects that carry byte offsets and escape flags. It rejects trailing bytes after the top-level value. Whitespace is space, tab, newline, or carriage return. If a record's sha field is not a string, step 6 fails and step 8 is skipped. Step 8 only runs when exactly one matching sha is found.\n\nThe batch will be decoded as UTF-8 first; any failure is treated as invalid JSON. Byte offsets for tracked strings will be computed by encoding the prefix text to UTF-8, which is acceptable for small batches.\n\nThe splice check now uses three distinct codes. An escaped SHA string yields internal refusal. A SHA string whose raw content does not start at the prepend length yields splice_not_at_listing. Otherwise the position is valid. The prepend length equals the decoded byte offset of the inserted digest. When no prepends exist, that offset is zero, so the batch must begin with the raw hex characters rather than a quote.\n\nThe batch bytes for the splice check will be built during the proof walk itself, avoiding a separate reconstruction from the proof operations. The `check_batch_leg` function begins by checking whether any operation is a hexlify step.\n\nThe `check_batch_leg` function now enforces that the first operation is exactly one hexlify step. It encodes the body digest as lowercase ASCII and initializes a bytearray for the reconstructed batch, beginning with the raw digest bytes.\n\nThe proof walk iterates over the remaining operations after the leading hexlify. It rejects non-dictionary entries as malformed. It stops at sha256 to mark the SHA field as found. It decodes hex operands for append and prepend steps and extends the reconstructed batch.\n\nPrepend operands are inserted at the front of the batch bytearray. The walk requires a sha256 step to be present. Hex operand decoding is still guarded against invalid pairs and oversized inputs, though prior validation already ensures these checks pass.\n\nThe prepend length is computed by summing the decoded byte lengths of all prepend steps before the first sha256. Each operation is checked against the 65536-byte limit, and hex operands exceeding 4096 bytes are rejected. A hexlify step on large data can push the batch past the limit.\n\nThe sha256 proof operation is valid starting at 32 bytes. Rule 15 verifies signatures against the contract signing bytes using the party's base64 key, with canonical decoding and point checks. Every party must have at least one signature entry, and all entries for a party must verify. Each signature domain normalizes to exactly one party; if it matches none, the proof is refused. The implementation will also enforce that a party's key is used correctly when its domain matches.\n\nRule 4 requires the two normalized domains to differ; normalization failure for any party causes refusal. The key_url field must be an https:// URL, with the scheme required to start with lowercase https://. The task must be an object. Overlap checks between grant.authorized_actions are also being considered.\n\nAction overlap is checked by intersecting the authorized and prohibited sets; any shared action causes refusal. Empty strings are rejected for actions, but empty strings are allowed for `requires` since the spec only requires a string type. Witness names must be non-empty strings. The `max_hops` integer may be zero.\n\nFinality depth and ack_window must be at least one; zero causes door rejection. Expiry height may be zero. A bond amount is truthy only if it is a non-zero number or a non-empty string, list, or dictionary. NaN is truthy because Python bool(float('nan')) returns True.\n\nA bond is well-formed only when its amount is an integer between 1 and 2^53 - 1. If the key is absent or null, the outcome is n/a. A present but malformed bond yields a malformed reason; if its amount is truthy, the outcome is undetermined, otherwise n/a. A non-object bond such as integer 5 is malformed.\n\nRule 9.3 confirms that a value of one is read as a bond with a truthy amount. Status undetermined overrides the bond outcome only for well-formed or truthy malformed bonds. A well-formed bond with an underspecified status yields undetermined, while an absent bond yields n/a. The pending_finality check runs exclusively in the non-underspecified branch, so it cannot trigger when the status is provisional.\n\nReason codes will be deduplicated and sorted. The event set is empty when the proof walk is skipped, such as during early stops from rules 4.1, 4.2, 5.1, 6.2, or oversized headers; otherwise it may be empty but the walk still executes. Binding dispositions apply universally, including on early stops, while triage dispositions are absent in those cases.\n\nEarly stops from rules 4 and 5 occur before triage. For rule 6.2, set-aside and rejected records receive dispositions, but kept records do not, since none are examined further after the count is taken.\n\nSet-aside and 6.0-rejected records will still receive dispositions even if rule 6.2 triggers, because their reasons are themselves dispositions. The \"never examined\" clause in section 9.2 is being interpreted as applying only to kept records that were never individually triaged.\n\nThe interpretation of section 9.2 is being refined: bound records that were never examined, such as kept records that were not anchor-checked, have no disposition. Records that were set aside were examined and retain their dispositions.\n\nForeign, unbound, and inconsistent records are bound even when sections 4 or 5 fail, so they still receive dispositions. If rule 4.1 stops the computation, those bound records have no disposition because triage is skipped. The event set is empty and the verdict remains underspecified. Rule 6.0's closed failure only applies during triage.\n\nSection 2.3 requires triage to run before checking for problems. This implies triage always executes even when rules 4 or 5 fail, which would retain dispositions that should be removed. The exact ordering is being re-examined.\n\nSection 2.3 requires triage to run before checking the contract and view. This means triage always executes even when rules 4 or 5 fail, which would retain dispositions that should be removed.\n\nThe apparent contradiction between section 2.3 and section 9.2 is being resolved by interpreting \"examined\" as section 7 examination. Triage dispositions would still be assigned even when section 4 fails, but anchor dispositions would not.\n\nSection 6.4 explicitly states that collapse proceeds when view rules 1–8 pass, regardless of section 4 results. This directly contradicts section 2.3’s claim that a section 4 failure stops further examination. The more specific rule 6.4 overrides the general summary paragraph.\n\nA concrete contradiction has emerged. If section 4 fails but the view passes, rule 6.4 still permits collapse and duplicate_dropped dispositions to be assigned. Section 9.2 then states that bound records have no disposition when section 4 failed. This means dispositions would exist even though the specification says they do not.\n\nThe contradiction is being resolved by interpreting section 9.2's \"section 4\" as the stop condition in section 2.3, while rule 6.4 explicitly permits collapse and dispositions even when 4.1 fails. A test vector with a bad principal signature is being considered to verify this behavior.\n\nSection 9.2 is being treated as the normative output specification. It explicitly states that bound records have no disposition when sections 4, 5, or 6.2 fail. This overrides the earlier interpretation that triage always runs before those checks.\n\nThe contradiction between 9.2 and 6.4 is being reconciled by treating duplicate_dropped as a valid disposition even when section 4 fails, since both sections are normative.\n\nSection 9.2's \"never examined\" clause applies only to anchor dispositions, not duplicate_dropped dispositions from rule 6.4. When section 4 fails but the view passes, 6.4 still runs because it operates on records kept by 6.0, so triage must execute for collapse to proceed.\n\nA similar contradiction exists for section 5. If the view fails, rule 6.4 does not run, but triage still executes because section 2.3 requires it before the view check. This would produce set-aside dispositions even though section 9.2 says bound records have no disposition when section 5 fails.\n\nThe author is now weighing a hybrid approach: triage might still run when the view fails, but section 9.2 would then strip all dispositions from those records. They are also reconsidering whether \"examined\" in 9.2 applies only to anchor dispositions, since that section lists record_not_strict and other triage codes alongside binding and anchor codes.\n\nThe implementation order is now fixed. Sections 4 and 5 are checked first. Binding always follows. If section 4, 5, or 6.2 fails, triage is skipped and bound records receive no disposition.\n\nThe phrase \"whether or not section 4 did\" in rule 6.4 is being parsed as meaning that the success of section 4 does not affect whether collapse proceeds. This interpretation would allow duplicate_dropped dispositions even when sections 4.1 or 4.2 fail, directly contradicting the earlier ordering where triage is skipped when those checks fail.\n\nThe author is now considering whether the bad-contract test vector simply contains no events, which would make dispositions empty regardless of the ordering. They will check the vector name to verify this.\n\nThe contract hash excludes signatures, so a bad principal signature does not change the bound record. If triage ran on this record, it might be accepted and included in the event set. Because section 4.1 fails, the walk stops before anchor examination, leaving the event set empty. The summary paragraph in section 2.3 confirms that no record is examined further when section 4.1 fails.\n\nThe phrase \"whether or not section 4 did\" in rule 6.4 is ambiguous, since it does not specify whether 4.2 or 4.3 failures matter. To match the test vectors safely, a failed section 4.1 will produce an empty event set and no bound dispositions.\n\nThe phrase \"whether or not section 4 did\" is now interpreted as unambiguous: a section 4 failure does not prevent rule 6.4 from running when the view passes. This means duplicate_dropped dispositions can be assigned even if sections 4.1 or 4.2 fail.\n\nThe algorithm is finalized. Contract binding and section checks run first. If the view fails or headers are too large, triage is skipped entirely. Otherwise triage proceeds even when sections 4.1 or 4.2 fail. Rule 6.4 then runs whenever the view passes.\n\nThe algorithm is now fully resolved. When the view fails, triage, collapse, anchors, and the event walk are all skipped entirely. When the view passes but sections 4.1 or 4.2 fail, triage and collapse still run via rule 6.4, yet conformance checks, anchors, and the walk are skipped; the event set remains empty because no records are accepted. Only when both the view and sections 4.1 and 4.2 pass does the full examination path execute.\n\nRule 6.2 applies after triage even when section 4.1 fails. If more than 10,000 records are kept, the input_too_large disposition is assigned and collapse is skipped. The event set remains empty because anchors are not run and no records are accepted. For a test vector with no duplicate bodies, expected dispositions would be limited to 6.0 set-asides.\n\nA normal strictly signed record is classified as kept by triage but receives no disposition code. This matches section 9.2, which states that bound records have no disposition when sections 4, 5, or 6.2 fail. The baseline execution would therefore be kept with no disposition and an empty event set.\n\nSection 2.3 requires triage to run before the stop check. Unsigned records therefore receive a disposition even when the contract is bad.\n\nTriage can run before the view check because anchor strictness and signature verification do not require a valid contract. Malformed contracts may lack witness keys, but triage can still classify records based on available parties. A view failure will therefore not skip triage.\n\nThe anchor_not_strict cross-check requires a valid view to determine whether another record anchors validly. If the view fails, that check is skipped and the otherwise row applies, producing an anchor_not_strict reason. This would conflict with section 9.2, which forbids dispositions when sections 4, 5, or 6.2 fail. To resolve this, triage is now skipped entirely when the view fails, ensuring no bound dispositions are assigned.\n\nThe author is now reconsidering the no-disposition rule. If triage runs when section 4 fails, records that are examined and classified receive dispositions such as anchor_not_strict. Section 9.2 explicitly excludes records from having dispositions whenever section 4 fails, which conflicts with the idea that triaged records should still be examined.\n\nThe author is now parsing which failures under \"section 4\" trigger the no-disposition rule. Since 2.3 stops on 4.1 and 4.2, but 9.2 names section 4 generally, a 4.3 failure like bond_malformed would leave the event set non-empty.\n\nThe author now interprets section 9.2's \"section 4\" as referring only to the stopping conditions in 4.1 and 4.2, not to 4.3 failures like bond_malformed. This means triage is skipped entirely when those checks fail, which aligns with the \"unexamined\" bound records clause. The author notes that rule 6.4's wording still contradicts this interpretation for section 4, but will proceed with the primary choice that matches 9.2 and section 2.3.\n\nThe author now interprets rule 6.4's phrase \"whether or not section 4 did\" as meaning that contract term problems (4.3) do not block collapse, while view verification remains the prerequisite for anchors validly. This resolves the earlier contradiction with section 9.2.\n\nThe author will document the ambiguity in implementation notes and report any vector mismatches. Rule 6.2 is evaluated only during triage; if more than 10,000 records are kept, input_too_large is assigned and collapse, anchors, and the walk are skipped.\n\nA 4.2 failure such as unscoped_approvals_refused stops examination entirely, leaving the event set empty and the verdict underspecified. A missing finality policy also halts examination with an underspecified verdict. If the view is not strict but rules 1 through 8 pass, examination continues and a reason is added; the event set may be non-empty, yet deviation codes remain empty and the status is undetermined.\n\nThe specification explicitly lists 4.3, rule 5.1 rule 9, 6.0, 7.4, and 11 as checks that never stop event set computation. This confirms that 4.1 and 4.2 failures halt examination entirely, while triage reasons and contract term issues do not.\n\nAnchor reasons such as anchor_incomplete are not in the list of checks that never stop event set computation, but they also do not empty the event set. The status remains undetermined whenever the verdict is underspecified, even if the event set was computed.\n\nThe implementation will use a standard library and `cryptography` Ed25519 module. Each input file holds one element. Orphaned heights are ignored when the verdict is underspecified.\n\nFiles will be parsed as single JSON values and processed in sorted name order for determinism. Output JSON will use compact separators, fixed field order, and only the eight required fields. The evidence_missing reason is applied after all other deviations are computed; if any underspecified reason exists, the verdict becomes underspecified and deviations are cleared before evidence_missing is evaluated.\n\nThe final verdict ordering is now defined. If the event set is empty, the verdict becomes nothing_to_settle and evidence_missing is skipped. Otherwise the default verdict is within_grant; evidence_missing is then evaluated and may upgrade it to deviation. Step 3 catches walk_not_strict as an underspecified reason before evidence_missing runs. evidence_names_other_contract is a deviation computed during the walk phase before the verdict is finalized.\n\n11.1 runs during the full examination path whenever examined executions exist, even if anchor reasons already make the verdict underspecified. The walk_not_strict reason is collected but discarded from output in that case. It reads kept executions from 6.0 and does not require section 10's walk.\n\nThe implementation will always compute walk_not_strict and nonconforming_record during the full examination path, then filter them from output if the verdict becomes underspecified. A fast path for cached Ed25519 point validation is also planned.\n\nThe author is verifying edge cases for Ed25519 point recovery. Identity points are rejected. Small-order points such as order 2 are rejected because L·P does not equal the identity. Non-canonical y values and sign-bit violations when x equals zero are also rejected.\n\nCanonical JSON encoding will use sorted keys and surrogate pair handling. Lone surrogate characters are permitted in strict strings because they fall outside the forbidden control range.\n\nA `walk_values` helper will traverse contract objects and nested structures for rule 12. Rule 11 rejects booleans, plain floats, and out-of-range integers; only JInt and JFloat are valid numbers. The parser will use a custom `parse_int` hook to ensure nested structures contain JInt values. Duplicate keys will raise a distinct exception so they can be handled separately from other errors.\n\nA ValueError raised by parse_int will propagate through json.loads, since CPython passes the result directly to int() without catching it.\n\nA pre-scan will reject JSON with depth exceeding 512 before parsing to avoid RecursionError. Iterative walks will be used where possible, and the default recursion limit is sufficient for the 512-level contract depth.\n\nThe `limits` key in a grant is out of scope only when it is not null. An `approval_policy` without an `approvers` key is in scope; if `allow_unscoped` is true or absent, the record is valid, but if it is false, a 4.2 reason applies.\n\nWitness counts exceeding 32 and key conflicts both trigger a too_many_witnesses reason under 4.2, which halts examination with an empty event set.\n\nThe grant action name check will be applied only in 4.2, not in door. A compiled regex will be used for validation, and domain strings will be normalized by stripping whitespace and trailing dots.\n\nThe domain normalization function strips whitespace and trailing dots, rejects empty strings, spaces, slashes, at-signs, colons, and labels shorter than two characters, and validates each label against a regex requiring alphanumeric characters and hyphens. Internal tabs are caught by the label pattern because they fall outside the allowed character class.\n\nThe `is_https_url` helper will require a host after `https://`, reject empty hosts or paths starting with `/`, and disallow spaces. A bare `https://` is invalid, while `https://example.com` and `https://example.com/path` are valid.\n\nDoor does not check the host under a domain; that is a finding rather than a refusal. The author is now coding the `establishes` patterns as a list of regexes, covering phrases like performed, delivered, money moved, paid, payment made, contract, binding, guarantee, escrow, custody, solvent, lawful, and fair.\n\nThe `establishes` regex list is completed with `\\bcertified\\b`, and all patterns will be matched with case-insensitive flags. A missing anchor proof triggers `anchor_proof_invalid` under rule 7.5, provided rule 7.4 already passed; an empty proof list also fails 7.5. Orphaned heights do not generate a reason. The finality horizon is then evaluated for valid depths.\n\nThe finality horizon is computed as `T - k + 1` where `k` is the grant depth and `T` is the chain tip. Heights at or below this horizon are final; any accepted or orphaned height above it makes the verdict provisional. Edge cases were verified: a zero horizon still marks the record final, and a negative horizon correctly forces provisional status.\n\nOrphaned records are now included in height checks even when they are the only records, and the nothing_to_settle verdict applies to them. A helper function will safely extract `payload_digest` from the task field, returning None if the task is missing or not a dictionary.\n\nThe binding check treats a null payload_digest as absent, so the check is skipped. When both the contract and reference lack a contract_id, the comparison evaluates to true and the reference is unbound.\n\nThe binding check will use direct equality on the contract_id field. If the reference is not a dictionary, it is treated as an empty object so missing keys return None. When the reference lacks a contract_sha256 and its contract_id does not match the current contract_id, the record is dropped; if the IDs match, it is marked unbound.\n\nThe binding check now handles missing fields explicitly: a missing contract_id on the reference makes the record inconsistent, and a present payload_digest that does not match the current one also yields inconsistency. Non-object records and wrong schemas are skipped before SHA256 computation.\n\nThe valid schemas are `a2a-execution-v0`, `a2a-revocation-v0`, and `a2a-revocation-ack-v0`. Canonical JSON failures will be set aside without disposition. Identical SHA256 hashes encountered during the binding walk will skip classification on the second record. Raw records will be stored for later use. The group key for rule 6.4 is the signing bytes, formed by concatenating the context with the canonical signing body. Anchor validation requires verified view data and will only run after that verification.\n\nA record is a valid anchor copy only if it passes strict signing, body, and anchor checks, plus a revocation policy check for revocations. A revocation without a policy is not kept. The `would_be_kept` helper rejects records that fail any of these three conditions.\n\nThe `would_be_kept` helper now also rejects revocation records when the grant lacks a revocation policy. For anchor-not-strict records that pass strict signing and body checks, the code checks whether any other kept-and-anchors-valid record exists in the same group. If another such record is found, the current record is set aside without a reason; otherwise it receives an anchor-not-strict disposition with a reason.\n\nThe `would_be_kept` helper does not depend on other records, so no circular dependency arises. An absent anchor is treated as strict vacuously, letting rule 7.4 catch incomplete proofs. The body-not-strict check requires a schema-specific decoder. Approval signature validation applies only to execution records. A signature is strict if canonical decoding yields 64 bytes, the R point passes the curve test, and S is below the order L.\n\nNon-canonical base64 signatures are treated as unusable under rule 10.4, producing a forged disposition. Helper functions will validate that `performed_actions` is a list of strings and that `approvals` is a list of objects. The author is now ready to write the implementation file.\n\nThe `crypto_verify` helper rejects public keys that fail the Ed25519 point test before calling the cryptography library, ensuring a strict interpretation of rule 3.2. Signatures must decode to exactly 64 bytes; any other length is unusable.\n\nThe cryptography library's verify() call will not enforce the S < L bound itself; strictness is handled separately. A signature whose R point fails the curve test but still verifies under RFC 8032 will be marked signature_not_strict. Point check results will be cached by public key bytes. The batch parser will use the main JSON parser with duplicate-key hooks, and any duplicate keys in a batch will produce a batch_not_json disposition.\n\nThe author is reconsidering whether a batch containing NaN should be treated as non-strict JSON. The specification's reference to strict JSON parsing and the parenthetical example suggest that NaN may parse successfully, so the batch would only fail if it does not contain an object with a valid schema.\n\nThe batch parser will only require successful strict JSON parsing and a valid schema object. NaN will be read as a number rather than treated as a parse error, so the batch may still fail at a later step or receive a batch_not_json disposition.\n\nThe author now requires strict JSON parsing for the batch in step 4. A non-strict batch, such as one containing NaN, will be refused with a batch_not_json disposition. The informative refusal code is not part of the core output; only the core field matters.\n\nAll batch leg refusals map to the same core disposition and reason, so only the accept or refuse decision matters for conformance. The author is now enumerating the exact boundary cases that must be rejected: missing hexlify, non-leading hexlify, malformed legs, invalid JSON or schema, count mismatches, and SHA256 duplicates or missing entries.\n\nKind mismatches, incorrect splice positions, and SHA values containing escapes are also rejected. Whether a batch with NaN is refused depends on the test vector: if NaN changes the expected output, it causes refusal; otherwise it is accepted.\n\nThe batch is embedded inside a record's anchor proof, not a top-level input file. A NaN in the batch must not abort the settlement; it is handled internally by rule 7.6.\n\nThe author now doubts that a NaN batch must be refused. The specification says NaN parses as a number, so the batch may still be an object with a valid schema. Rejecting it would produce a different core disposition than accepting it, which could change the settlement verdict. The text does not explicitly require rejecting non-strict values.\n\nThe author has decided not to reject batches solely for NaN or non-strict values. The batch will be parsed with 2.2 rules, allowing NaN as a number, and only required to be an object with a known schema. If NaN appears inside the records array and prevents it from being a list of objects, the batch will be refused with batch_schema_unknown; otherwise it may still pass. The NaN test vector exists to ensure implementations do not crash or treat the entire input as a parse error when batch bytes contain NaN.\n\nStep 8 internal refusals will map to the same core reason as other batch leg refusals. A baseline proof without hexlify will be accepted immediately. The author is now writing the implementation carefully, ensuring that parent narrowing handles grants with extra keys correctly.\n\nA canonical JSON equality helper will compare objects by their normalized string representation, preserving key order and correctly distinguishing null from empty objects. The author is also beginning to implement the approver canonicalization for rule 14, extracting the approval policy and its approvers list.\n\nThe approver canonicalization helper returns an empty set when the approvers list is absent or malformed. Because rule 4.1 already validates that a child's approvers field is well-formed, this helper only needs to handle the absent case. Rule 14 narrowing remains necessary when a child passes validation but lacks approvers while its parent has them.\n\nThe door function will return True for well-formed approvers without failing on out-of-scope keys such as spine. Spine is not checked by the door, so a parent contract with spine can pass the door check. Narrowing does not validate spine either.\n\nThe author will exit with code 2 when a child contract contains an out-of-scope field such as spine, since the specification treats this as undefined behavior. In-scope test vectors will be processed normally without error. The admission requirements are unchanged from settle v1.11 to v1.14.\n\nThe author is finalizing the carry rules for optional fields. A present and non-null value is carried, while a null or absent key is not. The spine field is out of scope when its key is present, even if null. A grant.limits entry forces requirements.admission to be out of scope. The implementation will be written as a clean, comment-free program and formatted with json.dumps using indent=2.\n\nThe output will be compact JSON with no extra spaces, a trailing newline, and keys in specification order. Disposition entries will be sorted by SHA256 hex, and deviation codes will be sorted as ASCII strings.\n\nThe author will ensure that underspecified verdicts omit deviation codes even when evidence_missing would otherwise apply. They will avoid type bugs by using is_int checks for height comparisons and converting anchor.height to an integer for event set membership. The JInt wrapper is an int subclass, so json.dumps should handle it correctly.\n\nThe author will explicitly convert JInt values to plain integers before JSON serialization as a safeguard. They also plan to handle the case where the specified vector directory does not exist, and are beginning to draft the main entry point with argument validation.\n\nThe main entry point catches `ParseError` and `JSONDecodeError` to emit short JSON error messages, and it also handles `FileNotFoundError` for missing input. The author is choosing brief reason strings such as \"invalid json\", \"duplicate key\", and \"missing input\" to match the specification's `<short reason>` requirement.\n\nThe author will use simple, clear short reasons for errors. Missing required files and out-of-scope fields are not 2.2 errors, so they will be handled separately from the JSON error output.\n\nThe author will exit with code 2 and an \"out of scope\" error for carried out-of-scope keys, noting this in the implementation notes. They also caught a bug where checking `spine` or `convergence` inside `requirements` without first verifying it is a dictionary could incorrectly match a string value; both `requirements` and `grant` must be checked as dictionaries before key access.\n\nA contract with null requirements is not out of scope because the door does not inspect that field. The batch UTF-8 and JSON parsing will be wrapped in try/except so a single bad batch cannot abort the entire settlement. The proof function returns an internal reason code, but the core output uses fixed reasons only. The author is now drafting the anchor check helper.\n\nThe anchor check helper will return a disposition code and a flag indicating whether to add that same code as an underspecified reason. Accepted and orphaned dispositions carry no reason, while other outcomes do. Orphaned heights will be collected for the settlement status. A `ViewInfo` class will store the height map, tip, floor, and lower bound. Rule 8 requires the header at the lower bound height to match its hash.\n\nView verification will return a boolean, a set of reasons, and an optional viewinfo object. If the view is invalid, it returns None and adds chain_view_rejected. Rule 9 is checked separately to add view_not_strict. A view longer than 200,000 headers triggers input_too_large and stops processing. Multiple headers that fail the same check yield only one chain_view_rejected reason. Non-object items in view.headers cause rule 4 to fail. A hex parsing helper will accept an optional trailing line feed.\n\nThe hex parser accepts a 160-character lowercase hex string with an optional trailing line feed. Rule 9 rejects strings that are not exactly 160 lowercase hex characters or that contain a trailing line feed. The `is_strict` check also catches non-strict strings, though the hex length check is the primary guard. Uppercase hex passes `is_strict` but fails the lowercase hex requirement and rule 4.\n\nThe author is defining `is_json_number_ok` to validate JSON numbers. Booleans are treated as non-numbers and handled separately. Integers must fall within the safe range, while JInt instances are accepted as valid numbers.\n\nThe `is_strict` helper is being implemented with a 512-level recursion limit. It rejects floats, accepts booleans and null, validates integers within the safe range, and rejects strings containing control characters or a delete byte. Lists are checked recursively.\n\nThe `is_strict` helper now validates dictionary keys as ASCII printable strings and recursively checks values. The author notes that contract rule 12 separately checks key validity, distinct from the strictness requirement, and wonders whether contracts must satisfy the full 6.0 strictness standard for strings.\n\nRule 12 only validates dictionary keys, not string values, so contracts may contain newlines in values and still pass the door. The author will walk the contract iteratively to collect numbers and keys for rule 11. Door rule 15 requires party keys to be normalized by domain.\n\nSignature verification will refuse any key that fails the point check, even if the key otherwise passes rule 6. A valid point with an invalid signature also yields refusal. The author decided against adding any self-checks or canonical tests that could alter output on import. They are now examining the `paid` regex and the example establishes.\n\nThe baseline establishes contain no forbidden words, so they should pass the door. The example files are only in the prompt text, not on disk, so the full vector cannot be executed here. The author is re-reading section 10.1 to confirm that the ack body digest is the lowercase hex SHA256 of the canonical record including signatures.\n\nThe author clarified that an acknowledgment can name either the body digest or the full record hash of a surviving copy. Dropped copies are excluded from the naming set. The body digest includes signatures, so copies with different signatures produce different digests and signing bytes.\n\nCopies with different signatures but identical bodies share the same signing bytes, so their body digests differ. An acknowledgment naming a dropped copy's body digest would not match the kept copy's digest and would fail to name the revocation. The author is now determining which hashes to include in each accepted revocation's naming set.\n\nThe naming set for each accepted revocation includes the record SHA256 of every surviving copy that shares its signed body, plus the body digest of that revocation. If no copy anchored validly, all copies survive and all their record SHA256s are included.\n\nThe author confirmed that at most one revocation is accepted per signed body, because section 6.4 drops the other when both anchor validly. They are now considering whether surviving copies that failed anchoring should still contribute to the naming set.\n\nCopies that survive 6.4 but fail anchoring still contribute their record SHA255 to the naming set. The accepted revocation's own body digest is also included. An acknowledgment names a revocation only if its revocation_sha256 exactly matches one of these hashes.\n\nThe author clarified that a missing acknowledgment does not name the revocation. The effective height E is the minimum of the anchor height plus the acknowledgment window and all naming acknowledgment heights; if no acknowledgments name the revocation, E equals the anchor height plus the window. Anchor mode requires no acknowledgment window, while delivery acknowledgments must have a positive integer window. Revocation ordering is irrelevant to the boolean outcome.\n\nThe author noted that sorting revocations is only for display and does not affect the boolean outcome. Execution heights are integers, so the revoked check compares them directly against E. In the prohibited state, no approval check runs and the action is treated as unauthorized.\n\nAll approvals on a record are checked for forgery in section 10.5, independent of the action loop. A forged approval for a prohibited action still adds the forged_approval reason. When an action is prohibited, it ignores any approvals and does not consume their nonces; those nonces may be used by other actions. Nonces are consumed only for conditional actions that are neither revoked nor prohibited.\n\nThe author clarified the event loop order. For each execution, revoked status is checked first and skips all other action checks, though approvals are still classified for forgery without consuming nonces. Non-revoked executions proceed through expiry, then prohibited, conditional, and unauthorized checks in sequence; conditional actions may consume nonces. Expiry does not skip later checks, so an action can be both expired and prohibited.\n\nThe author drafted the action loop logic. Expired actions add `after_expiry`. Prohibited actions add `prohibited` and skip to the next iteration. Conditional actions check approvals and skip to the next iteration. Unauthorized actions add `unauthorized`. Duplicate performed actions are judged individually, but each reason is stored as a single set element.\n\nThe author is now adding the `internal` splice logic with a compact JSON parser for spans. They will write a recursive descent parser to locate batch SHA positions in strings, and mentally test it on `{\"a\":\"bc\"}`. Step 8 requires SHA values to be written without escapes.\n\nThe author is implementing a recursive descent string parser to locate batch SHA positions. It tracks escape flags and checks for backslashes between quotes. Strings containing `\\/` or unicode escapes will be refused.\n\nThe parser will compute byte offsets from UTF-8 encodings. It will be a standalone batch parser that raises on any issue, causing batch refusal. SpanStr is defined only for this batch parser, not the main one.\n\nThe author decided to use `json.loads` for structural checks and a custom scan only for step 8. They will implement a `string_span_at_path` helper that walks the JSON text to return byte offsets and escape flags for a specific path, such as `['records', i, 'sha']`.\n\nThe author is now writing the full program and organizing functions. They will compare record signing bytes exactly when grouping records. They also drafted a `witness_key_b64` helper to look up a witness by name in the contract grant.\n\nThe author added a `party_by_role` helper to look up parties by role in the contract. They also began implementing `classify_signing`, which checks whether a record is strictly signed by looking up its schema context.\n\nThe `classify_signing` function is being implemented. It extracts signatures from the record, checks that a schema context exists, and constructs the canonical signing message by removing signatures and anchor fields. It then iterates over signature entries to verify each one against its matching public key.\n\nThe `classify_signing` function now returns `'strict'` if any signature is both valid and strictly encoded. It returns `'lax'` if a valid signature exists but is not strictly encoded, or if no signature verifies against the known keys.\n\nThe author realized that a strict signature with the wrong role should be rejected as not strictly signed, not classified as lax. They are refining the `classify_signing` logic to handle this case correctly.\n\nThe author finalized the `classify_signing` logic. A record is strictly signed only if an allowed-role signature both verifies and is strictly encoded. It is lax if any signature verifies but is not strictly encoded. The author noted that a strict signature with the wrong role should be rejected as not strictly signed.\n\nThe author is now drafting the `classify_signing` implementation. It will use boolean flags to track whether any signature verifies as strict or lax, then return the appropriate disposition based on the role and encoding checks.\n\nThe `classify_signing` implementation is complete. It returns `'strict'` only when an allowed-role signature both verifies and is strictly encoded. It returns `'lax'` if any signature verifies but is not strictly encoded, or if any signature verifies against any known key while the encoding is non-strict. Otherwise it returns `'none'`.\n\nThe author added a `decode_target_hex` helper to parse an 8-character lowercase hex string into an integer and then decode it as compact bits. They also confirmed that `sig_is_strict_b64` rejects any base64 signature that does not decode to exactly 64 bytes.\n\nThe author clarified that `max_target_bits` is the standard big-endian hex string of the compact bits value, not a little-endian byte sequence. For example, \"17080000\" decodes to an integer and then to compact bits. The header's nBits field occupies bytes 72-76 as little-endian bytes.\n\nThe author verified that the header target must be less than or equal to the floor. They confirmed the example max_target_bits decodes to a positive target. They also noted that Python float repr is safe for canonical signing.\n\nThe author confirmed that `repr` matches `json.dumps` for floats and will use it for canonical signing. They also verified that extra keys in `limits` and `approval_policy` entries are refused, and are now checking conditional entry extra keys.\n\nExtra keys are permitted on conditional entries, witnesses, parties, and signatures. Conditional entries must contain a non-empty string action and an optional requires field. The establishes list is checked to ensure every element is a string.\n\nThe author requires both `establishes` and `does_not_establish` to be non-empty lists containing only strings. They confirmed that Python's default regex engine uses Unicode word boundaries, which matches the reference implementation. They also noted that any value that is not a list should be treated as absent.\n\nThe author is computing SHA256 hashes of canonical non-strict objects to detect walk_not_strict. Non-object nenrin entries are skipped during indexing.\n\nThe author added the execution nenrin_ref lookup. A reference found in non_strict_shas triggers walk_not_strict. A reference found in the strict index is checked for contract_sha256 mismatch against the current contract. Duplicate SHA entries are impossible because identical content cannot be both strict and non-strict.\n\nThe author will keep a separate list of executions that pass 6.0, 6.4, and 6.6 but receive anchor dispositions, for the nenrin check. A `revoked_by` check will run after step 6.6. Allowed extra fields on revocation objects are schema, contract_ref, revoked_by, anchor, and signatures.\n\nThe author defined allowed extra fields for revocation and execution objects. They noted that extra fields on charges trigger rejection. They also specified that outcomes keys must match performed_actions entries, and that approval action patterns apply only to object-style approvals.\n\nThe author is defining strictness checks for approval and performed-action fields. If approvals is present but not a list of objects, the record is not strictly signed. Each approval object must contain a valid action matching the pattern. The performed_actions list must be a list of strings; absence or non-list type triggers a problem. Any list longer than 256 entries also triggers a problem.\n\nThe author drafted a `has_verifying_contractor_sig` helper to check that a charge record contains a contractor signature that actually verifies against the contract's contractor public key. If no contractor signature exists, the record is rejected as not charged.\n\nThe author decided to run a single pass over the records, rejecting any that fail and skipping them on subsequent passes. They will store the canonical signing bytes on each record to avoid recomputing them. A `without` helper will remove keys from dictionaries. Contract signing will strip the `signatures` key before canonicalizing. The `canonical` function does not mutate its input.\n\nThe author is implementing a custom JSON parser to enforce strict canonicalization. It tracks nesting depth and rejects duplicate keys, invalid numbers like `0001`, and `+Infinity`. A custom `InputError` exception will be raised for these cases.\n\nThe custom JSON parser now rejects integers longer than 4300 digits. It also parses NaN, Infinity, and -Infinity as valid JSON constants.\n\nThe custom JSON parser now catches `ValueError` and `JSONDecodeError` to raise `InputError`. It also confirms that `InputError` propagates correctly through `json.loads` because it inherits from `Exception`.\n\nThe custom JSON scanner correctly handles escaped quotes and backslash escapes such as `\\/` without confusing nesting depth. Raw newlines inside strings are invalid JSON and will be rejected. The author is now ready to write the program and will implement Ed25519 point arithmetic carefully, trusting the math while being aware that a bug in the point check could incorrectly reject valid strict signatures.\n\nValid Ed25519 signatures must have R in the prime-order subgroup. A bug in the point check would reject all strict signatures and break tests. The author is now verifying the square-root computation against RFC 8032.\n\nThe author implemented the `recover_x` helper for Ed25519 point recovery using the standard RFC 8032 formula. They confirmed that the square root of -1 modulo p is computed correctly as 2^((p-1)/4) mod p. For subgroup verification, they will multiply a recovered point by the curve order L and check that the result is the identity element.\n\nThe author confirmed that multiplying the identity point by the curve order L yields the identity element. They will verify the point addition implementation against a known test vector to ensure correctness.\n\nThe author identified the standard Ed25519 base point public key encoding. They considered adding a self-test at import time but rejected it to avoid startup delays and potential silent failures.\n\nThe author cannot iterate to verify the code, so they will implement carefully. They noted that the `cryptography` library does not expose point multiplication easily, and the `nacl` package is unavailable. They also considered relying on OpenSSL to reject small-order public keys, but decided against it because the specification requires explicit implementation of these checks.\n\nThe author is weighing whether `cryptography.Ed25519PublicKey.from_public_bytes` can replace custom point validation. It may reject invalid encodings and identity points, but OpenSSL's handling of small-order or mixed-order keys is uncertain. Using it for signature R checks would be risky because OpenSSL might enforce stricter or looser rules than the specification requires.\n\nThe author will implement the Ed25519 point validation math directly from RFC 8032, rejecting reliance on `cryptography` or OpenSSL for signature R checks. They noted that a correct implementation must accept the example public key, since any bug would cause verify to return unusable and break the door and baseline tests.\n\nThe author is now reviewing the RFC 8032 Python code carefully. They will use a double-and-add algorithm for point addition and may switch to projective coordinates for speed. They plan to review their custom point check twice before relying on it. A quick sanity check confirms that the identity point will be rejected.\n\nThe author confirmed that the identity point is `010000...` and that y=0 is not the identity. They will copy the RFC formulas exactly to avoid point-check bugs. The subgroup check will be fast enough for the baseline workload. Caching will be added. The code is ready to be written.\n\nThe author resolved an ambiguity in section 6.6: rejected records will not cause a re-run of the collapse step, since the specification orders collapse before conformance checks. They are also reviewing section 7.6 to clarify whether witness and trace batches skip kind validation, and whether executions can appear in those batches.\n\nWitness and trace batches skip step 7 but still require a SHA-256 hash in step 6. Only the nenrin-agreement-batch-v1 schema is typed, so revocations in typed batches are refused. A non-object record entry causes the entire batch to be rejected as unknown schema. If the count field is null, it does not match the actual record count and triggers a mismatch.\n\nThe author clarified that a batch containing duplicate keys will be refused as `batch_not_json` rather than treated as an input 2.2 error. Only top-level input files may abort settlement via 2.2; batch parsing failures are handled separately.\n\nThe author will place the program inside a single fenced code block, followed by notes. Output field order will match the specification exactly: event_set items use kind, sha256, and height in that sequence. They will not use json.dumps with sort_keys to preserve the required ordering. They also noted a subtle bug in parent rule 6 that needs careful handling.\n\nThe author resolved the subtle bug in parent rule 6. They confirmed that a child action cannot be both prohibited and authorized because section 4.1 forbids overlap. They also verified that a parent conditional action may still be prohibited by the child, and that skipping it is correct.\n\nRule 7 rejects a child conditional action only if it is absent from both the parent's authorized and conditional lists. An action appearing in both lists satisfies rule 7 because it is already in the parent's authorized list, and rule 6 may still apply. The author also added a helper to safely extract conditional entries, defaulting to an empty list when the field is missing or not a list.\n\nThe author is drafting helper functions for list extraction and delegation allowed actions. They are also beginning to implement rule 9, starting with a `revocation_violation` check that inspects the parent grant's revocation field.\n\nThe author is implementing the `revocation_violation` helper. It compares the parent grant's `effective_at` value against the child grant's. If the parent lacks a revocation object, it returns False. If the child lacks a revocation object or its `effective_at` field, it returns True. When the parent uses `anchor`, the child must not use `anchor`. When the parent uses `delivery_ack`, the child may use `anchor` but must use `delivery_ack` with a valid integer `ack_window`.\n\nThe author finalized the `revocation_violation` logic. A child grant without an integer `ack_window` is a violation. When both grants specify `delivery_ack`, the child's window must not exceed the parent's. The author then began implementing Rule 10.\n\nThe author is implementing Rule 10. It checks that a child grant's finality object exists and has an integer depth at least as large as the parent's. It also verifies that max_target_bits is present in the child when the parent specifies it, decoding both values to compare targets.\n\nThe author completed Rule 10 by adding a check that the child's max_target_bits decodes to a target no larger than the parent's. They also began implementing Rule 12, which requires the child grant to set privacy and ordering to the same canonical JSON values as the parent when the parent specifies them.\n\nRule 12 is finalized. A child grant must set `ordering` to the same canonical JSON value as the parent. An explicit `{\"same_height\": null}` counts as set, but omitting the key is a violation.\n\nRule 13 is drafted. It checks that a child grant's `approval_policy.allow_unscoped` is not true when the parent's is false. The author uses strict `is True` comparison rather than truthiness.\n\nThe author is implementing the `parent_contract` check. They realized that a missing `contract_id` in the child's parent contract must fail even if the parent's `contract_id` is also absent, because the specification requires the field to be present.\n\nThe author refined the `parent_contract` validation. A missing `contract_id` in either the child or parent input causes a failure. If the parent is not supplied, the parent contract is ignored and no narrowing error is added. If the parent is supplied but its contract object is null, only the `parent_not_supplied` error applies.\n\nThe author decided to emit only the `parent_not_supplied` error when no parent is provided. They noted that \"parent is not an object\" would also be true for a missing parent, but they will not add both errors.\n\nThe author will use a two-branch structure for parent validation: `parent_not_supplied` when no parent is provided, and `parent_narrowing_failed` otherwise. They will collect `contract_signature_not_strict` regardless of context. Signatures that are not lists will be skipped, and valid signatures must decode to exactly 64 bytes.\n\nThe author is reconsidering the signature decoding requirement. They note that section 4.3 says a signature \"decodes to 64 bytes,\" which might mean any base64-decodable value rather than strictly canonical. If so, non-canonical signatures would still decode to 64 bytes but fail the strictness check, and the implementation must not miss this violation.\n\nThe author decided to decode signatures using standard base64 with validate=True and a 64-byte length check, but without requiring re-encoding to match. Strictness will be verified directly on the decoded bytes.\n\nThe author applied the same signature decoding approach to approval signatures in section 6.0. A signature that decodes to 64 bytes but is not strict will be flagged as non-strict, even if it is non-canonical.\n\nThe author will create two helper functions: `b64_decode` for standard base64 validation and exact length, and `b64_canonical` for strict canonical re-encoding checks. They noted that non-canonical base64 variants, such as those using `+/` instead of `-+`, can still validate with standard decoders.\n\nThe author is analyzing the difference between standard base64 validation and strict canonical re-encoding. They note that Python's `validate=True` rejects non-alphabet characters and incorrect padding, which already catches many non-canonical variants. They are considering whether a separate re-encode check is still needed to catch subtle non-canonical forms.\n\nThe author decided to use a strict re-encode check for section 3.2 canonical validation, but a looser decode check for sections 4.3 and 6.0 where only \"decodes to 64 bytes\" is required.\n\nThe author confirmed that signature R bytes must pass canonical public-key point encoding checks, while signature text canonicalness is handled separately. They also verified that final proof and header merkle roots are exactly 32 bytes. With the design complete, they are proceeding to write the implementation and will import sha256.\n\nThe author will omit debug output. They plan to cache point validity checks to speed up signature verification and keep the point multiplication implementation simple. The code is expected to be 1500–2000 lines. They noted that exercise cases and the input_not_settleable error are not needed for the file interface, but they will still enforce the 10001-record limit and add a view header count limit.\n\nThe author will guard against malformed view inputs. A missing `grant` or `lower_bound` will trigger `chain_view_rejected`. They will avoid defensive exception catching so unexpected bugs surface during development.\n\nThe author decided to add defensive exception handling after all, since a crash would produce a nonzero exit code and no JSON settlement. They will catch any unexpected errors during contract SHA256 computation and treat them as failures. Floats in the contract are handled correctly: canonical JSON succeeds but door rule 11 rejects them. The main `settle` function is being drafted with `reasons` and `deviations` sets.\n\nThe `settle` function is being drafted. It initializes a `dispositions` dictionary and returns an immediate failure if the contract is not a dictionary. It then computes the contract SHA256 from canonical JSON without signatures, prefixed with `a2a-contract-v0`. The contract door is checked next; if it fails, `contract_not_verified` is added to the reasons set. If the door passes, `settleable_terms` is invoked to populate the remaining reasons.\n\nThe `settle` function now invokes `strict_terms` for section 4.3, checks the view with `check_view`, and binds records via `bind_records`. It then defines a `stop_exam` guard that halts execution if the contract door fails, any section 4.2 reason is present, or the view check fails.\n\nThe `settle` function now proceeds through the remaining pipeline. It calls `triage` to filter events and updates the disposition and reason sets. If more than 10,000 events remain, it marks `input_too_large` and returns immediately. It then runs `collapse` on the kept events, followed by `conformance` against the contract.\n\nThe `settle` function now merges conformance deviations into the main set. It calls `ignore_revocations` to filter out revocation records and updates dispositions accordingly. It then prepares for anchor checks by saving execution records before they are processed, since Nenrin validation must run on all executions including those that fail anchors. The loop over kept records begins with `check_anchor`.\n\nThe anchor loop now sorts accepted records into the event set. It then runs the section 10 walk and Nenrin checks, updates deviations, and returns the final settlement verdict. The author also began defining the `FOUR_TWO` reason set.\n\nThe `FOUR_TWO` reason set is now fully defined with eight specific terms. The author clarified that `view_ok` means rules 1–8 passed and the header count is acceptable; too many headers triggers `input_too_large` without also requiring `chain_view_rejected`. Non-strict view data does not halt examination. They began drafting the `finish()` function.\n\nThe `finish()` function now maps the final state to one of four verdicts: `underspecified`, `deviation`, `nothing_to_settle`, or `within_grant`. It returns an empty deviation list for the first two cases and a sorted list for deviations. The author noted that section 11.2 checks must run before the final verdict is finalized.\n\nThe author drafted the 11.2 evidence check inside the examination path before the final verdict. If no reasons exist and evidence is required, it scans accepted executions for a valid 64-character Nenrin reference; otherwise it adds `evidence_missing`. The final verdict is `within_grant` when the event set is non-empty and deviations are empty, or `deviation` when deviations are present.\n\nThe author confirmed that section 11.2 evidence checks only run when no examination reasons exist and either deviations or an event set is present. They also defined the `bond_outcome` and `compute_status` signatures, noting that `compute_status` requires accepted heights, orphaned heights, and horizon for non-undetermined verdicts.\n\nThe author confirmed that early stops always carry a reason, so no orphaned heights are produced. They also noted that section 11.1 can add reasons and deviations, but those deviations are discarded whenever any examination reasons exist.\n\nThe author confirmed that section 11.1 always runs in the full path and can add `walk_not_strict` when applicable. They verified that 4.3, view strictness, and 6.0 reasons are already present before the full path begins, so the pipeline remains sound. They also noted that the anchor strictness cross-check requires a valid view, which is available during the full path. For the `anchors_validly` helper, they will use the same proof and batch checks rather than comparing the lower bound directly.\n\nThe author verified that a record below the lower bound can still pass `anchors_validly` and be kept by section 6.0, then later receive an `anchor_below_lower_bound` disposition during section 7.4.\n\nFor section 6.4, they drafted the collapse logic: within each group, only records that pass `anchors_validly` are kept; those records are sorted by height and SHA256, and the first is retained while the rest are marked `duplicate_dropped`. Groups of size one require no special handling.\n\nThe author confirmed that anchor heights are integers and SHA256 strings sort correctly as lowercase hex. They will cache the SHA256 on each record wrapper to avoid recomputing it. The implementation is now ready to be written.\n\nThe author is adding a `__main__` entry point and a `load_dir` helper to read the contract, view, and event files from a directory. They also noted the need to fix the JSON encoder and ensure valid Python syntax.\n\nThe `load_dir` helper now reads event files from the events subdirectory, Nenrin records from the nenrin subdirectory, and an optional parent.json file. It returns the contract, events, view, Nenrin records, parent data, and a boolean indicating whether the parent was supplied.\n\nThe author verified the Ed25519 order L equals 2^252 plus 27742317777372353535851937790883648493. They also confirmed that missing Nenrin directories yield None, which is handled safely by section 11.1. They will catch UnicodeDecodeError and OSError as InputError.\n\nThe author finalized the Ed25519 curve constants in Python. `L` is defined as `2**252 + 27742317777372353535851937790883648493`. The curve parameter `d` is computed as `(-121665 * pow(121666, p-2, p)) % p`. The square root constant `I` is set to `pow(2, (p-1)//4, p)`. They verified that `p = 2^255 - 19` satisfies `p ≡ 5 (mod 8)`, confirming the exponent for modular square roots. An optional runtime check against the cryptography library will validate that a random valid signature passes.\n\nThe author is verifying the correct point addition formulas for the twisted Edwards curve with a = -1, since Ed25519 uses this form rather than the standard Edwards curve. They are checking against RFC 8032 to ensure the implementation matches the specification.\n\nThe author confirmed the point addition formulas match RFC 8032 section 5.1.4 for the twisted Edwards curve with a = -1. They also began implementing scalar multiplication using binary exponentiation.\n\nThe author verified that the identity point addition formula correctly returns the other point. They confirmed that local reassignment of the parameter P avoids mutating the caller's data. They also noted that `JFloat` subclasses will use standard `math.isnan` and `math.isinf` for consistent handling of special floats.\n\nJFloat NaN handling is verified: it is recognized by math.isnan and canonicalized to 'NaN', and strictness rules already reject all floats so equality issues are irrelevant. The JSON parser will use object_pairs_hook to catch duplicate unicode keys. Contract rule 2 will be enforced with an exact 32-character lowercase hex check, and the nonce field will receive the same validation.\n\nThe author drafted validation checks for the contract parties and task fields. They require exactly two parties, one principal and one contractor, and enforce that both are objects. They also require the task dictionary to exist and contain a non-empty string purpose.\n\nThe author added validation for the optional `payload_digest` field in the task dictionary, requiring it to be a 64-character lowercase hex string when present. They also defined the allowed grant keys and began checking that the grant dictionary contains only those permitted fields.\n\nThe author added validation for `authorized_actions` and `prohibited_actions` in the grant dictionary. Both must be non-empty string lists, and they must not overlap. They also began drafting a `grant_types_ok` helper to enforce typed keys, and started checking the `approval_policy` field when it is present.\n\nThe author completed the `approval_policy` validation logic. It accepts only `allow_unscoped` and `approvers` keys, requires `allow_unscoped` to be a boolean, and delegates approver list checking to a new `approvers_well_formed` helper.\n\nThe `approvers_well_formed` helper now enforces that the approvers list has between one and sixteen entries, each entry is a dictionary containing only `name`, `public_key_ed25519_b64`, and `actions`. It also collects conditional actions from the grant's `conditional` list to validate against those entries.\n\nThe `approvers_well_formed` helper now validates each approver entry. It requires a non-empty string name, a canonical 32-byte Ed25519 base64 public key, and a non-empty actions list with no duplicates. Every action must be a non-empty string present in the grant's conditional actions. Valid entries are collected into separate lists for names and public keys.\n\nThe `approvers_well_formed` helper now checks that no two approvers share the same name or public key. The author noted that conditional actions are only needed to validate approver entries, so the order of these checks is irrelevant because any failure causes the door to fail.\n\nThe author will check out-of-scope status before door checks. If a contract is malformed but approvers are well-formed, the door fails and the result is undefined, so an error is acceptable. They will also reject any input containing a spine field immediately, producing no settlement. The `is_out_of_scope` helper will run at the start; if the contract is not a dictionary, it falls back to `contract_not_verified`.\n\nThe author decided to error on out-of-scope contracts rather than return a failure result. They noted that all test vectors are in-scope by definition, so this path will not be exercised. They also confirmed the settlement body must contain exactly eight fields and will not include extra informative fields. Before writing the code, they want to re-check whether section 6.0 body validation is strict for contract_ref fields.\n\nThe author confirmed that section 6.0 body validation is not strict for `contract_ref` fields. A present but non-64-character lowercase hex value in `contract_sha256` or `payload_digest` causes the body to be rejected as not strict. Null values are also treated as invalid hex.\n\nThe author clarified that a bound record can carry an invalid `payload_digest` if the `nenrin_ref` digest is absent, because binding only validates against the present digest. A non-64 hex `payload_digest` in that case causes the body to be rejected as not strict. They then began drafting validation for the `nenrin_ref` field.\n\nThe author confirmed the `nenrin_ref` validation correctly rejects non-64 lowercase hex values when the field is present. They also noted that anchor strictness applies to the full record, not the body, and that performed actions should be checked on the body without signatures or anchor. They began drafting approval signature validation.\n\nThe author drafted the approval signature validation for the `a2a-execution-v0` schema. It iterates over each approval entry and checks both `sig_b64` and `signature` fields. Each value is base64-decoded to 64 bytes, and if decoding succeeds but the resulting bytes are not strict, the body is rejected as not strict. They also began defining a `sig_bytes_strict` helper.\n\nThe `sig_bytes_strict` helper now enforces 64-byte signatures, checks that the scalar S is below the curve order L, and validates that the public key point R is canonical and non-identity. This same strictness rule will be applied to contract signatures in section 4.3. The author is ready to write the full source and plans to use projective scalar multiplication for speed while keeping correctness.\n\nThe author chose the RFC affine version for correctness first. A baseline of about 100 milliseconds is acceptable, but vectors with many approvals could take several seconds. Projective coordinates will be implemented as a faster fallback if evaluation becomes too slow.\n\nThe author estimated that 20 Ed25519 point checks would take roughly one second, confirming the affine approach is fast enough. They decided against raising the recursion limit and finalized the `emit` function to write compact JSON directly to stdout.\n\nThe `emit` function now appends a newline and exits with the given code. Disposition keys, event sets, deviation codes, and reasons are sorted to ensure deterministic JSON output. Multiple dispositions for the same key overwrite each other, with the last one winning.\n\nThe author will enforce exactly one disposition per SHA-256. Binding and triage operate on separate record sets, so they never overlap. Duplicate records sharing the same SHA are skipped, keeping only the first. Records that fail canonicalization, non-dictionary events, or wrong schemas are set aside without a disposition. The author is now ready to write the complete implementation.\n\nThe author will add a nested batch position parser. They plan to implement a `locate_sha_span` helper that uses a span-tracking JSON parser to locate the exact text span of a matching SHA-256 digest. If the parser fails on valid JSON, the batch will be refused as malformed.\n\nThe author is writing a custom `SpanParser` class to locate exact text spans for SHA-256 digests in batch vectors. The baseline test vector does not exercise this step, so the parser must be correct for synthetic batches.\n\nThe `SpanParser` class is being implemented with a recursive `val()` method. It handles objects, arrays, strings, booleans, and null values. The author noted that NaN could be mistaken for null because both start with 'n'.\n\nThe `SpanParser` now distinguishes `null` from `NaN` and handles `Infinity` and negative infinity. It also enforces a 512-level depth limit on nested objects.\n\nThe `SpanParser` now parses object keys. It skips whitespace, expects a quoted string, and checks for a colon.\n\nThe `SpanParser` now handles object values, duplicate keys, and commas. It will also parse arrays and strings. The author noted that `SpanStr` must work as a dictionary key.\n\nThe author decided to subclass `str` for `SpanStr`, storing a `start_byte` attribute so the parser can later extract exact text spans. This also ensures that `SpanStr` objects work correctly as dictionary keys and in duplicate checks.\n\nThe author realized that UTF-8 multibyte characters would make character indices incompatible with raw byte offsets. To fix this, `SpanStr` will store an `escaped` flag and compute its byte offset by encoding the prefix up to `start_char` as UTF-8. This ensures the span maps directly to the original batch bytes.\n\nThe author confirmed that valid UTF-8 roundtripping preserves bytes. They verified that `start_byte` points to the first content character, not the quote mark. To keep step 8 parsing lightweight, they will use `json.loads` for schema and count checks, and only use the custom span parser for locating exact text spans.\n\nThe author decided to use the custom span parser for both locating SHA spans and parsing the full batch structure, rather than using json.loads for steps 4-7. This avoids divergence between the two paths. The parser will return float('nan') for NaN tokens, which the schema check can then process normally. Numbers without fractions or exponents will be parsed as integers, while larger values become floats or infinity.\n\nThe span parser is the riskiest part of the implementation, but it is still being written carefully. It will accept standard JSON whitespace and handle empty arrays and nested structures.\n\nThe author confirmed the validation pipeline order: 7.4, then 7.5, then 7.6. They verified that 7.5 rejects invalid operations before 7.6 runs, so all ops are well-formed when hexlify rules are checked. A proof with a hexlify operation can pass 7.5 yet still fail 7.6 if the hexlify rule is violated.\n\nThe author noted that a proof reaching the merkle root with extra bytes equal by chance is acceptable. They also compiled a list of implementation ambiguities to resolve, including whether collapse runs when earlier steps fail, how parent_not_supplied interacts with parent_narrowing_failed, and the correct error path for out-of-scope inputs.\n\nThe author confirmed that forged_approval still applies to revoked executions. They also re-examined the batch NaN vector: the specification clarifies that NaN is read as a number, not as a parse error that aborts settlement. The actual outcome of that vector determines whether the batch is refused.\n\nThe author will add an `is_strict` check on the parsed batch object. If the batch fails strict JSON validation, it will be refused.\n\nThe author decided to refuse non-strict batches. NaN causes a settlement with anchor_batch_leg_refused rather than an abort. The specification's emphasis on strict JSON and the v1.16 theme of rejecting non-strict data supports this approach.\n\nThe author clarified that \"strict JSON\" in the specification refers to section 2.2, not section 6.0. The parenthetical note about NaN is meant to explain a 2.2 parsing behavior, so the document's emphasis on strictness still supports refusing batches containing NaN.\n\nThe author reversed their earlier decision. They now interpret \"strict JSON\" as requiring only a successful parse under section 2.2, which accepts NaN as a number. Batches containing NaN will not be extra-rejected for strictness violations; they will only be refused if other schema or count checks fail. This is the more literal reading of the citation.\n\nThe author confirmed that a batch with NaN in an extra field will be accepted as a valid leg if the SHA checks pass. They also clarified that step 4 produces either `batch_not_json` or `batch_schema_unknown`, and that UTF-8 decode failures on raw batch bytes will be refused as `batch_not_json`.\n\nThe author is now writing the implementation, aiming to keep it under 2000 lines. They will add an `is_lower_hex` helper and compile regex patterns for action names and forbidden words once. The forbidden-word pattern uses a negative lookahead to exclude \"paid for this record\" while allowing \"paid for the record\".\n\nThe author verified that the forbidden-word regexes correctly match intended phrases and reject others. They will import `math` for NaN checks and `cryptography` at the top of the file.\n\nThe author is implementing the Ed25519 signature verification layer. A `crypto_verify` helper catches `InvalidSignature` and `ValueError` from `from_public_bytes` to return a boolean. The top-level `verify` function canonicalizes base64 inputs, rejects unusable keys, checks the public key point, and delegates to `crypto_verify`.\n\nThe author clarified that signature point checks are not part of the \"unusable\" path. Only key and signature length or canonicalization failures trigger that outcome. The R point check belongs to strictness validation instead.\n\nThe author clarified that strict signature validation requires the R point to pass public-key checks, S to be below the curve order L, and the signature to strictly verify. Step 4.3 only needs to decode the signature to 64 bytes and fail strictness if R is invalid or S is not below L; it does not require verification. A signature with a valid R point but an S below L is still a strict encoding even if it fails verification. The author will also implement a `b64_decode_any` helper that accepts non-canonical base64 for step 4.3 decoding.\n\n`b64_decode_any` validates base64 and length, while `b64_canonical` additionally checks that the bytes re-encode to the exact same string. Both helpers will be used for contract door rule 6 and witness keys in rule 10.\n\nThe author noticed a discrepancy between the contract door rules: parties require canonical base64 decoding, while witnesses only require 32 bytes. To be safe and consistent with section 3.2, they will require canonical base64 for both parties and witnesses.\n\nWitness keys will be decoded with `b64_decode_any` to 32 bytes, while party keys and approvers will use `b64_canonical`. The `key_conflict` check will compare decoded bytes from whichever decoder was used for acceptance. Non-canonical witness keys are unusable under section 3.2.\n\nThe author is now writing the program. They will cache `point_ok` results in a dictionary and pre-reject points where the high bit makes y >= p before calling recover_point.\n\nThe author is writing the `compute_status` function. It returns 'undetermined' for 'underspecified' verdicts. They also verified that null bonds on non-object contracts and orphaned records above the horizon map to 'provisional'.\n\nThe author finalized the `compute_status` logic: it returns 'final' when no heights exist or all accepted and orphaned heights are at or below the horizon, and 'provisional' otherwise. The horizon is derived from the contract's finality depth as `viewinfo.tip - k + 1`. They also noted that accepted records should store their height. With these details settled, they are ready to write the implementation.\n\nThe author is now writing the implementation in a single careful pass. They noted that approval messages require the principal key in base64 for signature verification, and that canonical encoding must handle JSON integers, booleans, and strings correctly. They also began drafting helper functions `contract_id_of` and `payload_of` to extract fields from the contract object.\n\nThe author completed the `payload_of` helper to extract the `payload_digest` from a task dictionary. They noted that v0 canonical objects always contain the three required keys.\n\nThey also confirmed that a missing `sig_b64` field causes verification to return unusable, which maps to a forged outcome.\n\nThe author began drafting an `approval_fields_ok` helper to validate approval fields: `valid_until_height` must be a non-negative integer, `nonce` must be a 32-character lowercase hex string, and `single_use` must be a boolean.\n\nThe `approval_fields_ok` helper now also validates `contract_sha256` as a 64-character lowercase hex string when `need_csha` is true. The author began drafting `classify_approval`, which returns 'forged' for non-dict or missing-key approvals, then starts building the v2 approval message prefix and canonical payload.\n\nThe `classify_approval` function now completes the v2 approval path. It canonicalizes the action, valid_until_height, nonce, and single_use fields into a byte prefix, verifies the signature against the principal key, and returns 'counted' if the contract SHA matches or 'other_terms' otherwise. It then falls through to the v1 approval path, which canonicalizes the contract_id and payload_digest.\n\nThe v1 approval path canonicalizes the action, valid_until_height, nonce, and single_use fields into a byte prefix and returns 'label_bound' if signature verification succeeds. The v0 approval path then canonicalizes the contract_id, payload_digest, and action fields and performs signature verification.\n\nThe author confirmed that a missing action field in v2 approvals is valid; canonicalization handles it as null, and the signature will not verify unless signed with that exact payload. They also began drafting the counted-approval use logic.\n\nThe `approval_matches` helper enforces four conditions: the action must match, the record SHA must match or the approval height must be strictly below the target, the current height must not exceed the approval's validity window, and single-use nonces must not repeat. An approval counts only if it targets the same record or a strictly lower one; equal heights on different records are rejected. The first matching approval in event set order is selected.\n\nThe author will precompute counted approvals while walking the event set. All accepted executions, including revoked ones, must have their approvals classified. Forged approvals on revoked records will be recorded as deviations.\n\nCounted approvals on revoked executions remain available for later use but are not consumed by the revoked record's actions. The counted list is ordered by event set and approval list order, and the first match in that sequence is selected while skipping consumed nonces. Only approvals from accepted executions are included; orphaned execution approvals are excluded. The nenrin check uses a separate set that includes non-accepted executions.\n\nThe author confirmed that an empty or absent approvals list is handled safely. They noted that single-use nonces are consumed globally and shared across all approvals. They also raised a question about what happens when two separate single-use approvals share the same nonce.\n\nOnly single-use approvals consume their nonce; non-single-use approvals remain usable after a shared nonce is consumed. The author now considers the full implementation picture complete.\n\nThe author will raise `InputError('out of scope')` with exit code 2 for inputs outside core v0 scope. This avoids claiming conformance to a broader specification. They noted that test harnesses expecting reference outputs beyond core v0 may fail, but the user's constraints are clear.\n\nThe author confirmed that the listed limit and admission null vectors remain in scope. They verified that a parent execution carrying approvers while its child drops them correctly triggers `parent_narrowing_failed` rather than `contract_not_verified`. They also ensured that parents with approvers do not incorrectly trigger the out-of-scope check.\n\nThe author confirmed the child contract door only validates the child contract. They verified that the parent door must accept rich contracts carrying full fields such as bond and establishes, and that baseline contracts should pass. They also checked that the does_not_establish strings contain the required words runtime and enforce.\n\nThe author verified that the baseline contract door passes by checking forbidden word lists and establishes fields. They noted that proof construction uses append, prepend, and sha256 operations without hex encoding, and that proofs must end at the Merkle root.\n\nCanonical correctness is critical because a wrong digest or encoding would cause the proof to fail and return underspecified instead of within_grant or deviation. The author will write a custom encoder rather than use Python's json.dumps, since that library adds spaces and escapes unicode by default.\n\nThe author verified the custom canonical encoder handles Unicode escapes correctly. Keys sort in code-point order. U+0000 becomes `\\u0000`, U+0008 becomes `\\b`, and U+007F is written as itself. The solidus is not escaped.\n\nRecord signing bytes are the canonical body with signatures and anchor removed. Contract canonical excludes only signatures, keeping other keys sorted. The author is now writing the program and noted a potential bug in nesting counters with multi-byte UTF-8.\n\nThe author confirmed that structural brackets are counted as single code points, not inside multi-byte sequences. They verified that integer parsing receives the full token and that empty documents are rejected by json.loads. They also noted that point checks on keys and signatures from sections 3.2 and 3.4 must be implemented. Finally, they checked that mixed-order rejection works correctly when L*P equals the identity in the subgroup.\n\nThe author verified that the base point L is not identity. They checked that L modulo 8 equals 5, so for any small-order point P, L·P is non-zero and will be rejected.\n\nThe author plans to add a sanity check using the RFC 8032 test vector public key. They will decompress it and verify that L·P equals the identity point, ensuring the Ed25519 point arithmetic is correct.\n\nThe author will compute L·P at the first point_ok call for the RFC 8032 test vector. They cannot fix math errors at runtime, so they will implement carefully and rely on a remembered extended-coordinate decode snippet from a reference Ed25519 implementation.\n\nThe author refined the Ed25519 point-decompression formula. They replaced the `x² ≡ u/v` check with `v·x² ≡ u` to avoid division-by-zero when `v` is zero. They also noted that if `v` is zero, the modular inverse of zero would be invalid.\n\nThe author confirmed that `pow(0, P-2, P)` evaluates to 0 in Python, so the decompression check correctly rejects points where `v` is zero. They also noticed that when `x` is zero and the sign bit is set, the fallback `x = P - x` must be reduced modulo `P` to avoid returning an invalid point.\n\nThe author realized that rejecting the non-canonical zero encoding after the sign-flip would fail, because `P - 0` equals `P`, which is still non-zero and would pass the check. The rejection must happen before the flip instead.\n\nThe author finalized the Ed25519 point-decompression logic by reducing `x` modulo `P` before rejecting non-canonical zero encodings. They also verified that header hashes are big-endian integers and that Bitcoin-style little-endian byte reversal applies to the previous block hash.\n\nThe author will implement a single pass for conformance checks, since each record is independent and no repeated passes are required. They also plan to add a disposition for anchor failures using the record SHA. A wrapper class named `R` is being drafted.\n\nThe `R` wrapper class will use `__slots__` to store raw bytes, SHA, signing bytes, schema, and height. Height will be read from the anchor. Signing bytes will be precomputed only for bound records; foreign records keep only their SHA and disposition. The bind function will return a list of bound `R` objects plus a dispositions dictionary. Triage will consume that bound list. Python dictionaries preserve insertion order, so no `OrderedDict` import is needed. Everything will live in a single file.\n\nThe author re-read section 6.4 and confirmed that conformance is complete once rules 1 through 8 pass, even if section 4 did not. They considered whether vectors with both a section 4.1 failure and duplicate anchored copies might expect `duplicate_dropped` dispositions, but concluded that existing test vectors likely lack such duplicate bodies.\n\nThe author is weighing a strict reading of section 9.2 against the triage logic in section 6.4. If a contract fails section 4 but an event passes conformance, triage would assign dispositions to set-aside and duplicate records, yet section 9.2 says bound records have no disposition when section 4 failed. They are considering whether a test vector with a bad contract and an unsigned event would expect no disposition at all, or a rejection such as rejected or record_not_strict.\n\nThe author decided to follow interpretation A. If section 4 or 5 fails, no triage runs and bound records receive no disposition. This matches the real test vector where a bad contract leaves the signed event unanchored. The author noted that synthetic vectors combining contract failure with unsigned records are not explicitly listed.\n\nThe author will explicitly document in the notes that section 6.4 permits collapsing duplicate copies even when section 4 fails, provided the view passes. They noted this is a potentially risky assumption if an evaluation vector contradicts it.\n\nThe author realized that section 9.2 likely means records were never reached by any classification step, not that every bound record lacks a disposition when section 4 fails. Records classified by 6.0 or 6.4 still receive dispositions.\n\nThe author now interprets section 9.2 as describing the reference implementation's actual output. When the contract door fails, the settle function likely returns early before record processing begins, leaving dispositions only for binding classes.\n\nThe author now interprets section 6.4 as specifically exempting parent and bond checks (4.3) from blocking duplicate collapse, not all of section 4. Section 2.3 confirms that only 4.1 and 4.2 halt examination.\n\nThe author settled on a concrete triage rule: if view rules 1–8 pass, duplicate collapse proceeds even when section 4.1 or 4.2 fails, but conformance, anchors, and walk are skipped in that case. Dispositions from 6.0 and 6.4 still apply, while kept records that never reach anchors receive no disposition.\n\nThe author found a direct contradiction between section 2.3 and section 6.4: 2.3 says collapse is skipped when 4.1 fails, but 6.4 explicitly permits it. They are weighing which to follow.\n\nThe author resolved the conflict between sections 2.3 and 6.4 by treating 6.4 as the overriding rule. When the view passes but section 4 fails, triage and duplicate collapse still proceed, while conformance, anchors, and walk are skipped.\n\nThe author noted that a bad contract paired with only good records produces no dispositions under both interpretations, so the 6.4 exemption is only relevant for bad records and duplicates. They chose to follow 6.4 explicitly to avoid generating extra dispositions if the reference returns early when the door fails.\n\nRe-reading section 2.3 reveals that triage occurs before the contract and view checks. The \"no record examined further\" clause therefore applies only when a problem is found in those later checks, not when triage itself fails. This resolves the apparent contradiction with section 6.4.\n\nThe author finalized the algorithm: bind records unconditionally, then triage only if view rules 1–8 pass and header count is acceptable. If the view fails or there are too many headers, no triage runs and bound records receive no disposition.\n\nThe author is reconsidering whether triage should run when the view fails. If it does, every record would be unanchored because `anchors_validly` is false for an unverified view, which aligns with section 9.2's claim that records have no disposition when section 5 failed.\n\nThe author now interprets section 9.2 as overriding the triage order in section 2.3: when the view fails, no triage runs and records receive no disposition. This creates a conflict with section 6.4, which requires triage results to collapse even when section 4 fails but the view passes.\n\nThe author resolved the conflict by accepting that section 9.2 applies only when a record is never reached because sections 4, 5, or 6.2 failed. Because triage still runs under section 6.4 even when 4.1 fails, set-aside records are examined and receive dispositions. The author will note this inconsistency.\n\nThe author reconciled the apparent contradiction by deciding to always run triage first, even when sections 4, 5, or 6.2 fail. Records examined by triage retain their dispositions from that step. Kept records receive no disposition only because they were never reached by later steps; this matches section 9.2's claim that records were not fully examined. Set-aside records keep their triage dispositions.\n\nThe author confirmed that triage must always run, even when the view check fails. If the view is unverified, non-strict anchors fail closed and add disposition reasons, because section 2.3 requires every problem found so far to be collected without stopping other checks.\n\nThe author confirmed that when the view fails, every record is treated as not anchoring validly because the view never verifies headers. This causes the anchor_not_strict cross-check to fail closed and add that disposition reason, even if the view failure and anchor failure occur in the same vector.\n\nThe author is reconsidering the definition of \"the view holds\" in section 6.4. They suspect it means the raw view object contains the height, not that verification succeeded. If so, triage could run before the view check and still evaluate anchors against an unverified view, which would be incorrect.\n\nThe author finalized the algorithm. They will compute SHA, section 4, and section 5 in parallel. Records are bound unconditionally. Triage runs unconditionally, but anchors_validly is only true when view rules 1–8 pass. Duplicate collapse proceeds whenever the view is verified, even if section 4 fails. Conformance, anchors, walk, and nenrin are skipped unless the view passes and both sections 4.1 and 4.2 succeed.\n\nThe author added the kept-record limit from section 6.2: if triage leaves more than 10,000 kept records, the event set is empty and the verdict is underspecified.\n\nThey also mapped the exact failure paths. When section 4.1 fails, the event set is empty, the verdict is underspecified, and the status is undetermined. When the view check fails, the event set is empty, the reason is chain_view_rejected, and any record_not_strict reasons from triage may still appear.\n\nThe author confirmed that adding record_not_strict when the view fails is consistent with section 2.3, since triage still runs and collects problems. They also verified that section 6.2 applies whenever triage completes, even if section 4.1 fails afterward.\n\nConformance checks are restricted to the full execution path. If section 4.1 fails, nonconforming strictly signed records are kept without a disposition rather than rejected. Nonconforming deviations are omitted when 6.6 is skipped. The author is now ready to code and noted that classify_signing handles missing party keys.\n\nMalformed grants yield None witness keys. A revocation set aside for missing revocation data still receives a disposition even when the contract door check fails, because triage runs before that check.\n\nThe author will code this version and add `view_not_strict` independently. They also decided that when the view holds more than 200,000 headers, triage is skipped entirely and records are not examined further, even though binding still occurs.\n\nThe author will add a `parent_supplied` flag to distinguish an explicitly null parent from one that was never supplied. They are now ready to write the full implementation.\n\nThe author refined the parent contract handling. A `null` or non-object value in `parent.json` yields `parent_narrowing_failed`, not `parent_not_supplied`. The code checks whether the file exists, then validates the parsed value as a dictionary and passes it through the door and narrowing checks.\n\nThe author confirmed that kept records from a failed section 4.1 receive no disposition, while dropped records get duplicate_dropped and are excluded from anchor checks. The full execution path will later overwrite any kept record with an anchor disposition. The program will be written in a structured, readable style.\n\nThe author realized the `anchor_not_strict` cross-check requires computing signing bytes for all bound records first. They will group those records by signing bytes and then resolve the cross-check rows before assigning final dispositions. If canonical serialization fails, the record cannot be grouped; since SHA computation already succeeded, this is treated as not strictly signed.\n\nThe author confirmed that canonical serialization of the body is valid. Records with an invalid schema context are not bound. Signature entries containing control characters or extra non-strict fields fail strictness checks and are treated as not strictly signed.\n\nThe author confirmed that a signature entry can be strict while the underlying signature is not; if the library rejects the non-strict signature, the record is rejected rather than lax. They also finalized the hex encoding details: lowercase ASCII output from `bytes.hex()`, decoding via `bytes.fromhex()`, and a 4096-byte maximum limit.\n\nThe author added proof validation rules. Each operation must be a dictionary with a valid 'op' key and type, and the proof list must be a list. Both `check_proof` and `check_batch` will return booleans. The `anchors_validly` helper checks that the anchor is a dictionary, its height is an integer, and it matches the view.\n\nThe `anchors_validly` helper now verifies the anchor block hash against the view header and checks the proof and batch. Section 7 will reuse these same helpers in the same order. An orphaned record is defined as one whose height exists in the view but whose hash does not match.\n\nThe author will store the lower bound height on the viewinfo object once the view is verified. Duplicate records in the event set are handled by binding only the first occurrence. Files will be sorted by name and non-file entries skipped. Encoding errors will also be caught.\n\nError messages will be short and stable. Out-of-scope contracts will return an \"out of scope\" error, but the program will not emit core fields for them since the specification leaves that behavior undefined. A helper function to iteratively deep-check numbers in the contract for rule 11 is also being added.\n\nThe `contract_numbers_ok` helper performs an iterative deep scan of the contract. It rejects floats, enforces integer bounds, and validates that all dictionary keys are printable ASCII strings.\n\nThe author decided to separate rule 11 and rule 12 into distinct checks. Rule 12 requires dictionary keys to be printable ASCII strings, allowing spaces but rejecting non-string keys. Empty keys are permitted since they contain no forbidden characters. The author is now ready to write the implementation file.\n\nThe author confirmed that JSON output will use lowercase booleans and SHA-256 digests. They decided to keep Ed25519 point checks in affine coordinates and cache `point_ok` results for repeated signatures.\n\nThe author drafted an `is_int` helper that rejects booleans and non-JSON integer tokens, enforcing a 53-bit safe integer bound. They noted that because booleans are subclasses of integers, the boolean check must precede the type check to avoid misclassification.\n\nThe author introduced a `json_int` helper that returns the integer value for a `JInt` or `None` otherwise. Plain integers are treated as valid JSON integers too, in case of constructed values. Canonical serialization checks that values are integers and not booleans, so `JInt` instances satisfy this requirement.\n\nCanonical serialization will accept both `JInt` and plain `int` values. The author is now composing the full source file. They also added a guard to door rule 15 so that a signature key failing the point check cannot be used as a verifying key, since `verify` already returns unusable for such cases. Signature objects must be dictionaries with a normalizable domain, and each entry in the contract's signatures list is validated accordingly.\n\nThe signature verification loop checks each entry against its domain and public key. A single bad signature immediately fails the check, and duplicate roles are deduplicated. Rule 16 is satisfied only when both principal and contractor signatures are present. Signing bytes are computed once per record.\n\nThe author decided that door rule 15 will not fail on non-strict signatures. If the cryptography library rejects a signature as non-strict, door still passes and section 4.3 adds the `contract_signature_not_strict` reason. Both reasons may appear together. Section 4.3 runs independently of door success. A new `check_sig_strictness` helper will validate all signatures for strictness.\n\nThe `check_sig_strictness` helper will decode each signature and reject non-strict bytes. Bond and parent checks will be added to `strict_terms`. The implementation is estimated at 1200–1600 lines, written compactly but clearly. A regex using `re.search` will validate the `establishes` field as a list.\n\nThe author settled on a case-insensitive regex with a negative lookahead to detect the word \"paid\" without matching \"paid for this record\". They will use `re.IGNORECASE` and skip `re.ASCII`. For `does_not_establish`, they will perform lowercase substring checks against the lowercased text. They also clarified that each term must be hit by at least one string, not by concatenating all strings together.\n\nThe author will require `establishes` elements to be strings, failing door if any element is not a string. They are now writing the program and will use compact JSON separators with sorted dispositions. A `KIND` mapping and `CTX` constants for the three contract types are being added.\n\nALLOWED_FIELDS sets will be added to restrict valid fields in contracts. The author confirmed that InputError propagates correctly through Python's JSON parser hooks, since it inherits from Exception and the C extension calls parse_int from Python code.\n\nA depth pre-check will reject contracts deeper than 512 before `json.loads` runs, preventing `RecursionError`.\n\nThe recursion limit will be raised to 10000 before parsing to safely handle the maximum allowed depth of 512.\n\nA manual depth counter will scan the raw JSON string character by character. It tracks nested braces and brackets while skipping escaped backslashes inside quoted strings. This avoids Python's recursion limit when rejecting contracts deeper than 512.\n\nThe author confirmed that an escaped backslash at the end of a quoted string is safely handled by the manual depth counter. They re-checked rule 10.1: the body digest is computed from the canonical contract without the anchor block, while the record SHA-256 covers the full canonical contract, and revocation acknowledgments compare against these lowercase hex values. They also clarified that \"still in the input after 6.4\" refers to entries remaining in the kept list after collapse.\n\nThe author will map each signing byte to the SHA-256 hashes of surviving copies after collapse. Only accepted revocations are considered for rule E, and their signing bytes point to the surviving record SHAs.\n\nThe accepted revocation record's body digest is the specific value to compare against. Other copies of that same revocation may carry different signatures and thus different body digests. A copy is defined as any record sharing the same signing bytes, with signatures excluded.\n\nThe author will compute effective height E as the anchor height h in anchor mode. For delivery acknowledgments, E is the minimum of the anchor height plus the acknowledgment window and any accepted acknowledgment heights that name the revocation. A candidate acknowledgment names the revocation if its name set contains the revocation SHA-256.\n\nThe author will separate accepted records by kind. An execution is revoked if any revocation has effective height at or before the anchor height. For each revoked execution, every string in performed_actions is added to the revoked set. If performed_actions is missing, no strings are added.\n\nThe author added an `after_expiry` check that skips the rule when the grant's `expiry_height` is absent or null. They also began defining the prohibited set, authorized set, and conditional map from action to entry.\n\nEvidence checks will apply only to accepted executions. A new `is_64hex` helper validates 64-character lowercase hex strings. The `nenrin_ref` field is indexed only when it is a non-empty list; absent, null, or non-list values are skipped. Execution kept by rule 6.0 and surviving after collapse and rejection by rule 6.6 are the candidates for rule 11.1.\n\nThe author will snapshot the kept execution list immediately after collapse and conformance, before any revocation filtering. Each execution is unique by SHA-256 after deduplication, so strictness checks apply once per record. Executions with invalid or non-strict nenrin_ref values are already excluded from this list, so walk_not_strict only needs to match against valid 64-character hex references.\n\nDeviations from rule 11.1 will be emitted as codes, while strictness walk reasons are collected separately. The verdict logic for rule 11.2 is being added next. A `bond_outcome` helper will compute the final bond result, returning 'n/a' when the bond field is missing or malformed.\n\nThe `bond_outcome` helper is now fully implemented. It returns 'undetermined' for an underspecified verdict, 'pending_finality' for a provisional status, 'forfeited' for a deviation verdict, and 'held' otherwise. If the bond amount is present but invalid, it returns 'undetermined'; otherwise it returns 'n/a'.\n\nThe author verified that malformed bonds trigger an underspecified verdict and an undetermined outcome, while well-formed bonds with other reasons still yield a held outcome. They confirmed that missing bond amounts evaluate as falsy. The implementation is now complete and ready for source code generation.\n\nThe `finish` function will enforce that deviation codes are empty whenever reasons exist. The event set will be a sorted list of accepted records, keyed by height and SHA-256, with each entry carrying kind, sha256, and height. Disposition keys will also be sorted. All disposition codes will match the specification exactly, with no extras added. Orphaned heights will be stored as integers.\n\nStatus is undetermined whenever reasons exist, even if the view is verified and the full path is complete. Without reasons, status is provisional only after computing the horizon from the tip height and finality depth. The author is now ready to write the complete Python program.\n\nA `batch_leg_ok` helper is being added to validate batch operations. It checks that the operations list contains exactly one `hexlify` operation and that it appears as the first element.\n\nThe `batch_leg_ok` helper now constructs the batch by encoding the body digest hex into a bytearray. It scans the remaining operations for a `sha256` step, rejecting any operation that is not a dictionary or uses an unsupported name. Hex values must be valid lowercase strings of even length.\n\nThe `batch_leg_ok` helper now rejects any raw hex longer than 4096 bytes. It builds the batch by prepending or appending raw bytes, then decodes the combined bytearray as UTF-8. It passes this text to a new `parse_batch` function that returns the parsed object and the SHA span.\n\nThe parser will return the object with SpanStr markers. The batch validator will locate the record whose SHA matches the body digest hex, then check that its SpanStr start_byte equals the pre_len and that it is not escaped.\n\nThe author confirmed that escaped SpanStr values must be refused because the raw text would not contain the 64 hex characters. A non-escaped value at the correct offset with a matching digest is valid. They began implementing a robust span parser with a number method to handle signed integers.\n\nThe span parser now handles floating-point numbers with optional exponents. It returns floats or integers, rejecting any integer longer than 4300 digits.\n\nThe span parser now includes a `string` method that handles escaped characters. It computes the byte offset from the start of the string using UTF-8 encoding and returns a `SpanStr` object tracking the value, its start byte, and whether it was escaped.\n\nThe span parser now handles common escape sequences such as backslash, quote, slash, and control characters. It also supports Unicode escapes by converting four hexadecimal digits into a single character.\n\nThe span parser now rejects control characters and unterminated strings. It enforces duplicate keys, depth limits above 512, and trailing whitespace after parsing. Because this parser is used only for batch JSON, it must accept standard JSON syntax including numbers like `0.5`, `-0`, and `10`.\n\nThe author confirmed that `-0` parses as integer 0 and `0e0` as float. Literal matching for `true`, `false`, `null`, `NaN`, `Infinity`, and `-Infinity` will be exact to avoid prefix collisions. They are now adding a schema check after parsing, starting with the `BATCH_SCHEMAS` dictionary.\n\nThe `BATCH_SCHEMAS` dictionary now lists the three allowed batch types: `nenrin-agreement-batch-v1`, `nenrin-witness-batch-v1`, and `nenrin-trace-pin-batch-v0`. A `KIND_FOR` map will restrict typed batches to `a2a-execution-v0` as execution records; revocation and ack entries are refused. Each record must carry a unique SHA-256, a valid kind, and a matching schema field.\n\nThe record schema will be passed into `batch_leg_ok` rather than read from the batch itself. The validator will enforce exact lowercase SHA-256 equality against the digest hex, rejecting uppercase matches as unlisted records. The author is now drafting the complete Python program and adding imports, a main argument guard, and inline review checks.\n\nThe script will require exactly one command-line argument. For Ed25519 point validation, the author is weighing a faster double-and-add implementation using projective coordinates against the current affine approach, since 50 ms per vector could total roughly 50 seconds for 100 vectors.\n\nThe author chose a simple projective Edwards addition for Ed25519 point validation. They noted that RFC 8032's slow version is correct and that C-accelerated `pow` can handle scalar multiplication in roughly 10 ms per signature, totaling about 100 ms for ten signatures.\n\nAffine coordinates were chosen for Ed25519 point validation. The author estimated that 100 vectors with five signatures each would take about five seconds, which is acceptable.\n\nThe code will be organized into eleven sections: imports and constants, JSON parsing, canonical encoding, base64 and Ed25519 utilities, contract door checks, view logic, record processing, anchors and batch validation, walk and nenrin logic, settle orchestration, and the main entry point.\n\nA subtle ordering issue was noted: narrowing should only run after both doors pass, even though individual grants may satisfy door 4.1.\n\nThe grant subset function will remain defensive despite assuming types. When a child door fails, the parent narrowing reason is added immediately if the parent contract is supplied, without invoking grant subset. This captures the case where the child fails 4.1 even with a parent present.\n\nThe author clarified that when a child door fails and a parent contract is supplied, both `parent_narrowing_failed` and `contract_not_verified` are added. The specification only forbids adding `contract_not_verified` during the parent narrowing check itself; the child door failure still contributes that reason.\n\nIf a parent contract is set but not supplied, only `parent_not_supplied` is added. The parent narrowing check is skipped entirely when the parent is missing, so `parent_narrowing_failed` is never produced in that case.\n\nThe door check will remain independent of parent validation. A `sha256_hex` helper will be added. The program will skip warning filters. Header counts will be verified before hashing to avoid unnecessary work.\n\nThe author decided to verify all headers before checking the 200,000 limit. If the view fails verification, only `chain_view_rejected` is returned even for a massive header set. The `check_view` function will return a tuple of `(verified, too_large, reasons, viewinfo)`, and `view_not_strict` will be added directly inside it. The final code is now being produced.\n\nCanonical encoding must match the reference exactly. The author verified that Python's `str(int('-0'))` produces `0`, which is correct because `-0` is not negative and canonical form forbids leading zeros.\n\nFloat canonicalization will use `repr(float(v))` to match Python 3's JSON float output. This preserves the original exponent form for large numbers and strips trailing zeros from decimal floats.\n\nThe author is now drafting the `settle` orchestration function. They will add `walk_not_strict` and evidence logic directly into the code. Dispositions for triage set-aside will use record SHA-256 values, which remain unique after binding. Records dropped as not ours will be excluded from disposition.\n\nForeign, inconsistent, and unbound records will receive dispositions. Each record belongs to exactly one binding class. The binding loop skips non-dictionary events, validates schema presence, computes canonical SHA-256 digests, discards duplicates, and reads contract references.\n\nThe binding loop now classifies each record and routes it to the bound list or a disposition map. Records that fail classification are dropped. Undigestable records are set aside with `record_not_strict` but receive no disposition.\n\nThe author confirmed that undigestable records are set aside with `record_not_strict` but receive no disposition. The underspecified reason is not added to the settlement because it lacks a SHA-256 digest; only an informative count is recorded. Strictly signed records with valid SHAs still receive the reason. The code will be written as one complete block.\n\nThe author will add section-reference comments to keep the code organized. `make_rec` will compute signing bytes by concatenating the schema prefix with the canonical body digest, then return a `Rec` object. Anchor cross-checks will group records by those signing bytes. A dedicated `Rec` class was chosen over a dict wrapper for clarity.\n\nThe `Rec` class stores the raw event, its SHA-256 digest, signing bytes, and schema. A `rec_height` helper extracts the height from the anchor field using `is_int`. The author is now writing the complete program and will review critical sections as they go.\n\nThe author is drafting the `carried_out_of_scope` helper to detect out-of-scope contracts. It checks requirements for spine, convergence, or admission fields, and inspects the grant dictionary. A null limits value will not be treated as out of scope.\n\nThe `carried_out_of_scope` helper now checks the grant dictionary for a non-null `limits` field or a well-formed `approval_policy.approvers`. A well-formed approver set marks the contract out of scope, and the door will fail even if other checks are invalid. The author noted that this result is undefined by the specification.\n\nThe author is now writing the code. They will add a `FOUR_TWO` stop set. A contract that fails door 4.2 will still be triaged, but it will not anchor or walk, leaving the event set empty and using the 4.2 reason as the underspecified reason. They are also checking whether a strictly signed record with a non-strict body should receive both `record_not_strict` and the 4.2 reason.\n\nThe author confirmed that `record_not_strict` can appear alongside a 4.2 reason because triage problems are collected before the door check. They also verified that section 6.0's rule to avoid emptying the event set does not apply here, since anchoring is skipped when a 4.2 problem exists.\n\nThe author resolved the conflict between 2.3 and 6.4 by following 6.4: collapse will run whenever the view is verified, even if doors 4.1 or 4.2 fail, unless stopped by 6.2. Conformance checks and anchors are deferred to the final step, but only when no earlier stop condition applies.\n\nThe author decided to run the 11th check only on the full path. It requires executions left after 6.4 and 6.6, so it is skipped when an earlier stop condition halts the computation. This avoids adding `walk_not_strict` during early exits.\n\nThe author finalized the settlement verdict logic. A full path with no reasons yields a verdict from deviations and the event set. If reasons exist, the settlement is underspecified and deviations are hidden. The 4.3 check runs before the full path begins. A view_not_strict reason does not block the full path. The four_two_hit flag is computed after door 4.2. If door_ok is false, four_two remains empty and the full path is skipped.\n\nThe ignore step will run only on the full path, before anchors. When the event set is empty after a full walk, the verdict will be nothing_to_settle if no reasons or deviations exist.\n\nThe author clarified that the ignore step is part of triage and runs unconditionally, not only on the full path. A kept revocation with a non-principal revoked_by is ignored and excluded from collapse and anchors.\n\nThe ignore step will run during triage, before conformance checks. A kept revocation with a non-principal revoked_by is ignored and excluded from anchors, so it never reaches 6.6. This matches the specification ordering where 6.5 precedes 6.6.\n\nThe author confirmed that a kept revocation with an extra field and a principal revoked_by is rejected by 6.6 with disposition rejected. The ignore step applies only to records that would otherwise be kept, so ignored records never reach collapse or check 11. Conformance rejections will run on the post-collapse kept list during the full path.\n\nThe author will add an `input_too_large` reason and skip the full path and collapse when a record exceeds size limits. They also clarified that the kept count is computed after the ignore step, since ignored records are excluded from the kept set.\n\nThe author resolved the 10000-record limit by counting records kept by the triage table before the ignore step, not after. This ensures ignored records are excluded from the count.\n\nThe author will count records kept by the triage table before splitting out ignored ones, and assign dispositions for set-aside and rejected records during triage while keeping kept records undispensed.\n\nAnchor_not_strict failures will be handled fail-closed with both a disposition and a reason. When a good copy exists, only the disposition is assigned and no reason is added. A record that will be ignored is still counted as kept by the triage table because ignore runs after the table.\n\nThe author noted a rare edge case where a table-kept revocation anchors validly but is later ignored. In that scenario, the good copy is removed from the kept set while the bad copy is set aside, leaving neither in the event set. This follows the specification text and is treated as an odd but acceptable outcome.","reasoning_details":[{"type":"reasoning.summary","summary":"I will implement `settle.py` based solely on the MUSUBI settle core v0 specification.\n\nThe implementation will read inputs from a vector directory and output JSON with eight core fields or an error. It requires strict JSON parsing with duplicate key detection and depth limits, canonical JSON formatting, and Ed25519 validation ensuring points lie on the curve, are not the identity, and have prime order.\n\nThe implementation will cover contract verification, view verification, record triage, binding, conformance, anchors, grant evaluation, NENRIN checks, and verdict generation. JSON parsing must reject duplicate keys, nesting deeper than 512 levels, NaN, Infinity, negative Infinity, and integers longer than 4300 digits.\n\nI will use Python's `json` module with `object_pairs_hook` to detect duplicate keys and `parse_constant` to accept exactly `NaN`, `Infinity`, and `-Infinity`. Large number tokens exceeding the double range will be read as infinity. I also need to enforce that integer tokens contain no fraction or exponent.\n\nI need a custom JSON decoder to distinguish integer tokens from float tokens. Python's standard parser converts both 1.0 and 1e2 into floats, which would violate the strictness rules requiring every number to be an integer within ±(2^53-1). The decoder must preserve the original token form so I can enforce that no number is non-integer and apply canonical formatting only to non-integer values.\n\nI will use `json.JSONDecoder` with `parse_int` and `parse_float` hooks to tag each number as an integer or float during parsing. This preserves the original token form so I can enforce the 4300-digit limit and strict integer rules. The tagged structure will be unwrapped afterward for normal processing.\n\nI am weighing a custom number class approach to preserve original token spelling for canonical JSON output. The specification requires non-integer values to be formatted as Python's json module writes them, including NaN, Infinity, -Infinity, and finite floats like 1.5 or 1e+16.\n\nI clarified the canonical JSON formatting rules. Non-finite numbers must be written as `NaN`, `Infinity`, or `-Infinity`. Finite floats should use Python's `repr` format, such as `1e+16` or `1.0`.\n\nI realized that `isinstance(True, int)` returns True in Python, so a simple `int` subclass cannot distinguish booleans from integers. I will use a custom `JInt` class instead to track integer tokens cleanly.\n\nI will use `JInt` and `JFloat` subclasses to distinguish integer tokens from booleans and floats. For canonical JSON, finite floats will be formatted with `repr`, while non-finite values use the exact strings `NaN`, `Infinity`, or `-Infinity`. I also need a pre-parse scan of the raw text to count nesting depth, since the 512-level limit applies to brackets and braces outside of strings.\n\nI am writing a raw-text scanner that counts nesting depth while tracking string boundaries and escape sequences. This will enforce the 512-level limit before parsing begins. I also need to scan for integer tokens longer than 4300 digits.\n\nI realized Python's standard `json.loads` accepts `NaN`, `Infinity`, and `-Infinity` by default as valid JSON extensions. To enforce the strict parse error requirement, I must explicitly configure `parse_constant` to reject any non-standard number tokens.\n\nI will implement `parse_constant` to explicitly return `JFloat` instances for `NaN`, `Infinity`, and `-Infinity`, ensuring they are tagged as floats rather than defaulting to plain Python floats. I also drafted the `object_pairs_hook` logic that raises a `ValueError` upon detecting duplicate keys.\n\nI am now working out the canonical JSON encoding rules. Objects must have keys sorted by Unicode code point with no whitespace, and arrays must also be whitespace-free. Strings require escaping of quotes, backslashes, and control characters U+0000 through U+001F, plus special escapes for b, f, n, r, and t. I am checking how Python's `json.dumps` handles these edge cases to ensure the output matches the specification exactly.\n\nI will write a custom canonical encoder instead of relying on Python's `json.dumps`. Integers must be plain decimal with no leading zeros. I also need to handle lone surrogate code points by encoding them as `\\udxxx` sequences, since Python's JSON parser preserves them in strings.\n\nI confirmed that Python's JSON decoder preserves surrogate pairs as separate code units rather than combining them into a single character. I am now determining whether valid surrogate pairs should be written back as `\\udxxx` sequences during canonical encoding, or if only lone surrogates require that escape.\n\nValid surrogate pairs will be encoded as their combined Unicode character rather than as separate `\\udxxx` escapes. Only lone surrogate code units must be written as `\\udxxx`.\n\nI will implement base64 with padding and canonical decoding, where re-encoding yields the same text. Public keys are 32 bytes and signatures are 64 bytes. A public key is unusable if it does not decode to a valid Edwards25519 point, is the identity point, or lies outside the prime-order subgroup.\n\nEdwards25519 points are encoded as 32 little-endian bytes with the y-coordinate in the first 255 bits and the x-sign bit in the top byte. A 255-bit y-coordinate must be strictly less than p (2^255 - 19) to be canonical. The identity point is encoded as 0x01 followed by 31 zero bytes. A valid point must have prime order L, meaning its order divides L.\n\nI will verify that a decoded point is in the prime-order subgroup by multiplying it by the group order L and checking that the result is the identity. The identity point itself must be rejected separately.\n\nI am now implementing the Edwards25519 arithmetic. I have defined the curve constants p, d, L, and I. I am writing a point decompression routine that reads the 32-byte little-endian encoding, extracts the y-coordinate and x-sign bit, and rejects any y-coordinate greater than or equal to p.\n\nI completed the Edwards25519 point decompression routine. It computes x² from y² using the curve equation, resolves the x-coordinate with modular square roots and the imaginary unit I, and enforces that the recovered x matches the sign bit in the top byte.\n\nI defined the Edwards25519 point addition formulas for affine coordinates. Scalar multiplication by L will use double-and-add, requiring roughly 252 doublings.\n\nSignature strictness requires the first 32 bytes to be a canonical Edwards25519 point in the prime-order subgroup, and the last 32 bytes to be a little-endian scalar strictly less than L. The R component is validated exactly like a public key. I will use the cryptography library's Ed25519PublicKey class for signature verification.\n\nI will perform the custom Edwards25519 point checks before calling the cryptography library's verify method. This ensures that non-canonical keys are rejected as unusable according to section 3.2, rather than letting the library raise an exception.\n\nStrict verification requires both a strict signature and a successful verification. The contract door treats false and unusable as equivalent refusals, so only the contract_not_verified code is needed. Rule 6 accepts a public key that decodes to 32 bytes, but rule 15 rejects it during signature verification if the point fails validation. The SHA-256 hash of the contract is now being considered.\n\nThe signing bytes are the prefix `b\"a2a-contract-v0\\n\"` concatenated with the canonical JSON of the contract excluding its `signatures` key. The SHA-256 hash is lowercased hex. If the contract is not an object, the hash is null and the only refusal code is `contract_not_verified`. If `events` is not a list, the code is `input_not_settleable`, but the file interface guarantees that `events` will always be a list.\n\nThe file interface reads contract.json, view.json, and optional parent.json. The events/ directory holds one element per file; a missing directory yields an empty list. The optional nenrin/ directory behaves the same way. Every file is UTF-8 text. Event order is ignored for settlement but binding walks them in given order and skips duplicate record_sha256 values.\n\nThe output JSON object must list its fields in the exact order specified by the specification: contract_sha256, verdict, status, bond_outcome, deviation_codes, underspecified_reasons, event_set, and dispositions. The dispositions mapping is an object, so its key order affects canonical JSON encoding.\n\nI will sort disposition keys by sha256 for stable JSON output. Lists that represent sets will be sorted. I cannot match the reference's exact key order without it, so I will rely on standard JSON separators and the specified field order.\n\nI am reconsidering whether to sort disposition keys. The reference implementation likely preserves insertion order, so matching it exactly is risky.\n\nI will use compact JSON with keys in the specification order. Disposition keys will be sorted by record SHA-256 for determinism. I cannot match the reference's exact key order without it, so I will rely on standard JSON formatting.\n\nI will use compact JSON with sorted disposition keys and the eight specified fields, ending with a newline. I am now reviewing the contract door rules: schema must be \"a2a-contract-v0\", contract_id and nonce must each be 32 lowercase hex characters, and parties must contain exactly two objects with distinct roles of principal and contractor.\n\nI am continuing to review the contract door rules. The remaining checks cover domain normalization, key_url as an HTTPS URL, canonical base64 public keys, task objects with a non-empty purpose and optional payload_digest, grant objects restricted to allowed keys, authorized and prohibited actions as non-empty strings with no overlap, typed grant keys when present, integer bounds, printable ASCII keys, and establishes and does_not_establish regex validation.\n\nThe contract door requires each party to have at least one verifying signature. If the contract is an object but its canonical form cannot be computed, the SHA-256 hash must still be produced even if the door ultimately rejects the contract. Keys outside the core specification, such as spine, convergence, approvers, limits, or admission, are out of scope and would disqualify any implementation from claiming core v0 conformance.\n\nThe interface distinguishes between success output and 2.2 errors, which print an error and exit with code 2. Out-of-scope keys are not treated as 2.2 errors; they disqualify the implementation from core v0 conformance instead.\n\nTest vectors may carry keys such as synth_limits_null or synth_admission_null that trigger a 4.1 refusal rather than being treated as carried keys. The requirements.spine and requirements.convergence fields are considered carried whenever their key is present, even if the value is null.\n\ngrant.approval_policy.approvers is carried only when it is a well-formed list; other values trigger a 4.1 refusal. grant.limits is carried whenever its value is present and non-null, but a null value is not carried and does not force requirements.admission. The synth_limits_null vector should still be settled because the door may reject it for reasons unrelated to carrying that key.\n\nA null admission value is in scope, so it does not trigger an out-of-scope refusal. A well-formed approver list is out of scope. The interface only defines exit codes 0 and 2, so encountering out-of-scope keys will produce a 2.2-style error rather than claiming conformance.\n\nThe parent may carry approvers while the child remains in scope. A child carrying a well-formed approver list is out of scope, so the entire settlement is rejected.\n\nThe 4.2 settlement rules apply only after 4.1 accepts the contract. Action names must match the pattern `^[a-z][a-z0-9_.:-]{0,63}$`. The `too_many_witnesses` refusal applies when there are more than 32 witnesses. The `key_conflict` refusal occurs when two keys decode to the same 32 bytes, including principal, contractor, and witness keys. The `tie_policy_refused` refusal applies when `same_height` is present but not null and not `\"conservative\"`.\n\n`revocation_policy_not_recomputable` cannot fire because 4.1 already validates `effective_at`. `ack_window_missing` applies when `delivery_ack` and `ack_window` are not integers greater than or equal to one. `finality_policy_missing` applies when `depth` is absent or not an integer greater than or equal to one. `bad_expiry_height` cannot fire. `unscoped_approvals_refused` triggers only if `allow_unscoped` is present and strictly `True`; since 4.1 requires it to be boolean, this means exactly `True`. The review is now moving to 4.3 Strict terms.\n\nThe 4.1 contract door applies `contract_signature_not_strict` when a signature decodes to exactly 64 bytes but is not strict, even if it fails verification. This reason appears once per signature. The `bond_malformed` refusal applies when a bond is present and non-null but its amount is not an integer between 1 and 2^53-1.\n\nThe `parent_not_supplied` refusal applies when a parent contract is present but no parent was supplied. The `parent_narrowing_failed` refusal applies when a parent contract is present, a parent is supplied, but the parent is not an object or fails its own 4.1 check, or the child contract fails 4.1 when combined with the parent. This narrowing check is judged by 4.3.1 and adds only `parent_narrowing_failed`; it does not also add `contract_not_verified`, which is decided by 4.1 on the child contract alone.\n\nThe parent narrowing rule checks whether the parent is absent, not an object, or fails its own 4.1 check. If no parent was supplied, the parent is absent, so this condition is met and `parent_narrowing_failed` applies.\n\nThe specification revision clarifies that when a parent contract is present but no parent is supplied, the parent is absent and therefore not an object. Both `parent_not_supplied` and `parent_narrowing_failed` can apply simultaneously.\n\nThe fourth narrowing rule is being reinterpreted. It applies only when a parent contract is supplied, not when none is provided. If no parent is supplied, the third row already covers that case. The fourth row instead checks whether the supplied parent input is an object and passes its own 4.1 check. This yields two distinct refusal paths rather than overlapping ones.\n\nThe `grant_subset` narrowing rule is being implemented. Absent or null lists count as empty, and a key is considered set only when its value is present and non-null.\n\nThe narrowing rules for `grant_subset` are being enumerated. The child must not introduce any authorized actions absent from the parent. The parent must not introduce any prohibited actions absent from the child. The child may omit data access entries. The child may not set max_hops above the parent's value, and a parent with zero max_hops excludes all children. The child may not add delegation allowed entries absent from the parent. Conditional entries are next.\n\nThe remaining narrowing rules are being enumerated. Conditional actions must be present in the parent's authorized or conditional actions. The child must not set an expiry height above the parent's. Witness keys, privacy, and ordering must match when the parent sets them. The child may not enable allow_unscoped if the parent does not. Approvers are compared as canonical entries. Rule 10 requires the child's max_target_bits to decode to a target no larger than the parent's.\n\nIf the parent's max_target_bits is absent, the target comparison is skipped, but the child must still carry a finality object when the parent does. The view verification rules are now being enumerated: max_target_bits must be eight lowercase hex digits decoding to a positive target; lower_bound must be an object with an integer height and a sixty-four-character lowercase hex hash; and headers must be a non-empty list.\n\nEach header is an object with a non-negative integer height and a 160-character lowercase hex string. Heights must be consecutive. From the second header onward, bytes 4-36 reversed as hex must equal the previous header's hash. The view must contain a header at lower_bound.height whose hash matches lower_bound.hash. Header hashes are sha256(sha256(80 raw bytes)), byte-reversed, and formatted in lowercase hex. A trailing newline on the hex string triggers only a view_not_strict refusal.\n\nA header ending in a line feed passes rules 1 through 8 and is refused only by rule 9 as view_not_strict. An upper-case hex header fails rule 4 and is refused by both chain_view_rejected and view_not_strict. A view that is not an object or whose headers field is not a list is refused only as chain_view_rejected.\n\nRule 9 applies when the view is an object whose headers field is a list. Every header must be an object with an integer height and a 160-character lowercase hex string. The view itself must be strict: no strings or keys may contain control characters, every key must be ASCII, and every number must be an integer within ±(2^53-1). A value nested deeper than 512 levels is also non-strict, though parsing would have already failed at that depth.\n\nA view that passes rules 1 through 8 but contains more than 200,000 headers is refused as input_too_large instead of chain_view_rejected. No further record examination follows. It is unclear whether triage and anchor checks are skipped in this case.\n\nSection 2.3 states that a problem in rules 4.1, 4.2, or 5.1 stops record examination. The input_too_large refusal is a separate exception: it triggers after verification and still halts further examination. Section 6.1 says binding runs even when sections 4 or 5 fail, but input_too_large is a post-verification consequence of 5.1, so it may still block classification.\n\nBinding will still run even when a view is refused as input_too_large, because that refusal is not a problem in rules 1 through 8. Triage, anchor checks, and header walking will be skipped instead.\n\nRe-reading section 2.3 shows that triage runs before the 4.1 and 5.1 checks, and problems found there do not stop the other checks in that paragraph. Only a problem in rules 4.1, 4.2, or 5.1 rules 1 through 8 halts further record examination.\n\nThe full computation order is now clear. After binding and triage, the contract and view are checked. Collapsing copies, conformance, and anchor checks follow. The event set is then walked. Checks 4.3, 5.1 rule 9, 6.0, 7.4, and 11 are collected but never stop the computation.\n\nSection 6.2 imposes an input_too_large limit of 10,000 records after triage, halting further examination. Section 6.4 collapse is conditional on 5.1 rules 1 through 8 passing, even if 4.1 fails. This creates a contradiction with section 2.3, which stops examination whenever 4.1, 4.2, or 5.1 rules 1 through 8 find problems.\n\nSection 6.4 explicitly overrides section 2.3 by running collapse even when section 4 fails, provided the view passed rules 1 through 8. The same conditional is being checked for conformance and anchor checks.\n\nThe event set is empty when the walk does not run. A reason from 4.3, 5.1 rule 9, 6.0, 7.4, or 11 never empties it.\n\nSection 9.2 states that bound records never examined because sections 4, 5, or 6.2 failed have no disposition. Triage assigns dispositions before the section 4 check, so triage dispositions remain valid even if a later section fails.\n\nSection 9.2 contradicts the earlier assumption that triage assigns dispositions before section 4. If records are never examined when sections 4, 5, or 6.2 fail, then triage must occur after those checks. The actual computation order may be: compute contract_sha256, run sections 4 and 5 first, bind records, then triage.\n\nBinding dispositions are always reported, even when sections 4 or 5 fail. Triage dispositions are only assigned when triage runs; if sections 4, 5, or 6.2 fail, records are not examined and no triage dispositions exist.\n\nThe implementation order is now fixed. Contract and view checks run before binding and triage. Bound records receive no disposition when sections 4 or 5 fail, so triage is skipped entirely. Failing-closed reasons from 6.0 are therefore absent, which aligns with the specification that they never stop the event set computation.\n\nThe implementation order is being refined. If the contract is not an object, the computation halts immediately with no binding or dispositions. If events are not a list, the computation also stops, though computing contract_sha256 in that case is ambiguous and will be skipped. The planned sequence now begins with parsing inputs, then computes contract_sha256, checks out-of-scope status, and proceeds to sections 4 and 5.\n\nBinding runs unconditionally unless the contract is not an object. If sections 4, 5, or view input_too_large fail, triage is skipped and only foreign, inconsistent, and unbound dispositions are assigned; the event set remains empty. Otherwise triage proceeds, followed by the size limit check, collapse, conformance, and anchors. The event set is then built from accepted records.\n\nThe event set is always computed before the walk begins. Even when underspecified reasons from 4.3, 5.1 rule 9, 6.0, or anchors are found, the walk still runs and produces deviations internally. The verdict becomes underspecified and deviations remain empty.\n\nEvidence_missing is only appended when the verdict would otherwise be within_grant or deviation; it is suppressed if the verdict is already underspecified. The final verdict order is: underspecified if any underspecified reasons exist, otherwise deviation if deviations were found, otherwise nothing_to_settle if the event set is empty, and finally within_grant.\n\nSection 11.1 checks are collected even when the settlement is already underspecified. They may add walk_not_strict or evidence_names_other_contract, but they never stop the event set computation.\n\nSection 11.1 is skipped when triage is bypassed, because it requires examined records. The cross-check deviation from 11.1 would be collected internally but omitted from the output if the verdict is already underspecified. Section 7 still evaluates kept and unrejected executions, including orphaned anchors.\n\nExecutions that fail anchor checks with underspecified reasons are still read by section 11.1, because section 7 evaluates all kept executions regardless of acceptance. Executions set aside in 6.0 or rejected by 6.6 are excluded from this check.\n\nA helper function `is_strict(value)` is needed for the strictness definition in 6.0, and additional checks must be added for `body_not_strict`.\n\nRecord signing bytes are the context plus the canonical form of the record without signatures and anchor. A strictly signed record requires one signature entry with an allowed role, strict verification, and a strict signature object. Execution roles are contractor or witness; the latter requires a matching grant witness name. Even when the contract is invalid or witness keys are missing, triage still attempts to match execution roles.\n\nTriage is gated by 4.1 passing, so parties and witnesses are well-formed when it runs. Keys that decode to 32 bytes but fail the Ed25519 point check are treated as unusable and not strictly signed. Revocation records require the principal role, while ack records require the contractor role. A record is set aside with reason `record_not_strict` if its `record_sha256` cannot be computed at all.\n\nCanonicalization failures that would prevent computing `record_sha256` are effectively impossible. The parser rejects integers longer than 4300 digits and limits nesting depth to 512, so any successfully parsed record can always be canonicalized.\n\nCanonicalization handles lone surrogates safely because they encode as ASCII escape sequences. During binding, records whose `record_sha256` cannot be computed are set aside with reason `record_not_strict`; the remaining records proceed to binding. Identical byte sequences are skipped during the binding walk.\n\nFilenames will be sorted to ensure deterministic event ordering. The binding table is being drafted: it checks the contract reference, validates the SHA256 hex format, and compares it against the contract SHA256 and ID to assign unbound, inconsistent, or foreign dispositions.\n\nThe binding table now includes a payload digest check: if the reference carries a payload digest that does not match the record, the disposition is inconsistent. A missing contract_id causes unbound only when the contract SHA256 is absent or null and the ID matches; otherwise the record is dropped silently.\n\nTriage in 6.0 applies exclusively to bound records. Records that are not strictly signed and have a non-strict body are set aside with reason `record_not_strict`. Records that are not strictly signed but whose signature verifies under lax rules alone are set aside with reason `signature_not_strict`. All other non-strict records are rejected.\n\nStrictly signed records with a non-strict body are set aside with reason `record_not_strict` and also add an underspecified reason. If a strictly signed record has an invalid anchor and another bound record shares its signing bytes, it is set aside with `anchor_not_strict`; otherwise it becomes an underspecified reason. A revocation record is set aside with `revocation_not_provided_for` when the grant's revocation field is not an object. All other strictly signed records are kept. Anchor validity depends on the view.\n\nThe `anchor_not_strict` triage rule is circular with 6.4. It requires knowing whether another bound record with the same signing bytes is kept and anchors validly, but that outcome depends on the same strictness checks. The algorithm must therefore evaluate strictness for all bound records together.\n\nThe disposition `anchor_not_strict` applies to both the set-aside case and the underspecified case. The exact wording of 9.2 is being re-read to determine whether the reason is added to the settlement in the set-aside scenario.\n\nThe first triage row sets aside the record with disposition `anchor_not_strict` but does not add the underspecified reason, because a valid copy exists. The second row fails closed with disposition `anchor_not_strict` and adds the underspecified reason.\n\nThe underspecified `anchor_not_strict` case is not set aside; it is failing closed and therefore never examined again. Only the strictly signed body-not-strict row both sets aside a record and adds an underspecified reason.\n\nBoth the set-aside and failing-closed `anchor_not_strict` outcomes are treated as not kept, so they never enter the event set. Only the \"otherwise\" case adds the underspecified reason. A record is considered kept by this table if it is strictly signed, body strict, and its anchor is valid under 6.4.\n\n\"Anchors validly\" requires a non-negative height, a matching block hash in the view, a proof reaching the Merkle root, and an accepted batch leg. It does not compare against the checkpoint.\n\nIf the good copy anchors validly but the bad-anchor copy fails closed, the bad copy is set aside or rejected and never examined again. 6.4 therefore sees only the good copy. If none of the bound records anchor validly, 6.4 keeps all of them.\n\nThe implementation will group bound records by signing bytes. A strictly signed, body strict, anchor strict record is the candidate good copy for its group. A strictly signed record with a non-strict anchor is set aside without reason if the group contains a good copy; otherwise it fails closed with reason. Anchor checks precede revocation checks in the triage table.\n\nA revocation record with a bad anchor is handled by the anchor rows, not the revocation_not_provided_for rule. If the anchor is strict but the grant lacks a revocation object, the record is set aside and does not count as kept by this table; its non-strict anchor copy then fails closed. A lax signature is one that passes 3.4 verification yet does not satisfy strict Ed25519 requirements.\n\nA record is strictly signed only if every signature entry verifies under strict Ed25519 rules and the entry itself is a strict value. A signature that passes lax verification but fails strict requirements—such as an S-value at or above the order L, a non-prime-order R point, or a control character in a field—counts as non-strict. The triage row therefore applies to any signature entry that verifies under 3.4 yet does not satisfy strictness.\n\nThe `signature_not_strict` triage row applies to any signature entry that verifies under lax rules but fails strict Ed25519 verification. A record is not strictly signed if its only valid signature has the wrong role, yet a different signature entry still verifies under 3.4. That lax signature triggers the set-aside.\n\nThe signature triage rule is now fully defined. A record is strictly signed only if at least one signature entry with an allowed role and matching key both verifies under strict Ed25519 rules and carries a strict value. If any verifying signature fails strictness, the record is set aside with reason `signature_not_strict`. Otherwise it is rejected.\n\nAny signature entry whose base64 value verifies under 3.4 will trigger the `signature_not_strict` triage row, even if its role is wrong. A strict signature beside a malleated one should keep the record; problems in the signatures list are ignored for strictly signed records.\n\nBody strictness is violated when the body value itself is not strict, nenrin_ref is present but neither null nor 64 lowercase hex, or contract_ref fields are present and not 64 lowercase hex. For executions, performed_actions and delegated_to must be lists of strings, approvals must be a list of objects, and any approval containing a signature that decodes to 64 bytes must satisfy strict Ed25519 rules. A missing nenrin_ref key is acceptable.\n\nA null value in contract_ref fields is treated as present and therefore invalid for strictness, since null is not 64 lowercase hex. This may conflict with binding rules that allow absent or null contract_sha256 for unbound records.\n\nA signature entry that decodes to fewer than 64 bytes is not checked for strict Ed25519 rules; it is classified as forged under 10.4. An absent anchor is treated as strict by default.\n\nA kept record with no anchor is not strictly signed, so it reaches 7.4 and is classified as `anchor_incomplete`. In 6.4, kept records are grouped by signing bytes; if multiple distinct records exist, the one with the smallest `(height, record_sha256)` pair is kept and the rest are dropped as `duplicate_dropped`. The specification does not clarify how to compare records when an anchor height is missing.\n\nOnly copies that anchor validly are kept in the duplicate-dropping path, so every candidate has a valid integer height. Dropped copies are never examined for conformance or anchors.\n\nA kept revocation is ignored if its `revoked_by` field is not `\"principal\"`. This check runs after conformance, which rejects revocations with extra fields.\n\nThe ignore rule for revocations must run before section 7. Otherwise a bad anchor would underspecify the settlement first. The full pipeline is kept, then duplicate collapse, then conformance, then ignore, then anchors.\n\n6.6 conformance rejects records with extra fields, non-string performed_actions, outcomes checks, more than 256 actions, or invalid action name patterns. An execution record that fails conformance but carries a contractor signature verifying under 3.4 is charged as `nonconforming_record` and still proceeds to section 7. The specification does not clarify whether a witness-signed record with conformance problems is rejected instead of charged.\n\nA witness-only execution with conformance problems is rejected. The specification does not explain which later check would read a rejected record, since conformance and collapse do not depend on other records.\n\nThe repeated conformance pass is unnecessary because conformance and duplicate collapse are independent of other records. Rejected records are never examined again, so they do not affect later checks.\n\n6.6 rejection is distinct from 6.0 rejection. An approval object that lacks an action field fails the action name pattern and counts as a conformance problem.\n\nRecords that pass section 6 are evaluated in order by sections 7.4, 7.5, and 7.6; the first failure determines the disposition.\n\nSection 7.4 rejects an anchor if it lacks a height or its block_hash is not exactly 64 lowercase hex. A height below the lower bound yields `anchor_below_lower_bound`. A height beyond the observed chain tip or a missing header at that height yields `anchor_beyond_observed_chain`. A block_hash that does not match the view hash yields `orphaned`, with no reason but the height still counting toward finality.\n\nSection 7.5 requires the proof to be a non-empty list of at most 512 operations.\n\nSection 7.5 proof validation begins with the body digest, which is the SHA-256 of the canonical record excluding only the anchor key. The operations are applied to that digest, and the final result must equal the Merkle root from bytes 36–68 of the raw header. A failure yields `anchor_proof_invalid`.\n\nSection 7.6 batch-leg validation rejects a record if it refuses the batch leg, producing `anchor_batch_leg_refused`. If all checks pass, the record is accepted.\n\nThe body digest excludes signatures but includes them in the canonical record used for signing.\n\nSection 7.6 rejects a record if hexlify is not the first operation or appears more than once, producing `hexlify_not_leading`. The batch leg is rebuilt by walking operations after the first up to the first sha256; any operation that is not append or prepend yields `batch_leg_malformed`. The reconstructed batch concatenates prepend operands in front-to-back order, then the ASCII hex of the body digest, then append operands in their original order.\n\nSection 7.6 requires the batch bytes to parse as strict JSON into an object matching one of the three batch schemas; otherwise the record is rejected as `batch_not_json` or `batch_schema_unknown`. A batch containing `NaN` fails strictness and is refused.\n\nThe parenthetical citation to strict JSON (2.2) refers to the reader rules, not the strictness definition in section 6.0. This means NaN is parsed as a number and then fails strictness, producing batch_not_json.\n\nThe batch schema requires a `records` list of objects. A `count` field must equal the list length; otherwise `batch_count_mismatch`. Exactly one record's SHA-256 hash must match the ASCII hex digest; otherwise `record_not_listed_in_batch` or `record_listed_twice`. For typed batches, each record's `kind` must match the schema kind, and its `schema` field must equal the record's own schema.\n\nThe raw batch text must contain the record SHA-256 as 64 unescaped hex characters. Its first character must sit at a byte offset equal to the total length of all prepend operands.\n\nThe SHA-256 hex string must begin immediately after the prepend operands, at the splice point where the body digest was inserted. This confirms the hexlify output matches the record's own SHA field exactly.\n\nThe SHA-256 hex string must appear as raw 64 characters with no escapes; any escape sequence triggers an internal refusal. Its first character must sit at a byte offset equal to the total length of all prepend operands. The exact position of that string in the raw batch text is still unclear.\n\nThe batch JSON must be parsed with position tracking to locate the exact raw span of the record's SHA-256 string. That span must contain exactly 64 unescaped hex characters, and its start offset must equal the total length of all prepend operands.\n\nPrepend operands are hex-decoded bytes, so their total length is measured in raw bytes. The header is 80 bytes: version, previous hash, Merkle root, timestamp, nBits, and nonce. The Merkle root sits at bytes 36–68. The header hash is the double SHA-256 of those 80 bytes, reversed, then hex-encoded.\n\nThe previous hash field is the computed header hash of the prior block, not a stored value. The nBits field is bytes 72–76 as a little-endian uint32 target. The header hash must be no greater than that target when read as a big-endian 256-bit integer.\n\nThe compact target is decoded from the nBits field by extracting the 8-bit exponent and the 23-bit mantissa. The value is invalid if the sign bit is set or the mantissa is zero.\n\nThe compact target is computed as mantissa shifted left by eight times the exponent minus three, or right if the exponent is smaller. A target of zero is invalid because the specification requires a positive value.\n\nStatus is undetermined when the verdict is underspecified. Otherwise it is final if every accepted height and every orphaned height is at most the horizon, where the horizon equals the chain tip minus the finality depth plus one. It is provisional otherwise. If there are no accepted or orphaned heights, the status is final. A missing finality depth produces an underspecified verdict and an undetermined status.\n\nIf rules 4.1, 4.2, or 5.1 fail, the event set is empty and no further examination occurs. Orphaned records only arise after a successful view and depth check. A missing finality depth therefore leaves the status undetermined without generating orphaned records.\n\nIf only rule 4.3 fails, the event set is still computed and the status remains undetermined.\n\nSection 9.3 defines bond outcomes: absent or null bonds yield n/a. A bond that is not an object with a positive integer amount produces an underspecified verdict; the outcome is undetermined when lower layers read it as a bond, and n/a otherwise. Python truthiness determines whether the amount counts as a valid bond.\n\nA well-formed bond yields undetermined if the verdict is underspecified, pending_finality if the status is provisional, held for within_grant and nothing_to_settle otherwise, and forfeited for deviation. Section 10.1 defines revocation effective_at as the anchor height h, and delivery_ack as the minimum of h plus ack_window and the heights of acknowledgments naming that revocation.\n\nIf no acknowledgments name the revocation, the effective_at height is simply h plus ack_window. An acknowledgment names a revocation when its revocation_sha256 matches either the lowercase hex body digest of the revocation or the record_sha256 of a copy still present after step 6.4. A copy dropped by step 6.4 no longer names the revocation.\n\nRevocations are sorted by effective_at height and record SHA-256. An execution at height h is revoked if a revocation has effective_at at or before h. A revoked execution yields deviation revoked for every performed action, consumes no approval nonce, and skips further checks.\n\nIf expiry_height is present and not null, actions at heights above it receive after_expiry verdict, though this does not halt other checks.\n\nEach string action is judged in sequence: prohibited actions are rejected, conditional actions are handled by section 10.4, and all remaining actions that are not in the authorized set are unauthorized.\n\nDelegated_to entries missing from delegation.allowed yield a delegation deviation.\n\nEvery approval on accepted executions is classified. A non-object or missing principal key is forged. If the signature base64 verifies over a v2 message and the contract SHA-256 matches, the approval is counted; otherwise it is other_terms. If the signature verifies over v1 or v0, it is label_bound. Otherwise it is forged.\n\nThe v2 message prefix is the byte string \"a2a-approval-v2\\n\" followed by the canonical JSON of the approval fields: contract_sha256, action, valid_until_height, nonce, and single_use.\n\nStep 2 approval fields require valid_until_height to be a non-negative integer, nonce to be 32 lowercase hex characters, single_use to be a boolean, and contract_sha256 to be 64 lowercase hex. A v1 signature is attempted only when these checks pass and the contract SHA-256 matches; otherwise the approval is other_terms. The v1 message prefix is \"a2a-approval-v1\\n\" followed by canonical JSON containing contract_id, payload_digest from the contract task, action, valid_until_height, nonce, and single_use.\n\nThe v1 message includes payload_digest even when absent, canonicalized as null. The v0 message prefix is \"a2a-approval-v0\\n\" followed by canonical JSON of contract_id, payload_digest, and action, with no field checks beyond signature verification.\n\nA missing sig_b64 field causes the approval to be judged forged. For conditional actions, the first counted approval in event set order is used: it must match the action, name the same record or a height strictly below h, satisfy valid_until_height, and leave the nonce unconsumed if single_use is true.\n\nNonces are consumed only when single_use is true. Consumed nonces are shared across all actions and executions. A missing approval yields deviation conditional. Every forged approval adds the deviation forged_approval, even on revoked executions.\n\nA revoked execution's approval can still approve a later action if it names the same record or a lower height. The nonce is not consumed for that revoked record's own judgment, but the approval may be counted by a subsequent execution.\n\nThe event set order scans all counted approvals in record list order. An approval from a later record is excluded because its height is not strictly below the current execution height.\n\nSection 11 NENRIN applies only when nenrin_records is a non-empty list. A missing or empty value is treated as absent, and a non-list value is also treated as absent.\n\nThe walk is not strict. Left-out objects are skipped. Other objects are indexed by record_sha256, and non-objects are ignored.\n\nExecutions kept by rule 6.0 that are not rejected by rule 6.6 and remain after step 6.4 are processed once per record_sha256.\n\nFor each kept execution, the walk whose record_sha256 matches its nenrin_ref is looked up. If that walk exists and its contract_sha256 differs from the current contract, the deviation evidence_names_other_contract is added. If the walk was left out because it was not strict, the reason walk_not_strict is set. A mismatched nenrin_ref produces no deviation or reason.\n\nSection 11.2 adds evidence_missing when requirements.evidence is nenrin_required and a kept execution's nenrin_ref is missing or not exactly 64 lowercase hex characters. This check applies only after the verdict would be within_grant or deviation.\n\nRule 13 of section 4.1 establishes a regex that rejects strings in the establishes field if they match case-insensitively against performed, delivered, money moved, funds transferred, paid, or payment completed.\n\nThe establishes regex also rejects strings containing contract, binding, guarantee, escrow, custody, solvent, lawful, fair, or certified. Rule 14 does_not_establish applies when the list is non-empty: a kept execution is judged against groups of runtime or enforce, judge or liability or fault, deviat, and legal.\n\nEach of the four groups in rule 14 must appear inside at least one string. The keyword does not need to be split across separate strings.\n\nDomain normalization strips whitespace and lowercases the string. It removes one or more trailing dots. The result must contain at least two labels separated by dots. Each label starts and ends with a letter or digit. It may contain hyphens in between. Consecutive dots produce empty labels and fail validation.\n\n`str.strip()` removes all Unicode whitespace characters. A `key_url` must parse as a valid HTTPS URL with a non-empty host. Each signature in the list is verified against the party whose domain normalizes to the object's domain.\n\nA signature is refused if its domain does not match any party. A non-object in the signatures list is also refused. Every party must have at least one valid signature. Numbers in the contract must be integers within ±(2^53-1). Boolean values are not numbers. Object keys anywhere must be printable ASCII characters.\n\nRule 8 restricts grant keys to a fixed set. The limits key is permitted, but only when it is null; if present as an object, the grant is out of scope and must be skipped. Rule 10 governs approval_policy.\n\nRule 10 restricts the approval_policy object to the keys allow_unscoped and approvers. If approvers is present, it must be a well-formed list of one to sixteen elements; otherwise the contract is refused as not verified. A present but empty or malformed approvers list is refused. A present and well-formed approvers list is carried out of scope.\n\nA conflict exists between the preamble and rule 10. The preamble says approvers is checked only when present and not null, but rule 10 explicitly requires a list whenever that key is present. Because null is not a list, it would refuse the contract under rule 10 even though the preamble would skip it.\n\nThe approvers conflict is resolved by special-casing the key: any present value, including null, must be a well-formed list or refuse. A present but null requires field is not a string, so it does not satisfy the conditional rule's requirement.\n\nThe delegation rule is next.\n\nDelegation must be an object with exactly one key, allowed, containing a list of non-empty strings; an empty object is refused.\n\nOrdering may contain only the optional same_height key, which must be a string or null.\n\nRevocation requires effective_at to be either anchor or delivery_ack. It may also contain ack_window as an integer greater than or equal to one. If ack_window is absent and effective_at is delivery_ack, 4.1 passes but 4.2 adds ack_window_missing.\n\nFinality may contain depth as an integer greater than or equal to one and max_target_bits.\n\nWitnesses must be a list of objects with non-empty name strings and public keys that decode to 32 bytes. Privacy must be a non-empty string when present. Max_hops and expiry_height must be integers greater than or equal to zero when present; booleans are refused.\n\ndata_access must be a list of non-empty strings. Any carried out-of-scope field causes the program to exit with code 2 and an error.\n\nA parent contract may carry out-of-scope keys such as approvers or spine without failing 4.1. The door only checks for in-scope fields, so a parent that passes all required checks remains valid even if it contains keys the settlement logic ignores.\n\n4.3 signature strictness is checked independently of 4.1. Malformed contracts are still decoded to extract signatures. A non-list signatures value is skipped. The view is evaluated even when section 4 fails. chain_view_rejected applies when rules 1–8 fail or the view is invalid, using a single reason.\n\nRule 9 separately adds view_not_strict. If the view passes rules 1–8 but contains more than 200,000 headers, the reason is input_too_large instead of proceeding normally. Rule 9 can still fail if non-strict strings appear in extra keys.\n\ninput_too_large and view_not_strict may both apply. A section 5 failure such as input_too_large still triggers binding, but bound records are not triaged. This avoids missing record_not_strict reasons.\n\nSection 6.2 limits kept records to ten thousand after triage. Exceeding this cap triggers input_too_large and halts further examination. Kept records that are triaged but not fully examined receive no final disposition from anchors, matching the rule that never-examined records have none.\n\nSet-aside and rejected records retain their 6.0 dispositions even when triage halts before they are examined. Kept records that were triaged but not further examined receive no additional disposition from anchors.\n\nEvents are ordered by anchor height and record SHA-256. The dispositions object maps each record SHA-256 to exactly one disposition code.\n\nDeviation codes and underspecified reasons are empty unless the verdict is deviation or underspecified. The JSON output will use ensure_ascii=False and deterministic key order: contract_sha256, verdict, status, bond_outcome, deviation_codes, underspecified_reasons, event_set, dispositions. Disposition keys will be sorted for determinism.\n\nEvent set items will use the key order kind, sha256, height. Error output is a JSON object with a short reason and exit code 2 for duplicate keys, depth above 512, invalid JSON, integers exceeding 4300 digits, NaN or infinity, and bad UTF-8. Missing contract.json or view.json triggers an error; extra files are ignored. Floats will be encoded using Python repr for canonical output.\n\nThe specification requires canonical float encoding to match Python's json module output, not repr. This is a subtle distinction because the two can differ for some values.\n\nCanonical float encoding will use Python repr for finite values, producing forms like '1.5' rather than '1.50'. Negative zero is handled correctly by both repr and json.dumps. JInt values are encoded as plain integers with no leading zeros. Booleans and null map directly to true, false, and null. A custom string-escaping routine is being drafted to handle quotes, backslashes, and control characters.\n\nThe string-escaping routine now handles control characters, valid surrogate pairs, and non-BMP characters. It writes standard escape sequences for \\b, \\f, \\n, \\r, and \\t, and encodes other ASCII control characters as four-digit Unicode escapes. Valid UTF-16 surrogate pairs are decoded into their corresponding scalar characters.\n\nThe string-escaping routine now encodes stray surrogate characters as four-digit Unicode escapes. The canonical() function returns UTF-8 bytes. Ed25519 constants P and L are being defined for the point implementation.\n\nThe Ed25519 point recovery function is being implemented. It derives the curve constants D and I, then reconstructs an x-coordinate from a 32-byte public key by solving the curve equation and applying the correct sign bit.\n\nThe Ed25519 point implementation now includes identity detection, point addition, and scalar multiplication via binary exponentiation. A function to verify canonical prime-order points is being drafted.\n\nThe canonical prime-order point check verifies that the recovered point is not identity and that its order is exactly L. The square-root formula is confirmed correct for p ≡ 5 (mod 8), and the recovered point lies on the curve by construction.\n\nSmall-order points are rejected because their order divides 8 but is not 1. Scalar multiplication by L requires roughly 252 point additions, which may be slow for many records, so extended coordinates could be used to speed up the check. The cryptography package already handles signature verification.\n\nAffine coordinates are sufficient for the small number of keys. Projective coordinates will be used to avoid modular inversions in the scalar multiplication loop.\n\nThe cryptography package will not be relied upon to reject non-canonical or small-order points, so those checks must be implemented manually. For strict signature validation, the R point must pass the prime-order test and the S scalar must be less than L.\n\nOpenSSL may reject signatures with S >= L before the program ever checks them. If so, \"lax verifies\" would not trigger for those adversarial signatures. The specification notes that OpenSSL differs from the reference in this regard.\n\nSignatures with S >= L are rejected as not strictly signed, not as signature_not_strict. The lax-verification row only applies when verify returns true.\n\nThe program will call cryptography's verify directly to match the reference behavior exactly. The disposition for synth_signature_s_plus_l depends on whether that call returns true.\n\nA strict signature beside a malleated one in the same record makes the record strictly signed; the bad entry is ignored. A canonical base64 decoder is being drafted that validates padding, length, and re-encoding to ASCII.\n\nThe base64 decoder will use validate=True to reject non-alphabet characters, whitespace, and invalid padding. A helper function checks that a string is exactly n lowercase hex characters. An integer validation routine is being drafted.\n\nThe integer validation helpers are now defined: `is_json_int` checks for the custom JInt type, and `is_safe_int` enforces the 53-bit safe range. The custom JSON parser correctly handles negative numbers. A recursive `is_strict` function is being drafted to validate JSON values.\n\nThe `is_strict` validator now rejects strings containing control characters U+0000–U+001F or U+007F, permits non-ASCII bytes, and requires JInt values to stay within the 53-bit safe range. It also returns False for floats and JFloats, and recursively checks lists and dictionaries.\n\nThe `is_strict` validator now enforces that dictionary keys are ASCII printable strings, rejecting control characters and DEL. It recursively checks all values.\n\nThe specification requires every object key to be ASCII and free of control characters and DEL. This matches contract rule 12, so keys must be printable ASCII (U+0020–U+007E). Spaces are permitted in keys. Strings may contain non-ASCII bytes and spaces, but must still avoid control characters and DEL.\n\nBody strictness rules are being clarified. The `nenrin_ref` field is strict only when it is null or exactly 64 lowercase hex characters; any other value makes the body non-strict. If `contract_ref` is not an object, those fields are treated as absent.\n\nBody strictness also rejects performed_actions, delegated_to, and approvals when they are not lists of strings or objects. Empty lists are valid. A non-strict body is set aside before reaching later record checks.\n\nApproval signatures are checked for strictness only when they canonical-base64-decode to exactly 64 bytes. The check requires the first 32 bytes to pass the public-key test and the last 32 bytes to have an S scalar below L. A non-canonical 64-byte signature does not trigger this rule.\n\nWitness names are unique during triage because a duplicate name triggers key_conflict. A grant revocation that is missing, null, or not an object is set aside as revocation_not_provided_for. If the revocation object exists, rule 4.1 ensures its effective_at is either anchor or delivery_ack.\n\nThe `same_height` field in rule 4.2 is valid only when it is null, absent, or exactly `\"conservative\"`. Any other string value makes the record non-strict. Section 10 clarifies that same-block records are resolved by explicit settlement logic rather than by ordering rules.\n\nConservative and null same_height values are accepted without altering the walk. Finality depth is guaranteed to be an integer of at least one when status computation proceeds, because rule 4.2 ensures this once rule 4.1 passes and no finality policy is missing. The lower_bound height comparison in section 7.4 is safe because the anchor check only runs after lower_bound validation succeeds.\n\nThe view header map uses heights as keys, which are unique and consecutive. The tip is the height of the last header. Rule 8 requires the view to contain a header at lower_bound.height whose hash matches lower_bound.hash; any missing or mismatched entry fails. Rule 4 requires each header hex string to be exactly 160 lowercase hex characters followed by an optional single line feed, rejecting carriage returns.\n\nHash computation uses the 80 bytes of hex data, ignoring any trailing line feed. Rule 9 strictness requires every string, key, number, and header object in the view to be strict. A trailing line feed makes the hex string non-strict because it contains a control character, and it also prevents the string from being exactly 160 characters, so the view is not strict. Upper-case hex letters are permitted in strict strings.\n\nA height value that is a float, such as 1.0, causes both rule 4 and rule 9 to fail. Rule 4 rejects the view because the height is not an integer. Rule 9 rejects it because the number is not an integer.\n\nIn section 6.1, the contract_id comparison still executes even when the contract identifier is malformed or not a string. If rule 4.1 fails, the contract identifier may be invalid, but the binding logic continues using the computed contract_sha256. Records matching that hash are bound only if their contract_id equals the computed identifier.\n\nA missing contract_id is treated as None, so the comparison against a reference value still works. The canonical contract SHA-256 is computed from the JSON representation of the contract object, including non-integer numbers and null values for non-object inputs. Duplicate keys in nested JSON objects are handled correctly by the custom parser. If an events file element is itself a JSON array, it is ignored as not a record.\n\nFiles are sorted by name for deterministic processing. Identical content hashes to the same SHA-256, so duplicate files bind identically and the first occurrence is kept. A missing parent file is treated as absent; invalid JSON in a parent file causes a parse error that halts settlement.\n\nA missing nenrin directory is treated as absent, not an empty list. Section 11.1 is skipped when the evidence list is absent or empty.\n\nThe requirements.evidence field is read in section 11 but not checked by the door. Only the value \"nenrin_required\" triggers rule 11.2; other values are ignored.\n\nThe walk record_sha256 is the SHA-256 of the canonical walk value. A deviation occurs in section 11.1 when the walk context is an object, contract_sha256 is present and non-null, and it differs from the computed contract SHA-256.\n\nEvidence checks apply only when required. A missing, null, or non-64 lowercase hex nenrin_ref triggers a deviation. If the event set contains accepted execution without that evidence and no other deviations exist, the verdict becomes deviation rather than within_grant. An empty event set is handled by rule 11.\n\nAn empty event set is classified as nothing_to_settle, so section 11.2 does not apply and no evidence_missing deviation is added.\n\nWhen a record is underspecified, the deviation codes list remains empty; forged approvals are not reported even if they were computed.\n\nIf a record is underspecified, the status is undetermined regardless of orphaned heights or whether the bond is well-formed.\n\nMalformed bonds are classified as n/a when the amount is missing, null, or not a positive integer. They are undetermined only when the amount is present and truthy, such as with integers, floats, or booleans.\n\nExtra keys in a bond object are permitted; the amount field alone determines well-formedness. A signature is judged for strictness and encoding validity even when contract rule 4.1 fails, independent of verification. If a 64-byte signature decodes correctly but its R is not prime-order or its S is not below L, it is flagged as non-strict regardless of whether it verifies.\n\nRule 6 requires that every action the child can perform must appear in the parent contract's conditional list with an identical `requires` value. A missing or null `requires` is treated as matching on both sides. If the child lacks a matching entry, or if the existing entry has a different `requires`, the rule is violated.\n\nRule 7 forbids the child from introducing conditional actions that the parent does not already authorize. Rule 4 requires the child's max_hops to be strictly less than the parent's; a missing or equal value is a violation. Rule 9 requires a matching revocation object when the parent has one, and if the parent's effective_at is an anchor, the child's must also be an anchor.\n\nRule 9 also allows the child's effective_at to be delivery_ack when the parent's is delivery_ack, and it compares ack_window only if both contracts specify an integer value. Rule 10 requires the child finality object whenever the parent has one, enforces that the child depth is at least the parent's depth, and checks max_target_bits only when the parent's key decodes successfully.\n\nRule 11 requires the child contract to contain at least one witness whose public key string matches each witness key of the parent. If the parent has no witnesses, this rule is skipped and the child may have none. String equality is used for the comparison.\n\nRule 12 requires the child contract to set privacy and ordering to the exact same JSON value as the parent. An ordering object containing `{\"same_height\": null}` counts as a present, non-null value, so the child must match it exactly. The specification does not clarify whether key order in objects affects equality.\n\nJSON equality is semantic dictionary comparison, so key order does not matter. Rule 13 requires the child approval_policy.allow_unscoped to be true only when the parent's is also true; a missing parent value counts as false. Rule 14 compares approvers as sets of canonical bytes, treating absent lists as empty.\n\nCanonical bytes for an approver entry sort its keys and preserve the actions array order. A parent with approvers but a child without them is a violation. If the child has an approvers key that is not well-formed, contract rule 4.1 fails before narrowing begins.\n\nA child contract that fails rule 4.1 on its own is also rejected when supplied with a parent contract, producing both `parent_narrowing_failed` and `contract_not_verified`. The specification revision clarifies that supplying a parent contract does not change the reason codes; a standalone 4.1 failure still yields only `contract_not_verified`.\n\nThe `contract_not_verified` reason is determined solely by the child contract's own 4.1 check. If the child passes 4.1 on its own but fails when supplied with a parent contract, only `parent_narrowing_failed` applies.\n\nThe fourth row of the settlement table is implemented literally: if a parent contract is present and the parent is not an object, fails 4.1, or the child fails 4.1 when supplied with that parent, `parent_narrowing_failed` is added alongside `contract_not_verified`. If no parent is supplied, only `parent_not_supplied` is reported.\n\nThe parent_contract must be an object. Its contract_id must match the parent's contract_id, and a missing or absent value fails narrowing.\n\nIf the child fails 4.1 on its own, the grant subset check is skipped because the settlement table already treats that as a failure with the parent supplied.\n\nThe view floor is derived from the contract.\n\nRule 1 requires grant.finality.max_target_bits to be 8 lowercase hex that decodes to a target. A missing grant or finality field causes chain_view_rejected even if rule 4.1 failed. Rule 2 accepts any integer height, but negative values are rejected by rule 8 because headers have non-negative heights.\n\nHeaders must form a consecutive sequence starting from any non-negative height. The proof current bytes must not exceed 65536 at any step, checked after each operation. Hex operands are limited to 4096 bytes; an empty string is permitted. A proof that exceeds this length is rejected as anchor_proof_invalid, not as a strictness failure.\n\nNon-object proof entries and missing operations are rejected. The baseline proof begins with an append operation rather than hexlify, so the batch leg must accept immediately. The body digest is computed by canonicalizing the record after removing its anchor key, then applying sha256. Canonical key sorting follows Unicode code point order.\n\nWhen the contract is not an object, the output is an underspecified verdict with undetermined status. The bond outcome is n/a because no bond exists. The event set and dispositions are empty.\n\nMultiple underspecified reasons are collected and deduplicated. Deviation codes are sorted and deduplicated. A nonconforming_record deviation is added during 6.6; if the anchor also fails with underspecified, the verdict remains underspecified and this deviation is omitted. Witness signatures require a role of \"witness\" and an exact matching witness_name.\n\nSignature entries are objects with role, sig_b64, and witness_name for witnesses. Missing witness_name or non-object entries are skipped. Verification messages use fixed context prefixes: a2a-execution-v0, a2a-revocation-v0, and a2a-revocation-ack-v0. Contract signing bytes are the prefix plus canonical contract bytes with the signatures key removed entirely. Party key lookup for contract signatures is noted but not detailed.\n\nDomain normalization uses the party's own normalized domain and public key. Multiple parties sharing the same normalized domain violate rule 4.1. The establishes regex uses case-insensitive word boundaries, matching \"paid\" only when not followed by \"for this record\".\n\nThe `does_not_establish` list must contain only strings; non-string elements cause refusal. The `task.purpose` field must be a non-empty string. The `payload_digest` is optional: it may be absent or null, or it may be 64 lowercase hex when present. Schema matching requires an exact match.\n\nInvalid UTF-8 in input files will raise an error. A JSON BOM may cause parsing to fail, which is acceptable. The JSON parser's `parse_int` hook will be used to reject integer tokens longer than 4300 digits; if it raises `ValueError`, the exception is caught and treated as a parse error.\n\n`+Infinity` is rejected by the JSON parser. `1e400` parses as a float and fails rule 11 in contracts; it is not a parse error. Depth is checked before parsing and again via the JSON parser. A depth of exactly 512 is allowed and strict.\n\nDuplicate keys in a JSON object cause the program to exit with code 2 and emit an error JSON containing a short reason string. The text-based depth scan is reserved for hard errors; because the JSON parser already enforces the 512-level limit, the strictness check does not need its own depth guard.\n\nError messages will be short, such as \"duplicate key\", \"invalid json\", and \"integer too long\". The implementation will be a single settle.py file. For step 8 of section 7.6, the batch leg must decode its UTF-8 bytes into a string to locate the sha string's byte offset; offsets are byte-based, not character-based.\n\nThe body digest hex is inserted at the exact byte offset equal to the total prepend bytes length. The 64-character hex string therefore occupies batch[pre_len:pre_len+64], so no character-to-byte mapping is needed.\n\nThe SHA string must begin with a quote and end with a quote immediately after the 64 hex characters. Escaped sequences cannot produce a false positive because the raw bytes at that offset are checked directly.\n\nThe batch-leg splice check requires both the digest hex to sit at the exact prepend offset and the preceding byte to be a JSON quote. A match of the digest elsewhere in the batch would still fail if the splice is not at the sha field.\n\nThe batch-leg splice check requires the 64 hex characters to be wrapped in JSON quotes at the exact prepend offset. If the digest sits there but is not a JSON string, the program refuses with code `internal`.\n\nA custom JSON parser will record each string's byte span. The sha field's raw content will be checked for backslashes to catch escaped values, and its start offset will be compared against the prepend length to detect misplacement.\n\nA recursive descent parser will track byte indices to locate the exact JSON string span for records[i].sha. The batch will be decoded from UTF-8 bytes into a string while preserving a byte offset map, or parsed directly from bytes.\n\nA separate recursive descent parser will locate the SHA string span in the batch without modifying the main JSON parser. It will return each string's byte start and end positions so the splice check can verify exact placement and raw unescaped content.\n\nThe main JSON parser will use the standard library with hooks for depth, duplicate keys, and integer limits. A custom span-aware parser is reserved only for the batch-leg splice check.\n\nThe scanner will walk raw bytes to locate JSON strings matching the digest and confirm they contain no escape sequences. Object key order is irrelevant for logic but required for canonical sorting. The custom float type JFloat preserves standard float string representation.\n\nJFloat string representations are 'inf' and 'nan', so non-finite values need special-case handling. The parser must check for JInt specifically rather than int, because bool is an int but not a JInt. json.loads already rejects leading zeros as parse errors.\n\nA signature that does not decode to 64 bytes is skipped and never triggers the strictness check. The strictness deviation only applies when decoding succeeds but the result is non-canonical; otherwise the signature is unusable under rule 15.\n\nCanonical base64 decoding to exactly 64 bytes is required before checking strictness. Non-canonical signatures are skipped and do not trigger the strictness deviation; rule 4.1 may still refuse them as unusable. A canonical signature with S >= L adds the contract_signature_not_strict reason even if it verifies or does not. Only one reason is recorded per bad signature.\n\nThe `allow_unscoped` flag is truthy only when rule 4.1 passes, so it cannot trigger an unscoped-approvals refusal if the door check fails. Key conflicts are detected by comparing decoded 32-byte public keys across the principal, contractor, and witnesses, plus checking for duplicate witness names; a witness key invalid error is still checked even though it should not occur after rule 4.1. The action-name pattern in rule 4.2 applies to authorized actions, prohibited actions, and conditional actions.\n\nRule 4.1 only requires non-empty strings, so action names like \"Read\" or \"payment!\" pass it but fail rule 4.2. The pattern is a lowercase letter followed by up to 63 of those characters, giving a total length of 1 to 64.\n\nWitness counts are not limited in rule 4.1, so 33 witnesses with valid keys would pass 4.1 yet still trigger the too_many_witnesses refusal in 4.2.\n\nEmpty authorized_actions is not an error; it simply means no actions are explicitly authorized.\n\nProhibited actions are checked before conditional and authorized actions.\n\nA conditional action takes precedence over an authorized action. If an action appears in both lists, it is judged as conditional and requires approval.\n\nIf the delegation field is missing, the allowed set is empty and no deviation is recorded for delegated_to entries.\n\nThe performed_actions field must be present and not a list.\n\nAn absent `performed_actions` field is a conformance problem under rule 6.6, not a strictness error. A strictly signed execution without this field is kept and later flagged as nonconforming. If the contractor signed it, the program charges `nonconforming_record` and continues. In that case, rule 10.3 finds no actions to process.\n\nA null `performed_actions` field is not a list, so it never reaches rule 6.6. The outcomes object must be present and non-null, its keys must match entries in `performed_actions`, and its values must be ok, error, timeout, or partial. Null or absent outcomes are allowed. More than 256 performed actions is a conformance problem.\n\nAny approval whose action name is missing or does not match the pattern causes a conformance problem, even if that approval is unused. If a conformance problem exists and no verifying contractor signature is present, the execution is rejected. A verifying contractor signature is one where the signature over the record signing bytes validates against the contractor's public key. Conformance checks run before the ignore step.\n\nIf both a conformance problem and an ignore condition apply, the execution is rejected. Ignored records are excluded from section 7 and do not trigger anchor_incomplete; their disposition is ignored.\n\nFor orphaned heights, the claimed height is valid because orphaned is the fourth row of table 7.4, so the height check already passed. The block hash is valid hex but does not match the view header at that height. The height is within the observed chain range.\n\nA height is provisional if it exceeds the horizon, which is computed as T minus k plus one. A height at or below the horizon is final.\n\nBaseline executions at heights above the horizon are provisional. Missing evidence such as nenrin_required causes a deviation. The view may start below the checkpoint because the first header's previous hash is not checked. A limit of 200,000 headers will be enforced. input_too_large and event set handling are next.\n\nEmpty event sets are underspecified and status undetermined. Binding is always computed for object contracts. Foreign records map to record_sha256. Inconsistent or unbound records are listed. Not-ours records have no disposition. Duplicate record_sha256 values in events cause the first copy to be kept and subsequent copies to be dropped with duplicate_dropped. The kept copy continues processing, and any later anchor failure applies to it rather than the dropped copies.\n\nA group containing only one record is not collapsed. Groups with multiple records are guaranteed to have distinct record_sha256 values because identical records were already merged in step 6.3.\n\nThe anchors_validly check reuses section 7 proof and batch functions but returns only a boolean without emitting reasons. It requires a verified view, so it runs only after the view passes. It checks that the height exists in the view, the block hash matches, the proof is valid, and the batch leg is valid. It does not enforce the lower bound check from note 7.4.\n\nA record below the checkpoint can still anchor validly for collapse purposes, but section 7 later marks it as anchor_below_lower_bound. During the 6.0 anchor cross-check, a non-strict anchor copy is set aside when a strict copy exists; the kept copy then proceeds to 6.4 for possible collapse. If both copies are strictly anchored, both are kept and 6.4 collapses them. The table ordering places the body-not-strict row before the anchor-not-strict row.\n\nA record that is not strictly signed and whose body is not strict is set aside as record_not_strict without also adding an underspecified reason. The fourth row of the table only applies to strictly signed records. A signature_status helper function will classify signatures as strict, lax, or none.\n\nThe `signature_status` helper extracts the signatures list and schema context. It builds a signing message from the canonical body with signatures and anchor removed. It iterates over signature entries to classify them as strict, lax, or none.\n\nThe helper maps signature roles to public keys: contractor for execution records, witness by name for execution records, principal for revocation records, and contractor for revocation-ack records. Entries with unrecognized roles or missing keys are skipped.\n\nThe helper verifies each signature against its mapped public key. A signature that is both strict and the entry is strict is classified as strict. Otherwise it is classified as lax if any signature verifies, or none otherwise. The specification requires that a signature verify under rule 3.4 alone.\n\nWrong-role entries that verify against any known key will be counted as lax signatures. This matches the specification's requirement that a signature verify under rule 3.4 alone.\n\nA signature is strictly verified only if the entry itself is a strict value. If a signature entry contains non-strict fields, the record is not strictly signed even when the signature verifies, so it falls under the lax row as signature_not_strict.\n\nThe \"lax\" label in the signature status table describes verification that is not strict. A signature that strictly verifies but whose entry contains non-strict fields is itself a strict signature, so it should be classified as strict rather than lax.\n\nStrictly signed requires an allowed role, a signature that strictly verifies, and a strict entry. A signature that strictly verifies but whose entry is not strict is rejected rather than treated as lax.\n\nThe `synth_approval_lax` test vector concerns approval signatures, not record signatures. A strict signature that verifies but carries an incorrect role is rejected rather than treated as lax.\n\nWitness keys must pass the point check in rule 3.2; otherwise verification returns unusable and the record is not strictly signed. The principal key is valid because rule 4.1 already requires a verifying signature from the principal, so the key must be a valid point.\n\nApproval canonical messages include all specified keys, defaulting missing fields to null.\n\nApproval signatures are verified against v2, then v1, then v0. A signature that verifies under any older form is labeled label_bound. If none verify, the approval is forged.\n\nA v2 signature that verifies is classified as counted or other_terms, not label_bound. Older forms are not checked after a successful v2 verification.\n\nApproval fields have strict types: single_use must be a JSON boolean, nonce must be a 32-character lowercase hex string, valid_until_height must be a non-negative integer, and contract_sha256 must be a 64-character lowercase hex string. The height h must be less than or equal to valid_until_height.\n\nEvent set kinds are execution, revocation, or revocation_ack.\n\nEvent set SHA-256 values are record_sha256, computed over the entire record including anchor and signatures. Heights in event sets are anchor heights for accepted records. Accepted records map to disposition \"accepted\". The JSON output uses integers for heights and strings for contract_sha256, with ensure_ascii=False and UTF-8 stdout. The program exits with code 0 or 2 and prints exactly one JSON object.\n\nThe JSON output will use compact separators and include a trailing newline. Field order follows the specification exactly. Deviation codes, reasons, and disposition keys are sorted alphabetically for stability.\n\nEvent sets must list height before sha256. The requirements key is only partially checked: spine and convergence are out of scope, evidence is read later, recovery is ignored, and other keys are skipped. Out-of-scope fields will not cause errors so in-scope tests pass.\n\nNull values for limits and admission are in scope and must not be rejected. An empty limits object is out of scope and should error, though no test expects this. The limits key is allowed by rule 4.1, but rule 10 does not type-check its value.\n\nCarried keys will be checked for out-of-scope values before any output is produced, even if the door check would reject the record. This prevents undefined results when a carried key is out of scope. The risk is that a test vector expecting contract_not_verified might fail if it also carries an out-of-scope key.\n\nThe implementation will error on out-of-scope keys rather than silently ignore them. This is safer because no reference specification exists for those cases, and the test vectors do not appear to expect settlements for records carrying such keys.\n\nA parent carrying an out-of-scope key does not invalidate the child settlement, because narrowing only evaluates the child record. A child carrying a null `requirements.spine` is out of scope and must error, since the specification does not define that result. The 6.2 counting rule for records kept by 6.0 is also being reviewed.\n\nKept records are those that pass triage and survive merging of identical bytes. The 10,000-record cap counts unique kept records; one record duplicated many times counts as a single entry. A single pass is expected for conformance, though a loop will be included to catch any missed interactions. In section 10.1, the revocation SHA-256 must match either the lowercase hex body digest or the record SHA-256 of a copy still present after step 6.4.\n\nCopies set aside during 6.0 are not in the input after 6.4, because they were removed before that step. Only kept copies that survive 6.4 can match the revocation SHA-256. A revocation ignored because revoked_by does not equal the principal survives 6.4 but is excluded from the input before anchors.\n\nIgnored revocations do not revoke anything, so their acknowledgments are irrelevant. The effective height for a delivery acknowledgment is the record height plus the acknowledgment window; this only applies when step 4.2 succeeds. Multiple revocations are sorted by effective height, and execution is revoked if any effective height is less than or equal to the record height. A same-block revocation anchor correctly sets the effective height equal to the record height.\n\nExecution revocation checks include accepted, orphaned, and anchor-failure dispositions. Ignored records are excluded because they apply to revocations. Duplicate drops, set aside records, and rejections from step 6.6 are also excluded. Executions that failed anchors are still checked.\n\nExecutions that are nonconforming but continue are kept by 6.0 and checked in step 11.1.\n\nFor the `walk_not_strict` check, the implementation computes the SHA-256 of a walk even when the walk is not strict. If the SHA-256 cannot be computed, the walk is skipped. A `nenrin_ref` that is not a 64-character hex string or null would fail to match any walk's SHA-256, so the execution would be set aside during 6.0 and excluded from step 11.1.\n\nWalks that fail the strictness check are excluded from the index but their SHA-256 values are still tracked in a set. A walk is considered not strict only under the general definition in section 6.0, first paragraph, and body-specific extra checks do not apply to walks. Non-object records are not treated as walks left out for strictness.\n\nIf an execution cites a non-object, no walk_not_strict deviation is generated. The evidence_names_other_contract deviation only applies when the walk is strict and an object, and its context check fails. A single execution can trigger both walk_not_strict and other deviations; in that case the verdict remains underspecified and step 11.2 is skipped.\n\nA single deviation reason does not empty the event set; the verdict may still be deviation while step 11.2 applies. All reasons are collected in a set. A view_not_strict reason alone does not stop the walk or empty the event set, so the status remains undetermined and the event set is non-empty.\n\nA rejected chain view stops examination and empties the event set. A trailing newline passes rules 1–8 but fails rule 9, so the event set is computed and the verdict remains underspecified. An anchor below the lower bound does not empty the event set; other records may still be present while the reason is added. The specification explicitly states that reasons from steps 4.3, 5.1 rule 9, 6.0, 7.4, or 11 do not empty the event set.\n\nAnchor_incomplete does not empty the event set. The settlement becomes underspecified, but the walk continues over accepted records. The event set is only empty when examination stops early.\n\nThe event set will not be emptied for anchor failures. The walk continues over accepted records, but if any reason leaves the verdict underspecified, deviation codes are left empty.\n\nStep 4.3 does not halt event set computation either. Malformed bonds, parent issues, and non-strict contract signatures still trigger walk execution, but the verdict is underspecified and deviations are hidden. A well-formed bond that is underspecified yields undetermined status.\n\nA record_not_strict reason does not halt event set computation; the bad record is set aside and the verdict becomes underspecified. Anchor_not_strict failures will be treated similarly. Disposition codes match their corresponding reason codes, such as anchor_incomplete or orphaned. The lower_bound for step 7.4 is drawn from the contract when the view passes, and the record height is compared against it. The tip height is the last header height.\n\nA header hash is computed by applying SHA-256 twice and reversing the bytes. The Merkle root occupies bytes 36 through 67 of the raw block. The nBits target decodes from the last four bytes using compact encoding, returning None for invalid or zero values.\n\nRule 7 requires the decoded nBits target to be valid and not exceed the floor, and the header hash number must not exceed that target. Rule 6 requires the reversed bytes 4 through 35 of the raw block to match the previous header hash.\n\nThe provided view is only a partial excerpt, so full baseline testing is not possible without the complete files. I will implement carefully and may add unit tests for individual components. The program must be returned as a single code block. I am also drafting an `is_https_url` helper using `urllib.parse.urlparse` to validate that `key_url` values are valid HTTPS URLs.\n\nThe HTTPS URL helper accepts URLs with credentials in the netloc. Domain labels must contain at least two segments after normalization, each matching the pattern `^[a-z0-9]([a-z0-9-]*[a-z0-9])?$`. This forbids hyphenated first or last characters and empty labels. Underscores are also rejected. The parties array must contain exactly two objects.\n\nEach party must be an object. Roles must contain exactly one principal and one contractor. Public keys are canonical base64-to-32-byte values; point checks are deferred to signature verification. Signatures that fail point checks are refused, even when other signatures for the same party are valid. Contract rule 15 requires every signature object to be an object, and a missing signature field makes the key unusable. A party with at least one verifying signature is accepted, but any bad signature still triggers refusal.\n\nA missing domain on a signature normalizes to a party and triggers refusal. Rule 11 numbers are checked across all values: JFloats, integers outside range, plain integers, and booleans are refused. Rule 12 requires all object keys to be printable ASCII. The code will be structured cleanly.\n\nA `canon_text` helper is being drafted to serialize values into canonical text for hashing. It maps None to 'null', booleans to 'true' or 'false', integers to strings, and floats to 'NaN' or infinity. A `canonical` wrapper will encode that text as UTF-8 bytes. JSON keys are always strings, so mixed-type sorting is not a concern.\n\nThe `canon_text` helper now handles strings, lists, and dictionaries. Lists become comma-separated bracketed text. Dictionaries are sorted by key and rendered as quoted JSON objects. A `canon_string` helper quotes keys for canonical output.\n\nChecking whether Python 3's `repr()` on a `JFloat` subclass returns the bare number or an object-style string, since canonical float output must be exact.\n\nPython 3 subclasses of `int` and `float` inherit the base type's `repr`, so a bare `repr(JFloat(1.5))` returns `'1.5'`. To guarantee exact canonical output, I will call `repr(float(v))` explicitly.\n\nBatch JSON parsing must follow strict JSON rules. Duplicate keys and nesting depth exceeding 512 are parse errors that yield batch_not_json. NaN values are permitted by the parser.\n\nNaN is treated as a parse success, but it fails strictness checks and yields batch_not_json. The parenthetical note that NaN is read as a number indicates the interesting behavior occurs after parsing.\n\nNaN is read as a number during parsing, so it does not trigger a parse error. It will only cause a refusal if it fails later strictness checks or schema validation.\n\nThe batch parser will return batch_not_json for parse failures, non-object values, and non-strict JSON. Schema mismatches yield batch_schema_unknown. A missing records array triggers batch_schema_unknown. A count field that does not equal the record list length triggers batch_count_mismatch.\n\nThe count field must be an integer; a float value causes a mismatch. Only the execution batch schema is typed, so the other schemas are skipped in step 7. The record schema maps to the execution kind.\n\nRevocation and ack records yield record_kind_unknown for typed batches. A present but null schema field causes a mismatch. The SHA must be an exact hex digest string match; non-string values trigger record_not_listed. Escaped characters in the SHA string refuse internal and map to anchor_batch_leg_refused.\n\nThe body digest is 32 bytes. The proof must be non-empty and contain no more than 512 operations. The first sha256 after the leading hexlify ends the batch construction; any operations following it belong to the Merkle path and are excluded from the batch.\n\nProof validation requires both Merkle root reachability and the additional header checks in 7.6 to pass. The height check in 7.4 runs first; if the height is below the lower bound, proof checks are skipped entirely. An anchor is refused as incomplete when the height is missing, negative, or non-integer, or when the block hash is absent, not exactly 64 lowercase hex characters, or contains uppercase letters.\n\nUppercase letters in the anchor block hash trigger a strictness refusal under rule 6.0, so the proof validation in 7.5 is never reached. An absent block hash is treated as strict and only fails later under 7.4.\n\nA helper `is_hex_pairs` will enforce that proof operation hex values are non-empty strings with even length and only lowercase hex characters. Empty strings are permitted. If a hex key is present but its value fails this check, the anchor is refused as not strict.\n\nNon-object entries in the proof list are not proof operations, so they do not trigger the hex-pair check. The anchor is still strict and 7.5 rejects the invalid proof. A missing contract.json file causes an error exit with code 2.\n\nA missing view.json file causes an error exit with code 2. The events directory must contain only files, sorted by name; any unparsable file causes the entire input to fail. If parent.json is present, it must parse successfully. A contract that is a list yields contract_not_verified and a null SHA. For object contracts, the SHA is always computed even if canonical serialization fails. Records containing non-strict floats are set aside.\n\nCanonical output must exactly match the reference signer's spelling of NaN and other floats, or signature verification will fail. A record that is strictly signed but contains a non-strict body is set aside and flagged as record_not_strict.\n\nApproval message objects are canonicalized with keys sorted alphabetically. The v1 schema includes contract_id, payload_digest, and nonce; the v0 schema includes action, contract_id, and payload_digest. Missing or null contract_id and payload_digest fields will be serialized as null in the canonical output.\n\nThe principal key is treated as missing and refused as forged if the parties object is malformed, even though the principal key should normally exist. Forged approvals will also be judged for revoked executions, despite the rule that nothing else in a record is judged.\n\nThe parenthetical in 10.4 is exhaustive, so forged approvals are explicitly judged for revoked executions. Each forged approval adds exactly one deviation code, preventing double-counting. A nonconforming record continues to section 7 and may be accepted before walk judges it.\n\nNonconforming records add both the nonconforming_record and revoked deviation codes when applicable. Delegation checks require string entries, and action comparisons are exact with no case folding. The prohibited list uses exact string matching. During the walk, grant keys are handled defensively since 4.1 already ensures authorized_actions and prohibited_actions exist as lists. Expiry_height is validated as a non-negative integer when present.\n\nThe \"computation repeated\" rule in 6.6 means rejecting nonconforming records, removing them, and re-running checks that could be affected by their absence. It does not require repeating the entire anchor or walk computation.\n\nThe exact order of operations is 6.4, then 6.6, then 7. Collapsed records that are later rejected do not return to the batch, so they cannot trigger further rejections. The \"repeat\" in 6.6 is a reference implementation detail rather than a literal loop over all records. Rule 6.5 ignores position.\n\nThe ignore rule in 6.5 applies during 6.0, before 6.4. A kept revocation is ignored if revoked_by is not the principal. Ignored revocations are excluded from collapse and anchors. They are skipped by 6.6, so conformance problems on them never trigger rejection.\n\nThe ignore rule in 6.5 will be applied after 6.6, not before it. Extra fields on a revocation are checked during 6.6 and cause rejection if they exist. A kept revocation is one that survives both 6.0 and 6.6.\n\nReconsidering the placement of the ignore rule: applying it during 6.0 would prevent a duplicate revocation with a non-principal revoked_by from entering 6.4 groups, so only the valid copy survives collapse. Applying it after 6.4 would let both copies collapse first.\n\nReconsidering the ignore rule placement: since revoked_by is signed, two copies of the same revocation body are identical and collapse into one group regardless of whether the ignore rule applies before or after 6.4. Extra fields in the body change the signing bytes, so they form separate groups; extra fields in signatures do not.\n\nConformance checks only cover top-level fields, so extra signature entries are ignored and do not affect collapse. The ignore rule will be applied after conformance and before anchors. Records that fail closed in 6.0 will receive a disposition. A `record_sha256` helper is being drafted to compute the SHA-256 of the canonical record.\n\nA `body_digest` helper computes the SHA-256 of the canonical body, excluding the anchor key. A `signing_body` helper excludes both anchor and signatures before signing. Canonical output omits whitespace and preserves UTF-8 string encoding. The next step is to verify the establishes regex against the reference Python implementation.\n\nThe `establishes` regex will use case-insensitive matching. The `\\b` word boundary handles Unicode letters correctly, so Japanese strings are not a concern. A `check_dne` helper is being drafted to validate the `does_not_establish` list.\n\nThe `check_dne` helper validates the `does_not_establish` list by requiring at least one string containing \"runtime\" or \"enforce\", one containing \"judge\", \"liability\", or \"fault\", one containing \"deviat\", and one containing \"legal\". Empty strings are permitted in the list but do not match any group.\n\nThe `establishes` list must be a non-empty list of strings, and no string may match the forbidden patterns. The `similar` list must also be a non-empty list of strings with no matches. A list containing only empty strings fails the content check. Duplicate deviation reasons across records are handled by Set semantics. `json.dumps(None)` produces the JSON literal `null`. Standard output uses locale encoding.\n\nOutput will be written directly to `sys.stdout.buffer` as UTF-8 bytes to avoid locale encoding issues. Errors are formatted as `{\"error\": \"...\"}`. The events directory is read as a flat list of files; hidden files or subdirectories are skipped, and any JSON parse failure triggers an error.\n\nThe parent narrowing rule 6 compares requires fields. A missing requires field is treated as null, so a child without requires matches a parent without requires and passes. If the child lacks the key, it fails because null does not equal the parent's requires value. Rule 6 also checks that conditional entries contain the action; if none do, it is a violation.\n\nRule 1 checks exact string equality for list membership. Duplicates in a child's authorized actions are allowed even when the parent contains them.\n\nAn absent data_access field counts as an empty list. A child with no entries is a subset of a parent that has entries, so it passes. A parent with no entries and a child with entries violates rule 3.\n\nIf a child delegation object is absent or null, its allowed list is treated as empty.\n\nA child with a delegation object and allowed entries violates the parent when the parent has no delegation. The max_hops field must be an integer or absent; booleans are rejected. A child may not exceed its parent's max_hops by one or more, so a child with max_hops equal to p is invalid if the parent's is p - 1.\n\nExpiry height may equal the parent's value; only a higher child expiry is invalid. Finality depth must be at least the parent's, so a child with equal depth passes. The child's target bits may not exceed the parent's, and equal targets are allowed. The child's acknowledgment window may not be larger than the parent's, with equal windows permitted.\n\nA child may use an anchor when the parent uses delivery_ack, but not the reverse. If a parent's privacy is null, the rule treats it as unset and imposes no constraint on the child. A null ordering field also leaves the child unconstrained.\n\nThe `allow_unscoped` flag is compared as a boolean string. A child may set it true only when the parent also allows it; otherwise narrowing fails. If both are true, narrowing passes and 4.2 alone rejects the child for unscoped approvals. Witness keys are compared as strings, not raw bytes.\n\nRule 11 requires the child to have at least one witness whose key matches a parent witness key. Because 4.1 already validates that every parent witness key is a string, this condition is automatically satisfied.\n\nIf a parent has no witnesses, the witness rule is skipped. The approver comparison logic extracts the `approvers` list from the parent's `approval_policy`, canonicalizes each entry, and compares them as sets of bytes. The order of approvers does not matter, but the order of actions within each entry does.\n\nA child without an approval_policy has empty approvers, so it violates narrowing when the parent requires specific approvers. Parent contract_id must match exactly as a string. The parent is validated against 4.1 alone; any failure there is recorded as parent_narrowing_failed rather than contract_not_verified. Parent bond and signature checks belong to 4.3, not 4.1.\n\nA parent with a non-strict signature that still verifies passes 4.1, but 4.3 would flag the child's signatures as not strict. The parent's own signature is only rejected if it fails verification entirely.\n\nThe `contract_signature_not_strict` reason applies only to the child's signatures, not the parent's. A missing `finality.max_target_bits` causes `chain_view_rejected`. A zero mantissa in the target bits is rejected by both door and view; door rule 10 fails and view rule 1 fails, producing `contract_not_verified` and `chain_view_rejected`.\n\n`contract_not_verified` is a single reason drawn from any 4.1 failure, so 4.2 reasons are not added. The door function will return a boolean via `door_ok`. A separate `is_out_of_scope` helper checks whether the requirements dictionary contains \"spine\" or \"convergence\".\n\nThe `is_out_of_scope` helper now also returns True when the requirements dictionary contains a non-null admission field, or when the grant dictionary contains limits, or when the approval policy approvers are well formed. The `approvers_well_formed` check requires conditional actions from the grant.\n\nA present but malformed approver list causes the door to refuse and the contract to be in scope. Each approver must contain only the keys name, public_key_ed25519_b64, and actions. The name must be a non-empty string. The public key must be a canonical 32-byte Ed25519 base64 string. Names and keys must be unique across the list. Actions must be a non-empty list of distinct non-empty strings. Every action must match an entry in the conditional policy. If the conditional policy is absent then no action matches.\n\nI will verify that conditional actions are unique as part of 4.1. The approver key uniqueness check uses string inequality, since canonical base64 strings decode to identical bytes. I am now beginning the implementation.\n\nStrict signature checks require point multiplication and inversion on the Ed25519 curve. Affine inversion is expensive, but the workload is small enough for tests. I will use extended coordinates from RFC 8032 for faster projective arithmetic.\n\nI will implement the Ed25519 point multiplication and addition manually using projective coordinates, following RFC 8032's extended twisted Edwards addition formula. No external libraries such as nacl will be used.\n\nI decided against manual projective coordinate arithmetic to avoid bugs. Affine point multiplication is sufficient for correctness and clarity, with optimization deferred if tests prove it necessary. I am also exploring a small-order cofactor check to verify that L·P is the identity element.\n\nI am now implementing projective Edwards addition to avoid inversions during scalar multiplication. The point must be checked for membership in the prime-order subgroup by verifying that L·P is the identity element.\n\nI abandoned the projective Edwards addition formula to avoid errors. I will use a well-tested RFC 8032 scalar multiplication routine instead. The standard library's modular exponentiation is fast enough for correctness.\n\nAffine point multiplication is sufficient for correctness and speed. The strict signature check requires the R point to be a canonical prime-order encoding that is not the identity element. The S value must be less than L, parsed as a 32-byte little-endian integer. The example signatures are standard 64-character base64 strings.\n\nI will add a note about ambiguities after the code block. I confirmed that raising ValueError inside json.loads object_pairs_hook propagates correctly. I am designing a depth scanner that counts brackets outside strings and handles escaped quotes.\n\nUnicode escapes are not structural and do not affect bracket counting. The parser will reject integers longer than 4300 digits, excluding the sign from that count. Scientific notation is treated as a float token rather than an integer.\n\nI confirmed that the custom JSON parser correctly distinguishes tokens: negative integers parse as JInt, scientific notation parses as JFloat, and boolean values are not treated as integers.\n\nFiles are read as UTF-8 and any decoding error is caught as invalid input. A top-level JSON number longer than 4300 digits raises an integer-too-long error. The walk logic treats an empty performed_actions list as a valid deviation-free state, and delegation checks are applied before the within_grant check.\n\nThe `evidence_missing` reason only applies when a required reference is not a 64-character hexadecimal string. A missing walk for an accepted execution does not trigger this error; the cross-check deviation only fires if the walk is present and names another contract. The `nenrin_required` check validates the reference format but does not require the walk to be supplied.\n\nWalks will be indexed by SHA-256. If a walk is found and its contract SHA-256 matches the context, no deviation occurs under 11.1. The absence of the context SHA-256 means this rule does not apply. The three conditions for the deviation are present, non-null, and not equal. I am also considering whether a non-strict walk could share the same SHA-256 as a strict one.\n\nA non-strict walk cannot share the same SHA-256 as a strict walk, since identical bytes imply identical strictness.\n\nWhen dispositions exist but the event set is empty and no reasons are underspecified, the verdict is nothing_to_settle. The status is final if no orphaned records remain above the horizon; otherwise it is provisional. A bond is held if the status is final, or pending_finality if provisional. If all records are foreign, the verdict remains nothing_to_settle provided both 4.1 and view checks pass.\n\nI will reject view headers that are empty or contain gaps. Rule 4 requires non-negative integer heights, so booleans and floats fail. I am adding an `is_int` helper to validate JInt values against optional bounds.\n\nThe view check will accept any JInt for the lower_bound height, even unsafe integers. Contract rule 11 would have already rejected an unsafe height during contract verification. This keeps the two checks independent.\n\nA float height such as 1.5 fails rule 2 and triggers both chain_view_rejected and contract_not_verified. An unsafe integer height passes rule 4 but fails rule 9, so only view_not_strict is added and chain_view_rejected is omitted.\n\nThe view strictness check now covers every string, key, and number in the value. Each header must contain an integer height and a hex string of exactly 160 lowercase characters. A view with uppercase hex or a float value fails this rule.\n\nIf a view is not an object or its headers field is not a list, only chain_view_rejected applies. view_not_strict is not added in those cases. The check_view_strict implementation begins with an isinstance check against dict.\n\nRule 9 requires an integer height but does not mandate non-negative. A negative integer therefore fails rule 4 while still satisfying rule 9, so only chain_view_rejected is added. The additional shape check for header heights is independent of the strictness requirement.\n\nThe view strictness check will be split into two phases: first verify the view is an object with a list of headers, then validate each header's shape and strictness separately. A header containing a control character in any field will fail `is_strict` and trigger `view_not_strict`, even if its height and hex are otherwise valid. The batch position parser still needs to be implemented.\n\nA custom string subclass will carry byte offsets and escape flags. The parser will use json.loads for the value, then re-parse with a custom hook to tag every string with its raw span.\n\nThe custom parser will be limited to batch inputs. It must still enforce rules 2.2: rejecting duplicates, depth limits, NaN, and oversized integers. Main inputs will continue using json.loads to avoid bugs.\n\nThe custom JSON parser will be used for both batch validation and span tracking. It will be trusted after testing, with no redundant cross-check against json.loads.\n\nA simpler way to locate the SHA string in a batch is to check that the 64-character digest hex appears raw between two quotes at the splice point. This avoids building a custom JSON parser for span tracking.\n\nThe raw digest hex must appear at the exact splice point inside records[i].sha. A different string placed at that position would fail the check even if it contains the same digest.\n\nA position-tracking JSON parser is being implemented to locate the exact byte span of `records[i].sha`. This avoids relying on the raw 64-character hex check, which would fail if the string contains escapes. The parser class will track depth and advance through the raw bytes.\n\nThe parser will return SpanStr objects that carry byte offsets and escape flags. It rejects trailing bytes after the top-level value. Whitespace is space, tab, newline, or carriage return. If a record's sha field is not a string, step 6 fails and step 8 is skipped. Step 8 only runs when exactly one matching sha is found.\n\nThe batch will be decoded as UTF-8 first; any failure is treated as invalid JSON. Byte offsets for tracked strings will be computed by encoding the prefix text to UTF-8, which is acceptable for small batches.\n\nThe splice check now uses three distinct codes. An escaped SHA string yields internal refusal. A SHA string whose raw content does not start at the prepend length yields splice_not_at_listing. Otherwise the position is valid. The prepend length equals the decoded byte offset of the inserted digest. When no prepends exist, that offset is zero, so the batch must begin with the raw hex characters rather than a quote.\n\nThe batch bytes for the splice check will be built during the proof walk itself, avoiding a separate reconstruction from the proof operations. The `check_batch_leg` function begins by checking whether any operation is a hexlify step.\n\nThe `check_batch_leg` function now enforces that the first operation is exactly one hexlify step. It encodes the body digest as lowercase ASCII and initializes a bytearray for the reconstructed batch, beginning with the raw digest bytes.\n\nThe proof walk iterates over the remaining operations after the leading hexlify. It rejects non-dictionary entries as malformed. It stops at sha256 to mark the SHA field as found. It decodes hex operands for append and prepend steps and extends the reconstructed batch.\n\nPrepend operands are inserted at the front of the batch bytearray. The walk requires a sha256 step to be present. Hex operand decoding is still guarded against invalid pairs and oversized inputs, though prior validation already ensures these checks pass.\n\nThe prepend length is computed by summing the decoded byte lengths of all prepend steps before the first sha256. Each operation is checked against the 65536-byte limit, and hex operands exceeding 4096 bytes are rejected. A hexlify step on large data can push the batch past the limit.\n\nThe sha256 proof operation is valid starting at 32 bytes. Rule 15 verifies signatures against the contract signing bytes using the party's base64 key, with canonical decoding and point checks. Every party must have at least one signature entry, and all entries for a party must verify. Each signature domain normalizes to exactly one party; if it matches none, the proof is refused. The implementation will also enforce that a party's key is used correctly when its domain matches.\n\nRule 4 requires the two normalized domains to differ; normalization failure for any party causes refusal. The key_url field must be an https:// URL, with the scheme required to start with lowercase https://. The task must be an object. Overlap checks between grant.authorized_actions are also being considered.\n\nAction overlap is checked by intersecting the authorized and prohibited sets; any shared action causes refusal. Empty strings are rejected for actions, but empty strings are allowed for `requires` since the spec only requires a string type. Witness names must be non-empty strings. The `max_hops` integer may be zero.\n\nFinality depth and ack_window must be at least one; zero causes door rejection. Expiry height may be zero. A bond amount is truthy only if it is a non-zero number or a non-empty string, list, or dictionary. NaN is truthy because Python bool(float('nan')) returns True.\n\nA bond is well-formed only when its amount is an integer between 1 and 2^53 - 1. If the key is absent or null, the outcome is n/a. A present but malformed bond yields a malformed reason; if its amount is truthy, the outcome is undetermined, otherwise n/a. A non-object bond such as integer 5 is malformed.\n\nRule 9.3 confirms that a value of one is read as a bond with a truthy amount. Status undetermined overrides the bond outcome only for well-formed or truthy malformed bonds. A well-formed bond with an underspecified status yields undetermined, while an absent bond yields n/a. The pending_finality check runs exclusively in the non-underspecified branch, so it cannot trigger when the status is provisional.\n\nReason codes will be deduplicated and sorted. The event set is empty when the proof walk is skipped, such as during early stops from rules 4.1, 4.2, 5.1, 6.2, or oversized headers; otherwise it may be empty but the walk still executes. Binding dispositions apply universally, including on early stops, while triage dispositions are absent in those cases.\n\nEarly stops from rules 4 and 5 occur before triage. For rule 6.2, set-aside and rejected records receive dispositions, but kept records do not, since none are examined further after the count is taken.\n\nSet-aside and 6.0-rejected records will still receive dispositions even if rule 6.2 triggers, because their reasons are themselves dispositions. The \"never examined\" clause in section 9.2 is being interpreted as applying only to kept records that were never individually triaged.\n\nThe interpretation of section 9.2 is being refined: bound records that were never examined, such as kept records that were not anchor-checked, have no disposition. Records that were set aside were examined and retain their dispositions.\n\nForeign, unbound, and inconsistent records are bound even when sections 4 or 5 fail, so they still receive dispositions. If rule 4.1 stops the computation, those bound records have no disposition because triage is skipped. The event set is empty and the verdict remains underspecified. Rule 6.0's closed failure only applies during triage.\n\nSection 2.3 requires triage to run before checking for problems. This implies triage always executes even when rules 4 or 5 fail, which would retain dispositions that should be removed. The exact ordering is being re-examined.\n\nSection 2.3 requires triage to run before checking the contract and view. This means triage always executes even when rules 4 or 5 fail, which would retain dispositions that should be removed.\n\nThe apparent contradiction between section 2.3 and section 9.2 is being resolved by interpreting \"examined\" as section 7 examination. Triage dispositions would still be assigned even when section 4 fails, but anchor dispositions would not.\n\nSection 6.4 explicitly states that collapse proceeds when view rules 1–8 pass, regardless of section 4 results. This directly contradicts section 2.3’s claim that a section 4 failure stops further examination. The more specific rule 6.4 overrides the general summary paragraph.\n\nA concrete contradiction has emerged. If section 4 fails but the view passes, rule 6.4 still permits collapse and duplicate_dropped dispositions to be assigned. Section 9.2 then states that bound records have no disposition when section 4 failed. This means dispositions would exist even though the specification says they do not.\n\nThe contradiction is being resolved by interpreting section 9.2's \"section 4\" as the stop condition in section 2.3, while rule 6.4 explicitly permits collapse and dispositions even when 4.1 fails. A test vector with a bad principal signature is being considered to verify this behavior.\n\nSection 9.2 is being treated as the normative output specification. It explicitly states that bound records have no disposition when sections 4, 5, or 6.2 fail. This overrides the earlier interpretation that triage always runs before those checks.\n\nThe contradiction between 9.2 and 6.4 is being reconciled by treating duplicate_dropped as a valid disposition even when section 4 fails, since both sections are normative.\n\nSection 9.2's \"never examined\" clause applies only to anchor dispositions, not duplicate_dropped dispositions from rule 6.4. When section 4 fails but the view passes, 6.4 still runs because it operates on records kept by 6.0, so triage must execute for collapse to proceed.\n\nA similar contradiction exists for section 5. If the view fails, rule 6.4 does not run, but triage still executes because section 2.3 requires it before the view check. This would produce set-aside dispositions even though section 9.2 says bound records have no disposition when section 5 fails.\n\nThe author is now weighing a hybrid approach: triage might still run when the view fails, but section 9.2 would then strip all dispositions from those records. They are also reconsidering whether \"examined\" in 9.2 applies only to anchor dispositions, since that section lists record_not_strict and other triage codes alongside binding and anchor codes.\n\nThe implementation order is now fixed. Sections 4 and 5 are checked first. Binding always follows. If section 4, 5, or 6.2 fails, triage is skipped and bound records receive no disposition.\n\nThe phrase \"whether or not section 4 did\" in rule 6.4 is being parsed as meaning that the success of section 4 does not affect whether collapse proceeds. This interpretation would allow duplicate_dropped dispositions even when sections 4.1 or 4.2 fail, directly contradicting the earlier ordering where triage is skipped when those checks fail.\n\nThe author is now considering whether the bad-contract test vector simply contains no events, which would make dispositions empty regardless of the ordering. They will check the vector name to verify this.\n\nThe contract hash excludes signatures, so a bad principal signature does not change the bound record. If triage ran on this record, it might be accepted and included in the event set. Because section 4.1 fails, the walk stops before anchor examination, leaving the event set empty. The summary paragraph in section 2.3 confirms that no record is examined further when section 4.1 fails.\n\nThe phrase \"whether or not section 4 did\" in rule 6.4 is ambiguous, since it does not specify whether 4.2 or 4.3 failures matter. To match the test vectors safely, a failed section 4.1 will produce an empty event set and no bound dispositions.\n\nThe phrase \"whether or not section 4 did\" is now interpreted as unambiguous: a section 4 failure does not prevent rule 6.4 from running when the view passes. This means duplicate_dropped dispositions can be assigned even if sections 4.1 or 4.2 fail.\n\nThe algorithm is finalized. Contract binding and section checks run first. If the view fails or headers are too large, triage is skipped entirely. Otherwise triage proceeds even when sections 4.1 or 4.2 fail. Rule 6.4 then runs whenever the view passes.\n\nThe algorithm is now fully resolved. When the view fails, triage, collapse, anchors, and the event walk are all skipped entirely. When the view passes but sections 4.1 or 4.2 fail, triage and collapse still run via rule 6.4, yet conformance checks, anchors, and the walk are skipped; the event set remains empty because no records are accepted. Only when both the view and sections 4.1 and 4.2 pass does the full examination path execute.\n\nRule 6.2 applies after triage even when section 4.1 fails. If more than 10,000 records are kept, the input_too_large disposition is assigned and collapse is skipped. The event set remains empty because anchors are not run and no records are accepted. For a test vector with no duplicate bodies, expected dispositions would be limited to 6.0 set-asides.\n\nA normal strictly signed record is classified as kept by triage but receives no disposition code. This matches section 9.2, which states that bound records have no disposition when sections 4, 5, or 6.2 fail. The baseline execution would therefore be kept with no disposition and an empty event set.\n\nSection 2.3 requires triage to run before the stop check. Unsigned records therefore receive a disposition even when the contract is bad.\n\nTriage can run before the view check because anchor strictness and signature verification do not require a valid contract. Malformed contracts may lack witness keys, but triage can still classify records based on available parties. A view failure will therefore not skip triage.\n\nThe anchor_not_strict cross-check requires a valid view to determine whether another record anchors validly. If the view fails, that check is skipped and the otherwise row applies, producing an anchor_not_strict reason. This would conflict with section 9.2, which forbids dispositions when sections 4, 5, or 6.2 fail. To resolve this, triage is now skipped entirely when the view fails, ensuring no bound dispositions are assigned.\n\nThe author is now reconsidering the no-disposition rule. If triage runs when section 4 fails, records that are examined and classified receive dispositions such as anchor_not_strict. Section 9.2 explicitly excludes records from having dispositions whenever section 4 fails, which conflicts with the idea that triaged records should still be examined.\n\nThe author is now parsing which failures under \"section 4\" trigger the no-disposition rule. Since 2.3 stops on 4.1 and 4.2, but 9.2 names section 4 generally, a 4.3 failure like bond_malformed would leave the event set non-empty.\n\nThe author now interprets section 9.2's \"section 4\" as referring only to the stopping conditions in 4.1 and 4.2, not to 4.3 failures like bond_malformed. This means triage is skipped entirely when those checks fail, which aligns with the \"unexamined\" bound records clause. The author notes that rule 6.4's wording still contradicts this interpretation for section 4, but will proceed with the primary choice that matches 9.2 and section 2.3.\n\nThe author now interprets rule 6.4's phrase \"whether or not section 4 did\" as meaning that contract term problems (4.3) do not block collapse, while view verification remains the prerequisite for anchors validly. This resolves the earlier contradiction with section 9.2.\n\nThe author will document the ambiguity in implementation notes and report any vector mismatches. Rule 6.2 is evaluated only during triage; if more than 10,000 records are kept, input_too_large is assigned and collapse, anchors, and the walk are skipped.\n\nA 4.2 failure such as unscoped_approvals_refused stops examination entirely, leaving the event set empty and the verdict underspecified. A missing finality policy also halts examination with an underspecified verdict. If the view is not strict but rules 1 through 8 pass, examination continues and a reason is added; the event set may be non-empty, yet deviation codes remain empty and the status is undetermined.\n\nThe specification explicitly lists 4.3, rule 5.1 rule 9, 6.0, 7.4, and 11 as checks that never stop event set computation. This confirms that 4.1 and 4.2 failures halt examination entirely, while triage reasons and contract term issues do not.\n\nAnchor reasons such as anchor_incomplete are not in the list of checks that never stop event set computation, but they also do not empty the event set. The status remains undetermined whenever the verdict is underspecified, even if the event set was computed.\n\nThe implementation will use a standard library and `cryptography` Ed25519 module. Each input file holds one element. Orphaned heights are ignored when the verdict is underspecified.\n\nFiles will be parsed as single JSON values and processed in sorted name order for determinism. Output JSON will use compact separators, fixed field order, and only the eight required fields. The evidence_missing reason is applied after all other deviations are computed; if any underspecified reason exists, the verdict becomes underspecified and deviations are cleared before evidence_missing is evaluated.\n\nThe final verdict ordering is now defined. If the event set is empty, the verdict becomes nothing_to_settle and evidence_missing is skipped. Otherwise the default verdict is within_grant; evidence_missing is then evaluated and may upgrade it to deviation. Step 3 catches walk_not_strict as an underspecified reason before evidence_missing runs. evidence_names_other_contract is a deviation computed during the walk phase before the verdict is finalized.\n\n11.1 runs during the full examination path whenever examined executions exist, even if anchor reasons already make the verdict underspecified. The walk_not_strict reason is collected but discarded from output in that case. It reads kept executions from 6.0 and does not require section 10's walk.\n\nThe implementation will always compute walk_not_strict and nonconforming_record during the full examination path, then filter them from output if the verdict becomes underspecified. A fast path for cached Ed25519 point validation is also planned.\n\nThe author is verifying edge cases for Ed25519 point recovery. Identity points are rejected. Small-order points such as order 2 are rejected because L·P does not equal the identity. Non-canonical y values and sign-bit violations when x equals zero are also rejected.\n\nCanonical JSON encoding will use sorted keys and surrogate pair handling. Lone surrogate characters are permitted in strict strings because they fall outside the forbidden control range.\n\nA `walk_values` helper will traverse contract objects and nested structures for rule 12. Rule 11 rejects booleans, plain floats, and out-of-range integers; only JInt and JFloat are valid numbers. The parser will use a custom `parse_int` hook to ensure nested structures contain JInt values. Duplicate keys will raise a distinct exception so they can be handled separately from other errors.\n\nA ValueError raised by parse_int will propagate through json.loads, since CPython passes the result directly to int() without catching it.\n\nA pre-scan will reject JSON with depth exceeding 512 before parsing to avoid RecursionError. Iterative walks will be used where possible, and the default recursion limit is sufficient for the 512-level contract depth.\n\nThe `limits` key in a grant is out of scope only when it is not null. An `approval_policy` without an `approvers` key is in scope; if `allow_unscoped` is true or absent, the record is valid, but if it is false, a 4.2 reason applies.\n\nWitness counts exceeding 32 and key conflicts both trigger a too_many_witnesses reason under 4.2, which halts examination with an empty event set.\n\nThe grant action name check will be applied only in 4.2, not in door. A compiled regex will be used for validation, and domain strings will be normalized by stripping whitespace and trailing dots.\n\nThe domain normalization function strips whitespace and trailing dots, rejects empty strings, spaces, slashes, at-signs, colons, and labels shorter than two characters, and validates each label against a regex requiring alphanumeric characters and hyphens. Internal tabs are caught by the label pattern because they fall outside the allowed character class.\n\nThe `is_https_url` helper will require a host after `https://`, reject empty hosts or paths starting with `/`, and disallow spaces. A bare `https://` is invalid, while `https://example.com` and `https://example.com/path` are valid.\n\nDoor does not check the host under a domain; that is a finding rather than a refusal. The author is now coding the `establishes` patterns as a list of regexes, covering phrases like performed, delivered, money moved, paid, payment made, contract, binding, guarantee, escrow, custody, solvent, lawful, and fair.\n\nThe `establishes` regex list is completed with `\\bcertified\\b`, and all patterns will be matched with case-insensitive flags. A missing anchor proof triggers `anchor_proof_invalid` under rule 7.5, provided rule 7.4 already passed; an empty proof list also fails 7.5. Orphaned heights do not generate a reason. The finality horizon is then evaluated for valid depths.\n\nThe finality horizon is computed as `T - k + 1` where `k` is the grant depth and `T` is the chain tip. Heights at or below this horizon are final; any accepted or orphaned height above it makes the verdict provisional. Edge cases were verified: a zero horizon still marks the record final, and a negative horizon correctly forces provisional status.\n\nOrphaned records are now included in height checks even when they are the only records, and the nothing_to_settle verdict applies to them. A helper function will safely extract `payload_digest` from the task field, returning None if the task is missing or not a dictionary.\n\nThe binding check treats a null payload_digest as absent, so the check is skipped. When both the contract and reference lack a contract_id, the comparison evaluates to true and the reference is unbound.\n\nThe binding check will use direct equality on the contract_id field. If the reference is not a dictionary, it is treated as an empty object so missing keys return None. When the reference lacks a contract_sha256 and its contract_id does not match the current contract_id, the record is dropped; if the IDs match, it is marked unbound.\n\nThe binding check now handles missing fields explicitly: a missing contract_id on the reference makes the record inconsistent, and a present payload_digest that does not match the current one also yields inconsistency. Non-object records and wrong schemas are skipped before SHA256 computation.\n\nThe valid schemas are `a2a-execution-v0`, `a2a-revocation-v0`, and `a2a-revocation-ack-v0`. Canonical JSON failures will be set aside without disposition. Identical SHA256 hashes encountered during the binding walk will skip classification on the second record. Raw records will be stored for later use. The group key for rule 6.4 is the signing bytes, formed by concatenating the context with the canonical signing body. Anchor validation requires verified view data and will only run after that verification.\n\nA record is a valid anchor copy only if it passes strict signing, body, and anchor checks, plus a revocation policy check for revocations. A revocation without a policy is not kept. The `would_be_kept` helper rejects records that fail any of these three conditions.\n\nThe `would_be_kept` helper now also rejects revocation records when the grant lacks a revocation policy. For anchor-not-strict records that pass strict signing and body checks, the code checks whether any other kept-and-anchors-valid record exists in the same group. If another such record is found, the current record is set aside without a reason; otherwise it receives an anchor-not-strict disposition with a reason.\n\nThe `would_be_kept` helper does not depend on other records, so no circular dependency arises. An absent anchor is treated as strict vacuously, letting rule 7.4 catch incomplete proofs. The body-not-strict check requires a schema-specific decoder. Approval signature validation applies only to execution records. A signature is strict if canonical decoding yields 64 bytes, the R point passes the curve test, and S is below the order L.\n\nNon-canonical base64 signatures are treated as unusable under rule 10.4, producing a forged disposition. Helper functions will validate that `performed_actions` is a list of strings and that `approvals` is a list of objects. The author is now ready to write the implementation file.\n\nThe `crypto_verify` helper rejects public keys that fail the Ed25519 point test before calling the cryptography library, ensuring a strict interpretation of rule 3.2. Signatures must decode to exactly 64 bytes; any other length is unusable.\n\nThe cryptography library's verify() call will not enforce the S < L bound itself; strictness is handled separately. A signature whose R point fails the curve test but still verifies under RFC 8032 will be marked signature_not_strict. Point check results will be cached by public key bytes. The batch parser will use the main JSON parser with duplicate-key hooks, and any duplicate keys in a batch will produce a batch_not_json disposition.\n\nThe author is reconsidering whether a batch containing NaN should be treated as non-strict JSON. The specification's reference to strict JSON parsing and the parenthetical example suggest that NaN may parse successfully, so the batch would only fail if it does not contain an object with a valid schema.\n\nThe batch parser will only require successful strict JSON parsing and a valid schema object. NaN will be read as a number rather than treated as a parse error, so the batch may still fail at a later step or receive a batch_not_json disposition.\n\nThe author now requires strict JSON parsing for the batch in step 4. A non-strict batch, such as one containing NaN, will be refused with a batch_not_json disposition. The informative refusal code is not part of the core output; only the core field matters.\n\nAll batch leg refusals map to the same core disposition and reason, so only the accept or refuse decision matters for conformance. The author is now enumerating the exact boundary cases that must be rejected: missing hexlify, non-leading hexlify, malformed legs, invalid JSON or schema, count mismatches, and SHA256 duplicates or missing entries.\n\nKind mismatches, incorrect splice positions, and SHA values containing escapes are also rejected. Whether a batch with NaN is refused depends on the test vector: if NaN changes the expected output, it causes refusal; otherwise it is accepted.\n\nThe batch is embedded inside a record's anchor proof, not a top-level input file. A NaN in the batch must not abort the settlement; it is handled internally by rule 7.6.\n\nThe author now doubts that a NaN batch must be refused. The specification says NaN parses as a number, so the batch may still be an object with a valid schema. Rejecting it would produce a different core disposition than accepting it, which could change the settlement verdict. The text does not explicitly require rejecting non-strict values.\n\nThe author has decided not to reject batches solely for NaN or non-strict values. The batch will be parsed with 2.2 rules, allowing NaN as a number, and only required to be an object with a known schema. If NaN appears inside the records array and prevents it from being a list of objects, the batch will be refused with batch_schema_unknown; otherwise it may still pass. The NaN test vector exists to ensure implementations do not crash or treat the entire input as a parse error when batch bytes contain NaN.\n\nStep 8 internal refusals will map to the same core reason as other batch leg refusals. A baseline proof without hexlify will be accepted immediately. The author is now writing the implementation carefully, ensuring that parent narrowing handles grants with extra keys correctly.\n\nA canonical JSON equality helper will compare objects by their normalized string representation, preserving key order and correctly distinguishing null from empty objects. The author is also beginning to implement the approver canonicalization for rule 14, extracting the approval policy and its approvers list.\n\nThe approver canonicalization helper returns an empty set when the approvers list is absent or malformed. Because rule 4.1 already validates that a child's approvers field is well-formed, this helper only needs to handle the absent case. Rule 14 narrowing remains necessary when a child passes validation but lacks approvers while its parent has them.\n\nThe door function will return True for well-formed approvers without failing on out-of-scope keys such as spine. Spine is not checked by the door, so a parent contract with spine can pass the door check. Narrowing does not validate spine either.\n\nThe author will exit with code 2 when a child contract contains an out-of-scope field such as spine, since the specification treats this as undefined behavior. In-scope test vectors will be processed normally without error. The admission requirements are unchanged from settle v1.11 to v1.14.\n\nThe author is finalizing the carry rules for optional fields. A present and non-null value is carried, while a null or absent key is not. The spine field is out of scope when its key is present, even if null. A grant.limits entry forces requirements.admission to be out of scope. The implementation will be written as a clean, comment-free program and formatted with json.dumps using indent=2.\n\nThe output will be compact JSON with no extra spaces, a trailing newline, and keys in specification order. Disposition entries will be sorted by SHA256 hex, and deviation codes will be sorted as ASCII strings.\n\nThe author will ensure that underspecified verdicts omit deviation codes even when evidence_missing would otherwise apply. They will avoid type bugs by using is_int checks for height comparisons and converting anchor.height to an integer for event set membership. The JInt wrapper is an int subclass, so json.dumps should handle it correctly.\n\nThe author will explicitly convert JInt values to plain integers before JSON serialization as a safeguard. They also plan to handle the case where the specified vector directory does not exist, and are beginning to draft the main entry point with argument validation.\n\nThe main entry point catches `ParseError` and `JSONDecodeError` to emit short JSON error messages, and it also handles `FileNotFoundError` for missing input. The author is choosing brief reason strings such as \"invalid json\", \"duplicate key\", and \"missing input\" to match the specification's `<short reason>` requirement.\n\nThe author will use simple, clear short reasons for errors. Missing required files and out-of-scope fields are not 2.2 errors, so they will be handled separately from the JSON error output.\n\nThe author will exit with code 2 and an \"out of scope\" error for carried out-of-scope keys, noting this in the implementation notes. They also caught a bug where checking `spine` or `convergence` inside `requirements` without first verifying it is a dictionary could incorrectly match a string value; both `requirements` and `grant` must be checked as dictionaries before key access.\n\nA contract with null requirements is not out of scope because the door does not inspect that field. The batch UTF-8 and JSON parsing will be wrapped in try/except so a single bad batch cannot abort the entire settlement. The proof function returns an internal reason code, but the core output uses fixed reasons only. The author is now drafting the anchor check helper.\n\nThe anchor check helper will return a disposition code and a flag indicating whether to add that same code as an underspecified reason. Accepted and orphaned dispositions carry no reason, while other outcomes do. Orphaned heights will be collected for the settlement status. A `ViewInfo` class will store the height map, tip, floor, and lower bound. Rule 8 requires the header at the lower bound height to match its hash.\n\nView verification will return a boolean, a set of reasons, and an optional viewinfo object. If the view is invalid, it returns None and adds chain_view_rejected. Rule 9 is checked separately to add view_not_strict. A view longer than 200,000 headers triggers input_too_large and stops processing. Multiple headers that fail the same check yield only one chain_view_rejected reason. Non-object items in view.headers cause rule 4 to fail. A hex parsing helper will accept an optional trailing line feed.\n\nThe hex parser accepts a 160-character lowercase hex string with an optional trailing line feed. Rule 9 rejects strings that are not exactly 160 lowercase hex characters or that contain a trailing line feed. The `is_strict` check also catches non-strict strings, though the hex length check is the primary guard. Uppercase hex passes `is_strict` but fails the lowercase hex requirement and rule 4.\n\nThe author is defining `is_json_number_ok` to validate JSON numbers. Booleans are treated as non-numbers and handled separately. Integers must fall within the safe range, while JInt instances are accepted as valid numbers.\n\nThe `is_strict` helper is being implemented with a 512-level recursion limit. It rejects floats, accepts booleans and null, validates integers within the safe range, and rejects strings containing control characters or a delete byte. Lists are checked recursively.\n\nThe `is_strict` helper now validates dictionary keys as ASCII printable strings and recursively checks values. The author notes that contract rule 12 separately checks key validity, distinct from the strictness requirement, and wonders whether contracts must satisfy the full 6.0 strictness standard for strings.\n\nRule 12 only validates dictionary keys, not string values, so contracts may contain newlines in values and still pass the door. The author will walk the contract iteratively to collect numbers and keys for rule 11. Door rule 15 requires party keys to be normalized by domain.\n\nSignature verification will refuse any key that fails the point check, even if the key otherwise passes rule 6. A valid point with an invalid signature also yields refusal. The author decided against adding any self-checks or canonical tests that could alter output on import. They are now examining the `paid` regex and the example establishes.\n\nThe baseline establishes contain no forbidden words, so they should pass the door. The example files are only in the prompt text, not on disk, so the full vector cannot be executed here. The author is re-reading section 10.1 to confirm that the ack body digest is the lowercase hex SHA256 of the canonical record including signatures.\n\nThe author clarified that an acknowledgment can name either the body digest or the full record hash of a surviving copy. Dropped copies are excluded from the naming set. The body digest includes signatures, so copies with different signatures produce different digests and signing bytes.\n\nCopies with different signatures but identical bodies share the same signing bytes, so their body digests differ. An acknowledgment naming a dropped copy's body digest would not match the kept copy's digest and would fail to name the revocation. The author is now determining which hashes to include in each accepted revocation's naming set.\n\nThe naming set for each accepted revocation includes the record SHA256 of every surviving copy that shares its signed body, plus the body digest of that revocation. If no copy anchored validly, all copies survive and all their record SHA256s are included.\n\nThe author confirmed that at most one revocation is accepted per signed body, because section 6.4 drops the other when both anchor validly. They are now considering whether surviving copies that failed anchoring should still contribute to the naming set.\n\nCopies that survive 6.4 but fail anchoring still contribute their record SHA255 to the naming set. The accepted revocation's own body digest is also included. An acknowledgment names a revocation only if its revocation_sha256 exactly matches one of these hashes.\n\nThe author clarified that a missing acknowledgment does not name the revocation. The effective height E is the minimum of the anchor height plus the acknowledgment window and all naming acknowledgment heights; if no acknowledgments name the revocation, E equals the anchor height plus the window. Anchor mode requires no acknowledgment window, while delivery acknowledgments must have a positive integer window. Revocation ordering is irrelevant to the boolean outcome.\n\nThe author noted that sorting revocations is only for display and does not affect the boolean outcome. Execution heights are integers, so the revoked check compares them directly against E. In the prohibited state, no approval check runs and the action is treated as unauthorized.\n\nAll approvals on a record are checked for forgery in section 10.5, independent of the action loop. A forged approval for a prohibited action still adds the forged_approval reason. When an action is prohibited, it ignores any approvals and does not consume their nonces; those nonces may be used by other actions. Nonces are consumed only for conditional actions that are neither revoked nor prohibited.\n\nThe author clarified the event loop order. For each execution, revoked status is checked first and skips all other action checks, though approvals are still classified for forgery without consuming nonces. Non-revoked executions proceed through expiry, then prohibited, conditional, and unauthorized checks in sequence; conditional actions may consume nonces. Expiry does not skip later checks, so an action can be both expired and prohibited.\n\nThe author drafted the action loop logic. Expired actions add `after_expiry`. Prohibited actions add `prohibited` and skip to the next iteration. Conditional actions check approvals and skip to the next iteration. Unauthorized actions add `unauthorized`. Duplicate performed actions are judged individually, but each reason is stored as a single set element.\n\nThe author is now adding the `internal` splice logic with a compact JSON parser for spans. They will write a recursive descent parser to locate batch SHA positions in strings, and mentally test it on `{\"a\":\"bc\"}`. Step 8 requires SHA values to be written without escapes.\n\nThe author is implementing a recursive descent string parser to locate batch SHA positions. It tracks escape flags and checks for backslashes between quotes. Strings containing `\\/` or unicode escapes will be refused.\n\nThe parser will compute byte offsets from UTF-8 encodings. It will be a standalone batch parser that raises on any issue, causing batch refusal. SpanStr is defined only for this batch parser, not the main one.\n\nThe author decided to use `json.loads` for structural checks and a custom scan only for step 8. They will implement a `string_span_at_path` helper that walks the JSON text to return byte offsets and escape flags for a specific path, such as `['records', i, 'sha']`.\n\nThe author is now writing the full program and organizing functions. They will compare record signing bytes exactly when grouping records. They also drafted a `witness_key_b64` helper to look up a witness by name in the contract grant.\n\nThe author added a `party_by_role` helper to look up parties by role in the contract. They also began implementing `classify_signing`, which checks whether a record is strictly signed by looking up its schema context.\n\nThe `classify_signing` function is being implemented. It extracts signatures from the record, checks that a schema context exists, and constructs the canonical signing message by removing signatures and anchor fields. It then iterates over signature entries to verify each one against its matching public key.\n\nThe `classify_signing` function now returns `'strict'` if any signature is both valid and strictly encoded. It returns `'lax'` if a valid signature exists but is not strictly encoded, or if no signature verifies against the known keys.\n\nThe author realized that a strict signature with the wrong role should be rejected as not strictly signed, not classified as lax. They are refining the `classify_signing` logic to handle this case correctly.\n\nThe author finalized the `classify_signing` logic. A record is strictly signed only if an allowed-role signature both verifies and is strictly encoded. It is lax if any signature verifies but is not strictly encoded. The author noted that a strict signature with the wrong role should be rejected as not strictly signed.\n\nThe author is now drafting the `classify_signing` implementation. It will use boolean flags to track whether any signature verifies as strict or lax, then return the appropriate disposition based on the role and encoding checks.\n\nThe `classify_signing` implementation is complete. It returns `'strict'` only when an allowed-role signature both verifies and is strictly encoded. It returns `'lax'` if any signature verifies but is not strictly encoded, or if any signature verifies against any known key while the encoding is non-strict. Otherwise it returns `'none'`.\n\nThe author added a `decode_target_hex` helper to parse an 8-character lowercase hex string into an integer and then decode it as compact bits. They also confirmed that `sig_is_strict_b64` rejects any base64 signature that does not decode to exactly 64 bytes.\n\nThe author clarified that `max_target_bits` is the standard big-endian hex string of the compact bits value, not a little-endian byte sequence. For example, \"17080000\" decodes to an integer and then to compact bits. The header's nBits field occupies bytes 72-76 as little-endian bytes.\n\nThe author verified that the header target must be less than or equal to the floor. They confirmed the example max_target_bits decodes to a positive target. They also noted that Python float repr is safe for canonical signing.\n\nThe author confirmed that `repr` matches `json.dumps` for floats and will use it for canonical signing. They also verified that extra keys in `limits` and `approval_policy` entries are refused, and are now checking conditional entry extra keys.\n\nExtra keys are permitted on conditional entries, witnesses, parties, and signatures. Conditional entries must contain a non-empty string action and an optional requires field. The establishes list is checked to ensure every element is a string.\n\nThe author requires both `establishes` and `does_not_establish` to be non-empty lists containing only strings. They confirmed that Python's default regex engine uses Unicode word boundaries, which matches the reference implementation. They also noted that any value that is not a list should be treated as absent.\n\nThe author is computing SHA256 hashes of canonical non-strict objects to detect walk_not_strict. Non-object nenrin entries are skipped during indexing.\n\nThe author added the execution nenrin_ref lookup. A reference found in non_strict_shas triggers walk_not_strict. A reference found in the strict index is checked for contract_sha256 mismatch against the current contract. Duplicate SHA entries are impossible because identical content cannot be both strict and non-strict.\n\nThe author will keep a separate list of executions that pass 6.0, 6.4, and 6.6 but receive anchor dispositions, for the nenrin check. A `revoked_by` check will run after step 6.6. Allowed extra fields on revocation objects are schema, contract_ref, revoked_by, anchor, and signatures.\n\nThe author defined allowed extra fields for revocation and execution objects. They noted that extra fields on charges trigger rejection. They also specified that outcomes keys must match performed_actions entries, and that approval action patterns apply only to object-style approvals.\n\nThe author is defining strictness checks for approval and performed-action fields. If approvals is present but not a list of objects, the record is not strictly signed. Each approval object must contain a valid action matching the pattern. The performed_actions list must be a list of strings; absence or non-list type triggers a problem. Any list longer than 256 entries also triggers a problem.\n\nThe author drafted a `has_verifying_contractor_sig` helper to check that a charge record contains a contractor signature that actually verifies against the contract's contractor public key. If no contractor signature exists, the record is rejected as not charged.\n\nThe author decided to run a single pass over the records, rejecting any that fail and skipping them on subsequent passes. They will store the canonical signing bytes on each record to avoid recomputing them. A `without` helper will remove keys from dictionaries. Contract signing will strip the `signatures` key before canonicalizing. The `canonical` function does not mutate its input.\n\nThe author is implementing a custom JSON parser to enforce strict canonicalization. It tracks nesting depth and rejects duplicate keys, invalid numbers like `0001`, and `+Infinity`. A custom `InputError` exception will be raised for these cases.\n\nThe custom JSON parser now rejects integers longer than 4300 digits. It also parses NaN, Infinity, and -Infinity as valid JSON constants.\n\nThe custom JSON parser now catches `ValueError` and `JSONDecodeError` to raise `InputError`. It also confirms that `InputError` propagates correctly through `json.loads` because it inherits from `Exception`.\n\nThe custom JSON scanner correctly handles escaped quotes and backslash escapes such as `\\/` without confusing nesting depth. Raw newlines inside strings are invalid JSON and will be rejected. The author is now ready to write the program and will implement Ed25519 point arithmetic carefully, trusting the math while being aware that a bug in the point check could incorrectly reject valid strict signatures.\n\nValid Ed25519 signatures must have R in the prime-order subgroup. A bug in the point check would reject all strict signatures and break tests. The author is now verifying the square-root computation against RFC 8032.\n\nThe author implemented the `recover_x` helper for Ed25519 point recovery using the standard RFC 8032 formula. They confirmed that the square root of -1 modulo p is computed correctly as 2^((p-1)/4) mod p. For subgroup verification, they will multiply a recovered point by the curve order L and check that the result is the identity element.\n\nThe author confirmed that multiplying the identity point by the curve order L yields the identity element. They will verify the point addition implementation against a known test vector to ensure correctness.\n\nThe author identified the standard Ed25519 base point public key encoding. They considered adding a self-test at import time but rejected it to avoid startup delays and potential silent failures.\n\nThe author cannot iterate to verify the code, so they will implement carefully. They noted that the `cryptography` library does not expose point multiplication easily, and the `nacl` package is unavailable. They also considered relying on OpenSSL to reject small-order public keys, but decided against it because the specification requires explicit implementation of these checks.\n\nThe author is weighing whether `cryptography.Ed25519PublicKey.from_public_bytes` can replace custom point validation. It may reject invalid encodings and identity points, but OpenSSL's handling of small-order or mixed-order keys is uncertain. Using it for signature R checks would be risky because OpenSSL might enforce stricter or looser rules than the specification requires.\n\nThe author will implement the Ed25519 point validation math directly from RFC 8032, rejecting reliance on `cryptography` or OpenSSL for signature R checks. They noted that a correct implementation must accept the example public key, since any bug would cause verify to return unusable and break the door and baseline tests.\n\nThe author is now reviewing the RFC 8032 Python code carefully. They will use a double-and-add algorithm for point addition and may switch to projective coordinates for speed. They plan to review their custom point check twice before relying on it. A quick sanity check confirms that the identity point will be rejected.\n\nThe author confirmed that the identity point is `010000...` and that y=0 is not the identity. They will copy the RFC formulas exactly to avoid point-check bugs. The subgroup check will be fast enough for the baseline workload. Caching will be added. The code is ready to be written.\n\nThe author resolved an ambiguity in section 6.6: rejected records will not cause a re-run of the collapse step, since the specification orders collapse before conformance checks. They are also reviewing section 7.6 to clarify whether witness and trace batches skip kind validation, and whether executions can appear in those batches.\n\nWitness and trace batches skip step 7 but still require a SHA-256 hash in step 6. Only the nenrin-agreement-batch-v1 schema is typed, so revocations in typed batches are refused. A non-object record entry causes the entire batch to be rejected as unknown schema. If the count field is null, it does not match the actual record count and triggers a mismatch.\n\nThe author clarified that a batch containing duplicate keys will be refused as `batch_not_json` rather than treated as an input 2.2 error. Only top-level input files may abort settlement via 2.2; batch parsing failures are handled separately.\n\nThe author will place the program inside a single fenced code block, followed by notes. Output field order will match the specification exactly: event_set items use kind, sha256, and height in that sequence. They will not use json.dumps with sort_keys to preserve the required ordering. They also noted a subtle bug in parent rule 6 that needs careful handling.\n\nThe author resolved the subtle bug in parent rule 6. They confirmed that a child action cannot be both prohibited and authorized because section 4.1 forbids overlap. They also verified that a parent conditional action may still be prohibited by the child, and that skipping it is correct.\n\nRule 7 rejects a child conditional action only if it is absent from both the parent's authorized and conditional lists. An action appearing in both lists satisfies rule 7 because it is already in the parent's authorized list, and rule 6 may still apply. The author also added a helper to safely extract conditional entries, defaulting to an empty list when the field is missing or not a list.\n\nThe author is drafting helper functions for list extraction and delegation allowed actions. They are also beginning to implement rule 9, starting with a `revocation_violation` check that inspects the parent grant's revocation field.\n\nThe author is implementing the `revocation_violation` helper. It compares the parent grant's `effective_at` value against the child grant's. If the parent lacks a revocation object, it returns False. If the child lacks a revocation object or its `effective_at` field, it returns True. When the parent uses `anchor`, the child must not use `anchor`. When the parent uses `delivery_ack`, the child may use `anchor` but must use `delivery_ack` with a valid integer `ack_window`.\n\nThe author finalized the `revocation_violation` logic. A child grant without an integer `ack_window` is a violation. When both grants specify `delivery_ack`, the child's window must not exceed the parent's. The author then began implementing Rule 10.\n\nThe author is implementing Rule 10. It checks that a child grant's finality object exists and has an integer depth at least as large as the parent's. It also verifies that max_target_bits is present in the child when the parent specifies it, decoding both values to compare targets.\n\nThe author completed Rule 10 by adding a check that the child's max_target_bits decodes to a target no larger than the parent's. They also began implementing Rule 12, which requires the child grant to set privacy and ordering to the same canonical JSON values as the parent when the parent specifies them.\n\nRule 12 is finalized. A child grant must set `ordering` to the same canonical JSON value as the parent. An explicit `{\"same_height\": null}` counts as set, but omitting the key is a violation.\n\nRule 13 is drafted. It checks that a child grant's `approval_policy.allow_unscoped` is not true when the parent's is false. The author uses strict `is True` comparison rather than truthiness.\n\nThe author is implementing the `parent_contract` check. They realized that a missing `contract_id` in the child's parent contract must fail even if the parent's `contract_id` is also absent, because the specification requires the field to be present.\n\nThe author refined the `parent_contract` validation. A missing `contract_id` in either the child or parent input causes a failure. If the parent is not supplied, the parent contract is ignored and no narrowing error is added. If the parent is supplied but its contract object is null, only the `parent_not_supplied` error applies.\n\nThe author decided to emit only the `parent_not_supplied` error when no parent is provided. They noted that \"parent is not an object\" would also be true for a missing parent, but they will not add both errors.\n\nThe author will use a two-branch structure for parent validation: `parent_not_supplied` when no parent is provided, and `parent_narrowing_failed` otherwise. They will collect `contract_signature_not_strict` regardless of context. Signatures that are not lists will be skipped, and valid signatures must decode to exactly 64 bytes.\n\nThe author is reconsidering the signature decoding requirement. They note that section 4.3 says a signature \"decodes to 64 bytes,\" which might mean any base64-decodable value rather than strictly canonical. If so, non-canonical signatures would still decode to 64 bytes but fail the strictness check, and the implementation must not miss this violation.\n\nThe author decided to decode signatures using standard base64 with validate=True and a 64-byte length check, but without requiring re-encoding to match. Strictness will be verified directly on the decoded bytes.\n\nThe author applied the same signature decoding approach to approval signatures in section 6.0. A signature that decodes to 64 bytes but is not strict will be flagged as non-strict, even if it is non-canonical.\n\nThe author will create two helper functions: `b64_decode` for standard base64 validation and exact length, and `b64_canonical` for strict canonical re-encoding checks. They noted that non-canonical base64 variants, such as those using `+/` instead of `-+`, can still validate with standard decoders.\n\nThe author is analyzing the difference between standard base64 validation and strict canonical re-encoding. They note that Python's `validate=True` rejects non-alphabet characters and incorrect padding, which already catches many non-canonical variants. They are considering whether a separate re-encode check is still needed to catch subtle non-canonical forms.\n\nThe author decided to use a strict re-encode check for section 3.2 canonical validation, but a looser decode check for sections 4.3 and 6.0 where only \"decodes to 64 bytes\" is required.\n\nThe author confirmed that signature R bytes must pass canonical public-key point encoding checks, while signature text canonicalness is handled separately. They also verified that final proof and header merkle roots are exactly 32 bytes. With the design complete, they are proceeding to write the implementation and will import sha256.\n\nThe author will omit debug output. They plan to cache point validity checks to speed up signature verification and keep the point multiplication implementation simple. The code is expected to be 1500–2000 lines. They noted that exercise cases and the input_not_settleable error are not needed for the file interface, but they will still enforce the 10001-record limit and add a view header count limit.\n\nThe author will guard against malformed view inputs. A missing `grant` or `lower_bound` will trigger `chain_view_rejected`. They will avoid defensive exception catching so unexpected bugs surface during development.\n\nThe author decided to add defensive exception handling after all, since a crash would produce a nonzero exit code and no JSON settlement. They will catch any unexpected errors during contract SHA256 computation and treat them as failures. Floats in the contract are handled correctly: canonical JSON succeeds but door rule 11 rejects them. The main `settle` function is being drafted with `reasons` and `deviations` sets.\n\nThe `settle` function is being drafted. It initializes a `dispositions` dictionary and returns an immediate failure if the contract is not a dictionary. It then computes the contract SHA256 from canonical JSON without signatures, prefixed with `a2a-contract-v0`. The contract door is checked next; if it fails, `contract_not_verified` is added to the reasons set. If the door passes, `settleable_terms` is invoked to populate the remaining reasons.\n\nThe `settle` function now invokes `strict_terms` for section 4.3, checks the view with `check_view`, and binds records via `bind_records`. It then defines a `stop_exam` guard that halts execution if the contract door fails, any section 4.2 reason is present, or the view check fails.\n\nThe `settle` function now proceeds through the remaining pipeline. It calls `triage` to filter events and updates the disposition and reason sets. If more than 10,000 events remain, it marks `input_too_large` and returns immediately. It then runs `collapse` on the kept events, followed by `conformance` against the contract.\n\nThe `settle` function now merges conformance deviations into the main set. It calls `ignore_revocations` to filter out revocation records and updates dispositions accordingly. It then prepares for anchor checks by saving execution records before they are processed, since Nenrin validation must run on all executions including those that fail anchors. The loop over kept records begins with `check_anchor`.\n\nThe anchor loop now sorts accepted records into the event set. It then runs the section 10 walk and Nenrin checks, updates deviations, and returns the final settlement verdict. The author also began defining the `FOUR_TWO` reason set.\n\nThe `FOUR_TWO` reason set is now fully defined with eight specific terms. The author clarified that `view_ok` means rules 1–8 passed and the header count is acceptable; too many headers triggers `input_too_large` without also requiring `chain_view_rejected`. Non-strict view data does not halt examination. They began drafting the `finish()` function.\n\nThe `finish()` function now maps the final state to one of four verdicts: `underspecified`, `deviation`, `nothing_to_settle`, or `within_grant`. It returns an empty deviation list for the first two cases and a sorted list for deviations. The author noted that section 11.2 checks must run before the final verdict is finalized.\n\nThe author drafted the 11.2 evidence check inside the examination path before the final verdict. If no reasons exist and evidence is required, it scans accepted executions for a valid 64-character Nenrin reference; otherwise it adds `evidence_missing`. The final verdict is `within_grant` when the event set is non-empty and deviations are empty, or `deviation` when deviations are present.\n\nThe author confirmed that section 11.2 evidence checks only run when no examination reasons exist and either deviations or an event set is present. They also defined the `bond_outcome` and `compute_status` signatures, noting that `compute_status` requires accepted heights, orphaned heights, and horizon for non-undetermined verdicts.\n\nThe author confirmed that early stops always carry a reason, so no orphaned heights are produced. They also noted that section 11.1 can add reasons and deviations, but those deviations are discarded whenever any examination reasons exist.\n\nThe author confirmed that section 11.1 always runs in the full path and can add `walk_not_strict` when applicable. They verified that 4.3, view strictness, and 6.0 reasons are already present before the full path begins, so the pipeline remains sound. They also noted that the anchor strictness cross-check requires a valid view, which is available during the full path. For the `anchors_validly` helper, they will use the same proof and batch checks rather than comparing the lower bound directly.\n\nThe author verified that a record below the lower bound can still pass `anchors_validly` and be kept by section 6.0, then later receive an `anchor_below_lower_bound` disposition during section 7.4.\n\nFor section 6.4, they drafted the collapse logic: within each group, only records that pass `anchors_validly` are kept; those records are sorted by height and SHA256, and the first is retained while the rest are marked `duplicate_dropped`. Groups of size one require no special handling.\n\nThe author confirmed that anchor heights are integers and SHA256 strings sort correctly as lowercase hex. They will cache the SHA256 on each record wrapper to avoid recomputing it. The implementation is now ready to be written.\n\nThe author is adding a `__main__` entry point and a `load_dir` helper to read the contract, view, and event files from a directory. They also noted the need to fix the JSON encoder and ensure valid Python syntax.\n\nThe `load_dir` helper now reads event files from the events subdirectory, Nenrin records from the nenrin subdirectory, and an optional parent.json file. It returns the contract, events, view, Nenrin records, parent data, and a boolean indicating whether the parent was supplied.\n\nThe author verified the Ed25519 order L equals 2^252 plus 27742317777372353535851937790883648493. They also confirmed that missing Nenrin directories yield None, which is handled safely by section 11.1. They will catch UnicodeDecodeError and OSError as InputError.\n\nThe author finalized the Ed25519 curve constants in Python. `L` is defined as `2**252 + 27742317777372353535851937790883648493`. The curve parameter `d` is computed as `(-121665 * pow(121666, p-2, p)) % p`. The square root constant `I` is set to `pow(2, (p-1)//4, p)`. They verified that `p = 2^255 - 19` satisfies `p ≡ 5 (mod 8)`, confirming the exponent for modular square roots. An optional runtime check against the cryptography library will validate that a random valid signature passes.\n\nThe author is verifying the correct point addition formulas for the twisted Edwards curve with a = -1, since Ed25519 uses this form rather than the standard Edwards curve. They are checking against RFC 8032 to ensure the implementation matches the specification.\n\nThe author confirmed the point addition formulas match RFC 8032 section 5.1.4 for the twisted Edwards curve with a = -1. They also began implementing scalar multiplication using binary exponentiation.\n\nThe author verified that the identity point addition formula correctly returns the other point. They confirmed that local reassignment of the parameter P avoids mutating the caller's data. They also noted that `JFloat` subclasses will use standard `math.isnan` and `math.isinf` for consistent handling of special floats.\n\nJFloat NaN handling is verified: it is recognized by math.isnan and canonicalized to 'NaN', and strictness rules already reject all floats so equality issues are irrelevant. The JSON parser will use object_pairs_hook to catch duplicate unicode keys. Contract rule 2 will be enforced with an exact 32-character lowercase hex check, and the nonce field will receive the same validation.\n\nThe author drafted validation checks for the contract parties and task fields. They require exactly two parties, one principal and one contractor, and enforce that both are objects. They also require the task dictionary to exist and contain a non-empty string purpose.\n\nThe author added validation for the optional `payload_digest` field in the task dictionary, requiring it to be a 64-character lowercase hex string when present. They also defined the allowed grant keys and began checking that the grant dictionary contains only those permitted fields.\n\nThe author added validation for `authorized_actions` and `prohibited_actions` in the grant dictionary. Both must be non-empty string lists, and they must not overlap. They also began drafting a `grant_types_ok` helper to enforce typed keys, and started checking the `approval_policy` field when it is present.\n\nThe author completed the `approval_policy` validation logic. It accepts only `allow_unscoped` and `approvers` keys, requires `allow_unscoped` to be a boolean, and delegates approver list checking to a new `approvers_well_formed` helper.\n\nThe `approvers_well_formed` helper now enforces that the approvers list has between one and sixteen entries, each entry is a dictionary containing only `name`, `public_key_ed25519_b64`, and `actions`. It also collects conditional actions from the grant's `conditional` list to validate against those entries.\n\nThe `approvers_well_formed` helper now validates each approver entry. It requires a non-empty string name, a canonical 32-byte Ed25519 base64 public key, and a non-empty actions list with no duplicates. Every action must be a non-empty string present in the grant's conditional actions. Valid entries are collected into separate lists for names and public keys.\n\nThe `approvers_well_formed` helper now checks that no two approvers share the same name or public key. The author noted that conditional actions are only needed to validate approver entries, so the order of these checks is irrelevant because any failure causes the door to fail.\n\nThe author will check out-of-scope status before door checks. If a contract is malformed but approvers are well-formed, the door fails and the result is undefined, so an error is acceptable. They will also reject any input containing a spine field immediately, producing no settlement. The `is_out_of_scope` helper will run at the start; if the contract is not a dictionary, it falls back to `contract_not_verified`.\n\nThe author decided to error on out-of-scope contracts rather than return a failure result. They noted that all test vectors are in-scope by definition, so this path will not be exercised. They also confirmed the settlement body must contain exactly eight fields and will not include extra informative fields. Before writing the code, they want to re-check whether section 6.0 body validation is strict for contract_ref fields.\n\nThe author confirmed that section 6.0 body validation is not strict for `contract_ref` fields. A present but non-64-character lowercase hex value in `contract_sha256` or `payload_digest` causes the body to be rejected as not strict. Null values are also treated as invalid hex.\n\nThe author clarified that a bound record can carry an invalid `payload_digest` if the `nenrin_ref` digest is absent, because binding only validates against the present digest. A non-64 hex `payload_digest` in that case causes the body to be rejected as not strict. They then began drafting validation for the `nenrin_ref` field.\n\nThe author confirmed the `nenrin_ref` validation correctly rejects non-64 lowercase hex values when the field is present. They also noted that anchor strictness applies to the full record, not the body, and that performed actions should be checked on the body without signatures or anchor. They began drafting approval signature validation.\n\nThe author drafted the approval signature validation for the `a2a-execution-v0` schema. It iterates over each approval entry and checks both `sig_b64` and `signature` fields. Each value is base64-decoded to 64 bytes, and if decoding succeeds but the resulting bytes are not strict, the body is rejected as not strict. They also began defining a `sig_bytes_strict` helper.\n\nThe `sig_bytes_strict` helper now enforces 64-byte signatures, checks that the scalar S is below the curve order L, and validates that the public key point R is canonical and non-identity. This same strictness rule will be applied to contract signatures in section 4.3. The author is ready to write the full source and plans to use projective scalar multiplication for speed while keeping correctness.\n\nThe author chose the RFC affine version for correctness first. A baseline of about 100 milliseconds is acceptable, but vectors with many approvals could take several seconds. Projective coordinates will be implemented as a faster fallback if evaluation becomes too slow.\n\nThe author estimated that 20 Ed25519 point checks would take roughly one second, confirming the affine approach is fast enough. They decided against raising the recursion limit and finalized the `emit` function to write compact JSON directly to stdout.\n\nThe `emit` function now appends a newline and exits with the given code. Disposition keys, event sets, deviation codes, and reasons are sorted to ensure deterministic JSON output. Multiple dispositions for the same key overwrite each other, with the last one winning.\n\nThe author will enforce exactly one disposition per SHA-256. Binding and triage operate on separate record sets, so they never overlap. Duplicate records sharing the same SHA are skipped, keeping only the first. Records that fail canonicalization, non-dictionary events, or wrong schemas are set aside without a disposition. The author is now ready to write the complete implementation.\n\nThe author will add a nested batch position parser. They plan to implement a `locate_sha_span` helper that uses a span-tracking JSON parser to locate the exact text span of a matching SHA-256 digest. If the parser fails on valid JSON, the batch will be refused as malformed.\n\nThe author is writing a custom `SpanParser` class to locate exact text spans for SHA-256 digests in batch vectors. The baseline test vector does not exercise this step, so the parser must be correct for synthetic batches.\n\nThe `SpanParser` class is being implemented with a recursive `val()` method. It handles objects, arrays, strings, booleans, and null values. The author noted that NaN could be mistaken for null because both start with 'n'.\n\nThe `SpanParser` now distinguishes `null` from `NaN` and handles `Infinity` and negative infinity. It also enforces a 512-level depth limit on nested objects.\n\nThe `SpanParser` now parses object keys. It skips whitespace, expects a quoted string, and checks for a colon.\n\nThe `SpanParser` now handles object values, duplicate keys, and commas. It will also parse arrays and strings. The author noted that `SpanStr` must work as a dictionary key.\n\nThe author decided to subclass `str` for `SpanStr`, storing a `start_byte` attribute so the parser can later extract exact text spans. This also ensures that `SpanStr` objects work correctly as dictionary keys and in duplicate checks.\n\nThe author realized that UTF-8 multibyte characters would make character indices incompatible with raw byte offsets. To fix this, `SpanStr` will store an `escaped` flag and compute its byte offset by encoding the prefix up to `start_char` as UTF-8. This ensures the span maps directly to the original batch bytes.\n\nThe author confirmed that valid UTF-8 roundtripping preserves bytes. They verified that `start_byte` points to the first content character, not the quote mark. To keep step 8 parsing lightweight, they will use `json.loads` for schema and count checks, and only use the custom span parser for locating exact text spans.\n\nThe author decided to use the custom span parser for both locating SHA spans and parsing the full batch structure, rather than using json.loads for steps 4-7. This avoids divergence between the two paths. The parser will return float('nan') for NaN tokens, which the schema check can then process normally. Numbers without fractions or exponents will be parsed as integers, while larger values become floats or infinity.\n\nThe span parser is the riskiest part of the implementation, but it is still being written carefully. It will accept standard JSON whitespace and handle empty arrays and nested structures.\n\nThe author confirmed the validation pipeline order: 7.4, then 7.5, then 7.6. They verified that 7.5 rejects invalid operations before 7.6 runs, so all ops are well-formed when hexlify rules are checked. A proof with a hexlify operation can pass 7.5 yet still fail 7.6 if the hexlify rule is violated.\n\nThe author noted that a proof reaching the merkle root with extra bytes equal by chance is acceptable. They also compiled a list of implementation ambiguities to resolve, including whether collapse runs when earlier steps fail, how parent_not_supplied interacts with parent_narrowing_failed, and the correct error path for out-of-scope inputs.\n\nThe author confirmed that forged_approval still applies to revoked executions. They also re-examined the batch NaN vector: the specification clarifies that NaN is read as a number, not as a parse error that aborts settlement. The actual outcome of that vector determines whether the batch is refused.\n\nThe author will add an `is_strict` check on the parsed batch object. If the batch fails strict JSON validation, it will be refused.\n\nThe author decided to refuse non-strict batches. NaN causes a settlement with anchor_batch_leg_refused rather than an abort. The specification's emphasis on strict JSON and the v1.16 theme of rejecting non-strict data supports this approach.\n\nThe author clarified that \"strict JSON\" in the specification refers to section 2.2, not section 6.0. The parenthetical note about NaN is meant to explain a 2.2 parsing behavior, so the document's emphasis on strictness still supports refusing batches containing NaN.\n\nThe author reversed their earlier decision. They now interpret \"strict JSON\" as requiring only a successful parse under section 2.2, which accepts NaN as a number. Batches containing NaN will not be extra-rejected for strictness violations; they will only be refused if other schema or count checks fail. This is the more literal reading of the citation.\n\nThe author confirmed that a batch with NaN in an extra field will be accepted as a valid leg if the SHA checks pass. They also clarified that step 4 produces either `batch_not_json` or `batch_schema_unknown`, and that UTF-8 decode failures on raw batch bytes will be refused as `batch_not_json`.\n\nThe author is now writing the implementation, aiming to keep it under 2000 lines. They will add an `is_lower_hex` helper and compile regex patterns for action names and forbidden words once. The forbidden-word pattern uses a negative lookahead to exclude \"paid for this record\" while allowing \"paid for the record\".\n\nThe author verified that the forbidden-word regexes correctly match intended phrases and reject others. They will import `math` for NaN checks and `cryptography` at the top of the file.\n\nThe author is implementing the Ed25519 signature verification layer. A `crypto_verify` helper catches `InvalidSignature` and `ValueError` from `from_public_bytes` to return a boolean. The top-level `verify` function canonicalizes base64 inputs, rejects unusable keys, checks the public key point, and delegates to `crypto_verify`.\n\nThe author clarified that signature point checks are not part of the \"unusable\" path. Only key and signature length or canonicalization failures trigger that outcome. The R point check belongs to strictness validation instead.\n\nThe author clarified that strict signature validation requires the R point to pass public-key checks, S to be below the curve order L, and the signature to strictly verify. Step 4.3 only needs to decode the signature to 64 bytes and fail strictness if R is invalid or S is not below L; it does not require verification. A signature with a valid R point but an S below L is still a strict encoding even if it fails verification. The author will also implement a `b64_decode_any` helper that accepts non-canonical base64 for step 4.3 decoding.\n\n`b64_decode_any` validates base64 and length, while `b64_canonical` additionally checks that the bytes re-encode to the exact same string. Both helpers will be used for contract door rule 6 and witness keys in rule 10.\n\nThe author noticed a discrepancy between the contract door rules: parties require canonical base64 decoding, while witnesses only require 32 bytes. To be safe and consistent with section 3.2, they will require canonical base64 for both parties and witnesses.\n\nWitness keys will be decoded with `b64_decode_any` to 32 bytes, while party keys and approvers will use `b64_canonical`. The `key_conflict` check will compare decoded bytes from whichever decoder was used for acceptance. Non-canonical witness keys are unusable under section 3.2.\n\nThe author is now writing the program. They will cache `point_ok` results in a dictionary and pre-reject points where the high bit makes y >= p before calling recover_point.\n\nThe author is writing the `compute_status` function. It returns 'undetermined' for 'underspecified' verdicts. They also verified that null bonds on non-object contracts and orphaned records above the horizon map to 'provisional'.\n\nThe author finalized the `compute_status` logic: it returns 'final' when no heights exist or all accepted and orphaned heights are at or below the horizon, and 'provisional' otherwise. The horizon is derived from the contract's finality depth as `viewinfo.tip - k + 1`. They also noted that accepted records should store their height. With these details settled, they are ready to write the implementation.\n\nThe author is now writing the implementation in a single careful pass. They noted that approval messages require the principal key in base64 for signature verification, and that canonical encoding must handle JSON integers, booleans, and strings correctly. They also began drafting helper functions `contract_id_of` and `payload_of` to extract fields from the contract object.\n\nThe author completed the `payload_of` helper to extract the `payload_digest` from a task dictionary. They noted that v0 canonical objects always contain the three required keys.\n\nThey also confirmed that a missing `sig_b64` field causes verification to return unusable, which maps to a forged outcome.\n\nThe author began drafting an `approval_fields_ok` helper to validate approval fields: `valid_until_height` must be a non-negative integer, `nonce` must be a 32-character lowercase hex string, and `single_use` must be a boolean.\n\nThe `approval_fields_ok` helper now also validates `contract_sha256` as a 64-character lowercase hex string when `need_csha` is true. The author began drafting `classify_approval`, which returns 'forged' for non-dict or missing-key approvals, then starts building the v2 approval message prefix and canonical payload.\n\nThe `classify_approval` function now completes the v2 approval path. It canonicalizes the action, valid_until_height, nonce, and single_use fields into a byte prefix, verifies the signature against the principal key, and returns 'counted' if the contract SHA matches or 'other_terms' otherwise. It then falls through to the v1 approval path, which canonicalizes the contract_id and payload_digest.\n\nThe v1 approval path canonicalizes the action, valid_until_height, nonce, and single_use fields into a byte prefix and returns 'label_bound' if signature verification succeeds. The v0 approval path then canonicalizes the contract_id, payload_digest, and action fields and performs signature verification.\n\nThe author confirmed that a missing action field in v2 approvals is valid; canonicalization handles it as null, and the signature will not verify unless signed with that exact payload. They also began drafting the counted-approval use logic.\n\nThe `approval_matches` helper enforces four conditions: the action must match, the record SHA must match or the approval height must be strictly below the target, the current height must not exceed the approval's validity window, and single-use nonces must not repeat. An approval counts only if it targets the same record or a strictly lower one; equal heights on different records are rejected. The first matching approval in event set order is selected.\n\nThe author will precompute counted approvals while walking the event set. All accepted executions, including revoked ones, must have their approvals classified. Forged approvals on revoked records will be recorded as deviations.\n\nCounted approvals on revoked executions remain available for later use but are not consumed by the revoked record's actions. The counted list is ordered by event set and approval list order, and the first match in that sequence is selected while skipping consumed nonces. Only approvals from accepted executions are included; orphaned execution approvals are excluded. The nenrin check uses a separate set that includes non-accepted executions.\n\nThe author confirmed that an empty or absent approvals list is handled safely. They noted that single-use nonces are consumed globally and shared across all approvals. They also raised a question about what happens when two separate single-use approvals share the same nonce.\n\nOnly single-use approvals consume their nonce; non-single-use approvals remain usable after a shared nonce is consumed. The author now considers the full implementation picture complete.\n\nThe author will raise `InputError('out of scope')` with exit code 2 for inputs outside core v0 scope. This avoids claiming conformance to a broader specification. They noted that test harnesses expecting reference outputs beyond core v0 may fail, but the user's constraints are clear.\n\nThe author confirmed that the listed limit and admission null vectors remain in scope. They verified that a parent execution carrying approvers while its child drops them correctly triggers `parent_narrowing_failed` rather than `contract_not_verified`. They also ensured that parents with approvers do not incorrectly trigger the out-of-scope check.\n\nThe author confirmed the child contract door only validates the child contract. They verified that the parent door must accept rich contracts carrying full fields such as bond and establishes, and that baseline contracts should pass. They also checked that the does_not_establish strings contain the required words runtime and enforce.\n\nThe author verified that the baseline contract door passes by checking forbidden word lists and establishes fields. They noted that proof construction uses append, prepend, and sha256 operations without hex encoding, and that proofs must end at the Merkle root.\n\nCanonical correctness is critical because a wrong digest or encoding would cause the proof to fail and return underspecified instead of within_grant or deviation. The author will write a custom encoder rather than use Python's json.dumps, since that library adds spaces and escapes unicode by default.\n\nThe author verified the custom canonical encoder handles Unicode escapes correctly. Keys sort in code-point order. U+0000 becomes `\\u0000`, U+0008 becomes `\\b`, and U+007F is written as itself. The solidus is not escaped.\n\nRecord signing bytes are the canonical body with signatures and anchor removed. Contract canonical excludes only signatures, keeping other keys sorted. The author is now writing the program and noted a potential bug in nesting counters with multi-byte UTF-8.\n\nThe author confirmed that structural brackets are counted as single code points, not inside multi-byte sequences. They verified that integer parsing receives the full token and that empty documents are rejected by json.loads. They also noted that point checks on keys and signatures from sections 3.2 and 3.4 must be implemented. Finally, they checked that mixed-order rejection works correctly when L*P equals the identity in the subgroup.\n\nThe author verified that the base point L is not identity. They checked that L modulo 8 equals 5, so for any small-order point P, L·P is non-zero and will be rejected.\n\nThe author plans to add a sanity check using the RFC 8032 test vector public key. They will decompress it and verify that L·P equals the identity point, ensuring the Ed25519 point arithmetic is correct.\n\nThe author will compute L·P at the first point_ok call for the RFC 8032 test vector. They cannot fix math errors at runtime, so they will implement carefully and rely on a remembered extended-coordinate decode snippet from a reference Ed25519 implementation.\n\nThe author refined the Ed25519 point-decompression formula. They replaced the `x² ≡ u/v` check with `v·x² ≡ u` to avoid division-by-zero when `v` is zero. They also noted that if `v` is zero, the modular inverse of zero would be invalid.\n\nThe author confirmed that `pow(0, P-2, P)` evaluates to 0 in Python, so the decompression check correctly rejects points where `v` is zero. They also noticed that when `x` is zero and the sign bit is set, the fallback `x = P - x` must be reduced modulo `P` to avoid returning an invalid point.\n\nThe author realized that rejecting the non-canonical zero encoding after the sign-flip would fail, because `P - 0` equals `P`, which is still non-zero and would pass the check. The rejection must happen before the flip instead.\n\nThe author finalized the Ed25519 point-decompression logic by reducing `x` modulo `P` before rejecting non-canonical zero encodings. They also verified that header hashes are big-endian integers and that Bitcoin-style little-endian byte reversal applies to the previous block hash.\n\nThe author will implement a single pass for conformance checks, since each record is independent and no repeated passes are required. They also plan to add a disposition for anchor failures using the record SHA. A wrapper class named `R` is being drafted.\n\nThe `R` wrapper class will use `__slots__` to store raw bytes, SHA, signing bytes, schema, and height. Height will be read from the anchor. Signing bytes will be precomputed only for bound records; foreign records keep only their SHA and disposition. The bind function will return a list of bound `R` objects plus a dispositions dictionary. Triage will consume that bound list. Python dictionaries preserve insertion order, so no `OrderedDict` import is needed. Everything will live in a single file.\n\nThe author re-read section 6.4 and confirmed that conformance is complete once rules 1 through 8 pass, even if section 4 did not. They considered whether vectors with both a section 4.1 failure and duplicate anchored copies might expect `duplicate_dropped` dispositions, but concluded that existing test vectors likely lack such duplicate bodies.\n\nThe author is weighing a strict reading of section 9.2 against the triage logic in section 6.4. If a contract fails section 4 but an event passes conformance, triage would assign dispositions to set-aside and duplicate records, yet section 9.2 says bound records have no disposition when section 4 failed. They are considering whether a test vector with a bad contract and an unsigned event would expect no disposition at all, or a rejection such as rejected or record_not_strict.\n\nThe author decided to follow interpretation A. If section 4 or 5 fails, no triage runs and bound records receive no disposition. This matches the real test vector where a bad contract leaves the signed event unanchored. The author noted that synthetic vectors combining contract failure with unsigned records are not explicitly listed.\n\nThe author will explicitly document in the notes that section 6.4 permits collapsing duplicate copies even when section 4 fails, provided the view passes. They noted this is a potentially risky assumption if an evaluation vector contradicts it.\n\nThe author realized that section 9.2 likely means records were never reached by any classification step, not that every bound record lacks a disposition when section 4 fails. Records classified by 6.0 or 6.4 still receive dispositions.\n\nThe author now interprets section 9.2 as describing the reference implementation's actual output. When the contract door fails, the settle function likely returns early before record processing begins, leaving dispositions only for binding classes.\n\nThe author now interprets section 6.4 as specifically exempting parent and bond checks (4.3) from blocking duplicate collapse, not all of section 4. Section 2.3 confirms that only 4.1 and 4.2 halt examination.\n\nThe author settled on a concrete triage rule: if view rules 1–8 pass, duplicate collapse proceeds even when section 4.1 or 4.2 fails, but conformance, anchors, and walk are skipped in that case. Dispositions from 6.0 and 6.4 still apply, while kept records that never reach anchors receive no disposition.\n\nThe author found a direct contradiction between section 2.3 and section 6.4: 2.3 says collapse is skipped when 4.1 fails, but 6.4 explicitly permits it. They are weighing which to follow.\n\nThe author resolved the conflict between sections 2.3 and 6.4 by treating 6.4 as the overriding rule. When the view passes but section 4 fails, triage and duplicate collapse still proceed, while conformance, anchors, and walk are skipped.\n\nThe author noted that a bad contract paired with only good records produces no dispositions under both interpretations, so the 6.4 exemption is only relevant for bad records and duplicates. They chose to follow 6.4 explicitly to avoid generating extra dispositions if the reference returns early when the door fails.\n\nRe-reading section 2.3 reveals that triage occurs before the contract and view checks. The \"no record examined further\" clause therefore applies only when a problem is found in those later checks, not when triage itself fails. This resolves the apparent contradiction with section 6.4.\n\nThe author finalized the algorithm: bind records unconditionally, then triage only if view rules 1–8 pass and header count is acceptable. If the view fails or there are too many headers, no triage runs and bound records receive no disposition.\n\nThe author is reconsidering whether triage should run when the view fails. If it does, every record would be unanchored because `anchors_validly` is false for an unverified view, which aligns with section 9.2's claim that records have no disposition when section 5 failed.\n\nThe author now interprets section 9.2 as overriding the triage order in section 2.3: when the view fails, no triage runs and records receive no disposition. This creates a conflict with section 6.4, which requires triage results to collapse even when section 4 fails but the view passes.\n\nThe author resolved the conflict by accepting that section 9.2 applies only when a record is never reached because sections 4, 5, or 6.2 failed. Because triage still runs under section 6.4 even when 4.1 fails, set-aside records are examined and receive dispositions. The author will note this inconsistency.\n\nThe author reconciled the apparent contradiction by deciding to always run triage first, even when sections 4, 5, or 6.2 fail. Records examined by triage retain their dispositions from that step. Kept records receive no disposition only because they were never reached by later steps; this matches section 9.2's claim that records were not fully examined. Set-aside records keep their triage dispositions.\n\nThe author confirmed that triage must always run, even when the view check fails. If the view is unverified, non-strict anchors fail closed and add disposition reasons, because section 2.3 requires every problem found so far to be collected without stopping other checks.\n\nThe author confirmed that when the view fails, every record is treated as not anchoring validly because the view never verifies headers. This causes the anchor_not_strict cross-check to fail closed and add that disposition reason, even if the view failure and anchor failure occur in the same vector.\n\nThe author is reconsidering the definition of \"the view holds\" in section 6.4. They suspect it means the raw view object contains the height, not that verification succeeded. If so, triage could run before the view check and still evaluate anchors against an unverified view, which would be incorrect.\n\nThe author finalized the algorithm. They will compute SHA, section 4, and section 5 in parallel. Records are bound unconditionally. Triage runs unconditionally, but anchors_validly is only true when view rules 1–8 pass. Duplicate collapse proceeds whenever the view is verified, even if section 4 fails. Conformance, anchors, walk, and nenrin are skipped unless the view passes and both sections 4.1 and 4.2 succeed.\n\nThe author added the kept-record limit from section 6.2: if triage leaves more than 10,000 kept records, the event set is empty and the verdict is underspecified.\n\nThey also mapped the exact failure paths. When section 4.1 fails, the event set is empty, the verdict is underspecified, and the status is undetermined. When the view check fails, the event set is empty, the reason is chain_view_rejected, and any record_not_strict reasons from triage may still appear.\n\nThe author confirmed that adding record_not_strict when the view fails is consistent with section 2.3, since triage still runs and collects problems. They also verified that section 6.2 applies whenever triage completes, even if section 4.1 fails afterward.\n\nConformance checks are restricted to the full execution path. If section 4.1 fails, nonconforming strictly signed records are kept without a disposition rather than rejected. Nonconforming deviations are omitted when 6.6 is skipped. The author is now ready to code and noted that classify_signing handles missing party keys.\n\nMalformed grants yield None witness keys. A revocation set aside for missing revocation data still receives a disposition even when the contract door check fails, because triage runs before that check.\n\nThe author will code this version and add `view_not_strict` independently. They also decided that when the view holds more than 200,000 headers, triage is skipped entirely and records are not examined further, even though binding still occurs.\n\nThe author will add a `parent_supplied` flag to distinguish an explicitly null parent from one that was never supplied. They are now ready to write the full implementation.\n\nThe author refined the parent contract handling. A `null` or non-object value in `parent.json` yields `parent_narrowing_failed`, not `parent_not_supplied`. The code checks whether the file exists, then validates the parsed value as a dictionary and passes it through the door and narrowing checks.\n\nThe author confirmed that kept records from a failed section 4.1 receive no disposition, while dropped records get duplicate_dropped and are excluded from anchor checks. The full execution path will later overwrite any kept record with an anchor disposition. The program will be written in a structured, readable style.\n\nThe author realized the `anchor_not_strict` cross-check requires computing signing bytes for all bound records first. They will group those records by signing bytes and then resolve the cross-check rows before assigning final dispositions. If canonical serialization fails, the record cannot be grouped; since SHA computation already succeeded, this is treated as not strictly signed.\n\nThe author confirmed that canonical serialization of the body is valid. Records with an invalid schema context are not bound. Signature entries containing control characters or extra non-strict fields fail strictness checks and are treated as not strictly signed.\n\nThe author confirmed that a signature entry can be strict while the underlying signature is not; if the library rejects the non-strict signature, the record is rejected rather than lax. They also finalized the hex encoding details: lowercase ASCII output from `bytes.hex()`, decoding via `bytes.fromhex()`, and a 4096-byte maximum limit.\n\nThe author added proof validation rules. Each operation must be a dictionary with a valid 'op' key and type, and the proof list must be a list. Both `check_proof` and `check_batch` will return booleans. The `anchors_validly` helper checks that the anchor is a dictionary, its height is an integer, and it matches the view.\n\nThe `anchors_validly` helper now verifies the anchor block hash against the view header and checks the proof and batch. Section 7 will reuse these same helpers in the same order. An orphaned record is defined as one whose height exists in the view but whose hash does not match.\n\nThe author will store the lower bound height on the viewinfo object once the view is verified. Duplicate records in the event set are handled by binding only the first occurrence. Files will be sorted by name and non-file entries skipped. Encoding errors will also be caught.\n\nError messages will be short and stable. Out-of-scope contracts will return an \"out of scope\" error, but the program will not emit core fields for them since the specification leaves that behavior undefined. A helper function to iteratively deep-check numbers in the contract for rule 11 is also being added.\n\nThe `contract_numbers_ok` helper performs an iterative deep scan of the contract. It rejects floats, enforces integer bounds, and validates that all dictionary keys are printable ASCII strings.\n\nThe author decided to separate rule 11 and rule 12 into distinct checks. Rule 12 requires dictionary keys to be printable ASCII strings, allowing spaces but rejecting non-string keys. Empty keys are permitted since they contain no forbidden characters. The author is now ready to write the implementation file.\n\nThe author confirmed that JSON output will use lowercase booleans and SHA-256 digests. They decided to keep Ed25519 point checks in affine coordinates and cache `point_ok` results for repeated signatures.\n\nThe author drafted an `is_int` helper that rejects booleans and non-JSON integer tokens, enforcing a 53-bit safe integer bound. They noted that because booleans are subclasses of integers, the boolean check must precede the type check to avoid misclassification.\n\nThe author introduced a `json_int` helper that returns the integer value for a `JInt` or `None` otherwise. Plain integers are treated as valid JSON integers too, in case of constructed values. Canonical serialization checks that values are integers and not booleans, so `JInt` instances satisfy this requirement.\n\nCanonical serialization will accept both `JInt` and plain `int` values. The author is now composing the full source file. They also added a guard to door rule 15 so that a signature key failing the point check cannot be used as a verifying key, since `verify` already returns unusable for such cases. Signature objects must be dictionaries with a normalizable domain, and each entry in the contract's signatures list is validated accordingly.\n\nThe signature verification loop checks each entry against its domain and public key. A single bad signature immediately fails the check, and duplicate roles are deduplicated. Rule 16 is satisfied only when both principal and contractor signatures are present. Signing bytes are computed once per record.\n\nThe author decided that door rule 15 will not fail on non-strict signatures. If the cryptography library rejects a signature as non-strict, door still passes and section 4.3 adds the `contract_signature_not_strict` reason. Both reasons may appear together. Section 4.3 runs independently of door success. A new `check_sig_strictness` helper will validate all signatures for strictness.\n\nThe `check_sig_strictness` helper will decode each signature and reject non-strict bytes. Bond and parent checks will be added to `strict_terms`. The implementation is estimated at 1200–1600 lines, written compactly but clearly. A regex using `re.search` will validate the `establishes` field as a list.\n\nThe author settled on a case-insensitive regex with a negative lookahead to detect the word \"paid\" without matching \"paid for this record\". They will use `re.IGNORECASE` and skip `re.ASCII`. For `does_not_establish`, they will perform lowercase substring checks against the lowercased text. They also clarified that each term must be hit by at least one string, not by concatenating all strings together.\n\nThe author will require `establishes` elements to be strings, failing door if any element is not a string. They are now writing the program and will use compact JSON separators with sorted dispositions. A `KIND` mapping and `CTX` constants for the three contract types are being added.\n\nALLOWED_FIELDS sets will be added to restrict valid fields in contracts. The author confirmed that InputError propagates correctly through Python's JSON parser hooks, since it inherits from Exception and the C extension calls parse_int from Python code.\n\nA depth pre-check will reject contracts deeper than 512 before `json.loads` runs, preventing `RecursionError`.\n\nThe recursion limit will be raised to 10000 before parsing to safely handle the maximum allowed depth of 512.\n\nA manual depth counter will scan the raw JSON string character by character. It tracks nested braces and brackets while skipping escaped backslashes inside quoted strings. This avoids Python's recursion limit when rejecting contracts deeper than 512.\n\nThe author confirmed that an escaped backslash at the end of a quoted string is safely handled by the manual depth counter. They re-checked rule 10.1: the body digest is computed from the canonical contract without the anchor block, while the record SHA-256 covers the full canonical contract, and revocation acknowledgments compare against these lowercase hex values. They also clarified that \"still in the input after 6.4\" refers to entries remaining in the kept list after collapse.\n\nThe author will map each signing byte to the SHA-256 hashes of surviving copies after collapse. Only accepted revocations are considered for rule E, and their signing bytes point to the surviving record SHAs.\n\nThe accepted revocation record's body digest is the specific value to compare against. Other copies of that same revocation may carry different signatures and thus different body digests. A copy is defined as any record sharing the same signing bytes, with signatures excluded.\n\nThe author will compute effective height E as the anchor height h in anchor mode. For delivery acknowledgments, E is the minimum of the anchor height plus the acknowledgment window and any accepted acknowledgment heights that name the revocation. A candidate acknowledgment names the revocation if its name set contains the revocation SHA-256.\n\nThe author will separate accepted records by kind. An execution is revoked if any revocation has effective height at or before the anchor height. For each revoked execution, every string in performed_actions is added to the revoked set. If performed_actions is missing, no strings are added.\n\nThe author added an `after_expiry` check that skips the rule when the grant's `expiry_height` is absent or null. They also began defining the prohibited set, authorized set, and conditional map from action to entry.\n\nEvidence checks will apply only to accepted executions. A new `is_64hex` helper validates 64-character lowercase hex strings. The `nenrin_ref` field is indexed only when it is a non-empty list; absent, null, or non-list values are skipped. Execution kept by rule 6.0 and surviving after collapse and rejection by rule 6.6 are the candidates for rule 11.1.\n\nThe author will snapshot the kept execution list immediately after collapse and conformance, before any revocation filtering. Each execution is unique by SHA-256 after deduplication, so strictness checks apply once per record. Executions with invalid or non-strict nenrin_ref values are already excluded from this list, so walk_not_strict only needs to match against valid 64-character hex references.\n\nDeviations from rule 11.1 will be emitted as codes, while strictness walk reasons are collected separately. The verdict logic for rule 11.2 is being added next. A `bond_outcome` helper will compute the final bond result, returning 'n/a' when the bond field is missing or malformed.\n\nThe `bond_outcome` helper is now fully implemented. It returns 'undetermined' for an underspecified verdict, 'pending_finality' for a provisional status, 'forfeited' for a deviation verdict, and 'held' otherwise. If the bond amount is present but invalid, it returns 'undetermined'; otherwise it returns 'n/a'.\n\nThe author verified that malformed bonds trigger an underspecified verdict and an undetermined outcome, while well-formed bonds with other reasons still yield a held outcome. They confirmed that missing bond amounts evaluate as falsy. The implementation is now complete and ready for source code generation.\n\nThe `finish` function will enforce that deviation codes are empty whenever reasons exist. The event set will be a sorted list of accepted records, keyed by height and SHA-256, with each entry carrying kind, sha256, and height. Disposition keys will also be sorted. All disposition codes will match the specification exactly, with no extras added. Orphaned heights will be stored as integers.\n\nStatus is undetermined whenever reasons exist, even if the view is verified and the full path is complete. Without reasons, status is provisional only after computing the horizon from the tip height and finality depth. The author is now ready to write the complete Python program.\n\nA `batch_leg_ok` helper is being added to validate batch operations. It checks that the operations list contains exactly one `hexlify` operation and that it appears as the first element.\n\nThe `batch_leg_ok` helper now constructs the batch by encoding the body digest hex into a bytearray. It scans the remaining operations for a `sha256` step, rejecting any operation that is not a dictionary or uses an unsupported name. Hex values must be valid lowercase strings of even length.\n\nThe `batch_leg_ok` helper now rejects any raw hex longer than 4096 bytes. It builds the batch by prepending or appending raw bytes, then decodes the combined bytearray as UTF-8. It passes this text to a new `parse_batch` function that returns the parsed object and the SHA span.\n\nThe parser will return the object with SpanStr markers. The batch validator will locate the record whose SHA matches the body digest hex, then check that its SpanStr start_byte equals the pre_len and that it is not escaped.\n\nThe author confirmed that escaped SpanStr values must be refused because the raw text would not contain the 64 hex characters. A non-escaped value at the correct offset with a matching digest is valid. They began implementing a robust span parser with a number method to handle signed integers.\n\nThe span parser now handles floating-point numbers with optional exponents. It returns floats or integers, rejecting any integer longer than 4300 digits.\n\nThe span parser now includes a `string` method that handles escaped characters. It computes the byte offset from the start of the string using UTF-8 encoding and returns a `SpanStr` object tracking the value, its start byte, and whether it was escaped.\n\nThe span parser now handles common escape sequences such as backslash, quote, slash, and control characters. It also supports Unicode escapes by converting four hexadecimal digits into a single character.\n\nThe span parser now rejects control characters and unterminated strings. It enforces duplicate keys, depth limits above 512, and trailing whitespace after parsing. Because this parser is used only for batch JSON, it must accept standard JSON syntax including numbers like `0.5`, `-0`, and `10`.\n\nThe author confirmed that `-0` parses as integer 0 and `0e0` as float. Literal matching for `true`, `false`, `null`, `NaN`, `Infinity`, and `-Infinity` will be exact to avoid prefix collisions. They are now adding a schema check after parsing, starting with the `BATCH_SCHEMAS` dictionary.\n\nThe `BATCH_SCHEMAS` dictionary now lists the three allowed batch types: `nenrin-agreement-batch-v1`, `nenrin-witness-batch-v1`, and `nenrin-trace-pin-batch-v0`. A `KIND_FOR` map will restrict typed batches to `a2a-execution-v0` as execution records; revocation and ack entries are refused. Each record must carry a unique SHA-256, a valid kind, and a matching schema field.\n\nThe record schema will be passed into `batch_leg_ok` rather than read from the batch itself. The validator will enforce exact lowercase SHA-256 equality against the digest hex, rejecting uppercase matches as unlisted records. The author is now drafting the complete Python program and adding imports, a main argument guard, and inline review checks.\n\nThe script will require exactly one command-line argument. For Ed25519 point validation, the author is weighing a faster double-and-add implementation using projective coordinates against the current affine approach, since 50 ms per vector could total roughly 50 seconds for 100 vectors.\n\nThe author chose a simple projective Edwards addition for Ed25519 point validation. They noted that RFC 8032's slow version is correct and that C-accelerated `pow` can handle scalar multiplication in roughly 10 ms per signature, totaling about 100 ms for ten signatures.\n\nAffine coordinates were chosen for Ed25519 point validation. The author estimated that 100 vectors with five signatures each would take about five seconds, which is acceptable.\n\nThe code will be organized into eleven sections: imports and constants, JSON parsing, canonical encoding, base64 and Ed25519 utilities, contract door checks, view logic, record processing, anchors and batch validation, walk and nenrin logic, settle orchestration, and the main entry point.\n\nA subtle ordering issue was noted: narrowing should only run after both doors pass, even though individual grants may satisfy door 4.1.\n\nThe grant subset function will remain defensive despite assuming types. When a child door fails, the parent narrowing reason is added immediately if the parent contract is supplied, without invoking grant subset. This captures the case where the child fails 4.1 even with a parent present.\n\nThe author clarified that when a child door fails and a parent contract is supplied, both `parent_narrowing_failed` and `contract_not_verified` are added. The specification only forbids adding `contract_not_verified` during the parent narrowing check itself; the child door failure still contributes that reason.\n\nIf a parent contract is set but not supplied, only `parent_not_supplied` is added. The parent narrowing check is skipped entirely when the parent is missing, so `parent_narrowing_failed` is never produced in that case.\n\nThe door check will remain independent of parent validation. A `sha256_hex` helper will be added. The program will skip warning filters. Header counts will be verified before hashing to avoid unnecessary work.\n\nThe author decided to verify all headers before checking the 200,000 limit. If the view fails verification, only `chain_view_rejected` is returned even for a massive header set. The `check_view` function will return a tuple of `(verified, too_large, reasons, viewinfo)`, and `view_not_strict` will be added directly inside it. The final code is now being produced.\n\nCanonical encoding must match the reference exactly. The author verified that Python's `str(int('-0'))` produces `0`, which is correct because `-0` is not negative and canonical form forbids leading zeros.\n\nFloat canonicalization will use `repr(float(v))` to match Python 3's JSON float output. This preserves the original exponent form for large numbers and strips trailing zeros from decimal floats.\n\nThe author is now drafting the `settle` orchestration function. They will add `walk_not_strict` and evidence logic directly into the code. Dispositions for triage set-aside will use record SHA-256 values, which remain unique after binding. Records dropped as not ours will be excluded from disposition.\n\nForeign, inconsistent, and unbound records will receive dispositions. Each record belongs to exactly one binding class. The binding loop skips non-dictionary events, validates schema presence, computes canonical SHA-256 digests, discards duplicates, and reads contract references.\n\nThe binding loop now classifies each record and routes it to the bound list or a disposition map. Records that fail classification are dropped. Undigestable records are set aside with `record_not_strict` but receive no disposition.\n\nThe author confirmed that undigestable records are set aside with `record_not_strict` but receive no disposition. The underspecified reason is not added to the settlement because it lacks a SHA-256 digest; only an informative count is recorded. Strictly signed records with valid SHAs still receive the reason. The code will be written as one complete block.\n\nThe author will add section-reference comments to keep the code organized. `make_rec` will compute signing bytes by concatenating the schema prefix with the canonical body digest, then return a `Rec` object. Anchor cross-checks will group records by those signing bytes. A dedicated `Rec` class was chosen over a dict wrapper for clarity.\n\nThe `Rec` class stores the raw event, its SHA-256 digest, signing bytes, and schema. A `rec_height` helper extracts the height from the anchor field using `is_int`. The author is now writing the complete program and will review critical sections as they go.\n\nThe author is drafting the `carried_out_of_scope` helper to detect out-of-scope contracts. It checks requirements for spine, convergence, or admission fields, and inspects the grant dictionary. A null limits value will not be treated as out of scope.\n\nThe `carried_out_of_scope` helper now checks the grant dictionary for a non-null `limits` field or a well-formed `approval_policy.approvers`. A well-formed approver set marks the contract out of scope, and the door will fail even if other checks are invalid. The author noted that this result is undefined by the specification.\n\nThe author is now writing the code. They will add a `FOUR_TWO` stop set. A contract that fails door 4.2 will still be triaged, but it will not anchor or walk, leaving the event set empty and using the 4.2 reason as the underspecified reason. They are also checking whether a strictly signed record with a non-strict body should receive both `record_not_strict` and the 4.2 reason.\n\nThe author confirmed that `record_not_strict` can appear alongside a 4.2 reason because triage problems are collected before the door check. They also verified that section 6.0's rule to avoid emptying the event set does not apply here, since anchoring is skipped when a 4.2 problem exists.\n\nThe author resolved the conflict between 2.3 and 6.4 by following 6.4: collapse will run whenever the view is verified, even if doors 4.1 or 4.2 fail, unless stopped by 6.2. Conformance checks and anchors are deferred to the final step, but only when no earlier stop condition applies.\n\nThe author decided to run the 11th check only on the full path. It requires executions left after 6.4 and 6.6, so it is skipped when an earlier stop condition halts the computation. This avoids adding `walk_not_strict` during early exits.\n\nThe author finalized the settlement verdict logic. A full path with no reasons yields a verdict from deviations and the event set. If reasons exist, the settlement is underspecified and deviations are hidden. The 4.3 check runs before the full path begins. A view_not_strict reason does not block the full path. The four_two_hit flag is computed after door 4.2. If door_ok is false, four_two remains empty and the full path is skipped.\n\nThe ignore step will run only on the full path, before anchors. When the event set is empty after a full walk, the verdict will be nothing_to_settle if no reasons or deviations exist.\n\nThe author clarified that the ignore step is part of triage and runs unconditionally, not only on the full path. A kept revocation with a non-principal revoked_by is ignored and excluded from collapse and anchors.\n\nThe ignore step will run during triage, before conformance checks. A kept revocation with a non-principal revoked_by is ignored and excluded from anchors, so it never reaches 6.6. This matches the specification ordering where 6.5 precedes 6.6.\n\nThe author confirmed that a kept revocation with an extra field and a principal revoked_by is rejected by 6.6 with disposition rejected. The ignore step applies only to records that would otherwise be kept, so ignored records never reach collapse or check 11. Conformance rejections will run on the post-collapse kept list during the full path.\n\nThe author will add an `input_too_large` reason and skip the full path and collapse when a record exceeds size limits. They also clarified that the kept count is computed after the ignore step, since ignored records are excluded from the kept set.\n\nThe author resolved the 10000-record limit by counting records kept by the triage table before the ignore step, not after. This ensures ignored records are excluded from the count.\n\nThe author will count records kept by the triage table before splitting out ignored ones, and assign dispositions for set-aside and rejected records during triage while keeping kept records undispensed.\n\nAnchor_not_strict failures will be handled fail-closed with both a disposition and a reason. When a good copy exists, only the disposition is assigned and no reason is added. A record that will be ignored is still counted as kept by the triage table because ignore runs after the table.\n\nThe author noted a rare edge case where a table-kept revocation anchors validly but is later ignored. In that scenario, the good copy is removed from the kept set while the bad copy is set aside, leaving neither in the event set. This follows the specification text and is treated as an odd but acceptable outcome.","format":"xai-responses-v1","index":0},{"type":"reasoning.encrypted","data":".eyJlbmRwb2ludF9zbHVnIjoieC1haS9ncm9rLTQuNy0yMDI2MDkxNnx4YWkifQ","format":"xai-responses-v1","id":"rs_ceb08c3d-2a44-9039-af48-00e2824f8e75","index":1}]}}],"usage":{"prompt_tokens":24296,"completion_tokens":133103,"total_tokens":157399,"cost":0.845482,"is_byok":false,"prompt_tokens_details":{"cached_tokens":1152,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.845482,"upstream_inference_prompt_cost":0.046864,"upstream_inference_completions_cost":0.798618},"completion_tokens_details":{"reasoning_tokens":112136,"image_tokens":0,"audio_tokens":0}}}